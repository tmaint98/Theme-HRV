                {%if settings.show_dentalhub_service_detail_team%}
                  <div class="product-team">
                    {%if settings.dentalhub_service_detail_team_title != empty%}<h2 class="team-title">{{settings.dentalhub_service_detail_team_title}}</h2>{%endif%}
                    <div class="row list-team">
                      {%for i in (1..6)%}
                        {%capture show%}show_dentalhub_service_detail_team_{{i}}{%endcapture%}
                        {%capture img%}dentalhub_service_detail_team_{{i}}_img.jpg{%endcapture%}
                        {%capture name%}dentalhub_service_detail_team_{{i}}_name{%endcapture%}
                        {%capture position%}dentalhub_service_detail_team_{{i}}_position{%endcapture%}
                        {%capture link%}dentalhub_service_detail_team_{{i}}_link{%endcapture%}
                        {%if settings[show]%}
                          <div class="col-lg-4 col-md-6 col-12 team-item">
                            <div class="img">
                              <a href="{{settings[link]}}"><img src="{{ img | asset_url}}" alt="{{settings[name]}}" /></a>
                            </div>
                            <div class="detail">
                              <div class="info">
                              {%if settings[name] != empty%}
                              <div class="name"><a href="{{settings[link]}}">{{settings[name]}}</a></div>
                              {%endif%}
                              {%if settings[position] != empty%}
                              <div class="position"><a href="{{settings[link]}}">{{settings[position]}}</a></div>
                              {%endif%}
                              </div>
                              <a href="{{settings[link]}}">
                              <div class="icon"><svg width="20px" height="20px" viewBox="0 0 24 24" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg"><path id="primary" d="M12,20a1,1,0,0,1-1-1V13H5a1,1,0,0,1,0-2h6V5a1,1,0,0,1,2,0v6h6a1,1,0,0,1,0,2H13v6A1,1,0,0,1,12,20Z" ></path></svg></div>
                              </a>
                            </div>
                          </div>
                        {%endif%}
                      {%endfor%}
                    </div>
                  </div>
                {%endif%}
              </div>
              {% if settings.show_dentalhub_service_detail_time or settings.show_dentalhub_product_form %}
                <div class="col-lg-4 col-12">
                  {%if settings.show_dentalhub_product_form%}
                    <div class="dentalhub-product-form">
                       <div class="service-form">
                          {% if settings.dentalhub_product_form_title != empty %}
                          <div class="heading-title">
                              <h2 class="title">{{ settings.dentalhub_product_form_title | newline_to_br }}</h2>
                          </div>
                          {% endif %}
                          <div class="form-box form-booking">
                            {%if settings.dh_form_product_booking == 'google-sheet'%}
                              <form id="formbooking" action="{{settings.dh_gg_product_link_form}}" data-shop="{{shop.name}}">
                                {%include 'pro-service-form'%}
                              </form>
                            {%else%}
                            {%- capture formProductContact -%}
                              {%form "contact"%}
                                {%include 'pro-service-form'%}
                              {%endform%}
                              {%- endcapture -%}
                              {{ formProductContact | replace: "script","noscript" }}
                            {%endif%}
                          </div>
                        </div>
                    </div>
                  {%endif%}
                  {% if settings.show_dentalhub_service_detail_time%}
                  <div class="product-time">
                    <div class="time-heading">
                      <div class="title">{{ settings.dentalhub_service_detail_time_title }}</div>
                      {% if settings.dentalhub_service_detail_time_desc != empty %}
                        <div class="desc">{{ settings.dentalhub_service_detail_time_desc }}</div>
                      {% endif %}
                    </div>
                    <div class="time-content">
                      <ul>
                        {% for i in (1..7) %}
                          {% capture title %}dentalhub_service_detail_time_{{i}}_title{%endcapture%}
                          {% capture desc %}dentalhub_service_detail_time_{{i}}_desc{%endcapture%}
                          {% if settings[title] != empty or settings[desc] != empty %}
                            <li><span class="title">{{settings[title]}}</span><span class="desc">{{settings[desc]}}</span></li>
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  </div>
                  {%endif%}
                </div>
              {% endif %}
            </div>
            </div></div></div></div></section></div><div class="d-none">{{ htmlPopover }}</div><div class="modal-coupon--backdrop"></div>
