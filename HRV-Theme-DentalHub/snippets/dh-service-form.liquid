{%if settings.show_dentalhub_service_form%}
{% unless has_heading %}
  <link rel="preload" href="{{ 'dh-page-heading.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'dh-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{% endunless %}

<link rel="preload" href="{{ 'dh-service-form.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'dh-service-form.scss.css' | asset_url }}">
<link href="{{ 'dh-service-form.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'dh-service-form.js' | asset_url }}"></script>
<section class="dentalhub-service-form">
  <div class="container">
    <div class="row align-items-center">
        <div class="col-lg-6 col-12">
          <div class="banner">
            <img src="{{ 'dentalhub_service_form_img.jpg' | asset_url}}" alt="{{ settings.dentalhub_service_form_title | strip_html | escape }}" loading="lazy" decoding="sync" />
          </div>
        </div>
      <div class="col-lg-6 col-12">
        <div class="service-form">
          {% if settings.dentalhub_service_form_title != empty %}
          <div class="heading-title">
              <h2 class="title">{{ settings.dentalhub_service_form_title | newline_to_br }}</h2>
          </div>
          {% endif %}
          <div class="form-box form-booking">
            {%if settings.dh_form_service_pro_booking == 'google-sheet'%}
              <form id="formbooking" action="{{settings.dh_gg_service_link_form}}" data-shop="{{shop.name}}">
                {%include 'service-form'%}
              </form>
            {%else%}
            {%- capture formProductContact -%}
              {%form "contact"%}
                {%include 'service-form'%}
              {%endform%}
              {%- endcapture -%}
              {{ formProductContact | replace: "script","noscript" }}
            {%endif%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%include 'modal-success-service'%}

{%endif%}

