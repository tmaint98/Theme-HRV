<link rel="preload" href="{{ 'dh-index-core.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'dh-index-core.scss.css' | asset_url }}">


  <section class="dentalhub-index-core">
    <div class="container">
      <div class="row list-core">
        {% for i in (1..3) %}
          {% capture show %}show_dentalhub_index_core_{{i}}{%endcapture%}
          {% capture img %}dentalhub_index_core_{{i}}_img.jpg{%endcapture%}
          {% capture title %}dentalhub_index_core_{{i}}_title{%endcapture%}
          {% capture desc %}dentalhub_index_core_{{i}}_desc{%endcapture%}
          {% if settings[show] %}
            <div class="col-lg-4 col-12">
              <div class="core-item">
                <div class="icon"><img src="{{ img | asset_url}}" alt="{{settings[title]}}" loading="lazy" decoding="sync"/></div>
                <div class="core-content">
                  <h3 class="title">{{settings[title]}}</h3>
                  <div class="desc">{{settings[desc]}}</div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>




