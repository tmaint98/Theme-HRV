{% unless has_heading %}
  <link rel="preload" href="{{ 'dh-page-heading.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'dh-page-heading.scss.css' | asset_url }}">
{% endunless %}

<link rel="preload" href="{{ 'dh-index-counter.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'dh-index-counter.scss.css' | asset_url }}">
<link href="{{ 'dh-index-counter.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'dh-index-counter.js' | asset_url }}"></script>

<section class="dentalhub-index-counter">
  <div class="container">
    <div class="row">
    <div class="heading-title">
      {% if settings.dentalhub_index_counter_title != empty %}
        <h2 class="title">{{ settings.dentalhub_index_counter_title | newline_to_br }}</h2>
      {% endif %}
      {% if settings.dentalhub_index_counter_desc != empty %}
        <div class="desc">{{ settings.dentalhub_index_counter_desc }}</div>
      {% endif %}
      {% if settings.dentalhub_index_counter_btn != empty %}
        <div class="btn-more">
          <a href="{{ settings.dentalhub_index_counter_link }}" class="btn-link">
            <span class="link-title">{{ settings.dentalhub_index_counter_btn }}</span>
            <span class="icon">
              <svg width="20px" height="20px" viewBox="0 0 24 24" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg"><path id="primary" d="M12,20a1,1,0,0,1-1-1V13H5a1,1,0,0,1,0-2h6V5a1,1,0,0,1,2,0v6h6a1,1,0,0,1,0,2H13v6A1,1,0,0,1,12,20Z" ></path></svg>
            </span>
          </a>
        </div>
      {% endif %}
    </div>
    <div class="banner">
      <img src="{{ 'dentalhub_index_counter_img.jpg' | asset_url}}" alt="{{ settings.dentalhub_index_counter_title | strip_html | escape }}" loading="lazy" decoding="sync" />
    </div>
      <div class="list-counter">
        {%for i in (1..3)%}
				{%capture show%}show_dentalhub_index_counter_{{i}}{%endcapture%}
				{%capture num%}dentalhub_index_counter_{{i}}_num{%endcapture%}
        {%capture unit%}dentalhub_index_counter_{{i}}_unit{%endcapture%}
				{%capture desc%}dentalhub_index_counter_{{i}}_desc{%endcapture%}
				{%if settings[show]%}
				<div class="counter-item">
					<div class="counter">
						<div class="counter-group notranslate"><span class="counter-num" data-counter="{{settings[num]}}">{{settings[num]}}</span>{%if settings[unit] != empty%}<span class="unit">{{settings[unit]}}</span>{%endif%}</div>
						<div class="desc">{{settings[desc]}}</div>
					</div>
				</div>
				{%endif%}
				{%endfor%}
      </div>
    </div>
  </div>
</section>