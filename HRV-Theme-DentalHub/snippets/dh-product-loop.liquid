{% comment %}<!-- Tính phần trăm -->{% endcomment %}
{% assign on_sale = false %}
{% if product.variants.first.compare_at_price > product.variants.first.price %}
  {% assign on_sale = true %}
{% endif %}

{% comment %}<!-- Tính giá khuyến mãi  -->{% endcomment %}
{% if product.variants.first.compare_at_price > product.variants.first.price %}
  {% assign price_sale = 0 %}
  {% assign price_sale = product.variants.first.compare_at_price | minus: product.variants.first.price | divided_by: product.variants.first.compare_at_price | times: 100 | round: 0 %}
{% endif %}

{% comment %}<!-- Sản phẩm có giá 0đ  -->{% endcomment %}
{%- assign price_zero = false -%}
{%- if product.variants.first.price == 0 -%}
  {%- assign price_zero = true -%}
{%- endif -%}
{% comment %}<!-- Tình trạng hết hàng -->{% endcomment %}
{% assign sold_out = true %}
{% if product.available %}
  {% assign sold_out = false %}
{% endif %}

{% comment %}<!-- Tag sản phẩm -->{% endcomment %}
{%- assign at_store = false -%}

{%- assign check_gift = false -%}
{%- for tag in product.tags -%}
  {%- if tag == 'giftbox' -%}
    {%- assign check_gift = true -%}
  {%- endif -%}
{%- endfor -%}
{% comment %}<!-- Check Video -->{% endcomment %}
{%- assign check_video = false -%}
{%- if product.media.size > 0 -%}
  {%- for media in product.media -%}
    {%- if media.media_type == 'external_video' -%}
      {%- assign check_video = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%assign template_service = false%}
{%if product.template_suffix == 'services'%}
{%assign template_service = true%}
{%endif%}

{%- assign index_item = forloop.index | times: 1 -%}
{%- if template contains 'search' or template contains 'collection' -%}
  {%- if page != nil -%}
    {%- assign index_item = page | minus: 1 | times: settings.collection_pagination_limit | plus: index_item -%}{%- endif -%}
{%- endif -%}
<div class="dentalhub-product-loop {%if template_service %}dentalhub-product-loop-service{%endif%}" data-id="{{ product.variants.first.id }}">
  <div class="dentalhub-product-inner" data-proid="{{ product.id }}" id="{{section}}_loop_{{index_item}}">
    <div class="dentalhub-proloop-image">
      {% if on_sale %}
        <div class="dentalhub-pro-sale">
          <span>-{{ price_sale }}%</span>
        </div>
      {% endif %}
      {% if sold_out %}
        <div class="dentalhub-pro-soldout">
          <span>Hết hàng</span>
        </div>
      {% endif %}
      {% if settings.promotion_hrvapp_use and settings.promotion_hrvapp == 'appcombo' or settings.promotion_hrvapp == 'appbuyxgety' %}
        <div class="gift product_gift_label d-none" data-id="{{product.id}}">
          <img class="lazyload" data-src="{{ settings.combo_icon }}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" alt="Icon quà tặng">
        </div>
      {% endif %}

      {%- if product.description contains '"image360":' or check_video -%}
        <div class="dentalhub-pro-iconbox ">
        {%- if check_video -%}
          <div class="dentalhub-pro-video">
            <img class="lazyload" data-src="https://file.hstatic.net/200000592359/file/icon_video_2d253ef605b0407da214e359ac3bdea5.png" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" alt="image video" />
          </div>
        {%- endif -%}
        {%- if product.description contains '"image360":' - %}
          				<div class="dentalhub-pro-360">
          					<img class="lazyload" data-src="https://file.hstatic.net/200000592359/file/icon_spin_3_556d2cb6ff344907b916eeb57020e156.png" 
          							 src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
          							 alt="image 360"/>
          				</div>
          				{%-endif -%}
          </div>
        {%- endif -%}
        <a href="{{product.url}}" class="dentalhub-product-link">
          <div class="dentalhub-product--image" data-src="{%if product.images.size > 0%}{{ product.featured_image.src | product_img_url: 'large' }}{%else%}{{'no_image.jpg' | asset_url}}{%endif%}">
            <picture>
              <source media="(max-width: 480px)" data-srcset="{%if product.images.size > 0%}{{ product.featured_image.src | product_img_url: 'large' }}{%else%}{{'no_image.jpg' | asset_url}}{%endif%}" srcset="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=">
              <source media="(min-width: 481px)" data-srcset="{%if product.images.size > 0%}{{ product.featured_image.src | product_img_url: 'master' }}{%else%}{{'no_image.jpg' | asset_url}}{%endif%}" srcset="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=">
              <img class="lazyload img-loop " data-src="{%if product.images.size > 0%}{{ product.featured_image.src | product_img_url: 'small' }}{%else%}{{'no_image.jpg' | asset_url}}{%endif%}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" alt="{% if product.featured_image.alt.size >0 %}{{ product.featured_image.alt | strip_html | escape }}{% else%} {{product.title | strip_html | escape}} {% endif %}" />
            </picture>
          </div>
        </a>
      {%comment%}
        <div class="dentalhub-list-icon">
          {%unless template_service or price_zero or check_gift%}
          <div class="dentalhub-quickview-product">
            <a
              class="dentalhub-icon-quickview"
              href="javascript:void(0)"
              name="icon quickview"
              data-handle="{{product.url}}"
              title="Xem nhanh">
              <svg width="20px" height="20px" viewBox="0 0 24 24">
  <path d="M2.03381935,11.8192361 C4.16808919,6.31506648 10.3602678,3.58322297 15.8644374,5.71749281 C18.6654288,6.80359152 20.8800819,9.01824467 21.9661807,11.8192361 C22.0112731,11.9355272 22.0112731,12.0644728 21.9661807,12.1807639 C19.8319108,17.6849335 13.6397322,20.416777 8.1355626,18.2825072 C5.3345712,17.1964085 3.11991805,14.9817553 2.03381935,12.1807639 C1.98872688,12.0644728 1.98872688,11.9355272 2.03381935,11.8192361 Z M8.49709046,17.3501459 C13.4256883,19.2612348 18.9628618,16.8680219 20.9616531,12.0000475 C19.9532865,9.54665483 17.9813179,7.6108696 15.5029095,6.64985412 C10.5743117,4.73876518 5.0371382,7.13197809 3.03834692,11.9999525 C4.04671349,14.4533452 6.01868212,16.3891304 8.49709046,17.3501459 Z M12,16 C9.790861,16 8,14.209139 8,12 C8,9.790861 9.790861,8 12,8 C14.209139,8 16,9.790861 16,12 C16,14.209139 14.209139,16 12,16 Z M12,15 C13.6568542,15 15,13.6568542 15,12 C15,10.3431458 13.6568542,9 12,9 C10.3431458,9 9,10.3431458 9,12 C9,13.6568542 10.3431458,15 12,15 Z"/>
</svg>
            </a>
          </div>
          {%endunless%}
          {% unless price_zero or check_gift or settings.promotion_hrvapp_use %}
            <div class="dentalhub-cart-product">
              {%- if settings.DentalHub_shop_buying and product.variants.first.price > 0 -%}
                <button
                  type="submit"
                  class="dentalhub-btn-proloop-cart dentalhub-add-to-cart {% if sold_out %} disabled {%endif%} {% if product.variants.size > 1 %}dentalhub-btn-addcart-view {% endif %}"
                  onclick="DentalHub.ProductLoop.DentalHub_addCartProdItem('{{ product.variants.first.id }}')"
                  {% if sold_out %}
                  disabled
                  {% endif %}>
                  <svg class="btnico-first" version="1.0" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    <g transform="translate(0 512) scale(.1 -.1)">
                      <path d="m2371 5100c-150-40-306-141-387-248l-35-48-492-58c-271-32-501-63-512-69-31-16-44-39-45-75 0-32 54-516 64-573 5-25 3-27-44-31-27-3-56-11-65-18s-78-117-155-245l-139-232-86-1660c-47-913-85-1692-85-1730 0-60 3-73 23-91l23-22h2125 2126l21 23c18 19 22 35 22 92 0 37-38 815-85 1728l-86 1660-139 232c-77 128-147 238-156 246-11 9-49 15-106 18-86 3-90 4-84 25 3 11 18 74 33 138 29 128 26 152-19 182-13 8-190 54-393 101-204 47-380 90-391 94-14 6-24 22-28 45-11 60-92 208-153 281-76 91-209 181-324 220-73 25-102 29-219 32-111 2-148-1-209-17zm318-176c139-34 279-140 353-265 21-34 36-64 34-66s-51 8-110 22c-113 28-152 27-180-4-8-9-34-96-56-192-23-95-43-182-46-191-4-14-72-44-80-35-1 1-19 139-39 306-19 167-40 311-44 320-21 39-55 45-163 33-56-7-103-10-106-7-8 8 127 68 183 81 72 18 178 17 254-2zm-329-258c0-2 14-117 30-256 17-139 27-256 23-260s-190-51-413-104c-308-74-410-102-427-118-31-29-30-70 7-220 17-67 30-128 30-135 0-10-45-13-203-13h-203l-56 478c-31 262-56 478-55 478 1 1 283 36 627 77s628 75 633 76c4 0 7-1 7-3zm1105-357c242-56 444-105 449-110 6-5-20-134-64-324l-74-315h-246-246l-82 343c-72 301-85 345-107 365-31 26-65 28-147 6-33-8-61-14-63-12-1 2 7 42 18 89l20 86 51-13c28-7 249-58 491-115zm-495-226c0-5 27-120 60-257 33-136 60-252 60-257s-276-9-643-9h-642l-28 117c-15 64-26 117-24 119 2 1 1194 291 1210 293 4 0 7-2 7-6zm-1980-282c0-9 14-119 25-203l5-38h-100c-55 0-100 3-100 6 0 18 145 244 156 244 8 0 14-4 14-9zm3239-110c39-66 71-122 71-125s-74-6-165-6-165 3-165 8c0 4 12 60 27 125l27 117h67 66l72-119zm155-373c3-35 40-733 81-1553s76-1511 78-1537l4-48h-1987-1987l4 48c2 26 37 717 78 1537s78 1518 81 1553l6 62h1818 1818l6-62z" />
                      <path d="m1850 3209c-168-32-260-248-169-395 24-39 82-92 114-104 23-9 23-10 27-242 4-223 5-236 32-313 85-248 285-432 534-492 88-21 256-21 344 0 249 60 449 244 534 492 27 77 28 90 32 312l4 233 34 16c42 20 101 85 121 133 24 55 21 159-6 214-26 53-87 112-140 134-46 20-156 20-202 0-199-83-215-381-26-479l39-19-4-207c-5-237-17-291-88-400-225-349-715-349-940 0-71 109-83 164-88 400l-4 207 39 19c85 44 132 127 133 232 0 175-145 292-320 259z" />
                    </g>
                  </svg>
                </button>
              {%- endif -%}
            </div>
          {% endunless %}
          <div class="dentalhub-view-product">
            <a href="{{product.url}}">
              <svg
                width="20px"
                height="20px"
                viewBox="0 0 24 24"
                id="right"
                class="icon line">
                <polyline id="primary" points="14 5 21 12 14 19" style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;"></polyline>
                <line
                  id="primary-2"
                  data-name="primary"
                  x1="21"
                  y1="12"
                  x2="3"
                  y2="12"
                  style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;"></line>
              </svg>
            </a>
          </div>
        </div>
{%endcomment%}

      </div>
      <div class="dentalhub-proloop-detail">
        {%- unless product.vendor == 'Khác' -%}
          <p class="dentalhub-proloop--vendor">{{ product.vendor | link_to_vendor }}</p>
        {%- endunless -%}

        <h3>
          <a href="{{product.url}}" class="dentalhub-quickview-product" data-handle="{{product.url}}">{{ product.title }}</a>
        </h3>
        {%if template_service %}
          {%- unless product.type == 'Khác' -%}
            <div class="dentalhub-proloop--type">{{ product.type }}</div>
          {%- endunless -%}
          {%endif%}
        {%- if settings.productreviews_hrvapp_use and settings.productreviews_hrvapp_proloop -%}
          <div class="dentalhub-proloop--review">
            <!-- check review -->
            {%- assign rate_review = product.metafields.src.product_loop | append: "" - %}
              				{% assign rate_number = '' %}
              				{%-if rate_review ! = '' - %}
              				{%-assign rate_number = rate_review | remove: ' đánh giá' - %}
              				{%-endif -%}
            <div class="haravan-product-reviews-badge" data-id="{{ product.id }}">
              {{ product.metafields.src.product_loop }}
            </div>
          </div>
        {%- endif -%}
        {%unless template_service %}
        <div class="dentalhub-wrapper-action-loop">
          {%- unless price_zero -%}
            <p class="dentalhub-proloop--price {% if on_sale %}on-sale{% endif %}">
              <span class="dentalhub-price">{{ product.variants.first.price | money }}</span>
              {%- if on_sale -%}
                <span class="dentalhub-price-del">{{ product.variants.first.compare_at_price | money }}</span>
              {%- endif -%}
              {%- if sold_out -%}
                <span class="dentalhub-prohzt-soldout">Hết hàng</span>
              {%- endif -%}
            </p>
          {%- endunless -%}
          
          {%- if price_zero or check_gift -%}
            <div class="dentalhub-proloop-actions">
              <div class="dentalhub-proloop-actions__inner">
                {%- if check_gift -%}
                  <a href="{{product.url}}" class="dentalhub-btn-proloop dentalhub-btn-proloop-gift" title="{{product.title}}">
                    <span>Hàng tặng không bán</span>
                  </a>
                {%- else -%}
                  <a href="{{settings.prod_pricezero_link}}" class="dentalhub-btn-proloop dentalhub-btn-proloop-contact">{{ settings.prod_pricezero_title }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
        {%endunless%}
      </div>
    </div>
  </div>