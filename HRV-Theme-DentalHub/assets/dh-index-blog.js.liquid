DentalHub.IndexBlogSlider = {
		init: function() {
			var that = this;
      that.DentalHub_IndexBlogSlider();
		},
  DentalHub_IndexBlogSlider: function(){
    const dentalhubSlider = new Swiper ('.dentalhub-index-blog .swiper', {
      slidesPerView: 2,  
			loop: $('.dentalhub-index-blog .article-loop').length > 2 ? true:false,
      preloadImages: false,
      lazy: true,
      speed: 1000,
      autoplay: false,
      /*autoplay: {
        delay: 6000,
        disableOnInteraction: false,
      },*/
			navigation: {
				nextEl: ".dentalhub-index-blog .swiper-next",
				prevEl: ".dentalhub-index-blog .swiper-prev",
			},
      /*pagination: {
				el: ".swiper-pagination",
				clickable: true,
			},*/
      breakpoints: {
      0: {
        slidesPerView: 1.2,
        spaceBetween: 10
      },
      768: {
        slidesPerView: 1.5,
        spaceBetween: 10
      },
      1366: {
        slidesPerView: 2,
        spaceBetween: 40
      },
      1600: {
        slidesPerView: 2.5,
        spaceBetween: 60
      }
    }
			
    });
    const totalSlides = dentalhubSlider.slides.length;
    if (totalSlides <= dentalhubSlider.params.slidesPerView) {
      $('.dentalhub-index-blog .swiper-next, .dentalhub-index-blog .swiper-prev').hide();
    }
  }
};
(function() {
  DentalHub.IndexBlogSlider.init();
})();




