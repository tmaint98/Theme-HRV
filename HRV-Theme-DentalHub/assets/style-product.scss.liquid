$bgMain: {{settings.shop_color_bg}};
$bgBtn: {{settings.shop_main_button}};
$colorBtn: {{settings.shop_main_button_text}};
.hidden{display: none !important;}

.layout-pageProduct .button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-block;
    padding: 18px 45px;
    line-height: normal;
    color: #fff;
    background-color: #202223;
    border: 0;
    border-radius: 0;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 1px;
    outline: none !important;
    -webkit-transition: all 0.45s;
    transition: all 0.45s;
    @media(min-width: 992px) {
       &:hover,
      &.has-hover,
       &:focus {
        border-color: transparent;
      }
       &:hover:before,
       &.has-hover:before,
       &:focus:before {
        opacity: 1;
      }
    }
    @media(max-width: 767px) {
      font-size: 12px;
      padding: 8px 15px;
      min-height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

#btn-scroll{
	scroll-margin-block-start: 150px;
	@media(max-width: 767px){
		scroll-margin-block-start: 70px;
	}
