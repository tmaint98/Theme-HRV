$colorText: {{ settings.shop_text_color }};
.dentalhub-index-counter-2 {
  padding: 80px 0;
  .counter-item {
    .counter-group {
      font-size: 72px;
      font-weight: 600;
      padding-bottom: 15px;
      margin-bottom: 20px;
      border-bottom: 1px solid rgba($colorText, 0.2);
    }
    .desc {
      font-size: 18px;
      opacity: 0.8;
    }
  }
  @media(max-width: 991px) {
    .list-counter {
      gap: 30px 0;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .list-counter {
      gap: 20px 0;
    }
    .counter-item {
      .counter-group {
        font-size: 50px;
        padding-bottom: 5px;
        margin-bottom: 15px;
      }
      .desc {
        font-size: 14px;
      }
    }
  }
}
