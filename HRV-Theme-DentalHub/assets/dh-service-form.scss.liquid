$colorText: {{settings.shop_text_color}};	
.dentalhub-service-form{
  padding: 80px 0;
  .form-box{
    .contact-form .input-group {
      input,select,textarea{
        color: $colorText;
        height: 45px;
        width: 100%;
        font-weight: 400; 
        padding: 8px 0;
        background: transparent;
        border: none;
        border-bottom: 1px solid rgba($colorText, 0.2);
        border-radius: 0;
        box-shadow: none;
        -moz-appearance: none;
        -webkit-appearance: none;
        appearance: none;
        &::-webkit-input-placeholder { color: $colorText !important; }
&::-moz-placeholder { color: $colorText !important; }
&:-moz-placeholder { color: $colorText !important; }
      }
      select{
        background-image: url("data:image/svg+xml,%3Csvg fill='%23333333' width='15px' height='15px' viewBox='0 -6 524 524' xmlns='http://www.w3.org/2000/svg' %3E%3Ctitle%3Edown%3C/title%3E%3Cpath d='M64 191L98 157 262 320 426 157 460 191 262 387 64 191Z' /%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 0px center;
      }
    }
    .button{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 30px;
    border: 1px solid;
    color: currentcolor;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
      outline: none;
    .link-title{
      padding-right: 10px;
      border-right: 1px solid rgba($colorText,0.2);
    }
    .icon{
      svg{
        fill: currentcolor;
        transition: all 0.3s;
      }
    }
    &:hover{
      .icon svg{
        transform: rotate(90deg);
      }
    }
      &.btn-disabled{
        opacity: 0.6;
      }
    }
  }

  @media(max-width: 991px){
    .service-form{
      margin-top: 40px;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
    .service-form{
      margin-top: 25px;
    }
    .heading-title{
      margin-bottom: 15px;
      text-align: center;
    }
    .addcart-area{
      text-align: center;
    }
    .form-box{
      .button{
        padding: 12px 20px;
      }
    }
  }
}

.modalForm-success{
	svg{fill: #009900;width: 80px; height: 80px; margin-bottom: 15px;}
	p{font-size: 18px;}
}