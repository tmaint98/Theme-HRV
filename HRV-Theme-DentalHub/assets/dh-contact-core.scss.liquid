
.dentalhub-contact-core{
  padding: 80px 0;
  .core-item{
    .icon{
      img{
        max-height: 40px;
      }
    }
    .title{
      font-size: 25px;
      margin: 30px 0 0;
    }
    .desc{
      font-size: 18px;
      margin-top: 20px;
    }
  }
  @media(max-width: 991px){
    .list-core{
      gap: 30px;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
    .core-item {
      display: flex;
      align-items: center;
      gap: 15px;
      .icon {
        flex: 0 0 auto;
        width: 30px;
        img {
          max-height: 30px;
        }
      }
      .title {
        font-size: 18px;
        margin: 0;
      }
      .desc {
        font-size: 14px;
        margin-top: 5px;
      }
    }
  }
}

