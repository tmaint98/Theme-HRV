      .dentalhub-header-action-item.dentalhub-js-action-show .dentalhub-header-action_text .dentalhub-box-triangle {
        visibility: visible;
        opacity: 1;
      }
      .dentalhub-header-action-item.dentalhub-js-action-show .dentalhub-header-action_dropdown {
        visibility: visible;
        opacity: 1;
        -webkit-transform: scale(1);
        transform: scale(1);
        transition: opacity 0.4s cubic-bezier(0, 1, 0.4, 1)
        , visibility 0.4s linear
        , -webkit-transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1);
        transition: opacity 0.4s cubic-bezier(0, 1, 0.4, 1)
        , transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1)
        , visibility 0.4s linear;
        transition: opacity 0.4s cubic-bezier(0, 1, 0.4, 1)
        , transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1)
        , visibility 0.4s linear
        , -webkit-transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1);
      }
      .dentalhub-header-action-item.dentalhub-header-action_account.dentalhub-js-action-show .dentalhub-header-action_dropdown .site_account_panel.is-selected {
        visibility: visible;
      }
      .dentalhub-header-action-item.dentalhub-header-action_locale.dentalhub-js-action-show .overlays:before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 100vh;
        width: 100%;
        background: #000;
        opacity: 0.7;
        z-index: 100;
        margin: auto;
      }
      .dentalhub-header-action-item.dentalhub-header-action_locale.dentalhub-js-action-show .overlays .dentalhub-header-action__link {
        z-index: 101;
      }
    }
    &.dentalhub-header-wrap-iconav {
      .dentalhub-header-action {
        .dentalhub-header-action-item.dentalhub-header-action_backlink {
          display: none;
        }
        .dentalhub-header-action-item.dentalhub-header-action_backlink a {
          margin-right: 0;
          width: 20px;
          line-height: 32px;
          color: $colorText;
          height: 35px;
          display: block;
          font-size: 28px;
        }
        .dentalhub-header-action-item.dentalhub-header-action_menu {
          .dentalhub-header-action_dropdown .dentalhub-box-triangle {
            right: initial;
            left: 16px;
          }
          .dentalhub-box-icon {
            width: 25px;
            .dentalhub-hamburger-menu {
              width: 25px;
              height: 35px;
              cursor: pointer;
              display: block;
              position: relative;
              .dentalhub-bar,
              .dentalhub-bar:after,
              .dentalhub-bar:before {
                height: 1px;
                background: $colorHd;
              }
              .dentalhub-bar {
                position: relative;
                top: 22px;
                display: block;
                margin: auto;
                width: 25px;
                -ms-transition: all 0ms 100ms
                , width 150ms linear;
                -webkit-transition: all 0ms 100ms
                , width 150ms linear;
                transition: all 0ms 100ms
                , width 150ms linear;
                -ms-transform: translateY(-2px);
                -webkit-transform: translateY(-2px);
                transform: translateY(-2px);
              }
              .dentalhub-bar:before {
                content: "";
                position: absolute;
                left: 0;
                bottom: 7px;
                width: 25px;
                -ms-transition: bottom 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1)
                , transform 300ms cubic-bezier(0.23, 1, 0.32, 1)
                , width 150ms linear
                , background 150ms linear;
                -webkit-transition: bottom 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1)
                , transform 300ms cubic-bezier(0.23, 1, 0.32, 1)
                , width 150ms linear
                , background 150ms linear;
                transition: bottom 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1)
                , transform 300ms cubic-bezier(0.23, 1, 0.32, 1)
                , width 150ms linear
                , background 150ms linear;
              }
              .dentalhub-bar:after {
                content: "";
                position: absolute;
                left: 0;
                top: 7px;
                width: 25px;
                -ms-transition: top 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1)
                , transform 300ms cubic-bezier(0.23, 1, 0.32, 1)
                , width 150ms linear
                , background 150ms linear;
                -webkit-transition: top 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1)
                , transform 300ms cubic-bezier(0.23, 1, 0.32, 1)
                , width 150ms linear
                , background 150ms linear;
                transition: top 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1)
                , transform 300ms cubic-bezier(0.23, 1, 0.32, 1)
                , width 150ms linear
                , background 150ms linear;
              }

            }
            .dentalhub-box-icon--close svg {
              height: 35px;
            }
          }
          &.dentalhub-js-action-show {
            .dentalhub-hamburger-menu {
              opacity: 0;
              visibility: visible;
              -webkit-transform: scale(1);
              transform: scale(1);
            }
          }
        }
      }
    }
  }

  .dentalhub-header-navbar-menu .dentalhub-header-wrap-menu {
    -ms-flex: 1 1 auto;
    flex: 1 1 auto;
  }
  .dentalhub-header-wrap-menu-desktop {
    display: flex;
    align-items: center;
    gap: 30px;
    .dentalhub-header-hotline {
      a {
        color: $colorHd;
        font-size: 16px;
        font-weight: 600;
      }
    }
  }

  @media(min-width: 1200px) {
    position: relative;
  }
  @media(min-width: 1200px) and (max-width: 1620px) {
    .dentalhub-header-left {
      gap: 25px;
    }
    .dentalhub-header-wrap-menu .dentalhub-menuList-main > li {
      margin: 0 6px;
      a {
        font-size: 15px;
      }
    }
  }

