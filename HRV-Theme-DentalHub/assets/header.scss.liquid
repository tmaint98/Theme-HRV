  padding: 12px 0;
  font-weight: 500;
  font-size: 15px;
}
.dentalhub-menuList-links > li.dentalhub-has-submenu > a {
  padding-right: 30px
}
.dentalhub-menuList-links > li.dentalhub-has-submenu span.dentalhub-icon-plus-submenu {
  width: 25px;
  height: 25px;
  cursor: pointer;
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  border: none;
}
.dentalhub-icon-plus-submenu:after,
.dentalhub-icon-plus-submenu:before {
  background: rgba($colorText, 0.6);
  content: '';
  display: block;
  position: absolute;
  margin-right: 7px;
  top: 50%;
  right: 0;
  -moz-transition: all 0.25s linear;
  -o-transition: all 0.25s linear;
  -webkit-transition: all 0.25s linear;
  transition: all 0.25s linear;
}
.dentalhub-icon-plus-submenu:before {
  width: 9px;
  height: 1px;
  -moz-transform: translateY(-50%);
  -ms-transform: translateY(-50%);
  -webkit-transform: translateY(-50%);
  transform: translateY(-50%);
}
.dentalhub-icon-plus-submenu:after {
  width: 1px;
  height: 9px;
  right: 4px;
  transform-origin: center;
  -moz-transform: translateY(-50%) scale(1, 1);
  -ms-transform: translateY(-50%) scale(1, 1);
  -webkit-transform: translateY(-50%) scale(1, 1);
  transform: translateY(-50%) scale(1, 1);
}
li.dentalhub-has-submenu.opened > a .dentalhub-icon-plus-submenu:after {
  -moz-transform: translateY(-50%) scale(1, 0);
  -ms-transform: translateY(-50%) scale(1, 0);
  -webkit-transform: translateY(-50%) scale(1, 0);
  transform: translateY(-50%) scale(1, 0);
}
ul.dentalhub-menuList-links li ul.dentalhub-submenu-links {
  display: none;
}
ul.dentalhub-submenu-links li a {
  padding: 8px 0;
}
li.dentalhub-has-submenu.dentalhub-level0 > ul.dentalhub-submenu-links {
  border-top: 1px dashed $colorBoder;
}
li.dentalhub-has-submenu.dentalhub-level0 > ul.dentalhub-submenu-links li a {
  padding-left: 12px;
}
li.dentalhub-has-submenu.dentalhub-level1 > ul.dentalhub-submenu-links li a {
  padding-left: 25px;
}
li.dentalhub-has-submenu.dentalhub-level2 > ul.dentalhub-submenu-links li a {
  padding-left: 35px;
}

/*----- LIVE STREAM ------*/
.dentalhub-modal-live {
  position: fixed;
  max-width: 45%;
  max-height: 75%;
  bottom: 5px;
  left: 5px;
  z-index: 999;
  transform: translateY(calc(100% + 5px));
  -webkit-transition: all 500ms ease-in-out;
  -moz-transition: all 500ms ease-in-out;
  -ms-transition: all 500ms ease-in-out;
  -o-transition: all 500ms ease-in-out;
  transition: all 500ms ease-in-out;
  .dentalhub-modal-live--inner {
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
  }
  &.opened {
    transform: translateY(0);
  }
  .dentalhub-btn-close--live {
    position: absolute;
    right: -40px;
    top: 0;
    cursor: pointer;
    opacity: 0;
    padding: 0 10px;
  }
  iframe {
    border-radius: 10px;
    display: block;
    width: 100%;
    height: 100%;
  }
   &:hover .dentalhub-btn-close--live {
    opacity: 1;
  }
  @media(max-width: 992px) {
    max-width: 100%;
    max-height: 100%;
    .dentalhub-btn-close--live {
      right: -5px;
      top: 5px;
      opacity: 1;
    }
  }
}

.box-item.box-live {
  position: relative;
  margin-top: 15px;
  .svgico {
    position: relative;
    z-index: 4;
    display: block;
    height: 48px;
    width: 48px;
    text-align: center;
    border-radius: 50%;
    border: 1px solid #ffffff;
    cursor: pointer;
    background: $colorLive;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    box-sizing: border-box;
    -moz-box-sizing: border-box;
    -webkit-box-sizing: border-box;
    animation: pulse 2s infinite;
    animation: pulse 2s infinite;
    svg {
      fill: #ffffff;
      width: 28px;
      height: 100%;
      transition: opacity 0.35s ease-in-out
      , -webkit-transform 0.35s ease-in-out;
      transition: opacity 0.35s ease-in-out
      , transform 0.35s ease-in-out;
      transition: opacity 0.35s ease-in-out
      , transform 0.35s ease-in-out
      , -webkit-transform 0.35s ease-in-out;
    }
  }
   &:before,
   &:after {
    position: absolute;
    content: '';
    height: 48px;
    width: 48px;
    left: 0;
    top: 0;
    background: $colorLive;
    border-radius: 50%;
  }
   &:before {
    animation: euiBeaconPulseSmall_live 2s infinite ease-out;
  }
   &:after {
    animation: euiBeaconPulseSmall_live 2s infinite ease-out 0.4s;
  }
}
@keyframes euiBeaconPulseSmall_live {
  0% {
    -webkit-transform: scale(0);
    transform: scale(0);
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
  100% {
    -webkit-transform: scale(1.6);
    transform: scale(1.4);
    opacity: 0;
  }
}
/*----- END LIVE STREAM ------*/
