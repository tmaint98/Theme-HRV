  top: 0 !important;
}
.skiptranslate {
  display: none;


  /*
   width: 0;
   height: 0;
   opacity: 0;
*/
}
.dentalhub-header-action_translate{
  flex: 0 0 auto;
}
.dentalhub-translate-wrapper {
  position: relative;
  cursor: pointer;
  padding: 0 10px 0 0;
  .svg-flag svg {
    width: 25px;
    height: 25px;
  }
  .language-text {
    font-size: 14px;
  }
  .dentalhub-translate-dropdown-wrapper {
    position: absolute;
    right: 0;
    z-index: 9;
    padding-top: 12px;
    margin-top: -12px;
    width: 100%;
    min-width: 105px;
    transition: 0.3s all;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    .dentalhub-translate-dropdown {
      overflow-y: auto;
      font-size: 12px;
      scroll-padding: 0.5rem 0;
      width: 100%;
      background-color: white;
      text-align: left;
      box-shadow: 0 7px 18px rgba(0, 0, 0, 0.2);
      .js-language-select {
        .flag {
          svg {
            width: 14px;
            height: 14px;
          }
        }
      }
      a {
        display: block;
        padding: 5px 8px;
        transition: 0.3s all;
        color: $colorHd;
        background-color: transparent;
         &:hover {
          background-color: rgba($colorHd, 0.1);
          color: $colorHd;
        }
      }

    }
  }
  .icon-svg {
    --icon-height: 12px;
    --icon-width: 12px;
  }
   &:hover,
  &.active {
    .dentalhub-translate-dropdown-wrapper {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    .icon-svg {
      transform: rotate(-180deg);
    }
  }
}
@media(min-width: 992px) {
  .language-text {
    display: none;
  }
}
@media(max-width: 991px) {
  .dentalhub-header-action_translate {
    display: none;
  }
  .dentalhub-translate-wrapper .dentalhub-translate-dropdown-wrapper {
    right: auto;
    left: 0;
  }
}
