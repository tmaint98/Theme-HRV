.dentalhub-sidebar-main {
  .dentalhub-sitenav-wrapper {
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: 6;
    background: transparent;
    &.dentalhub-sitenav-right {
      right: 0;
      .dentalhub-sitenav-inner {
        right: 0;
        -webkit-transform: translateX(120%);
        transform: translateX(120%);
        -webkit-transition: transform 0.35s ease
        , right 0.25s ease
        , visibility 0s;
        transition: transform 0.35s ease
        , right 0.25s ease
        , visibility 0s;
      }
    }
    &.dentalhub-sitenav-left {
      left: 0;
      .dentalhub-sitenav-inner {
        left: 0;
        -webkit-transform: translateX(-100%);
        transform: translateX(-100%);
        -webkit-transition: transform 0.35s ease
        , left 0.25s ease
        , visibility 0s;
        transition: transform 0.35s ease
        , left 0.25s ease
        , visibility 0s;
      }
    }
    .dentalhub-sitenav-inner {
      margin: 0 auto;
      max-width: 480px;
      position: absolute;
      top: 0;
      bottom: 0;
      background: $bg;
      background-clip: padding-box;
      display: flex;
      flex-direction: column;
       &:after {
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        background: #fff;
        z-index: 1;
        opacity: 1;
        visibility: visible;
      }
    }
  }
  &.dentalhub-is-show-right {
    .dentalhub-sitenav-wrapper.dentalhub-show {
      left: 0 !important;
      -webkit-transition-delay: 0s;
      transition-delay: 0s;
    }
    .dentalhub-sitenav-wrapper.dentalhub-show .dentalhub-sitenav-inner {
      right: 0;
      width: 85%;
      -webkit-transform: translateX(0);
      transform: translateX(0);
      -webkit-transition-delay: 0.1s;
      transition-delay: 0.1s;
      -webkit-transition-duration: 0.3s;
      transition-duration: 0.3s;
       &:after {
        visibility: hidden;
        opacity: 0;
      }
    }
    .dentalhub-sitenav-wrapper.dentalhub-show .dentalhub-sidebar-overlay {
      opacity: 1;
      visibility: visible;
    }
  }
  &.dentalhub-is-show-left {
    .dentalhub-sitenav-wrapper.dentalhub-show {
      right: 0 !important;
      -webkit-transition-delay: 0s;
      transition-delay: 0s;
    }
    .dentalhub-sitenav-wrapper.dentalhub-show .dentalhub-sitenav-inner {
      left: 0;
      width: 85%;
      -webkit-transform: translateX(0);
      transform: translateX(0);
      -webkit-transition-delay: 0.1s;
      transition-delay: 0.1s;
      -webkit-transition-duration: 0.3s;
      transition-duration: 0.3s;
       &:after {
        visibility: hidden;
        opacity: 1;
      }
    }
    .dentalhub-sitenav-wrapper.dentalhub-show .dentalhub-sidebar-overlay {
      opacity: 1;
      visibility: visible;
    }
  }
  .dentalhub-sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
    z-index: -1;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
  }
  .dentalhub-sitenav-info {
    .dentalhub-sitenav-inner {
      max-width: 380px;
      padding: 30px;
    }
    .dentalhub-sitenav-header {
      border-bottom: none;
      .logo {
        a {
          font-size: 28px;
          font-weight: 600;
          color: $colorText;
        }
      }
      .dentalhub-btn-sitenav-close {
        display: block;
        height: 48px;
        width: 48px;
        display: flex;
        align-items: center;
        border-radius: 50%;
        opacity: 1;
        text-align: center;
        outline: none;
        border: none;
        background: rgba($colorHd, 0.05);
        svg {
          width: 15px;
          height: 15px;
          -webkit-transition: all 0.3s ease;
          -ms-transition: all 0.3s ease;
          transition: all 0.3s ease;
          fill: $colorText;
        }
         &:hover {
          svg {
            -webkit-transform: rotate(180deg);
            -ms-transform: rotate(180deg);
            transform: rotate(180deg);
          }

        }
      }
    }
    .dentalhub-sitenav-content {
      display: flex;
      flex-flow: column;
      gap: 15px;
      color: $colorText;
    }
    .dentalhub-sitenav-social {
      display: flex;
      align-items: center;
