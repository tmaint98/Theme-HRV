      padding-left: 0;
      padding-right: 0;
      .dentalhub-navbar-mainmenu {
        height: 100%;
      }
      .dentalhub-menuList-main {
        height: 100%;
        display: -webkit-flex;
        display: flex;
      }
      .dentalhub-menuList-main > li {
        display: -webkit-flex;
        display: flex;
        -ms-align-items: center;
        align-items: center;
      }
    }
