$colorText: {{ settings.shop_text_color }};
$bgMain: {{ settings.shop_color_bg }};
$bgBtn: {{ settings.shop_main_button }};
$colorBtn: {{ settings.shop_main_button_text }};
$breadcrumbBg: {{ settings.dentalhub_service_detail_breadcrumb_bg }};
$breadcrumbColor: {{ settings.dentalhub_service_detail_breadcrumb_color }};
$timeBg: {{ settings.dentalhub_service_detail_time_bg }};
$timeColor: {{ settings.dentalhub_service_detail_time_color }};
$formBg: {{ settings.dentalhub_service_detail_form_bg }};
$formColor: {{ settings.dentalhub_service_detail_form_color }};             
.hidden {
  display: none !important;
}
.fluid-pd {
@media(min-width: 1366px) {
  padding: 0 50px;
}
@media (min-width: 576px) and (max-width: 767px) {
  max-width: 540px;
}

@media (min-width: 768px) and (max-width: 991px) {
  max-width: 720px;
}

}
.section-breadcrumb {
  background: $breadcrumbBg;
  color: $breadcrumbColor;
  a {
    color: $breadcrumbColor;
  }
  .breadcrumb-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 40px 0;
    .container {
      padding: 0;
    }
    h1 {
      margin: 0;
      font-size: 25px;
    }
  }
  .breadcrumb {
    background: none;
    padding: 0;
    margin: 0;
    li {
       &:not(:last-child) {
        position: relative;
        padding-right: 30px;
         &:after {
          content: '-';
          position: absolute;
          top: 0;
          right: 10px;
          font-size: 30px;
          line-height: 0.8;
        }
      }
       &:nth-last-child(2) {
        display: none;
      }
    }
  }
  @media(max-width: 767px) {
    .breadcrumb-title {
      padding: 20px 0;
      flex-flow: column;
      align-items: start;
      gap: 5px;
    }
  }
}
.productDetail-information {
  padding: 80px 0;
  @media(max-width: 767px) {
    padding: 40px 0;
  }
}
.product-description {
  .list-table {
    margin-bottom: 60px;
    p {
      margin: 0;
    }
  }
  .table-group {
    h2 {
      font-size: 42px;
      margin-bottom: 20px;
    }
    table {
      border: none;
      width: 100% !important;
      height: auto !important;
      tr {
        border-top: 1px solid rgba($colorText, 0.2);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        th,
        td {
          border: none;
          padding: 20px 0;
          flex: 0 0 auto;
          width: calc(60% - 15px) !important;
          height: auto !important;
          background-color: transparent !important;
           &:first-child {
            font-weight: 600;
            text-align: left !important;
          }
           &:last-child {
            width: 40% !important;
            text-align: right !important;
          }
        }
      }
      tbody {
        tr:last-child {
          border-bottom: 1px solid rgba($colorText, 0.2);
        }
      }
    }
  }
  @media(max-width: 991px) {
    .list-table {
      gap: 30px;
    }
  }
  @media(max-width: 767px) {
    .list-table {
      margin-bottom: 30px;
    }
    .table-group {
      h2 {
        font-size: 28px;
      }
      table tr {
        th,
        td {
          padding: 15px 0;
        }
      }
    }
  }
}
.product-time {
  padding: 60px 40px 40px;
  background: $timeBg;
  color: $timeColor;
  .time-heading {
    margin-bottom: 30px;
    .title {
      font-size: 28px;
      font-weight: 600;
    }
    .desc {
      margin-top: 15px;
    }
  }
  .time-content {
    ul {
      li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 0;
         &:not(:last-child) {
          border-bottom: 1px solid rgba($timeColor, 0.2);
        }
        .title {
          font-weight: 600;
        }
      }
    }
  }
  @media(max-width: 991px) {
    margin-top: 40px;
  }
  @media(max-width: 767px) {
    padding: 30px 15px 20px;
    .time-heading {
      margin-bottom: 20px;
      .title {
        font-size: 24px;
      }
    }
  }
}
.product-team {
  margin-top: 60px;
  .team-title {
    font-size: 52px;
    margin-bottom: 30px;
  }
  .list-team {
    gap: 30px 0;
  }
  .team-item {
    a {
      display: inline-block;
    }
    .img {
      position: relative;
      overflow: hidden;
      img {
        transition: all 0.5s;
      }
       &:hover {
        img {
          transform: scale(1.08);
        }
      }
    }
    .detail {
      margin-top: 30px;
    }
    .name {
      font-size: 25px;
      font-weight: 600;
      margin-bottom: 5px;
    }
    .position {
      font-size: 18px;
      opacity: 0.8;
    }
    .icon {
      width: 32px;
      height: 32px;
      background: $bgBtn;
      color: $colorBtn;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 15px;
      svg {
        fill: currentcolor;
        transition: all 0.3s;
      }
       &:hover {
        svg {
          transform: rotate(90deg);
        }
      }
    }
  }
  @media(max-width: 767px) {
    margin-top: 40px;
    .team-title {
      font-size: 28px;
      margin-bottom: 20px;
    }
    .team-item {
      .detail {
        margin-top: 15px;
        .name {
          font-size: 18px;
        }
        .position {
          font-size: 14px;
        }
      }
    }
  }
}
.dentalhub-product-form{
  padding: 40px;
  margin-bottom: 30px;
  background: $formBg;
  color: $formColor;
  .form-box{
    .contact-form .input-group {
      input,select,textarea{
        color: $formColor;
        height: 45px;
        width: 100%;
        font-weight: 400; 
        padding: 8px 0;
        background: transparent;
        border: none;
        border-bottom: 1px solid rgba($formColor, 0.2);
        border-radius: 0;
        box-shadow: none;
        -moz-appearance: none;
        -webkit-appearance: none;
        appearance: none;
        &::-webkit-input-placeholder { color: $formColor !important; }
&::-moz-placeholder { color: $formColor !important; }
&:-moz-placeholder { color: $formColor !important; }
      }
      select{
        background-image: url("data:image/svg+xml,%3Csvg fill='%23333333' width='15px' height='15px' viewBox='0 -6 524 524' xmlns='http://www.w3.org/2000/svg' %3E%3Ctitle%3Edown%3C/title%3E%3Cpath d='M64 191L98 157 262 320 426 157 460 191 262 387 64 191Z' /%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 0px center;
      }
    }
    .button{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 30px;
    border: 1px solid;
    color: currentcolor;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
      outline: none;
    .link-title{
      padding-right: 10px;
      border-right: 1px solid rgba($colorText,0.2);
    }
    .icon{
      svg{
        fill: currentcolor;
        transition: all 0.3s;
      }
    }
    &:hover{
      .icon svg{
        transform: rotate(90deg);
      }
    }
      &.btn-disabled{
        opacity: 0.6;
      }
    }
  }
  .heading-title {
      margin-bottom: 30px;
  }
  @media(min-width: 768px){
    .heading-title{
      .title{
        font-size: 30px;
      }
    }
  }
  @media(max-width: 991px){
    margin: 40px 0 30px;
  }
  @media(max-width: 767px){
    padding: 30px 15px;
    .heading-title{
      margin-bottom: 15px;
      text-align: center;
    }
    .addcart-area{
      text-align: center;
    }
    .form-box{
      .button{
        padding: 12px 20px;
      }
    }
  }
}

.modalForm-success{
	svg{fill: #009900;width: 80px; height: 80px; margin-bottom: 15px;}
	p{font-size: 18px;}
}
.tooltip-cs {
  position: relative;
  .tooltip-hover {
    position: absolute;
    top: -36px;
    left: 50%;
    transform: translateX(-50%);
    height: 24px;
    line-height: 24px;
    background: #17191a;
    color: #fff;
    font-size: 10px;
    text-decoration: none;
    white-space: nowrap;
    padding: 0 8px;
    border-radius: 3px;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 300ms ease;
     &:after {
      content: "";
      display: block;
      position: absolute;
      bottom: 1px;
      left: 50%;
      width: 0;
      height: 0;
      border: solid;
      border-width: 8px 8px 0 8px;
      border-color: transparent;
      border-top-color: #000;
      -webkit-transform: translate(-50%, 100%);
      transform: translate(-50%, 100%);
    }
  }
   &:hover .tooltip-hover {
    opacity: 1;
    visibility: visible;
  }
}
.product-toshare {
  display: flex;
  align-items: center;
  margin-top: 30px;
  .pro-title {
    padding-right: 15px;
    font-size: 14px;
    font-weight: 600;
  }
  a {
    position: relative;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 14px;
    text-align: center;
    line-height: 30px;
    margin-right: 10px;
    color: #fff;
    cursor: pointer;
     &:hover {
      color: #fff;
    }
    svg {
      width: 30px;
      height: 30px;
      vertical-align: initial;
    }
  }
  @media(max-width: 991px) {
    display: none;
  }
}

/*btn more desc*/
.description-content {
  .expandable-content_toggle {
    outline: none;
  }
   &:not(.opened) .expandable-content_toggle {
    margin-top: 30px;
    border: 0;
  }
  .description-btn {
    position: relative;
     &:before {
      content: "";
      position: absolute;
      top: -100%;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      background: linear-gradient(rgba($bgMain, 0), rgba($bgMain, 0.4) 15%, $bgMain);
    }
  }

}
.expandable-content_toggle {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  border: 1px solid $bgBtn;
  padding: 7px 15px;
  color: $bgBtn;
  position: relative;
  margin: 0 auto;
  border-radius: 4px;
  text-align: center;
  font-weight: 500;
  background: #fff;
  z-index: 1;
  outline: none;
  &-icon {
    position: relative;
    margin-right: 15px;
    width: 10px;
    height: 10px;
    -webkit-transition: transform 0.2s ease-in-out;
    transition: transform 0.2s ease-in-out;
     &:before,
     &:after {
      content: "";
      position: absolute;
      background: #6A6BBF;
      -webkit-transform: translate(-50%, -50%);
      transform: translate(-50%, -50%);
      transition: -webkit-transform 0.2s ease-in-out;
      transition: transform 0.2s ease-in-out;
      top: 50%;
      left: 50%;
    }
     &:before {
      width: 2px;
      height: 10px;
    }
     &:after {
      width: 10px;
      height: 2px;
    }
  }
  &.btn-closemore {
    .expandable-content_toggle-icon {
       &:before {
        content: none;
      }
    }
  }
}

.description-content.expandable-toggle.opened .description-productdetail {
  max-height: 230px;
  overflow: hidden;
}
/*END btn more desc*/