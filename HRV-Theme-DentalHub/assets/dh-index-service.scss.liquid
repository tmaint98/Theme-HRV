$colorText: {{settings.shop_text_color}};
.dentalhub-index-service{
  padding: 50px 0;
  .service-item{
    display: flex;
    align-items: center;
    gap: 12px;
    padding-right: 20px;
    &:not(:first-child){
      padding-left: 20px;
      border-left: 1px solid rgba($colorText,0.2);
    }
    .icon{
      flex: 0 0 auto;
      img{
        max-width: 74px;
      }
    }
    .title{
      font-weight: 600;
      margin-bottom: 8px;
    }
    .desc{
      opacity: 0.8;
    }
  }
  @media(max-width: 991px){
    .list-service{
      gap: 15px;
    }
    .service-item{
      &:not(:first-child){
      padding-left: 15px;
      border-left: none;
    }
    }
  }
  @media(max-width: 767px){
    padding: 25px 0;
    .service-item .icon img{
      max-width: 55px;
    }
  }
}
