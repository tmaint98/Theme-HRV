$bgFt: {{ settings.dentalhub_footer_bg }};
$colorFt: {{ settings.dentalhub_footer_color }};
$bgFtBtn: {{ settings.dentalhub_footer_bg_btn }};
$colorFtBtn: {{ settings.dentalhub_footer_color_btn }};

.dentalhub-mainFooter {
  background-color: $bgFt;
  color: rgba($colorFt, 0.8);
  padding-top: 80px;
  a {
    color: $colorFt;
  }
  h2 a {
    color: $colorFt;
  }
  .dentalhub-ft-logo {
    img {
      max-height: 60px;
      margin-bottom: 20px;
    }
  }
  .dentalhub-widget-footer {
    .dentalhub-title-footer,
    .dentalhub-fter-title {
      position: relative;
      margin-bottom: 28px;
      font-weight: 600;
      color: $colorFt;
      font-size: 20px;
      letter-spacing: 1px;
      @media(max-width: 991px) {
        border-bottom: 1px dashed rgba($colorFt, 0.3);
        margin: 0;
        padding: 15px 0;
         &:not(.dentalhub-fter-title):before {
          content: "\f107";
          font-family: "FontAwesome";
          position: absolute;
          top: 12px;
          right: 10px;
          text-align: center;
          font-size: 22px;
          transition: all 0.4s ease-in-out 0s;
          -moz-transition: all 0.4s ease-in-out 0s;
          -o-transition: all 0.4s ease-in-out 0s;
          -webkit-transition: all 0.4s ease-in-out 0s;
          -ms-transition: all 0.4s ease-in-out 0s;
        }
        &.opened {
          font-weight: 700;
        }
         &.opened:before {
          -moz-transform: rotate(-180deg);
          -webkit-transform: rotate(-180deg);
          -o-transform: rotate(-180deg);
          -ms-transform: rotate(-180deg);
          transform: rotate(-180deg);
        }
      }
      @media(max-width: 767px) {
        font-size: 15px;
      }
    }
    .desc {
      margin: 0;
    }
    .desc-newsletter {
      margin-bottom: 20px;
    }
  }
  
  .dentalhub-newsletter {
      margin-top: 40px;
    }
  

  .dentalhub-footer-newsletter {
    .dentalhub-newsletter-form {
      .dentalhub-newsletter-input {
        background: rgba($colorFt, 0.1);
        border: none;
        outline: none;
        border-radius: 0;
        color: $colorFt;
        &::-webkit-input-placeholder {
          color: $colorFt !important;
        }
        &::-moz-placeholder {
          color: $colorFt !important;
        }
         &:-moz-placeholder {
          color: $colorFt !important;
        }
      }
      .contact-form .input-group {
        flex-flow: nowrap;
        gap: 5px;
        input {
          font-size: 14px;
        }
      }
      .btn-more .btn-icon {
        border: none;
        outline: none;
        padding: 0 20px;
        height: 100%;
        display: flex;
        align-items: center;
        background: $bgFtBtn;
        color: $colorFtBtn;
        svg {
          fill: currentcolor;
        }
         &:hover {
          opacity: 0.8;
        }
      }
    }
  }
  .dentalhub-logo-footer {
    margin-top: 20px;
  }
  .dentalhub-footerNav-social {
    display: flex;
    flex-flow: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    i,
    svg {
      width: 36px;
      height: 36px;
      line-height: 34px;
      font-size: 19px;
      text-align: center;
      border: 1px solid;
      border-radius: 50%;
      -webkit-transition: all 0.2s ease;
      -moz-transition: all 0.2s ease;
      transition: all 0.2s ease;
    }
    .social-svg {
      svg {
        padding: 6px;
        fill: currentColor;
      }
      &.svg-lazada {
        svg path {
          stroke: currentColor;
        }
      }
    }
  }
  .dentalhub-address-footer {
    margin-bottom: 20px;
    li {
      margin-bottom: 10px;
      i {
        width: 20px;
      }
      &.address-phone {
        font-size: 22px;
        font-weight: 600;
      }
    }
  }
  .dentalhub-footer-link {
    li ~ li {
      margin-top: 10px;
    }
    a {
      font-weight: 600;
    }
  }
  .dentalhub-footer-blog {
    .item {
       &:not(:last-child) {
        margin-bottom: 20px;
      }
    }
    .article-footer {
      display: flex;
      gap: 15px;
      .article-image {
        flex: 0 0 auto;
        width: 80px;
      }
      .post-title {
        font-size: 16px;
        margin-bottom: 5px;
      }
      .date {
        font-size: 14px;
        opacity: 0.8;
      }
    }
  }
  .dentalhub-footer-copyright {
    margin-top: 40px;
    padding: 35px 0;
    border-top: 1px solid rgba($colorFt, 0.1);
    p {
      margin: 0;
    }
  }
  @media(min-width: 992px) {
    .dentalhub-footer-newsletter {
      .dentalhub-newsletter-title h3 {
        margin: 0;
      }
      .dentalhub-newsletter-form {
        .contact-form .input-group {
          margin: 0;
        }
      }
    }
  }
  @media(max-width: 991px) {
    &.has-toolbar {
      padding-bottom: 45px;
    }
    .dentalhub-widget-footer {
       &:last-child {
        .dentalhub-title-footer {
          border: none;
        }
        .dentalhub-content-footer {
          border-top: 1px dashed rgba($colorFt, 0.3);
        }
      }
      .dentalhub-block-collapse {
        display: none;
        padding: 15px 0;
      }
      .dentalhub-newsletter {
        margin-top: 0;
        .dentalhub-title-footer {
          border-top: 1px dashed rgba($colorFt, 0.3);
        }
      }
    }
    
    .dentalhub-footer-newsletter {
      .dentalhub-newsletter-title h3 {
        font-size: 30px;
        margin-bottom: 20px;
      }
    }
    .dentalhub-footer-copyright {
      margin-top: 25px;
      padding: 25px 0;
      text-align: center;
      > .row {
        gap: 15px;
      }
      .dentalhub-footer-link {
        justify-content: center;
      }
    }
  }
  @media(max-width: 767px) {
    padding-top: 50px;
    .dentalhub-footer-about .title {
      font-size: 26px;
      br {
        content: '';
         &:after {
          content: ' ';
        }
      }
    }
    .dentalhub-footer-newsletter {
      .dentalhub-newsletter-title h3 {
        font-size: 22px;
      }
    }
  }
}