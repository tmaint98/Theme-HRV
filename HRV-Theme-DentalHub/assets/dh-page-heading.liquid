.heading-title {
  margin-bottom: 50px;
  .title{
    font-size: 40px;
    line-height: 1.2;
    margin: 0;
  }
  .desc{
    font-size: 18px;
    opacity: 0.8;
    margin-top: 30px;
  }
  @media (max-width: 991px) {
    .title {
      font-size: 40px;
      br{
      content: '';
      &:after{
        content: ' ';
      }
      }
    }
  }
  @media (max-width: 767px) {
    margin-bottom: 25px;
    .title {
      font-size: 24px;
    }
    .desc{
      font-size: 14px;
      margin-top: 15px;
    }
  }
}
