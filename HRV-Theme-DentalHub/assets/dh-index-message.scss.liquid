$colorText: {{ settings.shop_text_color }};
.dentalhub-index-message {
  padding: 80px 0;
  .message-signature {
    margin-bottom: 20px;
    img {
      max-height: 56px;
    }
  }
  .message-info {
    padding-left: 20px;
    border-left: 1px solid rgba($colorText, 0.2);
    .name {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 5px;
    }
    .position {
      font-size: 18px;
      opacity: 0.8;
    }
  }
  @media(min-width: 1200px) {
    .message-content {
      padding-left: 50px;
    }
  }
  @media(max-width: 991px) {
    .row {
      gap: 30px;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .message-signature {
      img {
        max-height: 35px;
      }
    }
    .message-info {
      padding-left: 10px;
      .name {
        font-size: 16px;
      }
      .position {
        font-size: 14px;
      }
    }
  }
}
