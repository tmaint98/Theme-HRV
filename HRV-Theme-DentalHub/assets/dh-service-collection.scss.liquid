$colorMain: {{ settings.shop_main_color }};
.dentalhub-service-collection{
  padding: 80px 0;
  .listProduct-row{
    gap: 30px 0;
  }
  .btn-more {
    margin-top: 40px;
    .button {
      display: inline-block;
      padding: 15px 25px;
      background: $colorMain;
      color: #fff;
      border-radius: 50px;
      font-weight: 600;
    }
  }
  @media(min-width: 1200px){
    .heading-title{
      margin-bottom: 0;
      .title{
        font-size: 45px;
      }
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
  }
}
