.dentalhub-index-banner-list{
  padding: 80px 0;
  .list-banner {
    display: grid;
    gap: 30px;
    grid-template-areas:
        'img1 img2 img3 img4'
        'img5 img2 img6 img4';
    grid-template-columns: 1fr 1fr 1fr 1fr;
    .banner-item{
      position: relative;
      overflow: hidden;
      img{
        transition: all 0.5s;
      }
      &:nth-child(1){
        grid-area: img1;
      }
      &:nth-child(2){
        grid-area: img2;
      }
      &:nth-child(3){
        grid-area: img3;
      }
      &:nth-child(4){
        grid-area: img4;
      }
      &:nth-child(5){
        grid-area: img5;
      }
      &:nth-child(6){
        grid-area: img6;
      }
      &:hover{
        img{
          transform: scale(1.08);
        }
      }
    }
}
  @media(max-width: 991px){
    .list-banner {
      grid-template-areas:
        'img1 img2'
        'img3 img2'
        'img5 img4'
        'img6 img4';
      grid-template-columns: 1fr 1fr;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
    .list-banner {
      grid-template-areas: 'img1' 'img2' 'img3' 'img4' 'img5' 'img6';
      grid-template-columns: 1fr;
      gap: 15px;
    }
  }
}

