{%unless has_heading %} 
  <link rel="preload stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="stylesheet">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload stylesheet" href="{{ 'gw-index-about-3.scss.css' | asset_url }}" as="stylesheet">
<section class="greenweave-index-about-3">
    <div class="container">
      <div class="row">
        <div class="col-lg-6 col-12">
          <div class="banner">
            <div class="img img--1"><img src="{{'greenweave_index_about_3_banner_1.jpg' | asset_url}}" alt="{{ settings.greenweave_index_about_3_title_2 | strip_html | escape }}" loading="lazy" decoding="async" /></div>
          </div>
        </div>
        <div class="col-lg-6 col-12">
          <div class="heading-title">
            {% if settings.greenweave_index_about_3_title_1 != '' %}
              <div class="title1">{{ settings.greenweave_index_about_3_title_1 }}</div>
            {% endif %}
            {% if settings.greenweave_index_about_3_title_2 != '' %}
              <h2 class="title2 font-title">{{ settings.greenweave_index_about_3_title_2 | newline_to_br }}</h2>
            {% endif %}
            {% if settings.greenweave_index_about_3_desc != '' %}
              <div class="desc">{{ settings.greenweave_index_about_3_desc | newline_to_br }}</div>
            {% endif %}
          </div>
          <div class="banner">
            <div class="img img--2"><img src="{{'greenweave_index_about_3_banner_2.jpg' | asset_url}}" alt="{{ settings.greenweave_index_about_3_title_2 | strip_html | escape }}" loading="lazy" decoding="async" /></div>
          </div>
        </div>
      </div>
    </div>
  </section>