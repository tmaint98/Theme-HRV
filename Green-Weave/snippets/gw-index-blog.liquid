{%unless has_heading %} 
  <link rel="preload stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="stylesheet">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload stylesheet" href="{{ 'gw-index-blog.scss.css' | asset_url }}" as="stylesheet">

<section class="greenweave-index-blog">
	<div class="container">
    <div class="heading-title">
      {% if settings.greenweave_index_blog_title_1 != '' %}
        <div class="title1">{{ settings.greenweave_index_blog_title_1 }}</div>
      {% endif %}
      {% if settings.greenweave_index_blog_title_2 != '' %}
        <h2 class="title2 font-title">{{ settings.greenweave_index_blog_title_2 | newline_to_br }}</h2>
      {% endif %}
      {% if settings.greenweave_index_blog_desc != '' %}
        <div class="desc">{{ settings.greenweave_index_blog_desc | newline_to_br }}</div>
      {% endif %}
    </div>
    {%if blogs[settings.greenweave_index_blog_handle].articles.size == 0%}
    <p class="txt-noArticle">Chưa có bài viết nào trong mục này</p>
    {%else%}
    <div class="row list-blog">     
    {% for article in blogs[settings.greenweave_index_blog_handle].articles limit: 3 %}
      <div class="col-lg-4 col-12">
      {% include 'article-image' with article:article %}
        <div class="item-article">
        	<div class="media-article">
        		<a href="{{ article.url }}" title="{{ article.title }}" aria-label="{{ article.title }}" class="img-hover img-zoom">
        			<img src="{{ imageUrl | product_img_url : 'grande'}}" alt="{{ article.title }}"/>
        		</a>	
        	</div>
        	<div class="info-article">
            <div class="article-post-meta">   
              <span class="author">{{article.author}}</span>
              <span class="date">                
                <time pubdate datetime="{{ article.published_at | date: '%d Tháng %m, %Y' }}">{{ article.published_at | date: '%d Tháng %m, %Y' }}</time>
              </span>
            </div>
        		<div class="title-article">
        			<h4>
        				<a href="{{ article.url }}">{{ article.title }}</a>
        			</h4>
              <div class="short-article">
        			{{ article.excerpt_or_content | strip_html | truncatewords: 10 }}
        		</div>
        			<div class="btn-link">
        				<a href="{{ article.url }}" class="arrow-link"><span class="arrow"></span></a>
        			</div>
        		</div>
        		
        	</div>
        </div>
      </div>
    {%endfor%}
    </div>
      {%if blogs[settings.greenweave_index_blog_handle].articles.size > 3 and settings.greenweave_index_blog_btn != ''%}
      <div class="btn-more">
        <a href="{{blogs[settings.greenweave_index_blog_handle].url}}" class="button">
          {{settings.greenweave_index_blog_btn}}
        </a>
      </div>
      {%endif%}
    {%endif%}
  </div>
</section>
