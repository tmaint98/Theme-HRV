<link rel="preload stylesheet" href="{{ 'style-page.scss.css' | asset_url }}" as="stylesheet">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'page.js' | asset_url }}"></script>
<div class="layout-pageDetail">
	{%- include 'breadcrumb' -%}
	<div class="container pd-top">
		<div class="row">
			<div class="col-lg-9 col-md-8 col-12">
				<div class="wrapper-pageDetail">
					<div class="heading-pageDetail"><h1>{{ page.title }}</h1></div>
					<div class="content-pageDetail unreset">{{ page.content }}</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-4 col-12">
				{% include 'sidebar-page' %}
			</div>
		</div>
	</div>
</div>