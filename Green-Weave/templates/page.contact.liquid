										<div class="input-group group-text">
                      <span class="icon-form"><svg width="22px" height="22px" viewBox="0 0 48.011 48.011" xmlns="http://www.w3.org/2000/svg"> <path id="pen" d="M440.275,214.708a1,1,0,0,1-.243-1.027L445,200.78a1.022,1.022,0,0,1,.242-.392l31.948-31.923a5.036,5.036,0,0,1,7.1,0l2.231,2.252a5.027,5.027,0,0,1,0,7.1l-4.922,4.919c-.015.017-.03.034-.047.05s-.034.033-.051.048l-2.73,2.728q-.027.033-.058.063t-.064.058L454.577,209.74a1.016,1.016,0,0,1-.392.242L441.3,214.951a1.005,1.005,0,0,1-1.028-.243Zm2.3-2.3,4.27-1.691-2.588-2.562Zm5.295-2.1,5.46-2.162,23.258-23.241-6.494-6.51-23.257,23.24-2.175,5.5ZM478,183.491l1.42-1.419-6.493-6.511-1.42,1.419Zm2.841-2.838,4.26-4.256a3.018,3.018,0,0,0,0-4.262l-2.23-2.251a3.1,3.1,0,0,0-4.26,0l-4.262,4.259Zm-10.2,14.994,13-13,.707.706-13,13Z" transform="translate(-439.98 -167)" /> </svg></span>
