<link rel="preload stylesheet" href="{{ 'gw-page-contact.scss.css' | asset_url }}" as="stylesheet">
<div class="greenweave-layout-contact">
  <div class="hidden">{% include 'breadcrumb' %}</div>
  <section class="greenweave-contact-breadcrumb">
    <div class="container">
      <h1 class="text-center font-title">{{ page.title }}</h1>
      <div class="icon-down text-center">
        <a href="#btn-scroll">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="8" viewBox="0 0 14.626 8.639">
            <path id="Контур_6507" data-name="Контур 6507" d="M14.392,101.42l-.479-.482a.8.8,0,0,0-1.132,0L7.316,106.4l-5.472-5.472a.8.8,0,0,0-1.132,0l-.479.479a.8.8,0,0,0,0,1.131l6.515,6.538a.818.818,0,0,0,.567.257h0a.818.818,0,0,0,.566-.257l6.508-6.52a.808.808,0,0,0,.234-.571A.8.8,0,0,0,14.392,101.42Z" transform="translate(0 -100.698)"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
  <div id="btn-scroll">
    {% if settings.greenweave_google_maps_show %}
      <section class="contact-map">
        <div class="map">
          {{ settings.greenweave_google_maps_code }}
        </div>
      </section>
    {% endif %}

    {% if settings.show_greenweave_contact_info or settings.show_greenweave_contact_form %}
      <section class="contact-info">
        <div class="container">
          <div class="row align-items-center">
            {% if settings.show_greenweave_contact_info%}
            <div class="col-lg-4 col-12">
              <div class="heading-title">
                {% if settings.greenweave_contact_info_title != '' %}
                  <h2 class="title2">{{ settings.greenweave_contact_info_title | newline_to_br }}</h2>
                {% endif %}
              </div>
              <div class="list-info">
                <ul class="info">
                    {% for i in (1..3) %}
                      {% capture info %}greenweave_contact_address_{{i}}{%endcapture%}
                      {% if settings[info] != '' %}
                        <li>
                          <span>{{ settings[info] }}</span>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                <ul class="info info-email">
                    {% for i in (1..3) %}
                      {% capture info %}greenweave_contact_email_{{i}}{%endcapture%}
                      {% if settings[info] != '' %}
                        <li>
                          <a href="mailto:{{settings[info]}}">
                            <span>{{ settings[info] }}</span>
                          </a>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                <ul class="info info-phone">
                    {% for i in (1..3) %}
                      {% capture info %}greenweave_contact_phone_{{i}}{%endcapture%}
                      {% if settings[info] != '' %}
                        <li>
                          <a href="tel:{{settings[info] | remove: ' '}}">
                            <span>{{ settings[info] }}</span>
                          </a>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
              </div>
              {% if settings.show_greenweave_contact_social %}
								<ul class="contact-social">
								{%-if settings.greenweave_contact_social_link_facebook != blank -%}<li class="social-svg"><a href="{{settings.greenweave_contact_social_link_facebook}}" target="_blank" rel="noopener" title="Facebook" aria-label="Facebook"><svg width="30px" height="30px" viewBox="-7 -2 24 24" preserveAspectRatio="xMinYMin" class="jam jam-facebook"><path d='M2.046 3.865v2.748H.032v3.36h2.014v9.986H6.18V9.974h2.775s.26-1.611.386-3.373H6.197V4.303c0-.343.45-.805.896-.805h2.254V0H6.283c-4.34 0-4.237 3.363-4.237 3.865z' /></svg></a></li>	{%-endif-%}
