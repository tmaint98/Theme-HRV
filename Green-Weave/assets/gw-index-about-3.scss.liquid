$colorAbout2: {{ settings.greenweave_index_about_3_color }};
.greenweave-index-about-3{
  @media(min-width: 992px){
  	.container{	max-width: 100%;padding-left: 20px;	padding-right: 20px;}
  }
  @media(min-width: 1200px){
  	.container{max-width:1170px;}
  }
  @media(min-width: 1366px){
  	.container{max-width:1290px;}
  }
  @media(min-width: 1600px){
  	.container{max-width:1410px;}
  	.container-fluid{max-width:1800px;}
  }
}
.greenweave-index-about-3 .heading-title{
  color: $colorAbout2;
}               
.greenweave-index-about-3 {
  padding: 80px 0;
  background-image: url("{{ 'greenweave_index_about_3_bg.jpg' | asset_url}}");
  background-size: cover;
  background-position: center;
  .banner {
    img {
      border-radius: 14px;
    }
  }
  @media(min-width: 1200px) {
    .banner {
      .img--1 {
        padding-right: 100px;
      }
    }
  }
  @media(max-width: 991px){
    .heading-title{
      margin: 30px 0;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
  }
}
