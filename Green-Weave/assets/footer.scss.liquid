$bgFt: {{settings.greenweave_footer_bg}};
$colorFt: {{settings.greenweave_footer_color}};
.greenweave-mainFooter{
  @media(min-width: 992px){
  	.container{	max-width: 100%;padding-left: 20px;	padding-right: 20px;}
  }
  @media(min-width: 1200px){
  	.container{max-width:1170px;}
  }
  @media(min-width: 1366px){
  	.container{max-width:1290px;}
  }
  @media(min-width: 1600px){
  	.container{max-width:1410px;}
  	.container-fluid{max-width:1800px;}
  }
}
.greenweave-mainFooter{
  background-color: $bgFt;
		color: rgba($colorFt, 0.8);
  padding-top: 80px;
  a{
    color: $colorFt;
  }
	h2 a{color: $colorFt;}
	.ft-logo{
		img{max-height: 60px; margin-bottom: 20px;}
	}
  .greenweave-footer-about {
    .title{
      font-size: 46px;
      margin-bottom: 15px;
      color: $colorFt;
    }
    }
  .ft-phone{
  li{
    font-size: 20px;
    font-weight: 600;
  }
  }
  .ft-email{
        margin-bottom: 20px;
  a{
    color: rgba($colorFt, 0.8);
    position: relative;
    &:before{
    content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 100%;
      height: 1px;
      background: rgba($colorFt, 0.6);
      transition: all 0.3s;
    }
    &:hover{
      color: $colorFt;
      &:before{
        width: 0;
      }
    }
  }
  }
	.greenweave-widget-footer{
		.greenweave-title-footer,.greenweave-fter-title {
			position: relative;margin-bottom: 30px;
			font-weight: 600;
			color: $colorFt;
			font-size: 20px;
			letter-spacing: 1px;
			@media(max-width:991px){
				border-bottom: 1px dashed rgba($colorFt, 0.3);margin: 0px;padding: 15px 0;
				&:not(.greenweave-fter-title):before {
					content: "\f107";font-family: "FontAwesome";
					position: absolute;top: 12px;right: 10px;text-align: center;	font-size: 22px;
					transition: all 0.4s ease-in-out 0s;-moz-transition: all 0.4s ease-in-out 0s;
					-o-transition: all 0.4s ease-in-out 0s;	-webkit-transition: all 0.4s ease-in-out 0s;-ms-transition: all 0.4s ease-in-out 0s;
				}
				&.opened{font-weight: 700;}
				&.opened:before {
					-moz-transform: rotate(-180deg);	-webkit-transform: rotate(-180deg);
					-o-transform: rotate(-180deg);-ms-transform: rotate(-180deg);	transform: rotate(-180deg);
				}
			}
			@media(max-width:767px){font-size: 15px;}
		}
		.desc{margin: 0;}
	}
	.greenweave-logo-footer{margin-top: 20px;}
	.greenweave-footerNav-social{
		display: flex;
		flex-flow: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 20px;
		i,svg{
			width: 36px;
			height: 36px;
			line-height: 34px;
			font-size: 19px;
			text-align: center;
			border: 1px solid;
			border-radius: 50%;
			-webkit-transition: all 0.2s ease;
			-moz-transition: all 0.2s ease;
			transition: all 0.2s ease;
		}
		.social-svg{
			svg{padding: 6px;fill: currentColor;}
      &.svg-lazada{
				svg path{stroke: currentColor;}
			}
		}
	}
	.greenweave-footer-info{
		margin: 40px 0 0;
		padding-top: 40px;
		border-top: 1px solid rgba($colorFt, 0.1);
	}
	.greenweave-address-footer li {
		margin-bottom: 10px;
		i{
			width: 20px;
		}
	}
	.greenweave-footer-copyright {
		margin-top: 40px;
		padding: 25px 0;
		border-top: 1px solid rgba($colorFt, 0.1);
    text-align: right;
		p{margin: 0;}
  		.greenweave-footer-link {
			display: flex;
			flex-flow: wrap;
			gap: 10px 20px;
			/*.item{
				&:not(:first-child){
					position: relative;
					&:before{
						content: '/';
						margin-right: 10px;
					}
				}

			}*/
        a{
      color: rgba($colorFt, 0.8);
    }
		}
	}
	@media(min-width: 992px){
		.greenweave-footer-about{padding-right: 40px;}
		.greenweave-footer-info{
			>div{
				padding-left: 20px;
				&:first-child{
					padding-left: 0;
				}
				&:not(:last-child){
					border-right: 1px solid rgba($colorFt, 0.1);
				}
			}
		}
	}
	@media(max-width: 991px){
		&.has-toolbar{padding-bottom: 45px;}
		.greenweave-widget-footer{
			&:last-child{
				.greenweave-title-footer{
					border: none;
				}
				.greenweave-content-footer{
					border-top: 1px dashed rgba($colorFt, 0.3);
				}
			}
			.greenweave-block-collapse{display: none;padding: 15px 0;}
		}
		.greenweave-footer-about{margin-bottom: 20px;}
		.greenweave-footer-info {
			margin-top: 0;
			padding-top: 0;
			border-top: 1px dashed rgba($colorFt, 0.3);
			>div{padding: 0;}
		}
		.greenweave-footer-copyright{
			margin-top: 25px;
			padding: 25px 0;
			text-align: center;
			>.row{gap: 15px;}
			.greenweave-footer-link{justify-content: center;}
		}
	}
	@media(max-width: 767px){
    padding-top: 50px;
    .greenweave-footer-about .title{
      font-size: 26px;
      br{
      content: '';
      &:after{
        content: ' ';
      }
    }
    }
	}
}