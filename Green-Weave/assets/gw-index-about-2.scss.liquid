.greenweave-index-about-2{
  @media(min-width: 992px){
  	.container{	max-width: 100%;padding-left: 20px;	padding-right: 20px;}
  }
  @media(min-width: 1200px){
  	.container{max-width:1170px;}
  }
  @media(min-width: 1366px){
  	.container{max-width:1290px;}
  }
  @media(min-width: 1600px){
  	.container{max-width:1410px;}
  	.container-fluid{max-width:1800px;}
  }
}
.greenweave-index-about-2 .heading-title{
  color: #fff;
}
.greenweave-index-about-2 {
  padding: 80px 0;
  background-image: url("{{ 'greenweave_index_about_2_bg.jpg' | asset_url}}");
  background-size: cover;
  background-position: center;
  position: relative;
  color: #fff;
   &:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
  }
  .heading-title {
    .desc {
      color: #fff;
    }
  }
  .btn-more {
    text-align: right;
    .btn-icon {
      color: #fff;
      font-weight: 600px;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
      span {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 70px;
        height: 70px;
        border: 1px solid #fff;
        border-radius: 50%;
        svg {
          width: 20px;
          height: 20px;
          fill: #fff;
          polyline,
          line {
            stroke: #fff;
          }
        }
      }
    }
  }
  @media(min-width: 1200px) {
    min-height: 100vh;
    display: flex;
    .row {
      height: 100%;
    }
  }
  @media(max-width: 991px){
    .btn-more {
    text-align: left;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
    .btn-more {
    .btn-icon {
      span {
        width: 36px;
        height: 36px;
        svg {
          width: 15px;
          height: 15px;
        }
      }
    }
  }
  }
}
