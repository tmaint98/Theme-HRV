 {%if settings.show_greenweave_process_services%}
   {%unless has_heading %} 
  <link rel="preload" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
  <link rel="preload" href="{{ 'gw-process-services.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-process-services.scss.css' | asset_url }}">
	<section class="greenweave-process-services">
		<div class="container">
			<div class="row">
				<div class="col-lg-6 col-12">
					<div class="service-content">
						<div class="heading-title">
							{%if settings.greenweave_process_services_title_1 != ''%}<div class="title1">{{settings.greenweave_process_services_title_1}}</div>{%endif%}
							{%if settings.greenweave_process_services_title_2 != ''%}<h2 class="title2 font-title">{{settings.greenweave_process_services_title_2 | newline_to_br}}</h2>{%endif%}
							{%if settings.greenweave_process_services_desc != ''%}<p class="desc">{{settings.greenweave_process_services_desc}}</p>{%endif%}
						</div>
          </div>
        </div>
        <div class="col-lg-6 col-12">
					<div class="service-list">
            {%for i in (1..3)%}
              {%capture show%}show_greenweave_process_services_{{i}}{%endcapture%}
              {%capture img%}greenweave_process_services_{{i}}_img.jpg{%endcapture%}
              {%capture title%}greenweave_process_services_{{i}}_title{%endcapture%}
              {%capture desc%}greenweave_process_services_{{i}}_desc{%endcapture%}
              {%if settings[show]%}
                <div class="item">
                  <div class="img"><img src="{{ img | asset_url}}" alt="{{settings[title]}}" /></div>
                  <div class="detail">
                    {%if settings[title] != ''%}<h3 class="title">{{settings[title]}}</h3>{%endif%}
                    {%if settings[desc] != ''%}<div class="desc">{{settings[desc]}}</div>{%endif%}
                  </div>
                </div>
                {%endif%}
              {%endfor%}
          </div>
				</div>
      </div>
    </div>
  </section>
    {%endif%}