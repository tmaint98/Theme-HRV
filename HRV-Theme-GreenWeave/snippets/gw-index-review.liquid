<link rel="preload stylesheet" href="{{ 'gw-index-review.scss.css' | asset_url }}" as="stylesheet">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'gw-index-review.js' | asset_url }}"></script>
<section class="greenweave-index-review">
  <div class="container">
    {% assign info = '' %}
    {% assign content = '' %}
    {% assign count = -1 %}
    {% for i in (1..3) %}
      {% capture show %}show_greenweave_index_review_{{i}}{%endcapture%}
      {% capture img %}greenweave_index_review_{{i}}_img.jpg{%endcapture%}
      {% capture name %}greenweave_index_review_{{i}}_name{%endcapture%}
      {% capture position %}greenweave_index_review_{{i}}_position{%endcapture%}
      {% capture desc %}greenweave_index_review_{{i}}_desc{%endcapture%}
      {% if settings[show] %}
        {% assign count = count | plus: 1 %}
        {% capture info_html %}
		<div class="info-item info-item--{{count}} custom-dot {%if count == 0%}active{%endif%}" data-index="{{count}}">
			<div class="item-img">
				<img src="{{ img | asset_url}}" alt="{{settings[name]}}" loading="lazy" decoding="async" />
				<div class="item-quote">
					<svg height="20px" width="20px" version="1.1" id="_x32_" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 512 512"  xml:space="preserve"> <g><path class="st0" d="M119.472,66.59C53.489,66.59,0,120.094,0,186.1c0,65.983,53.489,119.487,119.472,119.487 c0,0-0.578,44.392-36.642,108.284c-4.006,12.802,3.135,26.435,15.945,30.418c9.089,2.859,18.653,0.08,24.829-6.389 c82.925-90.7,115.385-197.448,115.385-251.8C238.989,120.094,185.501,66.59,119.472,66.59z"/><path class="st0" d="M392.482,66.59c-65.983,0-119.472,53.505-119.472,119.51c0,65.983,53.489,119.487,119.472,119.487 c0,0-0.578,44.392-36.642,108.284c-4.006,12.802,3.136,26.435,15.945,30.418c9.089,2.859,18.653,0.08,24.828-6.389 C479.539,347.2,512,240.452,512,186.1C512,120.094,458.511,66.59,392.482,66.59z"/></g> </svg>
				</div>
			</div>
			<div class="item-detail">
				<p class="name">{{settings[name]}}</p>
				<p class="position">{{settings[position]}}</p>
			</div>
		</div>
		{%endcapture%}
        {% capture desc_html %}
          <div class="swiper-slide">
        		<div class="desc-item">
        			<p class="desc">{{settings[desc] | newline_to_br}}</p>
        		</div>
          </div>
		{%endcapture%}
        {% assign info = info | append: info_html %}
        {% assign content = content | append: desc_html %}
      {% endif %}
    {% endfor %}
    <div class="row">
      <div class="col-lg-4 col-12">
        <div class="review-info custom-pagination">
          {{ info }}
        </div>
      </div>
      <div class="col-lg-8 col-12">
        <div class="swiper">
          <div class="swiper-wrapper review-desc">
            {{ content }}
          </div>
        </div>
        <div class="review-nav hidden">
          <button type="button" class="review-prev">
            <svg
              width="20px"
              height="20px"
              viewBox="0 0 24 24"
              id="left"
              xmlns="http://www.w3.org/2000/svg"
              class="line">
              <polyline id="primary" points="10 19 3 12 10 5" style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;"></polyline>
              <line
                id="primary-2"
                data-name="primary"
                x1="3"
                y1="12"
                x2="21"
                y2="12"
                style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;"></line>
            </svg>
          </button>
          <button type="button" class="review-next">
            <svg
              width="20px"
              height="20px"
              viewBox="0 0 24 24"
              id="right"
              class="line">
              <polyline id="primary" points="14 5 21 12 14 19" style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;"></polyline>
              <line
                id="primary-2"
                data-name="primary"
                x1="21"
                y1="12"
                x2="3"
                y2="12"
                style="fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5;"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>