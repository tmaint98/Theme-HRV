{% if settings.show_greenweave_page_services %}
{%unless has_heading %} 
  <link rel="preload" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload" href="{{ 'gw-page-section-service.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-page-section-service.scss.css' | asset_url }}">
<section class="greenweave-page-service">
  <div class="container">
    {% assign count = 0 %}
    {% assign list_top = '' %}
    {% assign list_bottom = '' %}
    {% for i in (1..6) %}
      {% capture show %}show_greenweave_page_services_{{i}}{%endcapture%}
      {% capture img %}greenweave_page_services_{{i}}_img.jpg{%endcapture%}
      {% capture title %}greenweave_page_services_{{i}}_title{%endcapture%}
      {% if settings[show] %}
        {% assign count = count | plus: 1 %}
        {% capture item_html %}
<div class="item">
  <div class="img"><img src="{{ img | asset_url}}" alt="{{settings[title]}}" loading="lazy" decoding="async" /></div>
  <div class="title">{{settings[title]}}</div>
</div>
              {%endcapture%}
        {% if count < 3 %}
          {% assign list_top = list_top | append: item_html %}
        {% else %}
          {% assign list_bottom = list_bottom | append: item_html %}
        {% endif %}
      {% endif %}
    {% endfor %}
    <div class="row list-top">
      <div class="col-lg-6 col-12">
        <div class="heading-title">
          {% if settings.greenweave_page_services_title_1 != '' %}
            <div class="title1">{{ settings.greenweave_page_services_title_1 }}</div>
          {% endif %}
          {% if settings.greenweave_page_services_title_2 != '' %}
            <h2 class="title2 font-title">{{ settings.greenweave_page_services_title_2 | newline_to_br }}</h2>
          {% endif %}
          {% if settings.greenweave_page_services_desc != '' %}
            <div class="desc">{{ settings.greenweave_page_services_desc | newline_to_br }}</div>
          {% endif %}
        </div>
      </div>
      <div class="col-lg-6 col-12">
        <div class="list-item">
          {{ list_top }}
        </div>
      </div>
    </div>
    <div class="row list-bottom">
      {{ list_bottom }}
    </div>
  </div>
</section>
{%endif%}