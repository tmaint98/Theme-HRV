{%unless has_heading %} 
  <link rel="preload" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload" href="{{ 'gw-index-about-1.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-index-about-1.scss.css' | asset_url }}">
<section class="greenweave-index-about-1">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 col-12">
          <div class="banner">
            <div class="img img--1"><img src="{{'greenweave_index_about_1_banner_1.jpg' | asset_url}}" alt="{{ settings.greenweave_index_about_1_title_2 | strip_html | escape }}" loading="lazy" decoding="async" /></div>
            <div class="img img--2"><img src="{{'greenweave_index_about_1_banner_2.jpg' | asset_url}}" alt="{{ settings.greenweave_index_about_1_title_2 | strip_html | escape }}" loading="lazy" decoding="async" /></div>
          </div>
        </div>
        <div class="col-lg-6 col-12">
          <div class="heading-title">
            {% if settings.greenweave_index_about_1_title_1 != '' %}
              <div class="title1">{{ settings.greenweave_index_about_1_title_1 }}</div>
            {% endif %}
            {% if settings.greenweave_index_about_1_title_2 != '' %}
              <h2 class="title2 font-title">{{ settings.greenweave_index_about_1_title_2 | newline_to_br }}</h2>
            {% endif %}
            {% if settings.greenweave_index_about_1_desc != '' %}
              <div class="desc">{{ settings.greenweave_index_about_1_desc | newline_to_br }}</div>
            {% endif %}
          </div>
          {% if settings.greenweave_index_about_1_btn != '' %}
            <div class="btn-more">
              <a href="{{settings.greenweave_index_about_1_link}}" class="button">{{ settings.greenweave_index_about_1_btn }}</a>
            </div>
          {% endif %}
        </div>
      </div>
      {% if settings.show_greenweave_index_about_1_logo %}
        <div class="list-logo">
          {% for i in (1..6) %}
            {% capture show %}show_greenweave_index_about_1_logo_{{i}}{%endcapture%}
            {% capture img %}greenweave_index_about_1_logo_{{i}}_img.jpg{%endcapture%}
            {% capture alt %}greenweave_index_about_1_logo_{{i}}_alt{%endcapture%}
            {% if settings[show] %}
              <div class="item">
                <img src="{{ img | asset_url}}" alt="{{settings[alt]}}" loading="lazy" decoding="async" />
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
</section>
