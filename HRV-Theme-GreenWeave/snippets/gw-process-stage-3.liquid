{%if settings.show_greenweave_process_stage_3%}
  {%unless has_heading %} 
  <link rel="preload" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
  <link rel="preload" href="{{ 'gw-process-stage-3.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-process-stage-3.scss.css' | asset_url }}">
	<section class="greenweave-process-stage-3">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-6 col-12">
					<div class="stage-banner">
						<div class="img">
							<img src="{{ 'greenweave_process_stage_3_banner_img.jpg' | asset_url}}" alt="{{settings.greenweave_process_stage_3_banner_title}}" loading="lazy" decoding="async"/>
						</div>
					</div>
				</div>
				<div class="col-lg-6 col-12">
					<div class="stage-content">
						<div class="heading-title">
							{%if settings.greenweave_process_stage_3_title_1 != ''%}<div class="title1">{{settings.greenweave_process_stage_3_title_1}}</div>{%endif%}
							{%if settings.greenweave_process_stage_3_title_2 != ''%}<h2 class="title2 font-title">{{settings.greenweave_process_stage_3_title_2 | newline_to_br}}</h2>{%endif%}
							{%if settings.greenweave_process_stage_3_desc != ''%}<p class="desc">{{settings.greenweave_process_stage_3_desc}}</p>{%endif%}
						</div>
						<div class="more-desc">
							<ul class="list">
								{%for i in (1..3)%}
								{%capture desc%}greenweave_process_stage_3_desc_{{i}}{%endcapture%}
								{%if settings[desc] != ''%}
								<li class="item">
									<svg width="25px" height="25px" viewBox="0 0 24 24" enable-background="new 0 0 24 24"><path d="M18.7,7.2c-0.4-0.4-1-0.4-1.4,0l-7.5,7.5l-3.1-3.1c0,0,0,0,0,0c-0.4-0.4-1-0.4-1.4,0c-0.4,0.4-0.4,1,0,1.4l3.8,3.8c0.2,0.2,0.4,0.3,0.7,0.3c0.3,0,0.5-0.1,0.7-0.3l8.2-8.2C19.1,8.2,19.1,7.6,18.7,7.2z"/></svg>
									<span>{{settings[desc]}}</span>
								</li>
								{%endif%}
								{%endfor%}
							</ul>
						</div>
            {%if settings.greenweave_process_stage_3_btn%}
            <div class="btn-more">
              <a href="{{settings.greenweave_process_stage_3_link}}" class="button">{{settings.greenweave_process_stage_3_btn}}</a>
            </div>
            {%endif%}
					</div>
				</div>
			</div>
		</div>
	</section>
	{%endif%}