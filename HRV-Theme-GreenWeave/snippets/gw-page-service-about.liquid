{%if settings.show_greenweave_page_services_about%}
{%unless has_heading %} 
  <link rel="preload stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="stylesheet">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload stylesheet" href="{{ 'gw-page-service-about.scss.css' | asset_url }}" as="stylesheet">
<section class="greenweave-page-service-about" style="--bg-icon: {{settings.greenweave_page_services_about_bg}};--color-icon: {{settings.greenweave_page_services_about_color}};">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 col-12">
          <div class="about-banner">
            <img src="{{ 'greenweave_page_services_about_img.jpg' | asset_url}}" alt="banner about" loading="lazy" decoding="async" />
          </div>
      </div>
      <div class="col-lg-6 col-12">
          <div class="about-content">
            <div class="quote-icon"></div>
            <h2 class="title">{{settings.greenweave_page_services_about_title}}</h2>
            <div class="desc">{{settings.greenweave_page_services_about_desc}}</div>
            <div class="about-info">
              <div class="img">
                <img src="{{'greenweave_page_services_about_ceo_img.jpg' | asset_url}}" alt="" loading="lazy" decoding="async"/>
                <div class="item-quote">
        					<svg height="20px" width="20px" version="1.1" id="_x32_" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 512 512"  xml:space="preserve"> <g><path class="st0" d="M119.472,66.59C53.489,66.59,0,120.094,0,186.1c0,65.983,53.489,119.487,119.472,119.487 c0,0-0.578,44.392-36.642,108.284c-4.006,12.802,3.135,26.435,15.945,30.418c9.089,2.859,18.653,0.08,24.829-6.389 c82.925-90.7,115.385-197.448,115.385-251.8C238.989,120.094,185.501,66.59,119.472,66.59z"/><path class="st0" d="M392.482,66.59c-65.983,0-119.472,53.505-119.472,119.51c0,65.983,53.489,119.487,119.472,119.487 c0,0-0.578,44.392-36.642,108.284c-4.006,12.802,3.136,26.435,15.945,30.418c9.089,2.859,18.653,0.08,24.828-6.389 C479.539,347.2,512,240.452,512,186.1C512,120.094,458.511,66.59,392.482,66.59z"/></g> </svg>
        				</div>
              </div>
              <div class="detail">
                <div class="name">{{settings.greenweave_page_services_about_ceo_name}}</div>
                <div class="position">{{settings.greenweave_page_services_about_ceo_position}}</div>
              </div>
            </div>
          </div>
      </div>
            
    </div>
    {%if settings.show_greenweave_page_services_partner%}
    <div class="row align-items-center list-logo">
        <div class="col-lg-8 col-12">
          <div class="partner-logo">
            {%for i in (1..4)%}
              {%capture show%}show_greenweave_page_services_partner_{{i}}{%endcapture%}
              {%capture img%}greenweave_page_services_partner_{{i}}_img.jpg{%endcapture%}
              {%capture alt%}greenweave_page_services_partner_{{i}}_alt{%endcapture%}
              {%if settings[show]%}
                <div class="item"><img src="{{ img | asset_url}}" alt="{{settings[alt]}}" loading="lazy" decoding="async" /></div>
              {%endif%}
            {%endfor%}
          </div>
        </div>
        <div class="col-lg-4 col-12">
          <div class="heading-title">
          {%if settings.greenweave_page_services_partner_title != ''%}<h2 class="title2 font-title">{{settings.greenweave_page_services_partner_title | newline_to_br}}</h2>{%endif%}
          </div>
        </div>
        </div>
      {%endif%}
  </div>
</section>
{%endif%}