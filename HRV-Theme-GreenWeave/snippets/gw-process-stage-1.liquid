{%if settings.show_greenweave_process_stage_1%}
  {%unless has_heading %} 
  <link rel="preload" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
  <link rel="preload" href="{{ 'gw-process-stage-1.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-process-stage-1.scss.css' | asset_url }}">
	<section class="greenweave-process-stage-1">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-6 col-12">
					<div class="stage-banner">
						<div class="img">
							<img src="{{ 'greenweave_process_stage_1_banner_img.jpg' | asset_url}}" alt="{{settings.greenweave_process_stage_1_banner_title}}" loading="lazy" decoding="async"/>
						</div>
            {%if settings.greenweave_process_stage_1_banner_title != ''%}<div class="title font-title">{{settings.greenweave_process_stage_1_banner_title}}</div>{%endif%}
					</div>
				</div>
				<div class="col-lg-6 col-12">
					<div class="stage-content">
						<div class="heading-title">
							{%if settings.greenweave_process_stage_1_title_1 != ''%}<div class="title1">{{settings.greenweave_process_stage_1_title_1}}</div>{%endif%}
							{%if settings.greenweave_process_stage_1_title_2 != ''%}<h2 class="title2 font-title">{{settings.greenweave_process_stage_1_title_2 | newline_to_br}}</h2>{%endif%}
							{%if settings.greenweave_process_stage_1_desc != ''%}<p class="desc">{{settings.greenweave_process_stage_1_desc}}</p>{%endif%}
						</div>
            {%if settings.greenweave_process_stage_1_btn%}
            <div class="btn-more">
              <a href="{{settings.greenweave_process_stage_1_link}}" class="button">{{settings.greenweave_process_stage_1_btn}}</a>
            </div>
            {%endif%}
					</div>
				</div>
			</div>
		</div>
	</section>
	{%endif%}  