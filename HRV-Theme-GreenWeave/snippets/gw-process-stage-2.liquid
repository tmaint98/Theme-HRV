{%if settings.show_greenweave_process_stage_2%}
{%unless has_heading %} 
  <link rel="preload stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="stylesheet">
  {% assign has_heading = true %}
{% endunless %}
  <link rel="preload stylesheet" href="{{ 'gw-process-stage-2.scss.css' | asset_url }}" as="stylesheet">
	<section class="greenweave-process-stage-2">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-6 col-12">
					<div class="stage-content">
						<div class="heading-title">
							{%if settings.greenweave_process_stage_2_title_1 != ''%}<div class="title1">{{settings.greenweave_process_stage_2_title_1}}</div>{%endif%}
							{%if settings.greenweave_process_stage_2_title_2 != ''%}<h2 class="title2 font-title">{{settings.greenweave_process_stage_2_title_2 | newline_to_br}}</h2>{%endif%}
							{%if settings.greenweave_process_stage_2_desc != ''%}<p class="desc">{{settings.greenweave_process_stage_2_desc}}</p>{%endif%}
						</div>
						<div class="more-desc">
							<ul class="list">
								{%for i in (1..6)%}
								{%capture desc%}greenweave_process_stage_2_desc_{{i}}{%endcapture%}
								{%if settings[desc] != ''%}
								<li class="item">
									<span>{{settings[desc]}}</span>
								</li>
								{%endif%}
								{%endfor%}
							</ul>
						</div>
            {%if settings.greenweave_process_stage_2_btn%}
            <div class="btn-more">
              <a href="{{settings.greenweave_process_stage_2_link}}" class="button">{{settings.greenweave_process_stage_2_btn}}</a>
            </div>
            {%endif%}
					</div>
				</div>
        <div class="col-lg-6 col-12">
					<div class="stage-banner">
						<div class="img">
							<img src="{{ 'greenweave_process_stage_2_banner_img.jpg' | asset_url}}" alt="{{settings.greenweave_process_stage_2_banner_title}}" loading="lazy" decoding="async"/>
						</div>
					</div>
				</div>
			</div>
      		</div>
	</section>
	{%endif%}