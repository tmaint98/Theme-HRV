{%if settings.show_greenweave_about_us_about%}
  {%unless has_heading %} 
  <link rel="preload" href="{{ 'gw-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
  <link rel="preload" href="{{ 'gw-about-us-about.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'gw-about-us-about.scss.css' | asset_url }}">
  <script fetchpriority="low" type="text/javascript" defer src="{{ 'gw-about-us-about.js' | asset_url }}"></script>
	<section class="greenweave-about-us-about">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-6 col-12">
					<div class="about-banner">
						<div class="img">
							<img src="{{ 'greenweave_about_us_about_banner_img.jpg' | asset_url}}" alt="{{settings.greenweave_about_us_about_banner_title}}" loading="lazy" decoding="async"/>
						</div>
            {%if settings.greenweave_about_us_about_banner_title != ''%}<div class="title font-title">{{settings.greenweave_about_us_about_banner_title}}</div>{%endif%}
					</div>
				</div>
				<div class="col-lg-6 col-12">
					<div class="about-content">
						<div class="heading-title">
							{%if settings.greenweave_about_us_about_title_1 != ''%}<div class="title1">{{settings.greenweave_about_us_about_title_1}}</div>{%endif%}
							{%if settings.greenweave_about_us_about_title_2 != ''%}<h2 class="title2 font-title">{{settings.greenweave_about_us_about_title_2 | newline_to_br}}</h2>{%endif%}
							{%if settings.greenweave_about_us_about_desc != ''%}<p class="desc">{{settings.greenweave_about_us_about_desc}}</p>{%endif%}
						</div>
						<div class="more-desc">
							<ul class="list">
								{%for i in (1..3)%}
								{%capture desc%}greenweave_about_us_about_desc_{{i}}{%endcapture%}
								{%if settings[desc] != ''%}
								<li class="item">
									<svg width="25px" height="25px" viewBox="0 0 24 24" enable-background="new 0 0 24 24"><path d="M18.7,7.2c-0.4-0.4-1-0.4-1.4,0l-7.5,7.5l-3.1-3.1c0,0,0,0,0,0c-0.4-0.4-1-0.4-1.4,0c-0.4,0.4-0.4,1,0,1.4l3.8,3.8c0.2,0.2,0.4,0.3,0.7,0.3c0.3,0,0.5-0.1,0.7-0.3l8.2-8.2C19.1,8.2,19.1,7.6,18.7,7.2z"/></svg>
									<span>{{settings[desc]}}</span>
								</li>
								{%endif%}
								{%endfor%}
							</ul>
						</div>
            {%if settings.greenweave_about_us_about_btn%}
            <div class="btn-more">
              <a href="{{settings.greenweave_about_us_about_link}}" class="button">{{settings.greenweave_about_us_about_btn}}</a>
            </div>
            {%endif%}
					</div>
				</div>
			</div>
      {%if settings.show_greenweave_about_us_counter%}
      <div class="row list-counter">
				{%for i in (1..4)%}
				{%capture show%}show_greenweave_about_us_counter_{{i}}{%endcapture%}
				{%capture num%}greenweave_about_us_counter_{{i}}_num{%endcapture%}
				{%capture desc%}greenweave_about_us_counter_{{i}}_desc{%endcapture%}
				{%if settings[show]%}
				<div class="counter-item">
					<div class="counter">
						<div class="counter-num font-title" data-counter="{{settings[num]}}">{{settings[num]}}</div>
						<div class="desc">{{settings[desc]}}</div>
					</div>
				</div>
				{%endif%}
				{%endfor%}
			</div>
      {%endif%}
		</div>
	</section>
	{%endif%}