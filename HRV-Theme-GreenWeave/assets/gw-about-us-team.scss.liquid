:root {
  --bg-btn-team: {{ settings.greenweave_about_us_team_bg_btn }};
  --color-btn-team: {{ settings.greenweave_about_us_team_color_btn }};
}
.greenweave-about-us-team {
  .button{
    color: var(--color-btn-team);
    background-color: var(--bg-btn-team);
  }
  .typewriter {
    position: relative;
     /*&:before {
      content: '';
      position: absolute;
      top: 15%;
      left: 0;
      width: 100%;
      height: 85%;
      background: currentcolor;
    }*/
    .tw-text-bg{
      background: currentcolor;
    }
    .tw-text {
      filter: invert(1);
    }
    .tw-cursor {
      opacity: 0;
      width: 0;
      display: inline-block;
    }
  }
  .list-team {
    gap: 30px;
  }
  .team-item {
    -ms-flex: 0 0 calc(50% - 15px);
    flex: 0 0 calc(50% - 15px);
    max-width: calc(50% - 15px);
    position: relative;
    border-radius: 16px;
    overflow: hidden;
     &:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      transition: all 0.3s;
      opacity: 0;
      z-index: 1;
    }
    .img img {
      transition: all 0.3s;
    }
    .content {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-flow: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #fff;
      z-index: 2;
    }
    .info {
      .name,
      .position {
        opacity: 0;
        transition-property: all;
        transition-duration: 0.3s;
        position: relative;
        top: 10px;
      }
      .name {
        font-size: 24px;
        font-weight: 600;
      }
      .position {
        font-size: 18px;
      }
    }
    .list-social {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      position: absolute;
      bottom: 40px;
      left: 0;
      width: 100%;
      li {
        opacity: 0;
        transition-property: all;
        transition-duration: 0.3s;
        position: relative;
        top: 10px;
      }
      a {
        svg {
          fill: #fff;
        }
      }

    }
     &:hover {
       &:before {
        opacity: 1;
      }
      .img img {
        transform: scale(1.1);
      }
      .info {
        .name,
        .position {
          opacity: 1;
          top: 0;
        }
        .name {
          transition-delay: 0.2s;
        }
        .position {
          transition-delay: 0.3s;
        }
      }
      .list-social li {
        opacity: 1;
        top: 0;
         &:nth-child(1) {
          transition-delay: 0.4s;
        }
         &:nth-child(2) {
          transition-delay: 0.5s;
        }
         &:nth-child(3) {
          transition-delay: 0.6s;
        }
         &:nth-child(4) {
          transition-delay: 0.7s;
        }
      }
    }
  }
  @media(min-width: 1200px) {
    .team-content {
      padding-right: 50px;
    }
  }
  @media(max-width: 991px) {
    .list-team {
      margin: 30px 0 0;
    }
  }
  @media(max-width: 767px) {
    .list-team {
      gap: 15px;
    }
    .team-item {
      -ms-flex: 0 0 100%;
      flex: 0 0 100%;
      max-width: 100%;


      /*
   &:before,
   .content,
   .info .name,
   .info .position,
   .list-social li {
   opacity: 1;
   }
*/
      .info {
        .name {
          font-size: 18px;
        }
        .position {
          font-size: 14px;
        }
      }
    }
  }
}