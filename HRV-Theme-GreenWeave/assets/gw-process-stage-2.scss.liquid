:root {
--bg-stage-2-btn: {{settings.greenweave_process_stage_2_bg_btn}};
--color-stage-2-btn: {{settings.greenweave_process_stage_2_color_btn}};
--bg-stage-2-icon: {{settings.greenweave_process_stage_2_bg_icon}};
}
.greenweave-process-stage-2 {
  .button{
    color: var(--color-stage-2-btn);
    background-color: var(--bg-stage-2-btn);
  }
  .stage-banner {
    .img img {
      border-radius: 16px;
    }
  }
  .more-desc {
    .list {
      display: flex;
      flex-flow: wrap;
      gap: 0 30px;
      padding-left: 20px;
    }
    .item {
      -ms-flex: 0 0 calc(50% - 15px);
      flex: 0 0 calc(50% - 15px);
      max-width: calc(50% - 15px);
      list-style: disc;
      span{opacity: 0.6;}
      &::marker {
        color: var(--bg-stage-2-icon);
      }
       &:not(:last-child) {
        margin-bottom: 10px;
      }
    }
  }
  .btn-more {
    margin-top: 40px;
  }
  @media(min-width: 1200px) {
    .stage-content {
      padding-right: 90px;
    }
  }
  @media(max-width: 991px) {
    .stage-banner {
      margin-top: 30px;
    }
  }
  @media(max-width: 767px) {
    .more-desc .item:not(:last-child) {
      margin-bottom: 5px;
    }
    .btn-more {
      margin-top: 20px;
    }
  }
}
