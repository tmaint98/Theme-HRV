.greenweave-page-service-video {
  padding: 0;
  .banner-video {
    position: relative;
     &:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.3);
    }
    .video-play {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      .icon-play {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 2px solid;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        svg {
          fill: currentcolor;
        }
      }
    }
  }
  @media(max-width: 767px){
    .banner-video {
      .video-play {
      .icon-play {
        width: 50px;
        height: 50px;
        svg {
          width: 20px;
        height: 20px;
        }
      }
    }
    }
  }
}
