/*====Product Loop====*/
.greenweave-product-loop {
	& {
		position: relative;
	}
	.greenweave-product-inner {
		height: 100%;
		display: -ms-flexbox;
		display: -webkit-flex;
		display: flex;
		-webkit-flex-direction: column;
		-ms-flex-direction: column;
		flex-direction: column;
		justify-content: space-between;
	}
	.greenweave-proloop-image {
		position: relative;
		overflow: hidden;
		.greenweave-pro-sale,
		.greenweave-pro-soldout {
			position: absolute;
			top: 7px;
			z-index: 1;
			border-radius: 3px;
			color: #fff;
			font-size: 12px;
			font-weight: 500;
			padding: 2px 5px;
		}
		.greenweave-pro-soldout {
			left: 7px;
			background: #565656;
			font-size: 11px;
			padding-top: 3px;
			padding-bottom: 3px;
		}
		.greenweave-pro-sale {
			left: 7px;
			background: red;
			letter-spacing: 0.5px;
			min-width: 40px;
			text-align: center;
		}
		.greenweave-pro-sale + .greenweave-pro-soldout {
			top: 32px
		}
		.greenweave-product--image {
			position: relative;
			overflow: hidden;
			display: flex;
			display: -ms-flex;
			display: -webkit-flex;
			border-radius: 14px;
			img {
				border-radius: 14px;
				transition: all 0.3s;
			}
		}
		/*.greenweave-proloop-link {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
	}*/
		.gift.product_gift_label {
			width: 30px;
			height: 30px;
			line-height: 25px;
			position: absolute;
			top: 10px;
			right: 10px;
			z-index: 1;
			text-align: center;
			border-radius: 50%;
			padding: 0 5px;
			background: #ffffff;
		}
		.greenweave-pro-iconbox {
			width: 30px;
			height: 30px;
			position: absolute;
			top: 10px;
			right: 10px;
			z-index: 1;
			text-align: center;
		}
		.gift.product_gift_label:not(.d-none) + .greenweave-pro-iconbox {
			top: 40px;
		}
		.sticker_frame {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 99;
		}
		.greenweave-list-icon {
			position: absolute;
			top: calc(50% - 24px);
			left: 0;
			width: 100%;
			height: auto;
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 8px;
			a,
			button {
				display: inline-block;
				width: 48px;
				height: 48px;
				border-radius: 50%;
				border: none;
				outline: none;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				position: relative;
				top: 0;
				-webkit-transition: all 0.2s ease;
				-ms-transition: all 0.2s ease;
				transition: all 0.2s ease;
				background: #fff;
				color: #333;
				svg {
					width: 20px;
					height: 20px;
					transition: all 0.3s;
					fill: #333;
					polyline,line{
						stroke: #333;
					}
				}
			}
			> div {
				-webkit-transition: all 0.4s ease-in-out;
				-ms-transition: all 0.4s ease-in-out;
				transition: all 0.4s ease-in-out;
				opacity: 0;
				&:hover {
					a,
					button {
						top: -4px;
						svg {
							opacity: 0.5;
						}
					}
				}
			}
		}
		&:hover {
			.greenweave-product--image img {
				transform: scale(1.08);
			}
      @media (min-width: 992px) {
  			.greenweave-list-icon {
				> div {
					transition-property: opacity;
					opacity: 1;
					&:nth-child(1) {
						-webkit-transition-delay: 0.05s;
						-ms-transition-delay: 0.05s;
						transition-delay: 0.05s;
					}
					&:nth-child(2) {
						-webkit-transition-delay: 0.1s;
						-ms-transition-delay: 0.1s;
						transition-delay: 0.1s;
					}
					&:nth-child(3) {
						-webkit-transition-delay: 0.15s;
						-ms-transition-delay: 0.15s;
						transition-delay: 0.15s;
					}
				}

  			}
      }
		}
	}
	.greenweave-proloop-detail {
		position: relative;
		padding: 25px 0 0;
		display: -ms-flexbox;
		display: -webkit-flex;
		display: flex;
		-webkit-flex-direction: column;
		-ms-flex-direction: column;
		flex-direction: column;
		-webkit-flex: 1 1 auto;
		-ms-flex: 1 1 auto;
		flex: 1 1 auto;
		h3 {
			font-size: 20px;
			margin: 0 0 12px;
			a {
				white-space: initial;
				overflow: hidden;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				display: -webkit-box;
        color: currentColor;
			}
		}
		.greenweave-proloop--vendor {
			margin-bottom: 6px;
			text-transform: uppercase;
			font-size: 12px;
			font-weight: 500;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			a {
				color: #999999;
			}
		}
		.greenweave-proloop--variant {
			margin-bottom: 14px;
			margin-left: -5px;
			margin-right: -5px;
			-ms-flex-align: center;
			align-items: center;
			display: -ms-flexbox;
			display: flex;
			/*	-ms-flex-wrap: wrap;flex-wrap: wrap;*/
			-ms-justify-content: space-between;
			justify-content: space-between;
			.list-color,
			.list-option {
				padding: 0 5px;
			}
			.vrt-option {
				margin-left: 8px;
				font-size: 13px;
				color: #9a9a9a;
			}
			.vrt-color {
				font-size: 0;
				width: 16px;
				height: 16px;
				line-height: 12px;
				border: 1px solid #d4d4d4;
				padding: 1px;
				margin-right: 5px;
				margin-bottom: 5px;
				span {
					display: block;
					margin: 0;
					width: 100%;
					height: 100%;
				}
				& > img {
					width: 100%;
					height: 100%;
					object-fit: cover;
				}
			}
			.vrt-color:last-of-type {
				margin-right: 0
			}
			.vrt-color.color-count {
				font-size: 14px;
				width: auto;
				border: 0;
			}
			.vrt-color.color-count span {
				background: #ffffff;
				line-height: 100%;
			}
			.list-color {
				-ms-flex-order: 2;
				order: 2;
			}
			.list-option {
				-ms-flex-order: 3;
				order: 3;
				padding-bottom: 1px;
				-ms-justify-content: end;
				justify-content: end;
			}
			.list-option.not-colors {
				-ms-flex-order: 1;
				order: 1;
				-ms-justify-content: start;
				justify-content: start;
				.vrt-option:first-of-type {
					margin-left: 0
				}
			}
		}
		.greenweave-proloop--price {
			margin: 0;
			font-weight: 600;
			font-size: 16px;
			.greenweave-price-del {
				text-decoration: line-through;
				font-weight: 300;
				font-size: 13px;
			}
			.greenweave-price {
				margin-right: 6px;
			}
			&.on-sale .greenweave-price {
				color: #ff2c26;
			}
		}
		.greenweave-proloop-actions {
			&__inner {
				position: relative;
				.greenweave-btn-proloop {
					font-weight: 600;
					border: 1px solid #e9eaec;
					padding: 7px 10px;
					text-align: center;
					border-radius: 30px;
					display: block;
					white-space: nowrap;
					overflow: hidden;
					text-overflow: ellipsis;
				}
				.greenweave-btn-proloop-contact {
					width: 100%;
					border: 1px solid #e9eaec;
				}
				.greenweave-btn-proloop-gift {
					width: 100%;
					color: #c4c4c4;
					border: 1px solid #e9eaec;
				}
			}
		}
		.greenweave-wrapper-action-loop {
			margin-top: auto;
			display: -ms-flexbox;
			display: flex;
			-ms-flex-align: center;
			align-items: center;
			.greenweave-prices-ctas {
				margin-right: auto;
				padding-right: 5px;
			}
			.greenweave-proloop-actions {
				-ms-flex: 1 1 auto;
				flex: 1 1 auto;
				width: 1%;
				text-align: right;
			}
		}
	}
	.greenweave-proloop--review {
		margin-bottom: 6px;
		.haravan-product-reviews-badge {
			overflow: hidden;
			display: -webkit-flex;
			display: -ms-flex;
			display: flex;
			-webkit-align-items: center;
			-ms-align-items: center;
			align-items: center;
			.hrv-product-reviews-star {
				display: -webkit-flex;
				display: flex;
				-webkit-align-items: center;
				align-items: center;
				i[class^="star-"] {
					color: #fdd836 !important;
					font-size: 13px;
					margin-right: -3px;
					display: inline-block
				}
				i.star-off-png {
					color: #dadada !important;
				}
			}
			.hrv-product-reviews-star + span,
			.hrv-product-reviews-star + p {
				margin-bottom: 0;
				margin-left: 6px;
				color: #637381;
			}
			.hrv-product-reviews-star + p {
				margin-bottom: 0;
				margin-left: 8px;
				font-size: 0;
				visibility: hidden;
				&:before {
					content: "(0)";
					display: inline-block;
					visibility: visible;
				}
			}
			.hrv-product-reviews-star + span,
			.hrv-product-reviews-star + p:before {
				font-size: 12px;
			}
		}
	}
	.greenweave-proloop--review + .greenweave-proloop--action {
		margin-top: 0;
	}
	&:not(.greenweave-product-horizontal) {
		.greenweave-pro-percent {
			display: none;
		}
		.greenweave-prohzt-soldout {
			display: none;
		}
	}
	&.greenweave-product-only .greenweave-proloop-detail .greenweave-proloop-actions__inner .greenweave-btnico .greenweave-btnico-secondary {
		display: none;
	}
	&.greenweave-product-horizontal {
		padding-right: 0;
		padding-left: 0;
		margin-bottom: 0;
		.greenweave-product-inner {
			display: -ms-flex;
			display: flex;
			-ms-flex-direction: row;
			flex-direction: row;
			box-shadow: none;
		}
		.greenweave-proloop-image {
			display: block;
			min-width: 100px;
			padding: 10px;
		}
		.greenweave-proloop-image .icon-quickview {
			display: none;
		}
		.greenweave-pro-soldout {
			display: none;
		}
		.greenweave-prohzt-soldout {
			display: block;
			font-size: 12px;
			font-weight: 500;
			color: #878c8f;
		}
		.greenweave-proloop-detail {
			padding-left: 5px;
			padding-right: 0;
			text-align: left;
			.greenweave-proloop--price {
				padding-bottom: 0;
			}
			.greenweave-proloop--price .greenweave-price-del {
				margin-right: 4px;
			}
			.greenweave-proloop--review {
				display: none;
			}
			.greenweave-proloop--review .haravan-product-reviews-badge {
				-ms-justify-content: left;
				justify-content: left;
			}
			.greenweave-proloop-actions {
				display: none;
			}
		}
		.greenweave-pro-sale {
			display: none;
		}
		.greenweave-pro-percent {
			display: inline-block;
			min-width: 36px;
			padding: 1px 4px;
			background: #fbf1f1;
			text-transform: uppercase;
			text-align: center;
			font-weight: 600;
			font-size: 10px;
			letter-spacing: 0.5px;
			color: #ff0000;
			border: 1px solid #f0e8ee;
			border-radius: 3px;
			vertical-align: text-bottom;
		}
		&:hover .greenweave-product-inner {
			box-shadow: none;
		}
	}
	&.greenweave-product-loop-project {
		.greenweave-proloop-image .greenweave-list-icon {
			.quickview-product,
			.cart-product {
				display: none;
			}
		}
	}
	@media(min-width: 992px) {
		&.prod-action-small .greenweave-proloop-detail .greenweave-proloop-actions__inner .actions-primary .greenweave-btn-proloop-cart {
			padding: 0 40px 0 10px;
			font-size: 11px;
		}
		.greenweave-product-inner {
			& {
				position: relative;
				overflow: hidden;
				-webkit-transition: all 400ms ease;
				-moz-transition: all 400ms ease;
				-ms-transition: all 400ms ease;
				-o-transition: all 400ms ease;
				transition: all 400ms ease;
			}
			.greenweave-proloop-detail {
				-webkit-transition: transform 300ms ease;
				-moz-transition: transform 300ms ease;
				-ms-transition: transform 300ms ease;
				-o-transition: transform 300ms ease;
				transition: transform 300ms ease;
				.greenweave-proloop-actions__inner .actions-primary .greenweave-btn-proloop-cart:not(.disabled):hover {}
			}

		}
		.greenweave-proloop-detail {
			.greenweave-proloop--price .greenweave-price-del {
				display: block;
			}
		}
	}
	@media(max-width: 991px) {
		.greenweave-proloop-image .greenweave-icon-quickview {
			display: none;
		}
		.greenweave-proloop-actions {
			position: initial;
			visibility: visible;
			.greenweave-proloop-actions__inner .greenweave-btn-proloop-cart .btnadd:hover:after {
				display: none;
			}
		}
		.greenweave-proloop--review .haravan-product-reviews-badge {
			justify-content: center;
		}

	}
	@media(max-width: 767px) {
		.greenweave-proloop-image {
			.greenweave-list-icon {
        display: none;
				a,
				button {
					width: 35px;
					height: 35px;
					svg {
						width: 15px;
						height: 15px;
					}
				}
			}
			.greenweave-product--image {
				&,
				img {
					border-radius: 8px;
				}
			}
		}
		.greenweave-proloop-detail {
			padding: 15px 8px 0;
			text-align: center;
			h3 {
				font-size: 16px;
				margin-bottom: 5px;
			}
			.greenweave-proloop--price {
				font-size: 14px;
				.greenweave-price-del {
					font-size: 13px;
				}
				.greenweave-price {
					margin-right: 0;
				}
				&.on-sale .greenweave-price {
					margin-right: 6px;
				}
			}
			.greenweave-proloop-vendor {
				font-size: 10px;
			}
			.greenweave-proloop-actions {
				padding-bottom: 4px;
				padding-top: 10px;
				&__inner {
					.greenweave-btnico {
						width: 30px;
						height: 30px;
					}
					.greenweave-btnico svg {
						width: 13px;
					}
					.greenweave-btn-proloop {
						font-size: 12px;
					}

				}
			}
			.greenweave-wrapper-action-loop {
				/*margin-top: auto;*/
				-ms-flex-wrap: wrap;
				flex-wrap: wrap;
				.greenweave-proloop--price {
					-ms-flex: 0 0 auto;
					flex: 0 0 auto;
					width: 100%;
					margin-right: 0;
					margin-left: 0;
					padding-right: 0;
				}
				.greenweave-proloop-actions {
					-ms-flex: 0 0 auto;
					flex: 0 0 auto;
					width: 100%;
					text-align: center;
					padding-left: 0;
				}
			}
		}


	}
}


/*Quickview*/
/*===== QUICK VIEW DETAIL ================================*/
.greenweave-modal-product-quickview .button {
	position: relative;
	z-index: 1;
	overflow: hidden;
	display: inline-block;
	padding: 18px 45px;
	line-height: normal;
	color: #fff;
	background-color: red;
	border: 0;
	border-radius: 30px;
	font-size: 14px;
	font-weight: 600;
	text-align: center;
	letter-spacing: 1px;
	outline: none !important;
	-webkit-transition: all 0.45s;
	transition: all 0.45s;
	&:before {
		content: '';
		background-color: rgba(255,255,255, 0.2);
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		z-index: -1;
		transition: all 0.4s ease-in-out;
		border-radius: 100px;
	}
	@media(min-width: 992px) {
		&:hover,
		&.has-hover,
		&:focus {
			border-color: transparent;
		}
		&:hover:before,
		&.has-hover:before,
		&:focus:before {
			opacity: 1;
		}
	}
	@media(max-width: 767px) {
		font-size: 12px;
		padding: 8px 15px;
		min-height: 35px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
}
.greenweave-modal-product-quickview .tooltip-cs{
	position: relative;
	.tooltip-hover{
		position: absolute;
		top: -36px;
		left: 50%;
		transform: translateX(-50%);
		height: 24px;
		line-height: 24px;
		background: #17191a;
		color: #fff;
		font-size: 10px;
		text-decoration: none;
		white-space: nowrap;
		padding: 0 8px;
		border-radius: 3px;
		z-index: 999;
		opacity: 0;
		visibility: hidden;
		transition: all 300ms ease;
		&:after{
			content: "";
			display: block;
			position: absolute;
			bottom: 1px;
			left: 50%;
			width: 0;
			height: 0;
			border: solid;
			border-width: 8px 8px 0 8px;
			border-color: transparent;
			border-top-color: #000;
			-webkit-transform: translate(-50%, 100%);
			transform: translate(-50%, 100%);
		}
	}
	&:hover .tooltip-hover{
		opacity: 1;
		visibility: visible;
	}
}
.greenweave-modal-product-quickview {
	background: rgba(3, 17, 27, 0.3); z-index: 9999 !important;
	.modal-dialog-centered {
		pointer-events: none;
		display: -webkit-box;display: -ms-flexbox;display: flex;
		-webkit-box-align: center;-ms-flex-align: center;align-items: center; 
		margin: 28px auto;
		min-height: calc(100% - (28px * 2));
	}
	.modal-dialog-centered .modal-content {
		pointer-events: auto;
		width: 100%;
		margin-bottom: 50px;
		overflow: hidden; 
	}
	.modal-paramlink {
		position: relative;
		padding: 0;z-index: 5; 
		border-bottom: 1px solid #e6e6e6;
	}
	.modal-paramlink:before {
		content: "";
		position: absolute;
		width: 0;height: 100%;z-index: -1;
		top: 0;left: 0;
		background: #f7f5f5;
	}
	.modal-paramlink .greenweave-quickview-close {
		text-align: center;
		position: absolute;
		cursor: pointer;
		top: 10px;
		right: 10px;
		color: #272727;
		z-index: 999;
		width: 36px;
		height: 36px;
		border: 9px solid transparent;
		border-radius: 100%;-webkit-border-radius: 100%;-moz-border-radius: 100%;-ms-border-radius: 100%;-o-border-radius: 100%;
		&:before, &:after {
			content: "";
			position: absolute;
			height: 2px;
			width: 100%;
			top: 50%;
			left: 0;
			margin-top: -1px;
			background-color: rgba(39,39,39,.5);
			-webkit-transition: all .3s ease;
			transition: all .3s ease;
		}
		&:before {
			transform-origin: 50% 50%;
			-webkit-transform: rotate(-45deg);
			transform: rotate(-45deg);
		}
		&:after {
			transform-origin: 50% 50%;
			-webkit-transform: rotate(45deg);
			transform: rotate(45deg);
		}
		&:hover {background: #e5e5e5;}
		&:hover:before, &:hover:after {
			-webkit-transform: rotate(0deg);
			transform: rotate(0deg);
		}
		@media(max-width: 767px) {
			&{top: 5px;}
		}
	}
	.modal-paramlink .paramlink-topbar {
		position: relative;
		display: block;
		padding: 8px 50px;width:100%; 
	}
	.modal-paramlink .paramlink-topbar .purl-title {
		font-size: 15px;
		margin: 0;
		display: block; 
	}
	.modal-paramlink .paramlink-topbar .purl-title span {
		overflow: hidden;visibility: initial;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		display: -webkit-box; 
	}
	.modal-paramlink .paramlink-topbar .purl-link {
		margin: 0;font-size: 13px;
	}
	.modal-detailProduct {padding: 0;}
