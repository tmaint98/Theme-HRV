.greenweave-process-services {
  .service-list {
    .item {
      display: flex;
      gap: 30px;
       &:not(:last-child) {
        margin-bottom: 50px;
      }
      .img img {
        border-radius: 50%;
        max-width: 100px;
      }
      .detail {
        .title {
          font-size: 26px;
        }
        .desc {
          font-size: 18px;
          opacity: 0.6;
        }
      }
    }
  }
  @media(min-width: 1200px) {
    .service-content {
      padding-right: 50px;
    }
  }
  @media(max-width: 767px){
    .service-list{
      .item{
        gap: 15px;
        &:not(:last-child){
          margin-bottom: 20px;
        }
        .img img{
          max-width: 60px;
        }
        .detail {
          .title{
          font-size: 18px;
                    margin-bottom: 8px;
        }
          .desc{
            font-size: 14px;
          }
        }
      }
    }
    
  }
}
