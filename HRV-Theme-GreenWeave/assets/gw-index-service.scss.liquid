$colorService: {{settings.greenweave_index_service_color}};
$bgServiceItem: {{settings.greenweave_index_service_item_bg}};
$colorServiceItem: {{settings.greenweave_index_service_item_color}};
$bgServiceItemHover: {{settings.greenweave_index_service_item_bg_hover}};
$colorServiceItemHover: {{settings.greenweave_index_service_item_color_hover}};
.hidden{display: none !important;}
.greenweave-index-service{
  @media(min-width: 992px){
  	.container{	max-width: 100%;padding-left: 20px;	padding-right: 20px;}
  }
  @media(min-width: 1200px){
  	.container{max-width:1170px;}
  }
  @media(min-width: 1366px){
  	.container{max-width:1290px;}
  }
  @media(min-width: 1600px){
  	.container{max-width:1410px;}
  	.container-fluid{max-width:1800px;}
  }
}
.greenweave-index-service .heading-title{
  color: $colorService;
}
.greenweave-index-service {
  padding: 80px 0;
  background-image: url("{{ 'greenweave_index_service_bg.jpg' | asset_url}}");
  background-size: cover;
  background-position: center;
  overflow: hidden;
  .service-item {
    padding: 50px 50px 60px;
    background: $bgServiceItem;
    color: $colorServiceItem;
    border-radius: 14px;
    transition: all 0.3s;
    height: 100%;
    .img {
      margin-bottom: 30px;
      width: 70px;height: 70px;
      img{
        transition: all 0.3s;
      }
    }
    .title {
      font-size: 30px;
      margin-bottom: 15px;
      color: $colorServiceItem;
    }
    .desc {
      font-size: 18px;
      color: rgba($colorServiceItem, 0.6);
    }
    .icon {
      margin-top: 40px;
      svg {
        width: 20px;
        height: 20px;
        fill: $colorServiceItem;
        polyline,
        line {
          stroke: $colorServiceItem;
        }
      }
    }
  }
  .service-nav {
    button {
      width: 46px;
      height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border-radius: 50%;
      border: 1px solid rgba($colorService, 0.3);
      outline: none;
      color: $colorService;
      transition: all 0.3s;
      svg {
        width: 20px;
        height: 20px;
        fill: $colorService;
        transition: all 0.3s;
        polyline,
        line {
          stroke: $colorService;
          transition: all 0.3s;
        }
      }
      &.swiper-button-disabled {
        opacity: 0.5;
        pointer-events: none;
      }
       &:hover {
        background: #fff;
        color: #333;
        border-color: #fff;
        svg {
          fill: #333;
          polyline,
          line {
            stroke: #333;
          }
        }
      }
    }
  }
  .swiper{
    &:not(.swiper-initialized){
      .swiper-wrapper{
        display: flex;gap: 30px;
        .swiper-slide{
          flex: 0 0 calc(100%/3);
        }
      }
    }
    .swiper-slide{height: auto;}
  }
  @media(min-width: 992px) {
    .heading-col {
      display: flex;
      gap: 30px;
      .title2 {
        margin: 0;
      }
      .heading-left {
        -ms-flex: 0 0 32%;
        flex: 0 0 32%;
        max-width: 32%;
      }
      .heading-center {
        -ms-flex: 0 0 calc(45% - 30px);
        flex: 0 0 calc(45% - 30px);
        max-width: calc(45% - 30px);
      }
      .heading-right {
        -ms-flex: 0 0 calc(23% - 30px);
        flex: 0 0 calc(23% - 30px);
        max-width: calc(23% - 30px);
      }
    }
    
    .service-item {
       &:hover {
        background: $bgServiceItemHover;
        color: $colorServiceItemHover;
         .img{
           background: $colorServiceItemHover;
        		-webkit-mask: var(--bg-img) center / contain;
        		mask: var(--bg-img) center / contain;
        		mask-repeat: no-repeat;
           img{
             opacity: 0;
           }
         }
        .title,
        .desc {
          color: $colorServiceItemHover;
        }
        .icon {
          svg {
            fill: $colorServiceItemHover;
            polyline,
            line {
              stroke: $colorServiceItemHover;
            }
          }
        }
      }
    }
  }
  @media(min-width: 1200px) {
    .swiper {
        overflow: visible;
    }
  }
  @media(max-width: 991px){
    padding-bottom: 40px;
    .service-nav{
      margin-top: 20px;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
    .service-item {
    padding: 30px 20px;
    .img {
      margin-bottom: 20px;
      img {
        max-height: 50px;
      }
    }
    .title {
      font-size: 22px;
    }
    .desc {
      font-size: 14px;
    }
    .icon {
      margin-top: 15px;
    }
  }
    .owl-nav,
    .service-nav{
      button{
        width: 36px;
        height: 36px;
        svg{
          width: 15px;
          height: 15px;
        }
      }
    }
  }
}
