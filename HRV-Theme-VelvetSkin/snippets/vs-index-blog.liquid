<link rel="preload" href="{{ 'vs-index-blog.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'vs-index-blog.scss.css' | asset_url }}">
<section class="velvetskin-index-blog">
  <div class="container">
    <div class="heading-title text-center">
      {% if settings.velvetskin_index_blog_title_1 != empty %}
        <div class="title1">{{ settings.velvetskin_index_blog_title_1 }}</div>
      {% endif %}
      {% if settings.velvetskin_index_blog_title_2 != empty %}
        <h2 class="title2">{{ settings.velvetskin_index_blog_title_2 | newline_to_br }}</h2>
      {% endif %}
    </div>
    {% if blogs[settings.velvetskin_index_blog_handle].articles.size == 0 %}
      <p class="txt-noArticle">Chưa có bài viết nào trong mục này</p>
    {% else %}
      <div class="row list-blog">
        {% for article in blogs[settings.velvetskin_index_blog_handle].articles limit: settings.velvetskin_index_blog_limit %}
          {% include 'article-image' with article: article %}
          <article class="article-loop col-xl-6 col-12">
            <div class="article-inner">
              <div class="article-image">
                <a href="{{ article.url}}" class="blog-post-thumbnail" title="{{ article.title }}" rel="nofollow">
                  <img
                    class="lazyload"
                    {% if forloop.first %}
                    data-src="{{ imageUrl | product_img_url : '1024x1024' }}"
                    {% else %}
                    data-src="{{ imageUrl | product_img_url : 'grande' }}"
                    {% endif %}
                    src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                    alt="{{ article.title }}">
                </a>
              </div>
              <div class="article-detail">
                <div class="article-title">
                  <h3 class="post-title">
                    <a href="{{ article.url}}" title="{{ article.title }}">{{ article.title }}</a>
                  </h3>
                  <div class="article-post-meta">
                    <span class="author">bởi: {{ article.author }}</span>
                    <span> - </span>
                    <span class="date">
                      <time pubdate datetime="{{ article.published_at | date: '%d Tháng %m, %Y' }}">{{ article.published_at | date: '%d Tháng %m, %Y' }}</time>
                    </span>
                  </div>
                </div>
                <a href="{{ article.url}}" class="button">Xem chi tiết</a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if settings.velvetskin_index_blog_btn != empty and blogs[settings.velvetskin_index_blog_handle].articles.size > settings.velvetskin_index_blog_limit %}
        <div class="btn-more text-center">
          <a href="{{blogs[settings.velvetskin_index_blog_handle].url}}" class="button">{{ settings.velvetskin_index_blog_btn }}</a>
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>