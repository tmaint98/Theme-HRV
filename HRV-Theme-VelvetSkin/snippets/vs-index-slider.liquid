{%unless has_heading%}
<link rel="preload" href="{{ 'vs-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'vs-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{%endunless%}

<link rel="preload" href="{{ 'vs-index-slider.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'vs-index-slider.scss.css' | asset_url }}">
<link href="{{ 'vs-index-slider.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'vs-index-slider.js' | asset_url }}"></script>

<div class="velvetskin-index-slider" id="velvetskin-index-slider">
  <div class="container-fluid index-slider">
    <div class="swiper">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <div class="slider-item">
            <div class="slide--image">
              <img src="{{ 'velvetskin_index_slider_1_img.jpg' | asset_url }}" alt="{{ settings.velvetskin_index_slider_1_alt | strip_html | escape }}" class="swiper-lazy" loading="lazy" decoding="sync"/>
             </div>
            <div class="slide--content">
              <div class="content-box">
                {%if settings.velvetskin_index_slider_1_title != empty%}<h2 class="title">{{settings.velvetskin_index_slider_1_title}}</h2>{%endif%}
                {%if settings.velvetskin_index_slider_1_btn != empty%}
                <div class="btn-more">
                  <a href="{{settings.velvetskin_index_slider_1_link}}" class="button">{{settings.velvetskin_index_slider_1_btn}}</a>
                </div>
                {%endif%}
              </div>
            </div>
          </div>
        </div>
        {%- for i in (2..4) -%}
          {% capture show_slide %}velvetskin_index_slider_{{i}}_show{% endcapture %}
          {% capture image %}velvetskin_index_slider_{{i}}_img.jpg{% endcapture %}
          {% capture show_image_mb %}show_velvetskin_index_slider_{{i}}_img_mb{% endcapture %}
          {% capture image_mb %}velvetskin_index_slider_{{i}}_img_mb.jpg{% endcapture %}
          {% capture title %}velvetskin_index_slider_{{i}}_title{% endcapture %}
          {% capture btn %}velvetskin_index_slider_{{i}}_btn{% endcapture %}
          {% capture link %}velvetskin_index_slider_{{i}}_link{% endcapture %}
          {%- if settings[show_slide] -%}
            <div class="swiper-slide">
              <div class="slider-item">
                <div class="slide--image">
                  <img src="{{ image | asset_url }}" alt="{{ settings[alt] | strip_html | escape }}" class="swiper-lazy" loading="lazy" decoding="sync" />
                </div>
                <div class="slide--content">
                  <div class="content-box">
                    {%if settings[title] != empty%}<h2 class="title">{{settings[title]}}</h2>{%endif%}
                    {%if settings[btn] != empty%}
                    <div class="btn-more">
                      <a href="{{settings[link]}}" class="button">{{settings[btn]}}</a>
                    </div>
                    {%endif%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%comment%}<div class="swiper-pagination"></div>{%endcomment%}
      
      <div class="swiper-nav swiper-next">
        <svg width="30px" height="30px" viewBox="-77 0 512 512" xmlns="http://www.w3.org/2000/svg" ><title>right</title><path d="M98 460L64 426 227 262 64 98 98 64 294 262 98 460Z" /></svg>
      </div>
      <div class="swiper-nav swiper-prev">
        <svg width="30px" height="30px" viewBox="-78.5 0 512 512" xmlns="http://www.w3.org/2000/svg" ><title>left</title><path d="M257 64L291 98 128 262 291 426 257 460 61 262 257 64Z" /></svg>
      </div>

    </div>
  </div>
</div>

<div class="section-home-pus-promotion pus-promotion-grids">
  <div class="container">
    <div class="hrv-pus-promotion" data-hrvpus-layout="flashsale"></div>
  </div>
</div>
<div class="section-home-hrvpmo hrvpmo-grids">
  <div class="container">
    <div class="hrv-pmo-coupon" data-hrvpmo-layout="grids"></div>
    <div class="hrv-pmo-discount" data-hrvpmo-layout="grids"></div>
  </div>
</div>