{%- assign webfont_title_1 = settings.base_font_title1 | split : ':' | first -%}
$colorText: {{ settings.shop_text_color }};
$mainSlide: {{ settings.velvetskin_index_slider_main }};
.velvetskin-index-slider {
  img {
    max-width: 100%;
    vertical-align: middle;
    border-style: none;
  }
  .slide--image {
    text-align: center;
    position: relative;
    overflow: hidden;
    max-width: 70%;
    margin-right: 0;
    margin-left: auto;
    img {
      transition: all 0.5s;
    }
  }
  .slide--content {
    position: absolute;
    top: 0;
    left: 0;
    width: 45%;
    height: 100%;
    display: flex;
    align-items: center;
    .title {
      font-size: 75px;
    }
    .btn-more {
      margin-top: 40px;
    }
  }
  .swiper {
    .swiper-slide {
      .slide--image {
        border-radius: 10px;
        img {
          transition: all 1s;
          opacity: 0;
          transform: scale(1.6);
          border-radius: 10px;
        }
      }
      &.swiper-slide-active {
        .slide--image img {
          opacity: 1;
          transform: scale(1);
        }
      }
    }
    .swiper-nav {
      position: absolute;
      top: calc(50% - 23px);
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: none;
      outline: none;
      color: $colorText;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      svg {
        width: 20px;
        height: 20px;
        fill: currentcolor;
        polyline,
        line {
          stroke: currentcolor;
        }
      }
      &.swiper-next {
        right: 15px;
      }
      &.swiper-prev {
        left: 15px;
      }
       &:hover {
        background: rgba($colorText, 0.2);
      }
    }
  }
  @media(min-width: 1200px) {
    .index-slider {
      padding: 0;
    }
    .swiper {
      padding: 70px 50px 0;
    }
  }
  @media(max-width: 991px) {
    .slide--content .title {
      font-size: 55px;
    }
  }
  @media(max-width: 767px) {
    .slide--image {
      max-width: 100%;
    }
    .slide--content {
      width: 100%;
      position: unset;
      padding: 15px;
      text-align: center;
      .title {
        font-size: 30px;
        margin: 0;
      }
      .btn-more {
        margin-top: 20px;
      }
    }
    .swiper {
      .swiper-nav {
        top: calc(50% - 20px);
        width: 40px;
        height: 40px;
        background: rgba($colorText, 0.2);
        &.swiper-next {
          right: 5px;
        }
        &.swiper-prev {
          left: 5px;
        }
      }
    }
  }
}

.hrv-pus-promotion:empty,
.section-home-pus-promotion:empty,
.hrv-pmo-discount:empty,
.hrv-pmo-coupon:empty,
.section-home-hrvpmo:empty {
  padding: 0;
}