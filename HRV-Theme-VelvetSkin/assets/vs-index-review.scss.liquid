.velvetskin-index-review {
  padding: 80px 0;
  .nav-tabs {
    border-bottom: none;
    align-items: center;
    justify-content: center;
    gap: 15px 60px;
    margin-top: 50px;
    .nav-item {
      margin: 0;
    }
    .nav-link {
      background: none;
      border: none;
      padding: 0;
      opacity: 0.3;
      transition: all 0.3s;
      img {
        max-height: 30px;
      }
      &.active,
       &:hover {
        opacity: 1;
      }
    }
  }
  .tab-pane {
    font-size: 32px;
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .nav-tabs {
      gap: 15px 30px;
      margin-top: 30px;
      .nav-link img {
        max-height: 22px;
      }
    }
    .tab-pane {
      font-size: 22px;
    }
  }
}