  VelvetSkin_addCartProdItem: function(id){
		var prolink = $('.velvetskin-product-loop[data-id="'+id+'"] .velvetskin-proloop-image .velvetskin-product-link').attr('href');	
		var proId = $('.velvetskin-product-loop[data-id="'+id+'"] .velvetskin-product-inner').attr('data-proid');
		var proTitle = $('.velvetskin-product-loop[data-id="'+id+'"] .velvetskin-proloop-detail h3 a').html();
		if (template.indexOf('page.landing-page-01') > -1) {
			prolink = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .velvetskin-proloop-image .velvetskin-product-link').attr('href');	
			proId = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .velvetskin-proloop-image').attr('data-proid');
			proTitle = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .velvetskin-proloop-detail h3 a').html();
		}
		if(promotionApp){
			if(!$('.velvetskin-product-loop[data-id="'+id+'"]').find('.gift.product_gift_label').hasClass('d-none') && !$('.product-loop-ldpage .product-block[data-id="'+id+'"]').find('.gift.product_gift_label').hasClass('d-none')){
				//	window.location.href = $('.velvetskin-product-loop[data-id="'+id+'"]').find('a').attr('href') || $('.prodloop-block[data-id="'+id+'"]').find('a').attr('href');
				VelvetSkin.ProductLoop.VelvetSkin_renderQuickview(prolink,proId,proTitle);	
				setTimeout(function() {$('.modal-product-quickview .product-promotion').show();},150);
			}
			else{
				var min_qty = 1;
				var variant_id = $(this).attr('data-variantid');
				var params = {
					type: 'POST',
					url: '/cart/add.js',
					async: true,
					data:'quantity=' + min_qty + '&id=' + id,
					dataType: 'json',
					success: function(line_item) {
						if (template.indexOf('cart') > -1) {
							window.location.reload();
						} else {
							var image = '';
							if(line_item['image'] == null){ 
								image = 'https://hstatic.net/0/0/global/noDefaultImage6.gif';
							}
							else{
								image = Haravan.resizeImage(line_item['image'], 'small');
							}
							var $info = '<div class="row"><div class="col-md-12 col-xs-12"><p class="jGowl-text">Đã thêm vào giỏ hàng thành công!</p></div><div class="col-md-4 col-xs-4"><a href="' + line_item['url'] + '"><img width="70px" src="' + image + '" alt="' + line_item['title'] + '"/></a></div><div class="col-md-8 col-xs-8"><div class="jGrowl-note"><a class="jGrowl-title" href="' + line_item['url'] + '">' + line_item['title'] +  '</a><ins>' + Haravan.formatMoney(line_item['price'], formatMoney) + '</ins></div></div></div>';
							HRVTheme.General.notifyProduct($info);
							$('.velvetskin-product-actions[data-vrid="'+id+'"] .velvetskin-product-value').val(line_item.quantity);
							VelvetSkin.Cart.VelvetSkin_getCartModal(false);
						}
						$('.velvetskin-product-actions[data-vrid='+id+']').addClass('velvetskin-action-count');
					},
					error: function(XMLHttpRequest, textStatus) {
						Haravan.onError(XMLHttpRequest, textStatus);
					}
				};
				if($('.velvetskin-product-loop[data-id="'+id+'"] .velvetskin-add-to-cart').hasClass('velvetskin-btn-addcart-view') || $('.product-loop-ldpage .product-block[data-id="'+id+'"] .add-to-cart').hasClass('btn-addcart-view')){					
					VelvetSkin.ProductLoop.VelvetSkin_renderQuickview(prolink,proId,proTitle)	
				}
				else{
					jQuery.ajax(params);
				}
			}
		} 
		else{
			var min_qty = 1;
			var variant_id = $(this).attr('data-variantid');
			$('.velvetskin-product-actions[data-vrid='+id+'] .velvetskin-btn-proloop-cart').addClass('velvetskin-btnload');
			var params = {
				type: 'POST',
				url: '/cart/add.js',
				async: true,
				data:'quantity=' + min_qty + '&id=' + id,
				dataType: 'json',
				success: function(line_item) {
					if (template.indexOf('cart') > -1) {
						window.location.reload();
					} else {
						var image = '';
						if(line_item['image'] == null){ 
							image = 'https://hstatic.net/0/0/global/noDefaultImage6.gif';
						}
						else{
							image = Haravan.resizeImage(line_item['image'], 'small');
						}
						var $info = '<div class="row"><div class="col-md-12 col-xs-12"><p class="jGowl-text">Đã thêm vào giỏ hàng thành công!</p></div><div class="col-md-4 col-xs-4"><a href="' + line_item['url'] + '"><img width="70px" src="' + image + '" alt="' + line_item['title'] + '"/></a></div><div class="col-md-8 col-xs-8"><div class="jGrowl-note"><a class="jGrowl-title" href="' + line_item['url'] + '">' + line_item['title'] +  '</a><ins>' + Haravan.formatMoney(line_item['price'], formatMoney) + '</ins></div></div></div>';
						HRVTheme.General.notifyProduct($info);
						$('.velvetskin-product-actions[data-vrid="'+id+'"] .velvetskin-product-value').val(line_item.quantity);
						VelvetSkin.Cart.VelvetSkin_getCartModal(false);
					}

					setTimeout(function(){
						$('.velvetskin-product-actions[data-vrid='+id+']').addClass('action-count');
						$('.velvetskin-product-actions[data-vrid='+id+'] .btn-proloop-cart').removeClass('btnload');
					},400);
				},
				error: function(XMLHttpRequest, textStatus) {
					Haravan.onError(XMLHttpRequest, textStatus);
				}
			};
			if($('.velvetskin-product-loop[data-id="'+id+'"] .velvetskin-add-to-cart').hasClass('velvetskin-btn-addcart-view') || $('.product-loop-ldpage .product-block[data-id="'+id+'"] .add-to-cart').hasClass('btn-addcart-view')){					
				VelvetSkin.ProductLoop.VelvetSkin_renderQuickview(prolink,proId,proTitle)	
			}
			else{
				jQuery.ajax(params);
			}
		}
	},
  VelvetSkin_slideProdQuickview: async function () {
    var qvThumbSlider = new Swiper('#quickview-thumbproduct.swiper', {
      spaceBetween: 10,
      slidesPerView: 6,
      freeMode: true,
      watchSlidesProgress: true,
      breakpoints: {
          0: { slidesPerView: 10, spaceBetween: 7 },
          768: { slidesPerView: 6 },
          992: { slidesPerView: 6 },
          1200: { slidesPerView: 6 }
      }
    });
    var qvSlider = new Swiper('#quickview-sliderproduct.swiper', {
        slidesPerView: 1,
        speed: 500,
        loop: false,
        navigation: {
            nextEl: '#quickview-sliderproduct .swiper-button-next',
            prevEl: '#quickview-sliderproduct .swiper-button-prev',
        },
        pagination: {
            el: '#quickview-sliderproduct .swiper-pagination',
            clickable: true,
        },
        breakpoints: {
            768: {
                pagination: false
            }
        },
        thumbs: {
            swiper: qvThumbSlider
        }
    });

  },
  VelvetSkin_renderQuickview: function(url,id,title,preorder){
		jQuery.ajax({ 
			type: 'GET',
			url: url+(url.indexOf('?') > -1?'&':'?')+"view=se-quickview",
			async: false,
			success:function(data){
				htmlQv = data;	
				if(preorder != undefined && preorder == true){
					$('#velvetskin-quick-view-modal').addClass('has-preorder');
				}else{
					$('#velvetskin-quick-view-modal').removeClass('has-preorder');
				}
				$('#velvetskin-quick-view-modal .velvetskin-wrapper-quickview').html(htmlQv);	
				$('#velvetskin-quick-view-modal').modal("show");
				setTimeout(function(){	
					VelvetSkin.ProductLoop.VelvetSkin_slideProdQuickview();	
					//VelvetSkin.ProductLoop.VelvetSkin_submitPreorderQv(url);
					if(htmlQvApp != '' && htmlQvApp != undefined){
						if(promotionApp_name != 'app_combo'){
							if($('#velvetskin-quick-view-modal .q-selector-buyxgety').hasClass('d-none') && htmlQvApp != '' && $('#velvetskin-quick-view-modal .q-selector-buyxgety .buyxgety_lists').html() == ''){
								$('#velvetskin-quick-view-modal .q-selector-buyxgety .buyxgety_lists').append(htmlQvApp);
								$('#velvetskin-quick-view-modal .q-selector-buyxgety').removeClass('d-none');
							}
						}
					}
				},800);	
				if(htmlQvApp != '' && htmlQvApp != undefined){
					if(promotionApp_name == 'app_combo'){
						if($('#velvetskin-quick-view-modal .combo-info').hasClass('d-none') && htmlQvApp != ''){
							$('#velvetskin-quick-view-modal .combo-info').append(htmlQvApp).removeClass('d-none');
						}
					}
				}	
			}
		});
	},
