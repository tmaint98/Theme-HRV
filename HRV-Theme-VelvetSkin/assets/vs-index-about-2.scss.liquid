$colorAbout2: {{settings.velvetskin_index_about2_main}};
.velvetskin-index-about-2{
  padding: 80px 0;
  .heading-title{
    margin-bottom: 0;
    .title1{
      color: $colorAbout2;
    }
    .desc{
      margin-top: 20px;
    }
  }
  .btn-more{
    margin-top: 40px;
  }
  .about-banner{
    img{
      border-radius: 10px;
    }
  }
  @media(min-width: 1200px){
    .about-content{
      padding: 0 60px;
    }
  }
  @media(max-width: 991px){
    .row{
      flex-flow: column-reverse;
      gap: 40px;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
    .row{
      gap: 30px;
    }
    .btn-more{
      margin-top: 20px;
    }
  }
}
