$colorText: {{ settings.shop_text_color }};
.velvetskin-index-collection {
  padding: 80px 0;
  .heading-title {
    .title1 {
      color: var(--color);
    }
  }
  .list-pro {
    gap: 15px;
  }
  .btn-more {
    margin-top: 40px;
  }
  .product-item {
    flex: 0 0 auto;
    width: calc(100% / 4 - 11.25px);
    padding: 10px;
    border-radius: 10px;
    position: relative;
     &:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--color);
      border-radius: 10px;
      opacity: 0.08;
    }
    /*.velvetskin-product-loop .velvetskin-proloop-detail .velvetskin-wrapper-action-loop .velvetskin-btn-proloop-cart {
      border-color: rgba($colorText, 0.1);
       &:before {
        background: rgba($colorText, 0.5);
        filter: invert(1);
      }
    }*/
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .list-pro {
      gap: 10px;
      margin: 0;
    }
    .product-item {
      width: calc(50% - 5px);
    }
    .btn-more {
      margin-top: 20px;
    }
  }
}