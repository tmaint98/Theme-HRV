{%- unless has_heading -%}
  <link rel="preload" href="{{ 'sv-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'sv-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{%- endunless -%}
<link rel="preload" href="{{ 'sv-index-about-1.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'sv-index-about-1.scss.css' | asset_url }}">

<div class="streetvibe-index-about-1 streetvibe-index-ajax" id="sv-index-about-1">
  {%comment%}<div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 col-12">
        <div class="about-content">
          <div class="heading-title">
            {%if settings.streetvibe_index_about_1_title_1 != empty %}<div class="title1">{{settings.streetvibe_index_about_1_title_1}}</div>{%endif%}
            {%if settings.streetvibe_index_about_1_title_2 != empty %}<h2 class="title2">{{settings.streetvibe_index_about_1_title_2 | newline_to_br}}</h2>{%endif%}
            {%if settings.streetvibe_index_about_1_desc != empty %}<div class="desc">{{settings.streetvibe_index_about_1_desc}}</div>{%endif%}
          </div>
          {%if settings.streetvibe_index_about_1_btn != empty%}
            <div class="btn-more">
              <a href="{{settings.streetvibe_index_about_1_link}}" class="button">{{settings.streetvibe_index_about_1_btn}}</a>
            </div>
          {%endif%}
        </div>
      </div>
      <div class="col-lg-6 col-12">
        <div class="about-banner">
          <div class="banner-img"><img src="{{ 'streetvibe_index_about_1_img_1.jpg' | asset_url}}" alt="{{settings.streetvibe_index_about_1_title_2 | strip_newlines | strip_html}}" /></div>
          <div class="banner-img"><img src="{{ 'streetvibe_index_about_1_img_2.jpg' | asset_url}}" alt="{{settings.streetvibe_index_about_1_title_2 | strip_newlines | strip_html}}" /></div>
        </div>
      </div>
    </div>
  </div>{%endcomment%}
</div>