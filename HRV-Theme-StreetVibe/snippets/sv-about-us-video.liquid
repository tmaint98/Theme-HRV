{% if settings.show_streetvibe_about_us_video%}
<link rel="preload" href="{{ 'sv-about-us-video.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'sv-about-us-video.scss.css' | asset_url }}">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'sv-about-us-video.js' | asset_url }}"></script>

<div class="streetvibe-about-us-video">
    <div class="video-banner">
      <img src="{{ 'streetvibe_about_us_video_img.jpg' | asset_url }}" alt="{{settings.streetvibe_about_us_video_title_2}}" />
    </div>
  <div class="video-content">
    <div class="container">
      {%if settings.streetvibe_about_us_video_title_2 %}<h2 class="title2">{{settings.streetvibe_about_us_video_title_2}}</h2>{%endif%}
      {%if settings.streetvibe_about_us_video_title_1 %}<div class="title1">{{settings.streetvibe_about_us_video_title_1}}</div>{%endif%}
      <div class="video-play">
        <a class="icon-play" href="https://www.youtube.com/watch?v={{settings.streetvibe_about_us_video_id}}">
          <svg width="30px" height="30px" viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.79062 2.09314C4.63821 1.98427 4.43774 1.96972 4.27121 2.05542C4.10467 2.14112 4 2.31271 4 2.5V12.5C4 12.6873 4.10467 12.8589 4.27121 12.9446C4.43774 13.0303 4.63821 13.0157 4.79062 12.9069L11.7906 7.90687C11.922 7.81301 12 7.66148 12 7.5C12 7.33853 11.922 7.18699 11.7906 7.09314L4.79062 2.09314Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
  </div>
{%endif%}