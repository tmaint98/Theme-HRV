$colorVideo: {{ settings.streetvibe_index_video_color }};
.streetvibe-index-video {
  position: relative;
  color: $colorVideo;
  .video-box {
    display: flex;
    iframe {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
  .video-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.2);
    padding-top: 8%;
    .title {
      font-size: 140px;
      margin: 0;
    }
    .desc {
      font-size: 18px;
      font-weight: 600;
    }
  }
  @media(max-width: 767px) {
    .video-content {
      padding-top: 5%;
      .title {
        font-size: 50px;
      }
      .desc {
        font-size: 14px;
      }
    }
  }
}