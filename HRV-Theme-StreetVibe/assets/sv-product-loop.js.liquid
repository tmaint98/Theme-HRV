  StreetVibe_addCartProdItem: function(id){
		var prolink = $('.streetvibe-product-loop[data-id="'+id+'"] .streetvibe-proloop-image .streetvibe-product-link').attr('href');	
		var proId = $('.streetvibe-product-loop[data-id="'+id+'"] .streetvibe-product-inner').attr('data-proid');
		var proTitle = $('.streetvibe-product-loop[data-id="'+id+'"] .streetvibe-proloop-detail h3 a').html();
		if (template.indexOf('page.landing-page-01') > -1) {
			prolink = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .streetvibe-proloop-image .streetvibe-product-link').attr('href');	
			proId = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .streetvibe-proloop-image').attr('data-proid');
			proTitle = $('.product-loop-ldpage .product-block[data-id="'+id+'"] .streetvibe-proloop-detail h3 a').html();
		}
		if(promotionApp){
			if(!$('.streetvibe-product-loop[data-id="'+id+'"]').find('.gift.product_gift_label').hasClass('d-none') && !$('.product-loop-ldpage .product-block[data-id="'+id+'"]').find('.gift.product_gift_label').hasClass('d-none')){
				//	window.location.href = $('.streetvibe-product-loop[data-id="'+id+'"]').find('a').attr('href') || $('.prodloop-block[data-id="'+id+'"]').find('a').attr('href');
				StreetVibe.ProductLoop.StreetVibe_renderQuickview(prolink,proId,proTitle);	
				setTimeout(function() {$('.modal-product-quickview .product-promotion').show();},150);
			}
			else{
				var min_qty = 1;
				var variant_id = $(this).attr('data-variantid');
				var params = {
					type: 'POST',
					url: '/cart/add.js',
					async: true,
					data:'quantity=' + min_qty + '&id=' + id,
					dataType: 'json',
					success: function(line_item) {
						if (template.indexOf('cart') > -1) {
							window.location.reload();
						} else {
							var image = '';
							if(line_item['image'] == null){ 
								image = 'https://hstatic.net/0/0/global/noDefaultImage6.gif';
							}
							else{
								image = Haravan.resizeImage(line_item['image'], 'small');
							}
							var $info = '<div class="row"><div class="col-md-12 col-xs-12"><p class="jGowl-text">Đã thêm vào giỏ hàng thành công!</p></div><div class="col-md-4 col-xs-4"><a href="' + line_item['url'] + '"><img width="70px" src="' + image + '" alt="' + line_item['title'] + '"/></a></div><div class="col-md-8 col-xs-8"><div class="jGrowl-note"><a class="jGrowl-title" href="' + line_item['url'] + '">' + line_item['title'] +  '</a><ins>' + Haravan.formatMoney(line_item['price'], formatMoney) + '</ins></div></div></div>';
							HRVTheme.General.notifyProduct($info);
							$('.streetvibe-product-actions[data-vrid="'+id+'"] .streetvibe-product-value').val(line_item.quantity);
							StreetVibe.Cart.StreetVibe_getCartModal(false);
						}
						$('.streetvibe-product-actions[data-vrid='+id+']').addClass('streetvibe-action-count');
					},
					error: function(XMLHttpRequest, textStatus) {
						Haravan.onError(XMLHttpRequest, textStatus);
					}
				};
				if($('.streetvibe-product-loop[data-id="'+id+'"] .streetvibe-add-to-cart').hasClass('streetvibe-btn-addcart-view') || $('.product-loop-ldpage .product-block[data-id="'+id+'"] .add-to-cart').hasClass('btn-addcart-view')){					
					StreetVibe.ProductLoop.StreetVibe_renderQuickview(prolink,proId,proTitle)	
				}
				else{
					jQuery.ajax(params);
				}
			}
		} 
		else{
			var min_qty = 1;
			var variant_id = $(this).attr('data-variantid');
			$('.streetvibe-product-actions[data-vrid='+id+'] .streetvibe-btn-proloop-cart').addClass('streetvibe-btnload');
			var params = {
				type: 'POST',
				url: '/cart/add.js',
				async: true,
				data:'quantity=' + min_qty + '&id=' + id,
				dataType: 'json',
				success: function(line_item) {
					if (template.indexOf('cart') > -1) {
						window.location.reload();
					} else {
						var image = '';
						if(line_item['image'] == null){ 
							image = 'https://hstatic.net/0/0/global/noDefaultImage6.gif';
						}
						else{
							image = Haravan.resizeImage(line_item['image'], 'small');
						}
						var $info = '<div class="row"><div class="col-md-12 col-xs-12"><p class="jGowl-text">Đã thêm vào giỏ hàng thành công!</p></div><div class="col-md-4 col-xs-4"><a href="' + line_item['url'] + '"><img width="70px" src="' + image + '" alt="' + line_item['title'] + '"/></a></div><div class="col-md-8 col-xs-8"><div class="jGrowl-note"><a class="jGrowl-title" href="' + line_item['url'] + '">' + line_item['title'] +  '</a><ins>' + Haravan.formatMoney(line_item['price'], formatMoney) + '</ins></div></div></div>';
						HRVTheme.General.notifyProduct($info);
						$('.streetvibe-product-actions[data-vrid="'+id+'"] .streetvibe-product-value').val(line_item.quantity);
						StreetVibe.Cart.StreetVibe_getCartModal(false);
					}

					setTimeout(function(){
						$('.streetvibe-product-actions[data-vrid='+id+']').addClass('action-count');
						$('.streetvibe-product-actions[data-vrid='+id+'] .btn-proloop-cart').removeClass('btnload');
					},400);
				},
				error: function(XMLHttpRequest, textStatus) {
					Haravan.onError(XMLHttpRequest, textStatus);
				}
			};
			if($('.streetvibe-product-loop[data-id="'+id+'"] .streetvibe-add-to-cart').hasClass('streetvibe-btn-addcart-view') || $('.product-loop-ldpage .product-block[data-id="'+id+'"] .add-to-cart').hasClass('btn-addcart-view')){					
				StreetVibe.ProductLoop.StreetVibe_renderQuickview(prolink,proId,proTitle)	
			}
			else{
				jQuery.ajax(params);
			}
		}
	},
  StreetVibe_slideProdQuickview: async function () {
    var qvThumbSlider = new Swiper('#quickview-thumbproduct.swiper', {
      spaceBetween: 10,
      slidesPerView: 6,
      freeMode: true,
      watchSlidesProgress: true,
      breakpoints: {
          0: { slidesPerView: 10, spaceBetween: 7 },
          768: { slidesPerView: 6 },
          992: { slidesPerView: 6 },
          1200: { slidesPerView: 6 }
      }
    });
    var qvSlider = new Swiper('#quickview-sliderproduct.swiper', {
        slidesPerView: 1,
        speed: 500,
        loop: false,
        navigation: {
            nextEl: '#quickview-sliderproduct .swiper-button-next',
            prevEl: '#quickview-sliderproduct .swiper-button-prev',
        },
        pagination: {
            el: '#quickview-sliderproduct .swiper-pagination',
            clickable: true,
        },
        breakpoints: {
            768: {
                pagination: false
            }
        },
        thumbs: {
            swiper: qvThumbSlider
        }
    });

  },
  StreetVibe_renderQuickview: function(url,id,title,preorder){
		jQuery.ajax({ 
			type: 'GET',
			url: url+(url.indexOf('?') > -1?'&':'?')+"view=sv-quickview",
			async: false,
			success:function(data){
				htmlQv = data;	
				if(preorder != undefined && preorder == true){
					$('#streetvibe-quick-view-modal').addClass('has-preorder');
				}else{
					$('#streetvibe-quick-view-modal').removeClass('has-preorder');
				}
				$('#streetvibe-quick-view-modal .streetvibe-wrapper-quickview').html(htmlQv);	
				$('#streetvibe-quick-view-modal').modal("show");
				setTimeout(function(){	
					StreetVibe.ProductLoop.StreetVibe_slideProdQuickview();	
					//StreetVibe.ProductLoop.StreetVibe_submitPreorderQv(url);
					if(htmlQvApp != '' && htmlQvApp != undefined){
						if(promotionApp_name != 'app_combo'){
							if($('#streetvibe-quick-view-modal .q-selector-buyxgety').hasClass('d-none') && htmlQvApp != '' && $('#streetvibe-quick-view-modal .q-selector-buyxgety .buyxgety_lists').html() == ''){
								$('#streetvibe-quick-view-modal .q-selector-buyxgety .buyxgety_lists').append(htmlQvApp);
								$('#streetvibe-quick-view-modal .q-selector-buyxgety').removeClass('d-none');
							}
						}
					}
				},800);	
				if(htmlQvApp != '' && htmlQvApp != undefined){
					if(promotionApp_name == 'app_combo'){
						if($('#streetvibe-quick-view-modal .combo-info').hasClass('d-none') && htmlQvApp != ''){
							$('#streetvibe-quick-view-modal .combo-info').append(htmlQvApp).removeClass('d-none');
						}
					}
				}	
			}
		});
	},
