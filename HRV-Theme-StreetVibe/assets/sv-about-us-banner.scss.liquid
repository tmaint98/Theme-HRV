$colorAboutBanner: {{settings.streetvibe_about_us_banner_color}};
.streetvibe-about-us-banner{
  position: relative;
  color: $colorAboutBanner;
  .banner-content{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
}