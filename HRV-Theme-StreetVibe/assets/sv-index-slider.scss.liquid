$colorSlide: {{ settings.streetvibe_index_slider_color }};
$bgBtn: {{ settings.streetvibe_index_slider_button }};
$colorBtn: {{ settings.streetvibe_index_slider_button_text }};

@keyframes slide_content {
  from {
    transform: translateY(110%);
  }
  to {
    transform: translateY(0);
  }
}
@keyframes slide_btn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.streetvibe-index-slider {
  a {
    color: $colorSlide;
    text-decoration: none;
    outline: none;
    -moz-transition: all 0.3s ease-in-out;
    -o-transition: all 0.3s ease-in-out;
    -webkit-transition: all 0.3s ease-in-out;
    transition: all 0.3s ease-in-out;
     &:hover {
      text-decoration: none;
    }
  }
  img {
    max-width: 100%;
    vertical-align: middle;
    border-style: none;
  }
  .button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-block;
    padding: 10px 25px;
    line-height: normal;
    color: $colorBtn;
    background-color: $bgBtn;
    border: 0;
    border-radius: 0;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 1px;
    outline: none !important;
    -webkit-transition: all 0.45s;
    transition: all 0.45s;
     &:before {
      content: '';
      background-color: rgba($colorBtn, 0.2);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      z-index: -1;
      transition: all 0.4s ease-in-out;
    }
    @media(min-width: 992px) {
       &:hover,
      &.has-hover,
       &:focus {
        border-color: transparent;
      }
       &:hover:before,
       &.has-hover:before,
       &:focus:before {
        opacity: 1;
      }
    }
    @media(max-width: 767px) {
      font-size: 12px;
      padding: 8px 15px;
      min-height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  .index-slider {
    padding: 0;
  }
  .slider-item {
    position: relative;
    .slide--content {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: $colorSlide;
      padding-top: 10%;
      .content {
        max-width: 90%;
        margin: 0 auto;
      }
      .title1,
      .title2,
      .desc {
        position: relative;
        overflow: hidden;
        .text-ani {
          display: inline-block;
          transform: translateY(110%);
          line-height: 1.5;
        }
      }
      .title1 {
        font-size: 12px;
        margin-bottom: 20px;
      }
      .title2 {
        font-size: 70px;
        margin-bottom: 20px;
      }
      .desc {
        font-size: 18px;
        font-weight: 600;
        margin-top: 20px;
      }
      .btn-more {
        margin-top: 30px;
        display: flex;
        flex-flow: wrap;
        justify-content: center;
        gap: 10px 20px;
        .button {
          opacity: 0;
        }
      }
    }
  }
  .swiper {
    .swiper-slide{
      &.swiper-slide-active {
      .title1,
      .title2,
      .desc {
        .text-ani {
          animation: slide_content 0.5s forwards 0.2s ease-out;
        }
      }
      .btn-more {
        .button {
          animation: slide_btn 0.5s forwards 0.5s ease-out;
        }
      }
      }
    }
    .swiper-nav {
      position: absolute;
      top: calc(50% - 23px);
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: none;
      outline: none;
      color: $colorSlide;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      svg {
        width: 20px;
        height: 20px;
        fill: currentcolor;
        polyline,
        line {
          stroke: currentcolor;
        }
      }
      &.swiper-next {
        right: 15px;
      }
      &.swiper-prev {
        left: 15px;
      }
       &:hover {
        background: rgba($colorSlide, 0.2);
      }
    }
    .swiper-pagination{
      .swiper-pagination-bullet{
        background: $colorSlide;
      }
    }
  }
