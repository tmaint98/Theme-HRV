          max-width: 100%;
          margin: 0;
        }
        .title2{
          font-size: 120px;
        }
        .btn-more {
          justify-content: start;
        }
      }
    }
  }*/
  
  /*@media(max-width: 1199px){
    .swiper-slide,
    .slider-item {
       &[data-swiper-slide-index="0"] {
        .slide--content {
          left: 5%;
          width: 90%;
          .title2{
            font-size: 50px;
          }
        }
      }
    }
  }*/
  @media(max-width: 1199px) and (min-width: 768px) {
    .slider-item .slide--content .title {
      font-size: 58px;
    }
  }
  @media(max-width: 767px) {
    .slider-item {
      .slide--content {
        .title2,
        .desc {
          br {
            content: '';
             &:after {
              content: ' ';
            }
          }
        }
        .title2 {
          font-size: 35px;
        }
        .desc {
          font-size: 14px;
        }
      }
    }
    .swiper {
      .swiper-nav {
        top: calc(50% - 20px);
        width: 40px;
        height: 40px;
        background: rgba($colorSlide, 0.2);
        &.swiper-next {
          right: 5px;
        }
        &.swiper-prev {
          left: 5px;
        }
      }
    }
  }
}

.hrv-pus-promotion:empty,
.section-home-pus-promotion:empty,
.hrv-pmo-discount:empty,
.hrv-pmo-coupon:empty,
.section-home-hrvpmo:empty {
  padding: 0;
}