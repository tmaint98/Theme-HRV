$colorReview: {{ settings.streetvibe_index_review_color }};
@keyframes review_content {
  from {
    transform: translateX(40px);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}
.streetvibe-index-review {
  padding: 60px 0;
  color: $colorReview;
  .review-item {
    .row {
      margin: 0;
      gap: 30px;
    }
    .btn-link {
      color: $colorReview;
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb,currentColor 40%,transparent);
      margin-top: 15px;
      display: inline-block;
       &:hover {
        text-decoration-color: $colorReview;
      }
    }
    .review-content {
      .text-ani {
        display: inline-block;
        transform: translateX(40px);
        opacity: 0;
      }
      .title {
        font-size: 12px;
        opacity: 0.8;
      }
      .desc {
        font-size: 28px;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 20px;
      }
      .name {
        opacity: 0.8;
      }
      .review-star {
        margin: 15px 0;
      }
    }
  }
  .swiper-slide.swiper-slide-active {
    .review-item {
      .review-content {
        .desc {
          .text-ani {
            animation: review_content 0.3s forwards 0.6s ease-out;
          }
        }
        .name {
          .text-ani {
            animation: review_content 0.5s forwards 0.6s ease-out;
          }
        }
        .review-star {
          .text-ani {
            animation: review_content 0.1s forwards 0.6s ease-out;
          }
        }
      }
    }
  }
  .swiper-nav {
    position: absolute;
    bottom: 35px;
    width: 35px;
    height: 35px;
    opacity: 0.8;
    z-index: 2;
    cursor: pointer;
    svg {
      fill: currentcolor;
    }
    &.swiper-prev {
      left: 0;
    }
    &.swiper-next {
      left: 45px;
    }
  }
  @media(min-width: 992px) {
    .review-item {
      .row {
        > div {
          flex: 0 0 auto;
          width: calc(50% - 15px);
        }
      }
      .review-content {
        padding: 50px 30px 30px 0;
      }
      .review-banner {
        padding-left: 80px;
      }
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .review-item .review-content .desc {
      font-size: 20px;
    }
    .swiper {
      padding-bottom: 40px;
    }
    .swiper-nav {
      bottom: -10px;
    }
  }
}