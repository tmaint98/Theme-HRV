$bgVideo: {{ settings.streetvibe_about_us_video_2_bg }};
$colorVideo: {{ settings.streetvibe_about_us_video_2_color }};

.streetvibe-about-us-video-2 {
  position: relative;
  background: $bgVideo;
  color: $colorVideo;
  padding: 60px 0;
  .video-box {
    display: flex;
    position: relative;
    &:before{
      content: '';
      position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.2);
      opacity: 0;
    }
    iframe {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
  @media(min-width: 1200px){
    .heading-title{
      padding: 0 100px;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
  }
}