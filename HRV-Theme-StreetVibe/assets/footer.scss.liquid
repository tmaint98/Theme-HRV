$bgFt: {{ settings.streetvibe_footer_bg }};
$colorFt: {{ settings.streetvibe_footer_color }};
$bgFtBtn: {{ settings.streetvibe_footer_bg_btn }};
$colorFtBtn: {{ settings.streetvibe_footer_color_btn }};

.streetvibe-mainFooter {
  background-color: $bgFt;
  color: rgba($colorFt, 0.8);
  padding-top: 80px;
  a {
    color: $colorFt;
  }
  h2 a {
    color: $colorFt;
  }
  .streetvibe-ft-logo {
    img {
      max-height: 60px;
      margin-bottom: 20px;
    }
  }
  .streetvibe-widget-footer {
    .streetvibe-title-footer,
    .streetvibe-fter-title {
      position: relative;
      margin-bottom: 30px;
      font-weight: 600;
      color: $colorFt;
      font-size: 20px;
      letter-spacing: 1px;
      @media(max-width: 991px) {
        border-bottom: 1px dashed rgba($colorFt, 0.3);
        margin: 0;
        padding: 15px 0;
         &:not(.streetvibe-fter-title):before {
          content: "\f107";
          font-family: "FontAwesome";
          position: absolute;
          top: 12px;
          right: 10px;
          text-align: center;
          font-size: 22px;
          transition: all 0.4s ease-in-out 0s;
          -moz-transition: all 0.4s ease-in-out 0s;
          -o-transition: all 0.4s ease-in-out 0s;
          -webkit-transition: all 0.4s ease-in-out 0s;
          -ms-transition: all 0.4s ease-in-out 0s;
        }
        &.opened {
          font-weight: 700;
        }
         &.opened:before {
          -moz-transform: rotate(-180deg);
          -webkit-transform: rotate(-180deg);
          -o-transform: rotate(-180deg);
          -ms-transform: rotate(-180deg);
          transform: rotate(-180deg);
        }
      }
      @media(max-width: 767px) {
        font-size: 15px;
      }
    }
    .desc {
      margin: 0;
    }
    .desc-newsletter {
      margin-bottom: 20px;
    }
  }
  .streetvibe-footer-newsletter {
    .streetvibe-newsletter-form {
      .streetvibe-newsletter-input {
        background: rgba($colorFt, 0.1);
        border: none;
        outline: none;
        border-radius: 0;
        color: $colorFt;
        &::-webkit-input-placeholder {
          color: $colorFt !important;
        }
        &::-moz-placeholder {
          color: $colorFt !important;
        }
         &:-moz-placeholder {
          color: $colorFt !important;
        }
      }
      .contact-form .input-group {
        flex-flow: nowrap;
        gap: 5px;
        input {
          font-size: 14px;
        }
      }
      .btn-more .btn-icon {
        border: none;
        outline: none;
        padding: 0 20px;
        height: 100%;
        display: flex;
        align-items: center;
        background: $bgFtBtn;
        color: $colorFtBtn;
        svg {
          fill: currentcolor;
        }
         &:hover {
          opacity: 0.8;
        }
      }
    }
  }
  .streetvibe-logo-footer {
    margin-top: 20px;
  }
  .streetvibe-footerNav-social {
    display: flex;
    flex-flow: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    i,
    svg {
      width: 36px;
      height: 36px;
      line-height: 34px;
      font-size: 19px;
      text-align: center;
      border: 1px solid;
      border-radius: 50%;
      -webkit-transition: all 0.2s ease;
      -moz-transition: all 0.2s ease;
      transition: all 0.2s ease;
    }
    .social-svg {
      svg {
        padding: 6px;
        fill: currentColor;
      }
      &.svg-lazada {
        svg path {
          stroke: currentColor;
        }
      }
    }
  }
  .streetvibe-address-footer {
    margin-bottom: 20px;
    li {
      margin-bottom: 10px;
      i {
        width: 20px;
      }
    }
  }
  .streetvibe-footer-link {
    li ~ li {
      margin-top: 10px;
    }
    a {
      color: rgba($colorFt, 0.8);
    }
  }
  .streetvibe-footer-copyright {
    margin-top: 40px;
    padding: 35px 0;
    border-top: 1px solid rgba($colorFt, 0.1);
    p {
      margin: 0;
    }
  }
  .streetvibe-footer-payment{
    display: flex;
    flex-flow: wrap;
    align-items: center;
    justify-content: end;
    gap: 5px;
    .payment-item{
      img{
        max-height: 30px;
      }
    }
  }
  @media(min-width: 992px) {
    .streetvibe-footer-about {
      padding-right: 40px;
    }
    .streetvibe-footer-newsletter {
      .streetvibe-newsletter-title h3 {
        margin: 0;
      }
      .streetvibe-newsletter-form {
        .contact-form .input-group {
          margin: 0;
        }
      }
    }
  }
  @media(max-width: 991px) {
    &.has-toolbar {
      padding-bottom: 45px;
    }
    .streetvibe-widget-footer {
       &:last-child {
        .streetvibe-title-footer {
          border: none;
        }
        .streetvibe-content-footer {
          border-top: 1px dashed rgba($colorFt, 0.3);
        }
      }
      .streetvibe-block-collapse {
        display: none;
        padding: 15px 0;
      }
    }
    .streetvibe-footer-newsletter {
      .streetvibe-newsletter-title h3 {
        font-size: 30px;
        margin-bottom: 20px;
      }
    }
    .streetvibe-footer-copyright {
      margin-top: 25px;
      padding: 25px 0;
      text-align: center;
      > .row {
        gap: 15px;
      }
      .streetvibe-footer-link {
        justify-content: center;
      }
    }
    .streetvibe-footer-payment{
      justify-content: center;
      .payment-item img{
        max-height: 25px;
      }
    }
  }
  @media(max-width: 767px) {
    padding-top: 50px;
    .streetvibe-footer-about .title {
      font-size: 26px;
      br {
        content: '';
         &:after {
          content: ' ';
        }
      }
    }
    .streetvibe-footer-newsletter {
      .streetvibe-newsletter-title h3 {
        font-size: 22px;
      }
    }
  }
}