$colorAboutVideo: {{ settings.streetvibe_about_us_video_color }};
.streetvibe-about-us-video {
  padding: 0;
  position: relative;
  color: $colorAboutVideo;
  .video-banner {
    text-align: center;
     &:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.2);
    }
  }
  .video-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    .title1 {
      font-size: 18px;
      margin-bottom: 30px;
    }
    .title2 {
      font-size: 100px;
      margin-bottom: 20px;
    }
  }
  .video-play {
    .icon-play {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      border: 4px solid;
      color: $colorAboutVideo;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      transform: scale(0.9);
      transition: all 0.3s;
      svg {
        fill: currentcolor;
        width: 40px;
        height: 40px;
      }
       &:hover {
        transform: scale(1);
      }
    }

  }
  @media(max-width: 767px) {
    .video-content {
      .title1 {
        font-size: 16px;
        margin-bottom: 20px;
      }
      .title2 {
        font-size: 35px;
        margin-bottom: 10px;
      }
    }
    .video-play {
      .icon-play {
        width: 50px;
        height: 50px;
        svg {
          width: 20px;
          height: 20px;
        }
      }
    }
  }
}