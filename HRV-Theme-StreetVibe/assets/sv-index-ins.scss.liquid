$colorIns: {{ settings.streetvibe_index_ins_color }};
.streetvibe-index-ins {
  position: relative;
  color: $colorIns;
  .heading-title {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 30px;
    margin: 0;
    .title2 {
      margin: 0;
      a {
        color: $colorIns;
      }
    }
  }
  .list-img {
    margin: 0;
    justify-content: center;
    .item-img {
      flex: 0 0 auto;
      width: 25%;
      position: relative;
      &:before{
        content: '';
        position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
        background: rgba(0, 0, 0, 0.2);
      }
    }
  }
  @media(max-width: 991px) {
    .heading-title {
      padding: 15px;
    }
    .list-img {
      flex-flow: nowrap;
      justify-content: start;
      overflow-x: scroll;
      .item-img {
        width: 80%;
      }
    }
  }
}