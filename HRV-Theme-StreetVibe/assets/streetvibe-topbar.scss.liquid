$bgTopbar: {{ settings.streetvibe_topbar_bg }};
$colorTopbar: {{ settings.streetvibe_topbar_color }};
.streetvibe-topbar {
  padding: 8px 15px;
  background: $bgTopbar;
  color: $colorTopbar;
  display: flex;
  align-items: center;
  gap: 20px;
  font-size: 14px;
  .topbar-left,.topbar-right{
    flex: 0 0 auto;
    width: 20%;
  }
  .topbar-center{
    flex: 0 0 auto;
    width: calc(60% - 40px);
  }
  .topbar-right{
    text-align: right;
  }
  .streetvibe-social {
    display: flex;
    align-items: center;
    gap: 6px;
    >li{
      svg{
        width: 20px;
        height: 20px;
        fill: $colorTopbar;
      }
      &.svg-tiktok{
        svg{
          width: 22px;
          height: 22px;
        }
      }
      &.svg-shopee{
        svg{
          margin-top: -2px;
        }
      }
      &.svg-lazada{
        svg{
          stroke: $colorTopbar;
        }
      }
    }
  }
  .streetvibe-topbar-slide {
    .slide-item {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 15px;
      a {
        text-decoration: underline;
        color: $colorTopbar;
      }
    }
  }
  .topbar-countdown {
    position: relative;
    flex: 0 0 auto;
    &:before{
      content: '';
      position: absolute;
      top: -2px;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba($colorTopbar, 0.1);
    }
    &.soon[data-scale='m'] {
      font-size: 14px;
    }
    &.soon[data-layout*=group] {
      padding: 2px 0; 
    }
    &.soon[data-layout*=label-small] .soon-label {
      font-size: 9px;
    }
    &.soon[data-layout*=group][data-layout*=tight] .soon-group-sub > .soon-group-inner {
      position: relative;
      margin-right: 15px;
      .soon-text {
        position: absolute;
        top: 0;
        right: 2px;
        line-height: 0.7;
      }
    }
  }
  @media(max-width: 991px){
    .topbar-left,.topbar-right{
      display: none;
    }
    .topbar-center{
      width: 100%;
    }
  }
  @media(max-width: 767px){
    font-size: 12px;
    .topbar-countdown {
      &.soon[data-scale='m'] {
        font-size: 12px;
      }
    }
  }
}


/*----- Translate ------*/
body{
  top: 0 !important;
}
.skiptranslate {
  display: none;
 /* width: 0;
  height: 0;
  opacity: 0;*/
}
.streetvibe-translate-wrapper {
  position: relative;  
  cursor: pointer;
  .language-text{font-size: 12px;}
  .streetvibe-translate-dropdown-wrapper {
     position: absolute;
    right: 0;z-index: 9;
    padding-top: 12px;
    margin-top: -12px;
    width: 100%;max-width: 130px;
    transition: .3s all;
    opacity: 0;visibility: hidden;
    pointer-events: none;
    .streetvibe-translate-dropdown {
      overflow-y: auto;
      font-size: 12px;
      scroll-padding: .5rem 0;
      width: 100%;
      min-width: 105px;
      background-color: #fff;
      color: #333;
      text-align: left;
      z-index: 99;
      left: 0;
      box-shadow: 0px 7px 18px rgba(0,0,0,0.2);
      .js-language-select{
        .flag{
          svg{width: 14px;height: 14px;}
        }
      }
      a {
        display: block;
        padding: 5px 8px;
        transition: .3s all;
        background-color: transparent;
        &:hover {
          background-color: rgba($colorTopbar, 0.1);
        }
      }
      
    }
  }
  .icon-svg {
    --icon-height: 12px;
    --icon-width: 12px;
  }
  &:hover,
  &.active {
    .streetvibe-translate-dropdown-wrapper {
      opacity: 1;visibility: visible;
      pointer-events: auto;
    }
    .icon-svg {
      transform: rotate(-180deg);
    }
  }
}
@media(max-width: 991px){
  .streetvibe-header-action_translate{
    display: none;
  }
}
/*----- END Translate ------*/