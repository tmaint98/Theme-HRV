{%layout none%}
<div class="container">
  <div class="row align-items-center">
    <div class="col-lg-6 col-12">
      <div class="about-banner">
        <img src="{{ 'streetvibe_index_about_2_img.jpg' | asset_url}}" alt="{{settings.streetvibe_index_about_2_title_2 | strip_newlines | strip_html}}" />
      </div>
    </div>
    <div class="col-lg-6 col-12">
      <div class="about-content">
        <div class="heading-title">
          {% if settings.streetvibe_index_about_2_title_1 != empty %}
            <div class="title1">{{ settings.streetvibe_index_about_2_title_1 }}</div>
          {% endif %}
          {% if settings.streetvibe_index_about_2_title_2 != empty %}
            <h2 class="title2">{{ settings.streetvibe_index_about_2_title_2 | newline_to_br }}</h2>
          {% endif %}
          {% if settings.streetvibe_index_about_2_desc != empty %}
            <div class="desc">{{ settings.streetvibe_index_about_2_desc }}</div>
          {% endif %}
        </div>
        {% if settings.streetvibe_index_about_2_btn != empty %}
          <div class="btn-more">
            <a href="{{settings.streetvibe_index_about_2_link}}" class="button">{{ settings.streetvibe_index_about_2_btn }}</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>