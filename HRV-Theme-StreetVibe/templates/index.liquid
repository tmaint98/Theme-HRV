<link rel="preload stylesheet" href="{{ 'sv-index-slider.scss.css' | asset_url }}" as="stylesheet">
<link href="{{ 'sv-index-slider.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'sv-index-slider.js' | asset_url }}"></script>
<script fetchpriority="low" type="text/javascript" defer src="{{ 'index.js' | asset_url }}"></script>
<link rel="preload stylesheet" href="{{ 'sv-product-loop.scss.css' | asset_url }}" as="stylesheet">
