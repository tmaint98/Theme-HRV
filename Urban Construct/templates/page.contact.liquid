<div class="layout-contact">
  <div class="hidden">{% include 'breadcrumb' %}<h1>{{ page.title }}</h1>
  </div>
  {% if settings.show_contact_info %}
    <section class="contact-info">
      <div class="container">
        <div class="heading-title">
          {% if settings.contact_info_title != '' %}
            <h2 class="title2 wow fadeInUp">{{ settings.contact_info_title | newline_to_br }}</h2>
          {% endif %}
        </div>
        <div class="row list-info">
          <div class="col-lg-3 col-12 item wow fadeInUp" data-wow-delay="0.1s" data-wow-duration="0.8s">
            <div class="title">
              {{ settings.contact_email_title }}
            </div>
            <ul class="info">
              {% for i in (1..3) %}
                {% capture info %}contact_email_{{i}}{%endcapture%}
                {% if settings[info] != '' %}
                  <li>
                    <a href="mailto:{{settings[info]}}">
                      <span>{{ settings[info] }}</span>
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
          <div class="col-lg-3 col-12 item wow fadeInUp" data-wow-delay="0.2s" data-wow-duration="0.8s">
            <div class="title">
              {{ settings.contact_address_title }}
            </div>
            <ul class="info">
              {% for i in (1..3) %}
                {% capture info %}contact_address_{{i}}{%endcapture%}
                {% if settings[info] != '' %}
                  <li>
                    <span>{{ settings[info] }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
          <div class="col-lg-3 col-12 item wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
            <div class="title">
              {{ settings.contact_time_title }}
            </div>
            <ul class="info">
              <li>
                <span>{{ settings.contact_time_desc }}</span>
              </li>
            </ul>
          </div>
          <div class="col-lg-3 col-12 item wow fadeInUp" data-wow-delay="0.4s" data-wow-duration="0.8s">
            <div class="title">
              {{ settings.contact_phone_title }}
            </div>
            <ul class="info">
              {% for i in (1..3) %}
                {% capture info %}contact_phone_{{i}}{%endcapture%}
                {% if settings[info] != '' %}
                  <li>
                    <a href="tel:{{settings[info] | remove: ' '}}">
                      <span>{{ settings[info] }}</span>
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>

        </div>
      </div>
    </section>
  {% endif %}
  {% if settings.show_contact_form %}
    <section class="form-contact wow fadeInUp">
      <div class="container-fluid">
        <div class="form-bg">
          <div class="row">
            <div class="offset-xl-6 col-xl-6 offset-lg-2 col-lg-8 col-12">
              <div class="form-booking">
                {% if settings.contact_form_title != '' %}
                  <h2 class="title">{{ settings.contact_form_title | newline_to_br }}</h2>
                {% endif %}
                <div id="contactFormWrapper">
          {% form 'contact' %}
          {% if form.posted_successfully? %}
          <div class="alert alert-success">
            Cám ơn bạn đã liên hệ! Chúng tôi sẽ trả lời ngay khi có thể
          </div>
          {% endif %}
          <div class="contact-form">
            <div class="row">
              <div class="col-sm-12 col-xs-12">
                <div class="input-group">
                  <input required type="text" name="contact[name]" class="form-control" placeholder="Tên của bạn" aria-describedby="basic-addon1">
                </div>
              </div>
              <div class="col-sm-12 col-xs-12">
                <div class="input-group">
                  <input required type="text" name="contact[email]" class="form-control" placeholder="Email của bạn" aria-describedby="basic-addon1">
                </div>
              </div>
              <div class="col-sm-12 col-xs-12">
                <div class="input-group">
                  <input pattern="[0-9]{10,12}" required type="text" name="contact[phone]" class="form-control" placeholder="Số điện thoại của bạn" aria-describedby="basic-addon1">
                </div>
              </div>
              <div class="col-sm-12 col-xs-12">
                <div class="input-group">
                  <textarea required name="contact[body]" placeholder="Nội dung"></textarea>
                  <div class="sitebox-recaptcha " >
                    This site is protected by reCAPTCHA and the Google
                    <a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy Policy</a> 
                    and <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms of Service</a> apply.
                  </div>	
                </div>
              </div>
              <div class="col-sm-12 col-xs-12">
                <button class="button dark cta-submitform">{{settings.contact_form_btn}}</button>
              </div>
            </div>
          </div>
          {% endform %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}
</div>


