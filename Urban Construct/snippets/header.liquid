{%unless has_heading %} 
  <link rel="preload stylesheet" href="{{ 'uc-page-heading.scss.css' | asset_url }}" as="stylesheet">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload stylesheet" href="{{ 'header.scss.css' | asset_url }}" as="stylesheet">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'header.js' | asset_url }}"></script>
{%if settings.urbanconstruct_shop_google_translate%}
{%include 'theme_google_translate_js'%}
{%endif%}
{%if settings.urbanconstruct_shop_buying%}
<link rel="preload stylesheet" href="{{ 'header-minicart.scss.css' | asset_url }}" as="stylesheet">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'header-minicart.js' | asset_url }}"></script>
{%endif%}
{%if settings.show_urbanconstruct_header_search%}
<link rel="preload stylesheet" href="{{ 'header-search.scss.css' | asset_url }}" as="stylesheet">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'header-search.js' | asset_url }}"></script>
{%endif%}

{%- assign checkcarticon = false -%}
{%- if settings.urbanconstruct_toolbar_bottom_selected == 'urbanconstruct_toolbar_style_1' and settings.urbanconstruct_sidebar_icon_cart_show -%}
{%- assign checkcarticon = true -%}
{%- endif -%}
<div class="urbanconstruct-mainHeader--height">
	<header class="urbanconstruct-mainHeader">
    <div class="urbanconstruct-mainHeader-middle">
			<div class="container-fluid">
				<div class="urbanconstruct-flex-header">
					<div class="urbanconstruct-header-left">
						<div class="urbanconstruct-header-wrap-iconav urbanconstruct-header-wrap-action d-sm-block d-lg-none">
							<div class="urbanconstruct-header-action">
								<div class="urbanconstruct-header-action-item urbanconstruct-header-action_menu urbanconstruct-activeMenuChecked">							
									<div class="urbanconstruct-header-action_text">
										<a class="urbanconstruct-header-action__link" name="icon-menu-mobile" href="javascript:void(0)" aria-label="Menu" title="Menu">
											<span class="urbanconstruct-box-icon">								
												<span class="urbanconstruct-hamburger-menu"  aria-hidden="true">
													<span class="urbanconstruct-bar"></span>
												</span>
												<span class="urbanconstruct-box-icon--close">
