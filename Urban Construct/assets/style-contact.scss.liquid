$colorMain: {{ settings.shop_main_color }};
$colorText: {{ settings.shop_text_color }};

.layout-contact {
  border-top: 1px solid rgba($colorText, 0.2);
}
.contact-info {
  padding: 150px 0;
  .item {
    font-size: 20px;
    font-weight: 600;
    .title {
      color: rgba($colorText, 0.6);
      margin-bottom: 15px;
    }
    .info {
      li:not(:last-child) {
        margin-bottom: 8px;
      }
    }
  }
  @media(min-width: 768px) {
    .heading-title {
      .title2 {
        font-size: 46px;
      }
    }
  }
  @media(max-width: 767px) {
    padding: 60px 0 40px;
    .item {
      font-size: 16px;
       &:not(:last-child) {
        margin-bottom: 20px;
      }
      .title {
        margin-bottom: 10px;
      }
      .info {
        li:not(:last-child) {
          margin-bottom: 5px;
        }
      }
    }
  }
}
.form-contact {
  padding: 20px 0;
  .form-bg {
    position: relative;
    background-image: url("{{'contact_form_bg.jpg' | asset_url}}");
    background-size: cover;
    background-position: center;
    border-radius: 16px;
    padding: 60px 0;
    .form-booking {
      background: var(--shop-color-bg);
      padding: 45px 30px 55px;
      border-radius: 16px;
      .title {
        font-size: 35px;
        margin-bottom: 30px;
      }
      .cta-submitform {
        width: 100%;
        justify-content: center;
        &.btn-disabled {
          cursor: no-drop;
        }
      }
      .contact-form .input-group {
        input[type="checkbox"] {
          width: 18px;
          height: 24px;
          flex: 0 0 18px;
          appearance: checkbox;
          -webkit-appearance: checkbox;
          margin-right: 10px;
        }
        label {
          margin: 0;
          color: rgba($colorText, 0.6);
          a {
            color: var(--shop-color-main);
          }
        }
      }
      .field-error {
        top: calc(100% - 20px);
        bottom: auto;
      }
    }
  }
  @media(min-width: 1200px) {
    .form-bg {
      .form-booking {
        max-width: 520px;
      }
    }
  }
  @media(max-width: 991px) {
    .form-bg > .row {
      margin: 0;
    }
  }
  @media(max-width: 767px) {
    .form-bg {
      padding: 40px 0;
      .form-booking {
        padding: 30px 15px;
        .title {
          font-size: 22px;
          margin-bottom: 20px;
        }
        .contact-form .input-group {
          input,
          textarea {
            font-size: 14px;
          }
        }
      }
    }
  }
}


