    width: calc(100% - 60px);
    height: 1px;
    background: rgba($colorText, 0.2);
  }
  .item-article {
    .media-article {
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      text-align: center;
      img {
        border-radius: 16px;
        transition: all 0.3s;
      }
    }
    .info-article {
      margin-top: 20px;
      .author {
        font-size: 14px;
        text-transform: uppercase;
        margin-bottom: 10px;
      }
      .title-article a {
        font-size: 28px;
      }
      .article-post-meta {
        font-size: 14px;
        color: rgba($colorText, 0.6);
        .comment {
          margin-left: 10px;
          a {
            color: rgba($colorText, 0.6);
          }
        }
      }
      .short-article{display: none;}
    }
     &:hover {
      .media-article {
        img {
          transform: scale(1.08);
        }
      }
    }
  }
  .btn-more {
    margin-top: 40px;
  }
  @media(max-width: 991px){
    &:before {
      left: 15px;
    width: calc(100% - 30px);
    }
  }
  @media(max-width: 767px){
    .row{
      gap: 15px;
    }
    .item-article {
      .info-article {
      margin-top: 15px;
        .author{
          margin-bottom: 0;
        }
      .title-article a{
      font-size: 18px;
      }
    }
    }
    
  }
}