.section-index-about-2 {
  background: var(--home-project-bg);
  color: var(--home-project-color);
  .heading-title {
    .title2 span,
    .desc {
      color: rgba($colorProject, 0.6);
    }
    .btn-more {
      margin-top: 30px;
    }
  }
  .list-project {
    margin-top: 40px;
    .project-item {
      .detail {
        margin-top: 20px;
        .title {
          color: var(--home-project-color);
          font-size: 20px;
          margin-bottom: 6px;
        }
        .desc {
          color: rgba($colorProject, 0.6);
        }
      }
    }
  }
  @media(min-width: 1200px) {
    .heading-title {
      &.heading--1 {
        max-width: 65%;
      }
    }
    .list-project {
      display: flex;
      gap: 10px;
      padding: 0 50px;
      .project-item {
        transition: all 0.5s ease-in-out;
        .img {
          height: 730px;
          background-image: var(--bg-img);
          background-size: cover;
          background-position: center;
          border-radius: 16px;
          overflow: hidden;
          img {
            display: none;
          }
        }
      }
      &.item--1 {
        .project-item {
          -ms-flex: 0 0 100%;
          flex: 0 0 100%;
          max-width: 100%;
        }
      }
      &.item--2 {
        .project-item {
          -ms-flex: 0 0 calc(50% - 5px);
          flex: 0 0 calc(50% - 5px);
          max-width: calc(50% - 5px);
          &.no-active {
            -ms-flex: 0 0 20%;
            flex: 0 0 20%;
            max-width: 20%;
          }
          &.active {
            -ms-flex: 0 0 calc(80% - 10px);
            flex: 0 0 calc(80% - 10px);
            max-width: calc(80% - 10px);
          }
        }
      }
      &.item--3 {
        .project-item {
          -ms-flex: 0 0 calc(100% / 3 - 7px);
          flex: 0 0 calc(100% / 3 - 7px);
          max-width: calc(100% / 3 - 7px);
          &.no-active {
            -ms-flex: 0 0 15%;
            flex: 0 0 15%;
            max-width: 15%;
          }
          &.active {
            -ms-flex: 0 0 calc(70% - 20px);
            flex: 0 0 calc(70% - 20px);
            max-width: calc(70% - 20px);
          }
        }
      }
    }
  }
  @media(max-width: 1199px) {
    .list-project {
      .project-item {
        .img {
          border-radius: 16px;
          overflow: hidden;
        }
         &:not(:last-child) {
          margin-bottom: 15px;
        }
      }
    }
  }
  @media(max-width: 767px) {
    .list-project {
      margin-top: 20px;
      .project-item {
        .detail{
          margin-top: 10px;
          .title{
            font-size: 16px;
          }
        }
      }
    }
  }
}
.section-index-marquee {
  background: var(--home-marquee-bg);
  color: var(--home-marquee-color);
  padding: 40px 0;
  .marquee {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    &__inner {
      display: inline-flex;
      gap: 30px;
      animation: index-marquee var(--time) linear infinite;
      &--item {
        display: inline-block;
        font-size: 160px;
        font-weight: 600;
        text-transform: uppercase;
        line-height: 1;
      }
    }
  }


  /*
   .marquee:hover .marquee__inner {
   animation-play-state: paused;
   }
*/
  @media(max-width: 991px) {
    .marquee__inner--item {
      font-size: 100px;
    }
  }
@media(max-width: 767px) {
    .marquee__inner--item {
      font-size: 60px;
    }
  }
}
.section-index-review {
  background: var(--home-review-bg);
  color: $colorReview;
  position: relative;
   &:before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40%;
    height: 100%;
    background: radial-gradient(circle at center, rgba($colorReview, 0.1) 0, rgba($colorReview, 0) 55%) no-repeat
  }
  .heading-title {
    .desc {
      color: rgba($colorReview, 0.6);
    }
  }
  .review-item {
    background: var(--home-review-bg-item);
    padding: 50px 40px;
    border-radius: 16px;
    position: relative;
    .item-left {
      .logo {
        margin-bottom: 15px;
        img {
          opacity: 0.6;
          transition: all 0.3s;
          max-height: 60px;
          width: auto;
           &:hover {
            opacity: 1;
          }
        }

      }
      .title {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 10px;
      }
      .desc {
        color: rgba($colorReview, 0.6);
        margin-bottom: 30px;
      }
      .info {
        display: flex;
        align-items: center;
        gap: 8px;
        .img {
          img {
            max-width: 70px;
            border-radius: 50%;
          }
        }
        .detail {
          .name {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 5px;
          }
          .position {
            font-size: 14px;
            color: rgba($colorReview, 0.6);
          }
        }
      }
    }
    .item-right {
      .title {
        font-size: 24px;
      }
      .percent {
        &,
        .counter-num {
          color: var(--home-review-percent);
        }
        .p-desc {
          font-size: 18px;
          font-weight: 600;
          margin-top: 10px;
          display: inline-block;
        }
      }
    }
  }
  @media(min-width: 1200px) {
    .review-item {
      .item-left {
        padding-right: 40px;
        border-right: 1px solid rgba($colorReview, 0.1);
      }
      .item-right {
        padding-left: 30px;
        height: 100%;
        display: flex;
        flex-flow: wrap;
        align-items: center;
        > div {
          flex: 0 0 100%;
        }
      }
    }
  }
  @media(max-width: 991px) {
    &:before{
      width: 100%;
    }
    .review-item {
      .row {
        gap: 20px;
      }
    }
  }
  @media(max-width: 767px) {
    .review-item {
      padding: 30px 15px;
      .item-left {
        .logo img{max-height: 45px;}
        .title,.info .detail .name{
          font-size: 16px;
        }
      }
      .item-right {
        .title{
        font-size: 18px;
        }
        .percent{
          margin: 20px 0;
          .counter-num {
            height: rem(30px);
  font-size: rem(30px);
        }
        .p-desc {
          font-size: 16px;
        }
        }
      }
    }
  }
}
.section-index-service {
  background: var(--home-service-bg);
  color: $colorService;
  &.has-bg {
    background-image: url("{{ 'home_service_bg.jpg' | asset_url}}}");
    background-size: cover;
    background-position: center;
  }
  .service-heading {
    display: flex;
    align-items: end;
    gap: 15px 40px;
    .heading-title {
      -ms-flex: 0 0 65%;
      flex: 0 0 65%;
      margin: 0;
      .title2 {
        margin: 0;
      }
      .desc {
        color: rgba($colorService, 0.6);
        margin-top: 20px;
      }
    }
    a {
      display: inline-block;
      font-weight: 600;
      color: $colorService;
      text-align: right;
      -ms-flex: 0 0 calc(35% - 40px);
      flex: 0 0 calc(35% - 40px);
       &:hover {
        color: rgba($colorService, 0.6);
      }
    }
  }
  .service-tab {
    display: flex;
    align-items: start;
    gap: 30px;
    margin-top: 40px;
    .nav-tabs {
      -ms-flex: 0 0 30%;
      flex: 0 0 30%;
      max-width: 30%;
      .nav-item {
        -ms-flex: 0 0 100%;
        flex: 0 0 100%;
        max-width: 100%;
        .nav-link {
          border-radius: 0;
          font-size: 22px;
          font-weight: 600;
          padding: 18px 0;
          color: rgba($colorService, 0.6);
          border-bottom: 1px solid rgba($colorService, 0.2);
          border-top: none;
          border-left: none;
          border-right: none;
          &.active {
            background: none;
            color: $colorService;
            border-color: $colorService;
          }
           &:hover {
            color: $colorService;
          }
        }
         &:first-child {
          border-top: 1px solid rgba($colorService, 0.2);
        }
      }

    }
    .tab-content {
      -ms-flex: 0 0 calc(70% - 30px);
      flex: 0 0 calc(70% - 30px);
      max-width: calc(70% - 30px);
      .img {
        img {
          border-radius: 16px;
        }
      }
    }
  }
  @media(max-width: 991px) {
    .service-heading {
      gap: 20px;
      flex-flow: wrap;
      .heading-title,
      a {
        -ms-flex: 0 0 100%;
        flex: 0 0 100%;
      }
    }
    .service-tab {
      gap: 20px;
      flex-flow: wrap;
      .nav-tabs,
      .tab-content {
        -ms-flex: 0 0 100%;
        flex: 0 0 100%;
        max-width: 100%;
      }
    }
  }
  @media(max-width: 767px){
    .service-heading a{
      text-align: left;
    }
    .service-tab {
      margin-top: 25px;
      .nav-tabs .nav-item .nav-link{
      font-size: 16px;
    padding: 10px 0;
      }
    }
  }
}
.section-index-partner {
