        }
      }
    }
    .urbanconstruct-sitenav-bottom{
      margin-top: 50px;padding-top: 40px;
      border-top: 1px solid rgba($colorText, 0.1);
      color: $colorText;
      .urbanconstruct-info-phone{
        font-size: 22px;font-weight: 600;margin-bottom: 10px;
      }
    }
  }

}
.urbanconstruct-sitenav-inner{
	.urbanconstruct-sitenav-header{
		display: flex;flex-wrap: wrap;
		justify-content: space-between;
		padding: 15px;
		border-bottom: 1px solid $colorBoder;
		&__title{font-size: 22px;font-weight: 600;margin: 0;color: $colorText;}
		&__btn{
			svg{width: 17px;height:100%;margin:0 auto;cursor: pointer;fill: $colorText;}
		}
		.urbanconstruct-cart-shipping{
			flex: 0 0 100%;
			max-width: 100%;
			margin-top:18px;
			&__title{
				font-size: 14px;
				font-weight: 400;
				color: rgba($colorText, 0.6);
				letter-spacing: 0.5px;
				min-height: 30px;
				.price {font-weight: 600;color: #ff2c26;}
				.free-ship {text-transform: uppercase;color: $colorText;font-weight: 600;}
			}
		}
	}
	.urbanconstruct-sitenav-content{
		padding: 15px;
		position: relative;
		overflow-y: scroll;
		height: 100%;
		-webkit-overflow-scrolling: touch;
		-ms-scroll-chaining: none;
		overscroll-behavior: none;
		&::-webkit-scrollbar {width:4px;	height: 3px;}
		&::-webkit-scrollbar-track {-webkit-border-radius:2px;border-radius: 2px;margin-left: 10px;}
		&::-webkit-scrollbar-thumb {
			-webkit-border-radius:2px;border-radius:2px;background:#e1e3e4;
			-webkit-box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3); 
		}
