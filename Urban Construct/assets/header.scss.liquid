$bg: {{settings.urbanconstruct_header_color_bkg_sb}};
$colorText: {{settings.urbanconstruct_header_color_text_sb}};
$colorBoder: {{settings.urbanconstruct_header_color_border}};
$colorHd: {{settings.urbanconstruct_header_color_text}};
$bgHd: {{settings.urbanconstruct_header_color_bkg}};
$colorHdHover: {{settings.urbanconstruct_header_color_text_hover}};
$colorLive: {{settings.urbanconstruct_header_live_color}};

/*========Header========*/
  .urbanconstruct-mainHeader {
	width:100%;
	transition:-webkit-box-shadow 0.3s ease-in-out;
	transition: box-shadow 0.3s ease-in-out;
	transition: box-shadow 0.3s ease-in-out, -webkit-box-shadow 0.3s ease-in-out;
	background: $bgHd;color: $colorHd;
	.urbanconstruct-flex-header{
		display: -webkit-flex;display: flex;
		-webkit-align-items: center;align-items: center;
		-webkit-flex-flow: row nowrap;flex-flow: row nowrap;
		-webkit-justify-content: space-between;justify-content: space-between;
		&>[class*='urbanconstruct-header-wrap-'] {
			padding:0px 10px;
		}
	} 
  .urbanconstruct-header-center{
    -ms-flex: 0 0 55%;
		flex: 0 0 55%;
		max-width: 55%;
  }
	.urbanconstruct-header-left{
    -ms-flex: 0 0 18%;
		flex: 0 0 18%;
		max-width: 18%;
    display: flex;align-items: center;gap: 40px;
  }
	.urbanconstruct-header-right{
    -ms-flex: 0 0 27%;
		flex: 0 0 27%;
		max-width: 27%;
		display: flex;
		align-items: center;
		justify-content: end;
		gap: 20px;
		.urbanconstruct-header-hotline{
			.hotline{
				display: flex;
				align-items: center;
				gap: 10px;
				font-size: 20px;
				.icon {
					width: 40px;
					height: 40px;
					line-height: 40px;
					border-radius: 50%;
					display: inline-block;
					text-align: center;
					background: rgba($colorHdHover, 0.1);
					color: $colorHdHover;
				}
			}
		}
	}
	.urbanconstruct-header-wrap-menu{flex: 1;
		.urbanconstruct-navbar-mainmenu{text-align: center;position: relative;}  
		.urbanconstruct-menuList-main{
			margin:0;
			&>li {
				display: inline-block;margin:0 10px;position: relative;
				&>a {
					position: relative;z-index: 2;
					display: block;
					width: 100%;letter-spacing:0.75px;
					padding: 22px 5px;
					-webkit-transition:none;transition:none;
					color: $colorHd;
					svg {
						display: inline-block;vertical-align: middle;margin-left: 0;fill: currentcolor;
						-webkit-transition:transform .2s;-moz-transition:transform .2s;	-o-transition:transform .2s;transition:transform .2s;
					}
				}
				&.active > a, &:hover>a,&.active:hover > a{
          color: $colorHdHover;
				}
			}
			li.urbanconstruct-has-submenu{
				.urbanconstruct-menuList-submain {
					background: $bg;min-width:250px;	max-width:180%;padding: 12px 0;
					position: absolute;z-index:99;top:150%;
					pointer-events: none; visibility: hidden; opacity: 0;
					-webkit-box-shadow: 0px 0px 3px rgba(0,0,0,0.15);	box-shadow: 0px 0px 3px rgba(0,0,0,0.15);
					-webkit-transition: all 0.3s ease;-o-transition: all 0.3s ease;transition: all 0.3s ease;
				}
				.urbanconstruct-menuList-submain ul.urbanconstruct-menuList-submain {left: 100%;top:0;	}
				&:hover>.urbanconstruct-menuList-submain {pointer-events: auto;visibility: visible;top: 100%;opacity: 1;}
			}
			.urbanconstruct-item-live{
				display: -webkit-flex;
				display: flex;
				.urbanconstruct-header-box-live {
					.urbanconstruct-btn-live{
						padding: 5px 12px 5px 20px;
						color: $colorLive;
						background: transparent;
						outline: none;
						border: none;
						position: relative;
						&:after{
							content: '';
							background: $colorLive;;
							width: 8px;
							height: 8px;
							position: absolute;
							left: 7px;
							top: calc(50% - 4px);
							border-radius: 50%;
							animation: pulselive 1.65s linear infinite;
						}
					}
				}
			}
			@media(max-width:1199px) and (min-width:992px){
				&>li >a{font-size: 13px;}
			}
		}
		.urbanconstruct-menuList-submain{
			li{
				position: relative;
				&:not(:last-child){
					&:before{
						content: '';
						position: absolute;
						bottom: 0;
						left: 22px;
						width: calc(100% - 44px);
						height: 1px;
						background: rgba($colorText, 0.1);
					}
				}
				a {padding: 10px 22px;text-align: left;display: block;font-size: 15px;font-weight: 500;color:$colorText;}
				a svg {
					width: 15px;
					position: absolute;right: 15px;top: 50%;
					-ms-transform:translateY(-50%);
					-webkit-transform:translateY(-50%);
					transform:translateY(-50%);
					-webkit-transition: right 0.3s ease-in-out;
					-ms-transition:right 0.3s ease-in-out;
					transition: right 0.3s ease-in-out;
				}
				a:hover svg{right:10px; opacity: 0.8;}
			}
			li.urbanconstruct-has-submenu{padding-right:30px}
			li a:hover,li a:hover i{color: $colorHdHover;}
		}
	}
	.urbanconstruct-header-wrap-logo{
		h1,a {
			font-size: 26px;font-weight: 600;text-decoration: none;
			text-transform: uppercase;margin:0;color: $colorHd;
			white-space: initial;	overflow: hidden;
			-webkit-line-clamp: 1;-webkit-box-orient: vertical;
		}
	}
	.urbanconstruct-header-wrap-action{
		.urbanconstruct-header-action {
			position: relative;
			display: flex; display: -webkit-flex;
			justify-content: flex-end; -webkit-justify-content: flex-end;
			gap: 10px;
			.urbanconstruct-header-action-item {
				align-self: center;
				.urbanconstruct-header-action_text{
					&{position: relative;height: 100%;display: -ms-flexbox;display: -webkit-flex;display: flex;-webkit-align-items: center;-ms-align-items: center;align-items: center;}
					.urbanconstruct-box-triangle {position: absolute;width: 24px;height:15px;top: 100%;z-index: 999;visibility: hidden;opacity: 0;left: 0;right: 0;margin: 0 auto;}
					.urbanconstruct-box-triangle svg {-webkit-filter: drop-shadow(0 -3px 2px rgba(0, 0, 0, 0.12));filter: drop-shadow(0 -3px 2px rgba(0, 0, 0, 0.12));fill: $bg;}
					.urbanconstruct-header-action__link {position: relative;display:block;font-size:13px;color:$colorHd;white-space: nowrap;}
					.urbanconstruct-header-action__link .urbanconstruct-box-icon,
					.urbanconstruct-header-action__link .box-text{display: inline-block; vertical-align: middle;}
					.urbanconstruct-header-action__link .box-text{padding-left:2px;}
					.urbanconstruct-header-action__link .box-text .txtnw {font-size:11px;}
					.urbanconstruct-header-action__link .box-text .txtbl{font-size:13px;display:block;font-weight: 500;}
					.urbanconstruct-header-action__link .box-text .txt-overflow{white-space: nowrap;text-overflow: ellipsis; display: inline-block;vertical-align: middle;max-width: 115px; overflow: hidden;}
					.urbanconstruct-header-action__link .box-text .fa{	display: inline-block;font-size: 16px;vertical-align: middle;	margin-left: 3px;}
					.urbanconstruct-header-action__link .urbanconstruct-box-icon{position: relative;width:32px;height:40px;text-align: center;}
					.urbanconstruct-header-action__link .urbanconstruct-box-icon svg{width:22px;height:40px;fill: currentColor;}
					.urbanconstruct-header-action__link .urbanconstruct-box-icon svg.urbanconstruct-svg-ico-account{width: 22px;}
					.urbanconstruct-header-action__link .urbanconstruct-box-icon svg.urbanconstruct-svg-ico-search{width: 20px;}
					.urbanconstruct-header-action__link .urbanconstruct-box-icon .urbanconstruct-box-icon--close{
						position: absolute;top: 0;left: 0;right:0;bottom:0;
						opacity: 0;visibility: hidden;    transform: scale(0.3);
						transition: opacity 0.35s ease-in-out, -webkit-transform 0.35s ease-in-out;
						transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out;
						transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out, -webkit-transform 0.35s ease-in-out;
						svg{width:18px}					
					}
					.urbanconstruct-header-action__link .urbanconstruct-box-icon .urbanconstruct-count-holder{
						display: inline-block;vertical-align: top;
						background: $colorHd;color: $bgHd;
						font-size: 11px;text-align: center;
						position: absolute;left: 16px;top:-1px;padding: 0px 3px;
						min-width: 20px;height: 20px;	line-height: 20px;border-radius: 50%;
					}				
					.urbanconstruct-header-action__link:hover svg.urbanconstruct-svg-ico-search{-ms-transform:rotate(-5deg);	-webkit-transform:rotate(-5deg);transform: rotate(-5deg);}
				} 
				.urbanconstruct-header-action_dropdown{
					position: absolute;top: calc(100% + 15px);  left: auto;right:-15px;z-index: 990;
					min-width: 280px;border-radius: 3px;
					color: $colorText;background: $bg;  border: solid 1px $colorBoder;
					box-shadow: 0 1px 5px 2px rgba(0, 0, 0, 0.1);
					visibility: hidden;opacity: 0;
					-webkit-transform: scale(0.9);transform: scale(0.9);
					transition: opacity 0.25s ease-in-out, visibility 0.25s ease-in-out, max-height 0s linear 0.25s, -webkit-transform 0.25s ease-in-out;
					transition: opacity 0.25s ease-in-out, transform 0.25s ease-in-out, visibility 0.25s ease-in-out, max-height 0s linear 0.25s;
					transition: opacity 0.25s ease-in-out, transform 0.25s ease-in-out, visibility 0.25s ease-in-out, max-height 0s linear 0.25s, -webkit-transform 0.25s ease-in-out;
					will-change: transform;
					.urbanconstruct-box-triangle {
						position: absolute;bottom: calc(100% - 2px);
						margin:0 auto;width: 22px; height: 15px;right:19px; 
					}
					.urbanconstruct-box-triangle svg{
						-webkit-filter: drop-shadow(0 -3px 2px rgba(0, 0, 0, 0.12));
						filter: drop-shadow(0 -3px 2px rgba(0, 0, 0, 0.12));
					}
					.urbanconstruct-header-dropdown_content{
						width: 100%;height: 100%;	max-height: 100%;overflow: hidden;padding: 15px 20px;
						.urbanconstruct-sitenav-content .urbanconstruct-boxtitle{
							font-size: 18px;color:$colorText;text-transform: uppercase;letter-spacing: 0.5px;
							margin: 0;font-weight: 500;padding-bottom:8px;text-align:center;
						}
					}
				}	
				&.urbanconstruct-header-action_account .urbanconstruct-header-action_dropdown .urbanconstruct-box-triangle{right:58px;}
				&.urbanconstruct-header-action_search .urbanconstruct-header-action_dropdown .urbanconstruct-box-triangle{right:98px;}
				&.urbanconstruct-header-action_cart{position: relative;}
        &.urbanconstruct-header-action_hotline {
          a{color: currentcolor;}
          span{font-weight: 600;margin-left: 5px;}
          svg{fill: currentColor;}
        }
			}
			.urbanconstruct-header-action-item.urbanconstruct-js-action-show .urbanconstruct-header-action_text .urbanconstruct-box-triangle {visibility: visible;opacity: 1;}
			.urbanconstruct-header-action-item.urbanconstruct-js-action-show .urbanconstruct-header-action_dropdown{
				visibility: visible;opacity: 1;
				-webkit-transform: scale(1);transform: scale(1);
				transition: opacity 0.4s cubic-bezier(0, 1, 0.4, 1), visibility 0.4s linear, -webkit-transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1);
				transition: opacity 0.4s cubic-bezier(0, 1, 0.4, 1), transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1), visibility 0.4s linear;
				transition: opacity 0.4s cubic-bezier(0, 1, 0.4, 1), transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1), visibility 0.4s linear, -webkit-transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1);
			}
			.urbanconstruct-header-action-item.urbanconstruct-header-action_account.urbanconstruct-js-action-show .urbanconstruct-header-action_dropdown .site_account_panel.is-selected{	visibility: visible;}
			.urbanconstruct-header-action-item.urbanconstruct-header-action_locale.urbanconstruct-js-action-show .overlays:before{
				content:"";
				position: fixed;top: 0;left: 0;	right: 0;height:100vh;width: 100%;
				background: #000;opacity: 0.7;z-index: 100;margin: auto;
			}
			.urbanconstruct-header-action-item.urbanconstruct-header-action_locale.urbanconstruct-js-action-show .overlays .urbanconstruct-header-action__link{z-index: 101;}
		}
		&.urbanconstruct-header-wrap-iconav{
			.urbanconstruct-header-action {
				.urbanconstruct-header-action-item.urbanconstruct-header-action_backlink{display:none;}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_backlink a{margin-right:0px;width: 20px;line-height: 32px;color:$colorText;height: 35px;display: block; font-size: 28px;}	
				.urbanconstruct-header-action-item.urbanconstruct-header-action_menu{
					.urbanconstruct-header-action_dropdown .urbanconstruct-box-triangle {right: initial; left: 16px;}
					.urbanconstruct-box-icon{
						width: 25px;
						.urbanconstruct-hamburger-menu {
							width: 25px;height:35px;cursor: pointer;display: block;position: relative;
							.urbanconstruct-bar,.urbanconstruct-bar:after, .urbanconstruct-bar:before {height: 1px;background:$colorHd;}
							.urbanconstruct-bar {
								position: relative;top: 22px;	display: block;margin:auto;width:25px;
								-ms-transition:all 0ms 100ms, width 150ms linear;
								-webkit-transition:all 0ms 100ms, width 150ms linear;
								transition: all 0ms 100ms, width 150ms linear;
								-ms-transform:translateY(-2px);-webkit-transform:translateY(-2px);transform: translateY(-2px);
							}
							.urbanconstruct-bar:before {
								content: "";
								position: absolute;left: 0;bottom: 7px;width:25px;
								-ms-transition:bottom 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1),transform 300ms cubic-bezier(0.23, 1, 0.32, 1),width 150ms linear,background 150ms linear;
								-webkit-transition:bottom 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1),transform 300ms cubic-bezier(0.23, 1, 0.32, 1),width 150ms linear,background 150ms linear;
								transition: bottom 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1),transform 300ms cubic-bezier(0.23, 1, 0.32, 1),width 150ms linear,background 150ms linear;
							}
							.urbanconstruct-bar:after {
								content: "";
								position: absolute;	left: 0;	top: 7px;width:25px;
								-ms-transition:top 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1),transform 300ms cubic-bezier(0.23, 1, 0.32, 1),width 150ms linear,background 150ms linear;
								-webkit-transition:top 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1),transform 300ms cubic-bezier(0.23, 1, 0.32, 1),width 150ms linear,background 150ms linear;
								transition: top 300ms 100ms cubic-bezier(0.23, 1, 0.32, 1),transform 300ms cubic-bezier(0.23, 1, 0.32, 1),width 150ms linear,background 150ms linear;
							}

						}
						.urbanconstruct-box-icon--close svg {height:35px;}
					}
					&.urbanconstruct-js-action-show{
						.urbanconstruct-hamburger-menu{
							opacity: 0;	visibility: visible;
							-webkit-transform: scale(1);	transform: scale(1);
						}
					}
				}
			}
		}
	}

	.urbanconstruct-header-navbar-menu .urbanconstruct-header-wrap-menu {-ms-flex: 1 1 auto;flex: 1 1 auto;}
	.urbanconstruct-header-wrap-menu-desktop {
		display: flex;
		align-items: center;
		gap: 30px;
		.urbanconstruct-header-hotline{
			a{color: $colorHd;font-size: 16px;font-weight: 600;}
		}
	}

	@media(min-width:1200px){
		position: relative;
	}
	@media(min-width:1200px) and (max-width: 1710px){
		.urbanconstruct-header-left{gap: 25px;}
		.urbanconstruct-header-wrap-menu .urbanconstruct-menuList-main > li{
      margin: 0 6px;
      a{font-size: 15px;}
    }
	}

	@media(min-width:992px){
		.urbanconstruct-flex-header{-webkit-align-items: center; align-items: center;}
		.urbanconstruct-header-wrap-menu{
			padding-left:0px;padding-right:0;
			.urbanconstruct-navbar-mainmenu{height:100%;}
			.urbanconstruct-menuList-main {
				height: 100%;  display: -webkit-flex;display: flex;
				-ms-justify-content: center;justify-content: center;
			}
			.urbanconstruct-menuList-main > li {
				display: -webkit-flex; display: flex;
				-ms-align-items: center; align-items: center;
			}
		}
		.urbanconstruct-header-wrap-logo,.urbanconstruct-header-wrap-action {-ms-align-self: center;align-self: center;}
		.urbanconstruct-header-wrap-logo{
			a img{max-width:210px;max-height:70px;}	
			.urbanconstruct-wrap-logo {	min-width: 100px;	}
		}
		.urbanconstruct-header-wrap-action{
			.urbanconstruct-header-action{
				.urbanconstruct-header-action-item.urbanconstruct-header-action_cart  .urbanconstruct-header-action_dropdown{ width: 420px;}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_search .urbanconstruct-header-action_dropdown{ width: 420px;}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_account .urbanconstruct-header-action_dropdown{width:340px;}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_locale .urbanconstruct-header-action_dropdown{width:420px;}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_account .urbanconstruct-header-action_dropdown.urbanconstruct-header-action_widthAuto{width: auto;min-width:260px}
			}
		}
		.urbanconstruct-header-wrap-action .urbanconstruct-header-action .urbanconstruct-header-action-item .urbanconstruct-header-action_text .urbanconstruct-header-action__link .urbanconstruct-box-icon .pulse {
			border-radius: 50%;
			height: 6px;
			width: 6px;
			position: absolute;
			left: 0;
			right: 0;
			bottom: 4px;
			opacity: 1;
			margin: 0 auto;
			transform: rotateX(55deg);
			&:after {
				content: "";
				border-radius: 50%;
				height: 25px;
				width: 25px;
				position: absolute;
				margin: -8px 0 0 -12px;
				animation: pulsate 1s ease-out;
				animation-iteration-count: infinite;
				opacity: 0;
				animation-delay: 1.1s;
			}
		}
		.urbanconstruct-header-wrap-info {
			li:nth-child(2) {margin-left:15px;}
			li svg {width:22px;height:22px;transform: translateY(-2px);}
		}
	}
@media(max-width: 1200px){
  .urbanconstruct-header-wrap-action .urbanconstruct-header-action-item{
  &.urbanconstruct-header-action_hotline,&.urbanconstruct-header-action_btn{display: none;}
}
}
	@media(max-width:1199px) and (min-width:992px){
		& .container{width: auto;}
		.urbanconstruct-header-wrap-logo{
			h1,a {font-size: 26px;}
			a img{max-width:200px;max-height:70px}
		}
		.urbanconstruct-header-wrap-action .urbanconstruct-header-action .urbanconstruct-header-action-item.locationContainer .urbanconstruct-header-action_text .box-text .txtnw {font-size:10px;}
		.urbanconstruct-header-wrap-action .urbanconstruct-header-action .urbanconstruct-header-action-item.locationContainer .urbanconstruct-header-action_text .box-text .txtbl {font-size:12px;}

	}
	@media(max-width:991px){
    .urbanconstruct-mainHeader-middle{	position: relative;padding: 10px 0;}
    .urbanconstruct-header-center{
      display: none;
    }
		.urbanconstruct-header-left{-ms-flex: 0 0 calc(100% - 150px);flex: 0 0 calc(100% - 150px);max-width: calc(100% - 150px);gap: 10px;}
		.urbanconstruct-header-right{-ms-flex: 0 0 20%;flex: 0 0 20%;max-width: 150px;}
		.urbanconstruct-header-hotline, .urbanconstruct-header-btn{display: none;}
		.urbanconstruct-flex-header{
			margin:0;
			&>[class*='urbanconstruct-header-wrap-'] {position: initial;padding:0;}
			.urbanconstruct-header-wrap-right{flex: 0 0 85px;}
			.urbanconstruct-header-wrap-iconav{
				.urbanconstruct-header-action{
					justify-content: start;
					-webkit-justify-content: start;
				}
			}
		}
		.urbanconstruct-header-wrap-action{
			display: flex;
			-ms-flex: 0 0 10%;
			flex: 0 0 10%;
			max-width: 150px;
			&:not(.urbanconstruct-header-wrap-iconav){
				justify-content: end;
			}
			.urbanconstruct-header-action {
				position: initial;height: 100%;
				.urbanconstruct-header-action-item{
					position: initial;height: 100%;
					.urbanconstruct-header-action_text .urbanconstruct-box-triangle{top:calc(100% - 5px);}
					.urbanconstruct-header-action_text .urbanconstruct-header-action__link .box-text {display: none;}
					.urbanconstruct-header-action_dropdown{right: 0;left: 0;top: 100%;width: 100vw;height:100vh;}	
					&.urbanconstruct-js-action-show .urbanconstruct-header-action_text .urbanconstruct-header-action__link .urbanconstruct-box-icon .urbanconstruct-box-icon--close{
						opacity: 1;visibility: visible;
						-webkit-transform: scale(1);  transform: scale(1);
					}
					&.urbanconstruct-js-action-show .urbanconstruct-header-action_text .urbanconstruct-header-action__link .urbanconstruct-box-icon>svg,
					&.urbanconstruct-js-action-show .urbanconstruct-header-action_text .urbanconstruct-header-action__link .urbanconstruct-box-icon .urbanconstruct-count-holder{	
						opacity: 0;visibility: visible;
						-webkit-transform: scale(1);transform: scale(1);
					}
&.urbanconstruct-header-action_info{display: none;}
				}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_menu .urbanconstruct-header-action_dropdown .urbanconstruct-header-dropdown_content{padding:0 0px 80px;}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_menu .urbanconstruct-header-action_dropdown{right: 0;left:0px;top: 100%;width:100vw;height:100vh;}	
				.urbanconstruct-header-action-item.urbanconstruct-header-action_menu .urbanconstruct-header-action_dropdown .urbanconstruct-header-dropdown_content{overflow: auto;padding-bottom:120px;	-webkit-overflow-scrolling: touch;}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_cart {display: none;}
				.urbanconstruct-header-action-item.urbanconstruct-header-action_cart.urbanconstruct-show-mb {display: block;}
			}
		}
		.urbanconstruct-header-wrap-menu-desktop{display: none;}
	}
	@media(max-width:992px) and (min-width:768px){
		.urbanconstruct-header-wrap-logo{		
			a img{max-height:65px}
			h1,a {font-size:26px;}
		}
		.urbanconstruct-header-wrap-action .urbanconstruct-header-action .urbanconstruct-header-action-item.locationContainer .urbanconstruct-header-action__link .box-text {padding: 3px 10px;}
		.urbanconstruct-header-wrap-action.urbanconstruct-header-wrap-iconav .urbanconstruct-header-action .urbanconstruct-header-action-item.urbanconstruct-header-action_menu{margin-left:15px;margin-right:0;}
	}
