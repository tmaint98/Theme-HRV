/*--------------------------------------------------------------------------------
SIDEBAR MAIN
--------------------------------------------------------------------------------*/
.urbanconstruct-sidebar-main{
	.urbanconstruct-sitenav-wrapper{
		position: fixed;
		top: 0;
		bottom: 0;
		z-index: 6;
		background: transparent;
		&.urbanconstruct-sitenav-right{
			right: 0;
			.urbanconstruct-sitenav-inner{
				right: 0;
				-webkit-transform: translateX(120%);transform: translateX(120%);
				-webkit-transition: transform 0.35s ease,right 0.25s ease, visibility 0s;transition: transform 0.35s ease,right 0.25s ease, visibility 0s;
			}
		}
		&.urbanconstruct-sitenav-left{
			left: 0;
			.urbanconstruct-sitenav-inner{
				left: 0;
				-webkit-transform: translateX(-100%);transform: translateX(-100%);
				-webkit-transition: transform 0.35s ease,left 0.25s ease, visibility 0s;transition: transform 0.35s ease,left 0.25s ease, visibility 0s;
			}
		}
		.urbanconstruct-sitenav-inner{
			margin: 0 auto;
			max-width: 480px;
			position: absolute;
			top: 0;
			bottom: 0;
			background: $bg;
			background-clip: padding-box;
			display: flex;
			flex-direction: column;
			&:after{
				content: "";
				position: absolute;
				width: 100%;
				height: 100%;
				background: #fff;
				z-index: 1;
				opacity: 1;
				visibility: visible;
			}
		}
	}
	&.urbanconstruct-is-show-right{
		.urbanconstruct-sitenav-wrapper.urbanconstruct-show{
			left: 0 !important;
			-webkit-transition-delay: 0s;
			transition-delay: 0s;
		}
		.urbanconstruct-sitenav-wrapper.urbanconstruct-show .urbanconstruct-sitenav-inner{
			right: 0;width: 85%;
			-webkit-transform: translateX(0);transform: translateX(0);
			-webkit-transition-delay: 0.1s;transition-delay: 0.1s;
			-webkit-transition-duration: 0.3s;transition-duration: 0.3s;
			&:after{visibility: hidden;opacity: 0;}
		}
		.urbanconstruct-sitenav-wrapper.urbanconstruct-show .urbanconstruct-sidebar-overlay{opacity:1;visibility: visible;}
	}
	&.urbanconstruct-is-show-left{
		.urbanconstruct-sitenav-wrapper.urbanconstruct-show{
			right: 0 !important;
			-webkit-transition-delay: 0s;
			transition-delay: 0s;
		}
		.urbanconstruct-sitenav-wrapper.urbanconstruct-show .urbanconstruct-sitenav-inner{
			left: 0;width: 85%;
			-webkit-transform: translateX(0);transform: translateX(0);
			-webkit-transition-delay: 0.1s;transition-delay: 0.1s;
			-webkit-transition-duration: 0.3s;transition-duration: 0.3s;
			&:after{visibility: hidden;opacity: 1;}
		}
		.urbanconstruct-sitenav-wrapper.urbanconstruct-show .urbanconstruct-sidebar-overlay{opacity:1;visibility: visible;}
	}
	.urbanconstruct-sidebar-overlay{
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 100%;
		z-index: -1;
		background-color: rgba(0, 0, 0, 0.5);
		opacity: 0;
		visibility: hidden;
		transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
	}
  .urbanconstruct-sitenav-info{
    .urbanconstruct-sitenav-inner{
      max-width: 380px;padding: 30px;
    }
    .urbanconstruct-sitenav-header{
      border-bottom: none;
      .logo{
        a{
          font-size: 28px;font-weight: 600;
        }
      }
      .urbanconstruct-btn-sitenav-close{
        display: block;height: 48px;width: 48px;display: flex;align-items: center;border-radius: 50%;opacity: 1;
        text-align: center;outline: none;border: none;background: rgba($colorHdHover, 0.05);
        svg{
          width: 15px;
          height: 15px;
          -webkit-transition: all 0.3s ease;
          -ms-transition: all 0.3s ease;
          transition: all 0.3s ease;
          fill: $colorText;
        }
        &:hover{
          svg{
            -webkit-transform: rotate(180deg);
          -ms-transform: rotate(180deg);
          transform: rotate(180deg);
          }
         
        }
      }
    }
    .urbanconstruct-sitenav-content{
      display: flex;flex-flow: column;
    justify-content: space-between;
    }
    .urbanconstruct-sitenav-social{
      li{
        svg{
          width: 20px;height: 20px;fill: currentcolor;
        }
        span{
          font-size: 18px;font-weight: 600;margin-left: 20px;
        }
        a{
          display: inline-flex;align-items: center;
          &:hover{
            color: $colorText;
