}

.urbanconstruct-menuList-links{margin:0;}
.urbanconstruct-menuList-links li{position: relative;}
.urbanconstruct-menuList-links li a {color:$colorText;position: relative;font-size: 13px;display: block;}
.urbanconstruct-menuList-links li a:hover,.urbanconstruct-menuList-links li a:focus{color:$colorHdHover;}
.urbanconstruct-menuList-links > li{border-bottom: 1px dashed $colorBoder;}
.urbanconstruct-menuList-links > li:last-child{border-bottom: none;}
.urbanconstruct-menuList-links > li > a {padding:12px 0;font-weight: 500;font-size: 15px;}
.urbanconstruct-menuList-links > li.urbanconstruct-has-submenu >a{padding-right:30px}
.urbanconstruct-menuList-links > li.urbanconstruct-has-submenu span.urbanconstruct-icon-plus-submenu {	width: 25px;height:25px;cursor: pointer;position: absolute;right: 0;top: 0;bottom: 0;margin: auto;border: none;}
.urbanconstruct-icon-plus-submenu:after,.urbanconstruct-icon-plus-submenu:before {
	background: rgba($colorText,0.6);content: '';display: block;	position: absolute;	margin-right:7px;	top: 50%;right: 0;
	-moz-transition: all .25s linear;-o-transition: all .25s linear;-webkit-transition: all .25s linear;transition: all .25s linear;
}
.urbanconstruct-icon-plus-submenu:before{width: 9px;height: 1px;	-moz-transform: translateY(-50%);	-ms-transform: translateY(-50%);-webkit-transform: translateY(-50%);transform: translateY(-50%);}
.urbanconstruct-icon-plus-submenu:after {width: 1px;	height:9px;	right:4px;transform-origin: center;	-moz-transform: translateY(-50%) scale(1, 1);	-ms-transform: translateY(-50%) scale(1, 1);	-webkit-transform: translateY(-50%) scale(1, 1);transform: translateY(-50%) scale(1, 1);}
li.urbanconstruct-has-submenu.opened > a .urbanconstruct-icon-plus-submenu:after {-moz-transform: translateY(-50%) scale(1, 0);-ms-transform: translateY(-50%) scale(1, 0);-webkit-transform: translateY(-50%) scale(1, 0); transform: translateY(-50%) scale(1, 0);}
ul.urbanconstruct-menuList-links li ul.urbanconstruct-submenu-links{display: none;}
ul.urbanconstruct-submenu-links li a{ padding: 8px 0 8px 0px;}
li.urbanconstruct-has-submenu.urbanconstruct-level0 > ul.urbanconstruct-submenu-links{border-top: 1px dashed $colorBoder;}
li.urbanconstruct-has-submenu.urbanconstruct-level0 > ul.urbanconstruct-submenu-links li a{padding-left:12px;}
li.urbanconstruct-has-submenu.urbanconstruct-level1 > ul.urbanconstruct-submenu-links li a{padding-left:25px;}
li.urbanconstruct-has-submenu.urbanconstruct-level2 > ul.urbanconstruct-submenu-links li a{padding-left:35px;}

/*----- LIVE STREAM ------*/
.urbanconstruct-modal-live {
	position: fixed;
	max-width: 45%;
	max-height: 75%;
	bottom: 5px;
	left: 5px;
	z-index: 999;
	transform: translateY(calc(100% + 5px));
	-webkit-transition: all 500ms ease-in-out;
	-moz-transition: all 500ms ease-in-out;
	-ms-transition: all 500ms ease-in-out;
	-o-transition: all 500ms ease-in-out;
	transition: all 500ms ease-in-out;
	.urbanconstruct-modal-live--inner {
		background: #fff;
		border-radius: 10px;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
	}
	&.opened {
		transform: translateY(0);
	}
	.urbanconstruct-btn-close--live {
		position: absolute;
		right: -40px;
		top: 0;
		cursor: pointer;
		opacity: 0;
		padding: 0 10px;
	}
	iframe {
		border-radius: 10px;
		display: block;
		width: 100%;
		height: 100%;
	}
	&:hover .urbanconstruct-btn-close--live {
		opacity: 1;
	}
	@media(max-width: 992px) {
		max-width: 100%;
		max-height: 100%;
		.urbanconstruct-btn-close--live {
			right: -5px;
			top: 5px;
			opacity: 1;
		}
	}
}

.box-item.box-live{
	position: relative;margin-top: 15px;
	.svgico {
		position: relative; z-index: 4;    display: block;
		height:48px;width:48px;text-align: center;border-radius: 50%;
		border:1px solid #ffffff;    cursor: pointer;
		background:$colorLive; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);	
		box-sizing: border-box; -moz-box-sizing: border-box; -webkit-box-sizing: border-box;
		animation: pulse 2s infinite;animation: pulse 2s infinite; 
		svg {
			fill: #ffffff; width: 28px;height:100%;
			transition: opacity 0.35s ease-in-out, -webkit-transform 0.35s ease-in-out;
			transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out;
			transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out, -webkit-transform 0.35s ease-in-out;
		}
	}
	&:before, &:after {
		position: absolute;	content: '';
		height: 48px; width: 48px;left: 0;top: 0;
		background:$colorLive;	border-radius: 50%;	
	}
	&:before {animation: euiBeaconPulseSmall_live 2s infinite ease-out;}
	&:after {animation: euiBeaconPulseSmall_live 2s  infinite ease-out 0.4s;}
}
@keyframes euiBeaconPulseSmall_live {
		0% {-webkit-transform: scale(0); transform: scale(0);opacity: 1;}
		50% {opacity: 0.6;}
		100% {-webkit-transform: scale(1.6); transform: scale(1.4);opacity: 0;}
	}
/*----- END LIVE STREAM ------*/

