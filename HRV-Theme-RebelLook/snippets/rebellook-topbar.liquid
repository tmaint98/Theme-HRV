{%if settings.rebellook_header_topbar_show%}
<link rel="preload" href="{{ 'rebellook-topbar.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rebellook-topbar.scss.css' | asset_url }}">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'rebellook-topbar.js' | asset_url }}"></script>
{%if settings.rebellook_shop_google_translate%}
{%- include 'theme_google_translate_js' -%}
{%endif%}
<div class="rebellook-topbar">
  <div class="topbar-left">
  </div>
  <div class="topbar-center">
    <ul class="rebellook-topbar-slide swiper">
      <div class="swiper-nav swiper-prev">
        <span class="icon icon--2">
          <svg width="15px" height="15px" viewBox="-78.5 0 512 512" xmlns="http://www.w3.org/2000/svg" ><path d="M257 64L291 98 128 262 291 426 257 460 61 262 257 64Z" /></svg>
        </span>
        <span class="icon icon--1">
          <svg width="20px" height="20px" viewBox="0 0 24 24" id="left" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color"><path id="primary" d="M21,11H5.41l5.3-5.29A1,1,0,1,0,9.29,4.29l-7,7a1,1,0,0,0,0,1.42l7,7a1,1,0,0,0,1.42,0,1,1,0,0,0,0-1.42L5.41,13H21a1,1,0,0,0,0-2Z"></path></svg>
        </span>
      </div>
        <div class="swiper-wrapper">
          {%for i in (1..3)%}
            {%capture desc%}rebellook_topbar_sale_desc_{{i}}{%endcapture%}
  				{% if settings[desc] != empty %}
          <div class="swiper-slide">
    				<div class="slide-item">
              <div class="desc">{{settings[desc]}}</div>
            </div>
          </div>
  				{% endif %}
          {%endfor%}
        </div>
      <div class="swiper-nav swiper-next">
        <span class="icon icon--1">
          <svg width="20px" height="20px" viewBox="0 0 24 24" id="right" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color"><path id="primary" d="M21.71,11.29l-7-7a1,1,0,0,0-1.42,1.42L18.59,11H3a1,1,0,0,0,0,2H18.59l-5.3,5.29a1,1,0,0,0,0,1.42,1,1,0,0,0,1.42,0l7-7A1,1,0,0,0,21.71,11.29Z" ></path></svg>
        </span>
        <span class="icon icon--2">
          <svg width="15px" height="15px" viewBox="-77 0 512 512" xmlns="http://www.w3.org/2000/svg" ><path d="M98 460L64 426 227 262 64 98 98 64 294 262 98 460Z" /></svg>
        </span>
      </div>
			</ul>
  </div>
  <div class="topbar-right">
    {%if settings.rebellook_shop_google_translate%}
      <div class="topbar-translate">
          {%- include 'theme_google_translate' -%}
      </div>
    {%endif%}
  </div>
</div>
{% endif %}
