{%if settings.show_rebellook_about_us_blog%}
{%- unless has_heading -%}
  <link rel="preload stylesheet" href="{{ 'rl-page-heading.scss.css' | asset_url }}" as="stylesheet">
  {%- assign has_heading = true -%}
{%- endunless -%}
<link rel="preload stylesheet" href="{{ 'rl-about-us-blog.scss.css' | asset_url }}" as="stylesheet">
<div class="rebellook-about-us-blog wow fadeInUp" data-wow-delay="0.5s" data-wow-duration="0.8s" data-handle="{{settings.rebellook_about_us_blog_handle}}">
  <div class="container">
    <div class="heading-title text-center">
      <h2 class="title2">
        {% if settings.rebellook_about_us_blog_title != empty %}{{ settings.rebellook_about_us_blog_title }}{% else %}{{ blogs.[settings.rebellook_about_us_blog_handle].title }}{% endif %}
      </h2>
    </div>
    {% if blogs[settings.rebellook_about_us_blog_handle].articles.size == 0 %}
      <p class="txt-noArticle">Chưa có bài viết nào trong mục này</p>
      {% else %}
      <div class="row list-blog">
        {% for article in blogs[settings.rebellook_about_us_blog_handle].articles limit: 3 %}
          {% include 'article-image' with article: article %}
          <article class="article-loop">
            <div class="article-inner">
              <div class="article-image">
                <a href="{{ article.url}}" class="blog-post-thumbnail" title="{{ article.title }}" rel="nofollow">
                  <img
                    class="lazyload"
                    {% if forloop.first %}
                    data-src="{{ imageUrl | product_img_url : '1024x1024' }}"
                    {% else %}
                    data-src="{{ imageUrl | product_img_url : 'grande' }}"
                    {% endif %}
                    src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                    alt="{{ article.title }}">
                </a>
              </div>
              <div class="article-detail">
                <div class="article-post-meta">
                  <span class="author">bởi: {{ article.author }}</span>
                  <span> - </span>
                  <span class="date">
                    <time pubdate datetime="{{ article.published_at | date: '%d Tháng %m, %Y' }}">{{ article.published_at | date: '%d Tháng %m, %Y' }}</time>
                  </span>
                </div>
                <div class="article-title">
                  <h3 class="post-title">
                    <a href="{{ article.url}}" title="{{ article.title }}">{{ article.title }}</a>
                  </h3>
                </div>
                <p class="entry-content">{{ article.content | strip_html | truncatewords: 30 }}</p>
                <a href="{{article.url}}" class="btn-link">Xem chi tiết</a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if settings.rebellook_about_us_blog_btn != empty and blogs[settings.rebellook_about_us_blog_handle].articles.size > 3%}
        <div class="btn-more text-center">
        <a href="{{blogs[settings.rebellook_about_us_blog_handle].url}}" class="button">{{ settings.rebellook_about_us_blog_btn }}</a>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>
{%endif%}