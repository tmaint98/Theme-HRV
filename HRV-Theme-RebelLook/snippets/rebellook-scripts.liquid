<script defer>
  // === Cấu hình: danh sách URL cần bắt ===
  const watchUrls = ['/add.js', '/update.js', '/change.js'];
  // === Hàm kiểm tra URL có trùng pattern nào không ===
  function matchWatchedUrl(url) {
    try {
      const pathname = new URL(url, location.origin).pathname;
      return watchUrls.some(u => pathname.endsWith(u));
    } catch (err) {
      return watchUrls.some(u => url.indexOf(u) !== -1);
    }
  }
  // === Hook fetch ===
  (function() {
    if (!window.fetch) return;
    const _fetch = window.fetch;
    window.fetch = async function(input, init) {
      const url = (typeof input === 'string') ? input : input.url;
      const matched = matchWatchedUrl(url);
      if (matched) {
        // Trước khi request gửi đi
        $(document).trigger('ajax:before', { url, init });
      }
      const response = await _fetch.apply(this, arguments);
      if (matched) {
        // Sau khi có response
        response.clone().text().then(body => {
          $(document).trigger('ajax:after', {
            url,
            status: response.status,
            ok: response.ok,
            body
          });
        }).catch(() => {
          $(document).trigger('ajax:after', {
            url,
            status: response.status,
            ok: response.ok
          });
        });
      }
      return response;
    };
  })();
  // === Hook XMLHttpRequest (nếu dùng $.ajax) ===
  (function() {
    const _open = XMLHttpRequest.prototype.open;
    const _send = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function(method, url) {
      this._method = method;
      this._url = url;
      return _open.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function(body) {
      const matched = this._url && matchWatchedUrl(this._url);
      if (matched) {
        $(document).trigger('ajax:before', { url: this._url, method: this._method, body });
      }
      this.addEventListener('load', () => {
        if (matched) {
          $(document).trigger('ajax:after', {
            url: this._url,
            method: this._method,
            status: this.status,
            response: this.responseText
          });
        }
      });
      return _send.apply(this, arguments);
    };
  })();
  // === Ví dụ: lắng nghe các event chung ===
  $(document).on('ajax:before', function(e, data) {
    //console.log('🟡 Request bắt đầu:', data.url);
  });
  $(document).on('ajax:after', function(e, data) {
    //console.log('🟢 Request hoàn tất:', data.url, 'Status:', data.status);
    //console.log('Bắt đầu lấy data từ cart sau khi request')
    jQuery.getJSON('/cart.js', function(cart, textStatus) {
      $('.rebellook-count-holder .rebellook-count').html(cart.item_count);
      //console.log('Data Cart Updated')
    })
  });
</script>

