<link rel="preload stylesheet" href="{{ 'rl-index-marquee.scss.css' | asset_url }}" as="stylesheet">
<section class="rebellook-index-marquee wow fadeIn rebellook-index-ajax" id="rebellook-index-marquee" data-wow-delay="0.5s" data-wow-duration="0.8s">
  <div class="marquee">
      <div class="marquee__inner">
          {% for j in (1..3) %}
            {%for i in (1..6)%}
              {%capture show%}rebellook_index_marquee_show_{{i}}{%endcapture%}
              {%capture title%}rebellook_index_marquee_title_{{i}}{%endcapture%}
              {%capture img%}rebellook_index_marquee_img_{{i}}.jpg{%endcapture%}
              {%if settings[show]%}
                <div class="marquee__inner--item">
                  <img src="{{ img | asset_url}}" alt="{{settings[title]}}" />
                  <div class="title">{{settings[title]}}</div>
                </div>
              {%endif%}
            {%endfor%}
          {% endfor %}
      </div>
    </div>
</section>
