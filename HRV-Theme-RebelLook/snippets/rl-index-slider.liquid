
  <link rel="preload" href="{{ 'rl-index-slider.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rl-index-slider.scss.css' | asset_url }}">
  <script fetchpriority="low" type="text/javascript" defer src="{{ 'rl-index-slider.js' | asset_url }}"></script>


<div class="rebellook-index-slider" id="rebellook-index-slider">
  <div class="container-fluid index-slider">
    <div class="swiper">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <div class="slider-item">
            <div class="slide--image">
              <picture>
                <source media="(max-width: 767px)" srcset="{{ 'rebellook_index_slider_1_img_mb.jpg' | asset_url}}" />
                <source media="(min-width: 768px)" srcset="{{ 'rebellook_index_slider_1_img.jpg' | asset_url}}" />
                <img src="{{ 'rebellook_index_slider_1_img.jpg' | asset_url }}" alt="{{ settings.rebellook_index_slider_1_title | strip_html | escape }}" class="swiper-lazy" loading="lazy" />
              </picture>
            </div>
            <div class="slide--content">
              <div class="content">
                {% if settings.rebellook_index_slider_1_title != '' %}
                  <h2 class="title">
                    <span class="text-ani">{{ settings.rebellook_index_slider_1_title | newline_to_br }}</span>
                  </h2>
                {% endif %}
                {% if settings.rebellook_index_slider_1_desc != '' %}
                  <div class="desc">
                    <span class="text-ani">{{ settings.rebellook_index_slider_1_desc | newline_to_br }}</span>
                  </div>
                {% endif %}
                {% if settings.rebellook_index_slider_1_btn_1 != '' or settings.rebellook_index_slider_1_btn_2 != '' %}
                  <div class="btn-more">
                    {% if settings.rebellook_index_slider_1_btn_1 != '' %}
                      <a href="{{ settings.rebellook_index_slider_1_link_1 }}" class="button">{{ settings.rebellook_index_slider_1_btn_1 }}</a>
                    {% endif %}
                    {% if settings.rebellook_index_slider_1_btn_2 != '' %}
                      <a href="{{ settings.rebellook_index_slider_1_link_2 }}" class="button">{{ settings.rebellook_index_slider_1_btn_2 }}</a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {%- for i in (2..4) -%}
          {% capture show_slide %}rebellook_index_slider_{{i}}_show{% endcapture %}
          {% capture image %}rebellook_index_slider_{{i}}_img.jpg{% endcapture %}
          {% capture image_mb %}rebellook_index_slider_{{i}}_img_mb.jpg{% endcapture %}
          {% capture title %}rebellook_index_slider_{{i}}_title{% endcapture %}
          {% capture desc %}rebellook_index_slider_{{i}}_desc{% endcapture %}
          {% capture btn1 %}rebellook_index_slider_{{i}}_btn_1{% endcapture %}
          {% capture link1 %}rebellook_index_slider_{{i}}_link_1{% endcapture %}
          {% capture btn2 %}rebellook_index_slider_{{i}}_btn_2{% endcapture %}
          {% capture link2 %}rebellook_index_slider_{{i}}_link_2{% endcapture %}
          {%- if settings[show_slide] -%}
            <div class="swiper-slide">
              <div class="slider-item">
                <div class="slide--image">
                  <picture>
                    <source media="(max-width: 767px)" srcset="{{ image_mb | asset_url}}" />
                    <source media="(min-width: 768px)" srcset="{{ image | asset_url}}" />
                    <img src="{{ image | asset_url }}" alt="{{ settings[title] | strip_html | escape }}" class="swiper-lazy" loading="lazy" />
                  </picture>
                </div>
                <div class="slide--content">
                  <div class="content">
                    {% if settings[title2] != '' %}
                      <h2 class="title">
                        <span class="text-ani">{{ settings[title] | newline_to_br }}</span>
                      </h2>
                    {% endif %}
                    {% if settings[desc] != '' %}
                      <div class="desc">
                        <span class="text-ani">{{ settings[desc] | newline_to_br }}</span>
                      </div>
                    {% endif %}
                    {% if settings[btn1] != '' or settings[btn2] != '' %}
                      <div class="btn-more">
                        {% if settings[btn1] != '' %}
                          <a href="{{ settings[link1] }}" class="button">{{ settings[btn1] }}</a>
                        {% endif %}
                        {% if settings[btn2] != '' %}
                          <a href="{{ settings[link2] }}" class="button">{{ settings[btn2] }}</a>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
        <div class="swiper-pagination"></div>
