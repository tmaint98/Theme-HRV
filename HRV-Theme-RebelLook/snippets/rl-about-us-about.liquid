{%if settings.show_rebellook_about_us_about%}
{%- unless has_heading -%}
  <link rel="preload" href="{{ 'rl-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rl-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{%- endunless -%}
<link rel="preload" href="{{ 'rl-about-us-about.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rl-about-us-about.scss.css' | asset_url }}">

<div class="rebellook-about-us-about wow fadeInUp" data-wow-delay="0.5s" data-wow-duration="0.8s">
  <div class="container-fluid">
    {%if settings.rebellook_about_us_about_title_1 != empty %}
      <div class="about-desc text-center">{{settings.rebellook_about_us_about_title_1 | newline_to_br}}</div>
    {%endif%}
    <div class="row">
      <div class="col-lg-7 col-12">
        <div class="about-banner">
          <img src="{{ 'rebellook_about_us_about_img.jpg' | asset_url }}" alt="{{settings.rebellook_about_us_about_title_2}}" />
        </div>
      </div>
      <div class="col-lg-5 col-12">
        <div class="about-content">
          <div class="heading-title">
            {% if settings.rebellook_about_us_about_title_2 != empty %}<h2 class="title2">{{settings.rebellook_about_us_about_title_2}}</h2>{%endif%}
            <div class="desc">{{settings.rebellook_about_us_about_desc}}</div>
          </div>
          {% if settings.rebellook_about_us_about_btn != empty%}
          <div class="btn-more">
            <a href="{{settings.rebellook_about_us_about_link}}" class="button">{{settings.rebellook_about_us_about_btn}}</a>
          </div>
          {%endif%}
        </div>
      </div>
    </div>
    {% if settings.rebellook_about_us_about_marquee_desc != '' %}
    <div class="marquee">
      <div class="marquee__inner">
        {% for i in (1..4) %}
          <div class="marquee__inner--item">{{ settings.rebellook_about_us_about_marquee_desc }}</div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
{%endif%}