{%if settings.show_rebellook_about_us_logo%}
<link rel="preload" href="{{ 'rl-about-us-partner.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rl-about-us-partner.scss.css' | asset_url }}">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'rl-about-us-partner.js' | asset_url }}"></script>

<div class="rebellook-about-us-partner wow fadeInUp" data-wow-delay="0.5s" data-wow-duration="0.8s">
  <div class="container">
    <div class="list-logo swiper">
      <div class="swiper-wrapper">
      {% for i in (1..10) %}
        {% capture show %}rebellook_about_us_logo_show_{{i}}{%endcapture%}
        {% capture img %}rebellook_about_us_logo_img_{{i}}.jpg{%endcapture%}
        {% capture alt %}rebellook_about_us_logo_alt_{{i}}{%endcapture%}
        {% if settings[show] %}
          <div class="swiper-slide">
            <div class="item-logo">
              <img src="{{ img | asset_url}}" alt="{{settings[alt]}}" />
            </div>
          </div>
        {% endif %}
      {% endfor %}
      </div>
    </div>
  </div>
</div>
{%endif%}