:root {
  --rl-index-time: {{ settings.rebellook_index_marquee_time }}s;
}
@keyframes index-marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
.rebellook-index-marquee {
  padding: 60px 0;
  .marquee {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    &__inner {
      display: inline-flex;
      gap: 30px;
      animation: index-marquee var(--rl-index-time) linear infinite;
      &--item {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        gap: 30px;
        font-size: 80px;
        font-weight: 600;
        text-transform: uppercase;
        line-height: 1;
        img {
          max-height: 110px;
        }
        .title {
          flex: 0 0 auto;
        }
      }
    }
  }
  .marquee:hover .marquee__inner {
    animation-play-state: paused;
  }

  @media(max-width: 991px) {
    .marquee__inner--item {
      font-size: 60px;
    }
  }
  @media(max-width: 767px) {
    padding: 30px 0;
    .marquee__inner--item {
      font-size: 35px;
      img {
        max-height: 70px;
      }
    }
  }
}