{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
.rebellook-index-review {
  padding: 80px 0;
  border-bottom: 1px solid #eaeaea;
  .list-review {
    position: relative;
  }
  .review-item {
    .icon1 {
      margin-bottom: 15px;
      svg {
        width: 80px;
        height: 80px;
        fill: currentcolor;
      }
    }
    .icon2 {
      width: 10px;
      height: 20px;
      clip-path: polygon(100% 0, 100% 100%, 50% 79%, 0 100%, 0 0);
      background: currentcolor;
      margin: 0 auto 15px;
    }
    .desc {
      font-size: 28px;
      font-family: "{{ webfont_title }}"
      , sans-serif;
      margin-bottom: 15px;
    }
  }
  .swiper-nav {
    position: absolute;
    top: calc(50% - 20px);
    width: 40px;
    height: 40px;
    z-index: 2;
    svg {
      fill: currentcolor;
    }
    &.swiper-prev {
      left: 0;
    }
    &.swiper-next {
      right: 0;
    }
  }
  @media(min-width: 1200px) {
    .list-review {
      max-width: 70%;
      margin: 0 auto;
    }
    .swiper-nav {
      &.swiper-prev {
        left: -80px;
      }
      &.swiper-next {
        right: -80px;
      }
    }
  }
  @media(max-width: 991px) {
    .review-item {
      padding: 0 30px;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .review-item {
      .icon1 {
        svg {
          width: 50px;
          height: 50px;
        }
      }
      .desc {
        font-size: 18px;
      }
    }
    .swiper-nav {
      top: calc(50% - 10px);
      width: 25px;
      height: 25px;
      svg {
        width: 25px;
        height: 25px;
      }
    }
  }
}