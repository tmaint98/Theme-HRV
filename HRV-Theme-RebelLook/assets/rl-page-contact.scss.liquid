{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
$bgTime: {{ settings.rebellook_contact_time_top_bg }};
$colorTime: {{ settings.rebellook_contact_time_top_color }};
$contactBtnBg: {{ settings.rebellook_page_contact_bg_btn }};
$contactBtnColor: {{ settings.rebellook_page_contact_color_btn }};

.rebellook-layout-contact {
  .button {
    color: $contactBtnColor;
    background-color: $contactBtnBg;
  }
  .rebellook-contact-map {
    position: relative;
    .map {
      iframe {
        width: 100%;
        height: 600px;
      }
    }
    .time-top {
      position: absolute;
      top: 20%;
      left: 0;
      width: 100%;
      height: auto;
      display: flex;
      align-items: center;
      .time-box {
        background: $bgTime;
        color: $colorTime;
        border: 1px solid $colorTime;
        max-width: 400px;
        padding: 50px;
        .title{
          font-size: 36px;
          font-family: "{{ webfont_title }}", sans-serif;
        }
        .desc{
          font-size: 18px;
          margin-bottom: 20px;
        }
        .list-time{
          li{
            padding: 10px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            
            
            & ~ li{
              border-top: 1px solid rgba($colorTime, 0.2);
            }
          }
        }
      }
    }
    @media(max-width: 767px){
      .time-top{
        .time-box{
          padding: 20px;
          .title{
          font-size: 26px;
        }
        .desc{
          font-size: 16px;
          margin-bottom: 15px;
        }
        }
      }
    }
  }
  .rebellook-contact-info {
    padding: 60px 0;
    .title-info{
        font-size: 22px;
      margin-bottom: 15px;
      & ~ .title-info{
        margin-top: 20px;
      }
      }
    .desc-info{
      span{
        font-size: 12px;
        color: #ff0000;
      }
    }
    .list-info {
      .info {
        li {
            margin-bottom: 8px;
        }
        &.info-email,&.info-phone {
          a {
            color: currentcolor;
            position: relative;
            display: inline-block;
             &:before {
              content: '';
              position: absolute;
              bottom: -2px;
              left: 50%;
              width: 0;
              height: 1px;
              background: currentcolor;
              transition: all 0.3s;
            }
             &:hover {
              span {
                opacity: 1;
              }
               &:before {
                left: 0;
                width: 100%;
              }
            }
          }
        }
      }
    }
    .rebellook-contact-social {
    display: flex;
    flex-flow: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    i,
    svg {
      width: 36px;
      height: 36px;
      line-height: 34px;
      font-size: 19px;
      text-align: center;
      border: 1px solid;
      border-radius: 50%;
      -webkit-transition: all 0.2s ease;
      -moz-transition: all 0.2s ease;
      transition: all 0.2s ease;
    }
    .social-svg {
      svg {
        padding: 6px;
        fill: currentColor;
      }
      &.svg-lazada {
        svg path {
          stroke: currentColor;
        }
      }
    }
  }
    .form {
      .contact-form .input-group {
        position: relative;
        margin-bottom: 20px;
        &.group-text {
          margin-bottom: 0;
        }
        .icon-form {
          position: absolute;
          top: 10px;
          left: 0;
          z-index: 1;
          svg {
            fill: currentcolor;
            opacity: 0.6;
          }
        }

        input,
        textarea {
          background: none;
          border: 1px solid currentcolor;
          border-radius: 0;
          padding: 12px 10px;
          box-shadow: none;

        }
        input {
          height: 50px;
        }
        textarea {
          height: 100px;
        }
        input[type="checkbox"] {
          width: 18px;
          height: 24px;
          flex: 0 0 18px;
          appearance: checkbox;
          -webkit-appearance: checkbox;
          margin-right: 10px;
        }
        label {
          margin: 0 0 8px;
          opacity: 0.6;
          flex: 0 0 calc(100% - 30px);
          font-weight: 600;
          display: none;
        }
         &:not(.error) {
          input,
          textarea {
             &:focus {
               + .line:before {
                width: 100%;
              }
            }
          }
           &:hover {
            .line:before {
              width: 100%;
            }
          }
        }

      }
      .cta-submitform {
        margin-top: 30px;
        .icon {
          margin-right: 10px;
          svg {
            fill: $contactBtnColor;
          }
        }

      }
      .sitebox-recaptcha {
        margin-top: 15px;
      }
    }
    @media(min-width: 1200px) {
      .form-info {
        padding: 0 100px;
      }
      .form {
        padding-left: 40px;
      }
    }
    @media(max-width: 767px) {
      padding: 40px 0;
      
      .list-info {
        .info {
           &:not(:last-child) {
            margin-bottom: 20px;
          }
          li {
            font-size: 14px;
          }
          &.info-phone {
            a {
              font-size: 18px;
            }
          }
        }
      }
      .form {
        margin-top: 30px;
        .contact-form .input-group {
          margin-bottom: 15px;
          input,
          textarea {
            font-size: 14px;
          }
        }
        .btn-form {
          text-align: center;
        }
      }
    }
  }
}


