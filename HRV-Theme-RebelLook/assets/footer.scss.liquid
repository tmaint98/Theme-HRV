$bgFt: {{ settings.rebellook_footer_bg }};
$colorFt: {{ settings.rebellook_footer_color }};

.rebellook-mainFooter {
  background-color: $bgFt;
  color: $colorFt;
  padding-top: 80px;
  a {
    color: $colorFt;
  }
  h2 a {
    color: $colorFt;
  }
  .rebellook-ft-logo {
    img {
      max-height: 60px;
      margin-bottom: 20px;
    }
  }
  .rebellook-widget-footer {
    .rebellook-title-footer,
    .rebellook-fter-title {
      position: relative;
      margin-bottom: 30px;
      font-weight: 600;
      color: $colorFt;
      font-size: 20px;
      letter-spacing: 1px;
      @media(max-width: 991px) {
        border-bottom: 1px dashed rgba($colorFt, 0.3);
        margin: 0;
        padding: 15px 0;
         &:not(.rebellook-fter-title):before {
          content: "\f107";
          font-family: "FontAwesome";
          position: absolute;
          top: 12px;
          right: 10px;
          text-align: center;
          font-size: 22px;
          transition: all 0.4s ease-in-out 0s;
          -moz-transition: all 0.4s ease-in-out 0s;
          -o-transition: all 0.4s ease-in-out 0s;
          -webkit-transition: all 0.4s ease-in-out 0s;
          -ms-transition: all 0.4s ease-in-out 0s;
        }
        &.opened {
          font-weight: 700;
        }
         &.opened:before {
          -moz-transform: rotate(-180deg);
          -webkit-transform: rotate(-180deg);
          -o-transform: rotate(-180deg);
          -ms-transform: rotate(-180deg);
          transform: rotate(-180deg);
        }
      }
      @media(max-width: 767px) {
        font-size: 15px;
      }
    }
    .desc {
      margin: 0;
    }
    .desc-newsletter {
      margin-bottom: 20px;
    }
  }
  .rebellook-footer-newsletter {
    .rebellook-newsletter-form {
      .rebellook-newsletter-input {
        background: $colorFt;
        color: $bgFt;
        border: none;
        outline: none;
        border-radius: 0;
        &::-webkit-input-placeholder {
          color: $bgFt !important;
        }
        &::-moz-placeholder {
          color: $bgFt !important;
        }
         &:-moz-placeholder {
          color: $bgFt !important;
        }
      }
      .contact-form .input-group {
        flex-flow: nowrap;
        input {
          font-size: 14px;
        }
      }
      .btn-more .btn-icon {
        border: none;
        outline: none;
        padding: 0 20px;
        height: 100%;
        display: flex;
        align-items: center;
        border-left: 1px solid $bgFt;
        background: $colorFt;
        color: $bgFt;
        svg {
          fill: currentcolor;
        }
         &:hover {
          opacity: 0.8;
        }
      }
    }
  }
  .rebellook-logo-footer {
    margin-top: 20px;
  }
  .rebellook-footerNav-social {
    display: flex;
    flex-flow: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    i,
    svg {
      width: 36px;
      height: 36px;
      line-height: 34px;
      font-size: 19px;
      text-align: center;
      border: 1px solid;
      border-radius: 50%;
      -webkit-transition: all 0.2s ease;
      -moz-transition: all 0.2s ease;
      transition: all 0.2s ease;
    }
    .social-svg {
      svg {
        padding: 6px;
        fill: currentColor;
      }
      &.svg-lazada {
        svg path {
          stroke: currentColor;
        }
      }
    }
  }
  .rebellook-address-footer {
    margin-bottom: 20px;
    li {
      margin-bottom: 10px;
      i {
        width: 20px;
      }
    }
  }
  .rebellook-footer-link {
    li ~ li {
      margin-top: 10px;
    }
    li a{
      position: relative;
      &:before{
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 1px;
        background: currentcolor;
        transition: all 0.3s;
      }
      &:hover{
        &:before{
          width: 100%;
        }
      }
    }
  }
  .rebellook-footer-copyright {
    margin-top: 40px;
    padding: 35px 0;
    border-top: 1px solid rgba($colorFt, 0.1);
    p {
      margin: 0;
    }
    .rebellook-footer-link {
      display: flex;
      align-items: center;
      justify-content: end;
      gap: 15px 20px;
      text-transform: uppercase;
      .item ~ .item {
        position: relative;
        margin: 0;
         &:before {
          content: '-';
          position: absolute;
          top: 0;
          left: -12px;
          font-weight: 600;
        }
      }
    }
  }
  .rebellook-footer-payment {
    display: flex;
    flex-flow: wrap;
    align-items: center;
    gap: 5px;
    .payment-item {
      img {
        max-height: 30px;
      }
    }
  }
  @media(min-width: 992px) {
    .rebellook-footer-about {
      padding-right: 40px;
    }
    .rebellook-footer-newsletter {
      .rebellook-newsletter-title h3 {
        margin: 0;
      }
      .rebellook-newsletter-form {
        .contact-form .input-group {
          margin: 0;
        }
      }
    }
  }
  @media(max-width: 991px) {
    &.has-toolbar {
      padding-bottom: 45px;
    }
    .rebellook-widget-footer {
       &:last-child {
        .rebellook-title-footer {
          border: none;
        }
        .rebellook-content-footer {
          border-top: 1px dashed rgba($colorFt, 0.3);
        }
      }
      .rebellook-block-collapse {
        display: none;
        padding: 15px 0;
      }
    }
    .rebellook-footer-newsletter {
      .rebellook-newsletter-title h3 {
        font-size: 30px;
        margin-bottom: 20px;
      }
    }
    .rebellook-footer-copyright {
      margin-top: 25px;
      padding: 25px 0;
      text-align: center;
      > .row {
        gap: 15px;
      }
      .rebellook-footer-link {
        justify-content: center;
      }
    }
    .rebellook-footer-payment {
      justify-content: center;
      .payment-item img {
        max-height: 25px;
      }
    }
  }
  @media(max-width: 767px) {
    padding-top: 50px;
    .rebellook-footer-about .title {
      font-size: 26px;
      br {
        content: '';
         &:after {
          content: ' ';
        }
      }
    }
    .rebellook-footer-newsletter {
      .rebellook-newsletter-title h3 {
        font-size: 22px;
      }
    }
  }
}