.section-breadcrumb {
  position: relative;
  color: {{ settings.rebellook_about_us_breadcrumb_color }};
   &:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(27, 26, 26, 0.8) 0%, rgba(27, 26, 26, 0.6) 10%, rgba(27, 26, 26, 0) 65%, rgba(27, 26, 26, 0) 100%);
  }
  a {
    color: {{ settings.rebellook_about_us_breadcrumb_color }};
  }
  h1 {
    font-size: 50px;
    margin-bottom: 15px;
  }
  .breadcrumb-shop{
    border: none;
    
    .breadcrumb{
      gap: 15px;
      justify-content: center;
      background: none;
      padding: 0;
      margin: 0;
      > li ~ li{
        position: relative;
        &:before{
          content: '/';
          margin-right: 10px;
          
        }
      }
    }
  }
  .banner-content {
    padding: 120px 0 60px;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media(max-width: 767px) {
    h1 {
      font-size: 28px;
    }
    .banner-content {
      padding: 60px 0;
    }
  }
}