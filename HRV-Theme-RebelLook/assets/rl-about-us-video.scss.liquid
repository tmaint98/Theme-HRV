.rebellook-about-us-video {
  padding: 0;
  .banner-video {
    position: relative;

     &:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.2);
    }
    .video-play {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      .title {
        transition: all 300ms linear 0ms;
      }
      .icon-play {
        position: relative;
        width: 140px;
        height: 140px;
        padding-top: 20px;
        padding-bottom: 20px;
        padding-inline-start: 40px;
        transition: all 300ms linear 0ms;

        svg {
          &.play-stroke {
            max-width: 100%;
            max-height: 100%;
            circle {
              stroke-width: 2px;
              stroke: currentcolor;
            }
            .stroke-1 {
              opacity: 0.45;
            }
            .stroke-2 {
              stroke-dasharray: 940;
              stroke-dashoffset: 940;
              transition: stroke-dashoffset 0.6s cubic-bezier(0.22,1,0.36,1);
            }
          }
          &.play-icon {
            position: absolute;
            top: 40%;
            left: 55%;
            fill: currentcolor;
            transition: all 300ms linear 0ms;
          }

        }
      }
    }
     &:hover {
      .video-play {
        .title {
          transform: translateX(45px);
        }
        .icon-play {
          padding-top: 0;
          padding-bottom: 0;
          padding-inline-start: 0;
          svg {
            &.play-stroke {
              .stroke-2 {
                stroke-dashoffset: 0;
              }
            }
            &.play-icon {
              left: 40%;
            }
          }
        }
      }

    }
  }
  @media(max-width: 767px) {
    
  }
}
