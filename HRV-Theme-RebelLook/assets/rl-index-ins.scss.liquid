@keyframes ins-hover-underline-forward {
  0% {
    background-position: 100% 100%;
    background-size: 100% 2px;
  }

  35% {
    background-position: 100% 100%;
    background-size: 0 2px;
  }

  36% {
    background-position: 0 100%;
    background-size: 0 2px;
  }

  100% {
    background-position: 0 100%;
    background-size: 100% 2px;
  }
}
.rebellook-index-ins {
  padding: 80px 0;

  .heading-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    .title2 {
      margin: 0;
    }
  }
  .btn-link {
    position: relative;
    display: inline-flex;
    padding-bottom: 2px;
    background-repeat: no-repeat;
    background-image: linear-gradient(90deg, currentColor 0, currentColor 100%);
    background-position: 100% 100%;
    background-size: 100% 2px;
    transition: background-size 0.5s cubic-bezier(0.25, 0.46, 0.35, 0.94)
    , color 0.2s ease-out
    , background-color 0.2s ease-out
    , border-color 0.2s ease-out;
    text-decoration: none;
    text-transform: uppercase;
    color: currentColor;
     &:hover {
      animation: ins-hover-underline-forward 0.5s cubic-bezier(0.29, 0.15, 0.34, 0.88) 1 forwards;
    }
  }
  .swiper-wrapper {
    transition-timing-function: linear !important;
    .swiper-slide {
      .item-ins {
        padding: 0 20px;
        position: relative;
        .icon {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          display: flex;
          justify-content: center;
          align-items: center;
          span {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 70px;
            height: 70px;
            padding: 15px;
            background: #fff;
            transition: all 300ms linear 0ms;
            transform: scale(1.5);
            visibility: hidden;
            opacity: 0;
            svg {
              fill: #333;
            }
          }

        }
         &:hover {
          .icon span {
            transform: scale(1);
            visibility: visible;
            opacity: 1;

          }
        }
      }
      &[data-order="2"] {
        .item-ins {
          padding: 20px 20px 0;
          .icon {
            top: 20px;
            height: calc(100% - 20px)
          }
        }
      }
      &[data-order="3"] {
        .item-ins {
          padding: 40px 20px 0;
          .icon {
            top: 40px;
            height: calc(100% - 40px)
          }
        }
      }
      &[data-order="4"] {
        .item-ins {
          padding: 60px 20px 0;
          .icon {
            top: 60px;
            height: calc(100% - 60px)
          }
        }
      }
    }
  }
  @media(max-width: 991px){
    .swiper-wrapper {
    .swiper-slide {
      &[data-order="2"] {
        .item-ins {
          padding: 10px 10px 0;
          .icon {
            top: 10px;
            height: calc(100% - 10px)
          }
        }
      }
      &[data-order="3"] {
        .item-ins {
          padding: 20px 10px 0;
          .icon {
            top: 20px;
            height: calc(100% - 20px)
          }
        }
      }
      &[data-order="4"] {
        .item-ins {
          padding: 30px 10px 0;
          .icon {
            top: 30px;
            height: calc(100% - 30px)
          }
        }
      }
    }
  }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
  }
}