$colorBanner: {{ settings.rebellook_index_col_banner_color }};
.wow:not(.animated) {
  visibility: hidden;
  opacity: 0;
}
.rebellook-index-col-banner {
  padding: 40px 0;
  .list-banner {
    gap: 40px 0;
  }
  .banner-item {
    position: relative;
    .item-img {
      position: relative;
      overflow: hidden;
      img {
        transition: all 0.5s;
      }
    }
    .item-content {
      * {
        color: $colorBanner;
      }
      padding-top: 30px;
      .title {
        font-size: 26px;
        margin-bottom: 10px;
        position: relative;
        display: inline-block;
         &:before {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          width: 0;
          height: 1px;
          background: $colorBanner;
          transition: all 0.3s;
        }
         &:hover {
           &:before {
            width: 100%;
          }
        }
      }
    }
    &--1,
    &--4 {
      .item-content {
        position: absolute;
        bottom: 0;
        left: 0;
        padding: 40px;
      }
    }
    &--2 {
      .item-img {
        &,
        img {
          border-radius: 100px 0 0 0;
        }
      }
    }
    &--3 {
      .item-img {
        &,
        img {
          border-radius: 0 100px 0 0;
        }
      }
    }
     &:hover {
      .item-img img {
        transform: scale(1.03);
      }
    }
  }
  @media(min-width: 1200px) {
    .banner-item {
      padding: 0 20px;
    }
  }
  @media(max-width: 991px) {
    .banner-item {
      &--1 {
        order: 1;
      }
      &--2 {
        order: 2;
      }
      &--3 {
        order: 4;
      }
      &--4 {
        order: 3;
      }
    }

    @media(max-width: 767px) {
      .list-banner {
        gap: 15px 0;
      }
      .banner-item {
        .item-content {
          padding-top: 15px;
          .title {
            font-size: 20px;
            margin-bottom: 5px;
          }
        }
        &--1,
        &--4 {
          .item-content {
            padding: 20px 20px 20px 40px;
          }
        }
        }
      }
    }
  }