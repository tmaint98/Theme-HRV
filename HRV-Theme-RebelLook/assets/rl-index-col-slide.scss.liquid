.rebellook-index-col-slide {
  padding: 80px 0;
  border-top: 1px solid #eaeaea;
  .heading-title{
    display: flex;
    flex-flow: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    .title2{
      margin: 0;
    }
    .btn-link{
      position: relative;
      color: currentcolor;
      text-decoration: none;
      &:before{
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: currentcolor;
        transition: all 0.3s;
      }
      &:hover{
        &:before{
          width: 100%;
        }
      }
    }
  }
  .list-pro {
    align-items: stretch;
    height: 100%;
    padding: 0 0 40px;
    .swiper-slide {
      border: 1px solid #eaeaea;
      margin-inline-end: -1px;
      padding: 25px;
      transition: all 0.3s;
      height: auto;
       &:hover {
        box-shadow: 0 0 0 1px currentcolor inset
        , 0 5px 43px 0 rgba(27, 26, 26, 0.15)
      }
      .rebellook-product-loop {
        height: 100%;
      }
    }
    .swiper-pagination{
      bottom: 0;
      .swiper-pagination-bullet{
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: transparent;
        position: relative;
        border: 2px solid transparent;
        transition: all 0.3s;
        opacity: 1;
        &:before{
          content: '';
          position: absolute;
          top: 3px;
          left: 3px;
          width: 8px;
          height: 8px;
          border-radius: 50%;
          background: currentcolor;
          transition: all 0.3s;
        }
        &:hover,&.swiper-pagination-bullet-active{
          border-color: currentcolor;
          &:before{
            opacity: 0;
          }
        }
      }
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .list-pro {
      .swiper-slide{
        padding: 5px;
      }
    }
  }
}