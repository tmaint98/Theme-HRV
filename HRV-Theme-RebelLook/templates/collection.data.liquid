{%layout none%}
{%paginate collection.products by settings.collection_pagination_limit %}
{%- assign checkFilter = false -%}
{%- if settings.collection_filter_show -%} {%- assign checkFilter = true -%} {%- endif -%}

{%for product in collection.products%}
	{% include 'rl-product-loop' with page: paginate.current_page, section:'collection' %}
{%endfor%}
{% endpaginate %} 