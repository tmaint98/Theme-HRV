{%layout none%}
{% assign col_handle = '' %}
{% assign col_limit = 0 %}
{%for i in (1..2)%}
  {%capture handle%}radiance_col_slide_{{i}}_handle{%endcapture%}
  {%capture limit%}radiance_col_slide_{{i}}_limit{%endcapture%}
  {%if collection.handle == settings[handle] %}
    {% assign col_handle = settings[handle] %}
    {% assign col_limit = settings[limit] %}
  {%endif%}
{%endfor%}
<div class="swiper-wrapper">
{% for product in collection.products limit: col_limit %}
  <div class="swiper-slide">
    {% include 'rd-product-loop' %}
  </div>
{% endfor %}
</div>