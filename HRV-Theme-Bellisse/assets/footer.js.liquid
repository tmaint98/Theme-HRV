Radiance.Footer = {
		init: function() {
			var that = this;
      that.Radiance_toggleFooter();
      that.Radiance_newsletterForm();
		},
  Radiance_toggleFooter: function(){
		$('.radiance-title-footer').on('click', function(){
			if ($(window).width() < 992) {
				jQuery(this).toggleClass('opened').parent().find('.radiance-block-collapse').stop().slideToggle('medium');
			}
		});
	},
  Radiance_newsletterForm: function(){
		if($('.radiance-newsletter-form').length > 0){
			$('.radiance-newsletter-form form.contact-form').submit(function(e) { 
				var self = $(this);
				if($(this)[0].checkValidity() == true){
					e.preventDefault();
					grecaptcha.ready(function() {
						grecaptcha.execute('6LchSLkqAAAAABVHBpeFgg8N-WgkYsr5fO6GUF_s', {action: 'submit'}).then(function(token) {
							self.find('input[name="g-recaptcha-response"]').val(token);
							$.ajax({
								type: 'POST',
								url:'/account/contact',
								data: $('.radiance-newsletter-form form.contact-form').serialize(),
								success:function(data){		
									if($(data).find('#radiance-newsletter-success').length > 0){
										$('.radiance-newsletter-form .radiance-newsletter-error').html('');
										swal({
											icon: "success",
											className: "radiance-newsletter-form-success",
											title: "Đăng kí thông tin thành công",
											text: "Thông báo sẽ tự động tắt sau 5 giây...",
											button: false,
											timer: 5000,
										});
										e.target.reset();
									} else {
										$('.radiance-newsletter-form .radiance-newsletter-error').html('Địa chỉ email không hợp lệ');
									}
								},	
							})
						}); 
					});
				}
			});
		}
	},
};
(function() {
  Radiance.Footer.init();
})();
