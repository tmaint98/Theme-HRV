{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
$colorMain: {{ settings.radiance_index_team_main }};
.radiance-index-team {
  padding: 80px 0;
  .heading-title {
    .title1 {
      color: $colorMain;
    }
  }
  .team-item {
    .item-img {
      position: relative;
      overflow: hidden;
       &:before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.2);
        transition: all 0.3s;
        opacity: 0;
        visibility: hidden;
      }
      img{
        width: 100%;
      }
      .item-link {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
        opacity: 0;
        visibility: hidden;
        a {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 40px;
          height: 40px;
          border: 1px solid #fff;
          color: #fff;
          border-radius: 50%;
          transition: all 0.3s;
          svg {
            fill: currentcolor;
          }
           &:hover {
            background: $colorMain;
            border-color: $colorMain;
          }
        }
      }
       &:hover {
        .item-link,
         &:before {
          opacity: 1;
          visibility: visible;
        }
      }
    }
    .item-content {
      padding: 30px 15px 0;
      .name {
        font-size: 24px;
        font-family: "{{ webfont_title }}"
        , sans-serif;
        font-weight: 600;
        margin-bottom: 10px;
      }
      .position {
        font-size: 14px;
      }
    }
  }
  @media(max-width: 991px){
    .list-team{
      gap: 40px 0;
    }
  }
  @media(max-width: 767px){
    scroll-margin-block-start: 110px;
    padding: 40px 0;
    .team-item {
    .item-content {
      padding: 20px 15px 0;
      .name {
        font-size: 18px;
        margin-bottom: 5px;
      }
    }
  }
  }
}