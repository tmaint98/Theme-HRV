Radiance.Header = {
		init: function() {
			var that = this;
      that.Radiance_scrollFixedHeader();
      that.Radiance_actionClick();
      that.Radiance_clickIconsHeader();
      that.Radiance_menuSidebar();
      that.Radiance_modalLive();
		  that.Radiance_hiddenBtnLive();
      that.Radiance_menuScroll();
      {%if settings.show_radiance_header_btn%}
      that.Radiance_HeaderformBooking($('#modal-header-form'));
      {%endif%}
		},
  Radiance_scrollFixedHeader: function(){
		var $header = $(".radiance-mainHeader--height");
		var curScrollTop = 0;
		$(window).scroll(function(e) {
			var scroll = $(window).scrollTop();
			if(scroll > $header.height()){
				$header.addClass('radiance-fixed-header');
			}
			else{
				$header.removeClass('radiance-fixed-header');
			}
		});
	},
  Radiance_actionClick: function(){
		$(document).on('click', function (event) {
			var class_name = event.target.className.animVal;
			if(class_name == 'radiance-svg-ico-account' || class_name == 'radiance-svg-ico-search'){}
			else{
				if (!$(event.target).closest('.radiance-header-action_dropdown').length) {
					$('.radiance-header-action-item').removeClass('radiance-js-action-show');
				}
			}
		})
	},
  Radiance_clickIconsHeader: function(){
		$('.radiance-header-action_clicked').click(function(e){
			e.preventDefault();		
			if($(this).parents('.radiance-header-action-item').hasClass('radiance-js-action-show')){
				$('body').removeClass('radiance-locked-scroll');
				$(this).parents('.radiance-header-action-item').removeClass('radiance-js-action-show');
				if($(window).width() < 992){
					if ($(this).parents('.radiance-header-action-item').hasClass('radiance-header-action_cart')) {
						$('.radiance-siteCart-mobile__overlay').removeClass('radiance-show-cart');
						$('body').removeClass('radiance-locked-scroll').removeClass('radiance-body-showcart');
					}
				}
			}
			else{
				$('body').removeClass("radiance-locked-scroll-menu");
				$('.radiance-header-action-item').removeClass('radiance-js-action-show');
				$('body').addClass('radiance-locked-scroll');
				$(this).parents('.radiance-header-action-item').addClass('radiance-js-action-show');
				if($(window).width() < 992){
					if ($(this).parents('.radiance-header-action-item').hasClass('radiance-header-action_cart'))  {

						$('.radiance-siteCart-mobile').addClass('radiance-show-cart');
						$('body').removeClass('radiance-locked-scroll').addClass('radiance-body-showcart');
					}
				}
			}		
		});	
		$('.radiance-siteCart-mobile__header').click(function() {
			if ($(this).parents('.radiance-siteCart-mobile').hasClass('radiance-show-cart')) {
				$(this).parents('.radiance-siteCart-mobile').removeClass('radiance-show-cart');
				$('body').removeClass('radiance-locked-scroll').removeClass('radiance-body-showcart');
				$('.radiance-header-action-item.radiance-header-action_cart').removeClass('radiance-js-action-show');
			} else {	
				$('body').addClass('radiance-body-showcart');
				$(this).parents('.radiance-siteCart-mobile').addClass('radiance-show-cart');

			}
		});
		$('.radiance-siteCart-mobile__overlay').on('click', function(e){
			$(this).parents('.radiance-siteCart-mobile').removeClass('radiance-show-cart');
			$('body').removeClass('radiance-locked-scroll').removeClass('radiance-body-showcart');
			$('.radiance-header-action-item.radiance-header-action_cart').removeClass('radiance-js-action-show');
		})
		$('body').on('click', '#radiance-sitenav-overlay', function(e){
			$('body').removeClass('radiance-locked-scroll');
			$('.radiance-header-action-item').removeClass('radiance-js-action-show');
		});
		$('body').on('click', '#radiance-sitenav-overlay,.sitenav-content .btnclose', function(e){
			$('body').removeClass('radiance-locked-scroll').removeClass("radiance-locked-scroll-menu");
			$('.radiance-header-action-item').removeClass('radiance-js-action-show');
		});
		$('.radiance-activeCartChecked').click(function() {
			$('body').addClass('radiance-locked-scroll');
			$('.radiance-header-action-item').removeClass('radiance-js-action-show');
			$('.radiance-sidebar-main').addClass('radiance-is-show-right');
			$('.radiance-sidebar-main .radiance-sitenav-cart').addClass('radiance-show');
		});
		$('.radiance-activeMenuChecked').click(function() {
			if($('.radiance-sidebar-main .radiance-sitenav-wrapper.radiance-sitenav-menu').length == 0){
				$.ajax({
					url: '/index?view=header-load-menu',
					success:function(data){
						$('.radiance-sidebar-main').append(data);
						setTimeout(function() {
							if($('.addThis_listSharing').hasClass('active')){
								$('.addThis_listSharing').removeClass('active');
								$('.addThis_listSharing').fadeOut(150);	
							}
							$('body').addClass('radiance-locked-scroll');
							$('.radiance-header-action-item').removeClass('radiance-js-action-show');
							$('.radiance-sidebar-main').addClass('radiance-is-show-left');
							$('.radiance-sidebar-main .radiance-sitenav-menu').addClass('radiance-show');
						},100);
						Radiance.Header.Radiance_menuSidebar();
						Radiance.Header.Radiance_closeSidebarMain();
            if($(window).width() < 992){
              $('.template-index .radiance-menuList-links a').each(function() {
                let href = $(this).attr('href');
                if (href && href.includes('#')) {
                  let hash = href.substring(href.indexOf('#'));
                  $(this).attr('href', hash);
                }
              });
              $('.template-index .radiance-menuList-links a').click(function(){
                $('.radiance-sidebar-main').removeClass('radiance-is-show-left');
              })
            }
            {%if settings.Radiance_shop_google_translate%}
            if($(window).width() < 992){
              var currentLang_mb = localStorage.getItem("selectedLang"),
            currentLangFlag_mb = localStorage.getItem("selectedLangFlag");
        
            if (currentLang_mb) {
              document.documentElement.setAttribute("lang", currentLang_mb);
            }
            changeLanguage(currentLang_mb,currentLangFlag_mb);
            }
            {%endif%}
					}
				});
			}else{
				if($('.addThis_listSharing').hasClass('active')){
					$('.addThis_listSharing').removeClass('active');
					$('.addThis_listSharing').fadeOut(150);	
				}
				$('body').addClass('radiance-locked-scroll');
				$('.radiance-header-action-item').removeClass('radiance-js-action-show');
				$('.radiance-sidebar-main').addClass('radiance-is-show-left');
				$('.radiance-sidebar-main .radiance-sitenav-menu').addClass('radiance-show');
			}
		});
    $('.radiance-activeInfoChecked').click(function() {
			$('body').addClass('radiance-locked-scroll');
			$('.radiance-header-action-item').removeClass('radiance-js-action-show');
			$('.radiance-sidebar-main').addClass('radiance-is-show-right');
			$('.radiance-sidebar-main .radiance-sitenav-info').addClass('radiance-show');
		});
		$('.radiance-sidebar-overlay, .radiance-btn-sitenav-close').on('click', function(e){
			$('body').removeClass('radiance-locked-scroll').removeClass('radiance-body-showcart');
			$(this).parents('.radiance-sidebar-main').removeClass('radiance-is-show-right');
			$(this).parents('.radiance-sidebar-main').removeClass('radiance-is-show-left');
			$('.radiance-sidebar-main .radiance-sitenav-wrapper').removeClass('radiance-show');
		});
    
            
     
	},
  Radiance_menuSidebar: function(){
		$('.radiance-plus-nClick1').click(function(e){
			e.preventDefault();
			$(this).parents('.radiance-level0').toggleClass('opened');
			$(this).parents('.radiance-level0').children('ul').slideToggle(200);
		});
		$('.radiance-plus-nClick2').click(function(e){
			e.preventDefault();
			$(this).parents('.radiance-level1').toggleClass('opened');
			$(this).parents('.radiance-level1').children('ul').slideToggle(200);
		});
		$('.radiance-plus-nClick3').click(function(e){
			e.preventDefault();
			$(this).parents('.radiance-level2').toggleClass('opened');
			$(this).parents('.radiance-level2').children('ul').slideToggle(200);
		});
		/*jQuery('.sidebox-title .htitle').click(function(){
			$(this).parents('.group-sidebox').toggleClass('is-open').find('.sidebox-content-togged').slideToggle('medium');
		}); */
	},
  Radiance_closeSidebarMain: function(){
		$('.radiance-sidebar-overlay, .radiance-btn-sitenav-close').on('click', function(e){
			$('body').removeClass('radiance-locked-scroll');
			$(this).parents('.radiance-sidebar-main').removeClass('radiance-is-show-right');
			$(this).parents('.radiance-sidebar-main').removeClass('radiance-is-show-left');
			$('.radiance-sidebar-main .radiance-sitenav-wrapper').removeClass('radiance-show');
			jQuery('body').removeClass('radiance-mainBody-mbcart').removeClass('radiance-body-showcart');
		})
	},
  Radiance_modalLive: function(){
		$('.radiance-header-box-live .radiance-btn-live').click(function(){
			$('.radiance-modal-live').toggleClass('opened');
		});
		$('.radiance-box-live-mb .radiance-btn-live').click(function(){
			$('.radiance-modal-live').toggleClass('opened');
		});
		$('.radiance-btn-close--live').click(function(){
			$('.radiance-modal-live').removeClass('opened');
		});
	},
	Radiance_hiddenBtnLive: function(){
		setTimeout(function(){
			$('.radiance-box-live-mb').removeClass('hidden');
		},500);

		$('.radiance-btn-close').click(function(){
			$('.radiance-box-live-mb').addClass('hidden');
		});
	},
  Radiance_menuScroll: function(){
    $(".radiance-menuList-main a,.radiance-menuList-links a").each(function(e){
		$(this).click(function(e){	
			var destination = $(this).attr('href');
			if ( destination != '/' && window.location.pathname == '/' ) {
				e.preventDefault();
				if ( $(destination).offset() != undefined ) {
					/*if ( $('.radiance-mainHeader--height').hasClass('radiance-fixed-header')) {
						var scrollTo = $(destination).offset().top - 0;
					} else {
						var scrollTo = $(destination).offset().top - 0;
					}*/
          var scrollTo = $(destination).offset().top - 0;
					$('html,body').animate({scrollTop: scrollTo},500);
          
				}
			}
      
		});
	});
  },
  Radiance_HeaderformBooking: function($id){
		var today = new Date();
		var dd = today.getDate();
		var mm = today.getMonth()+1; //January is 0!
		var yyyy = today.getFullYear();
		var h = today.getHours();
		var m = today.getMinutes();
		if(h<10){h='0'+h} if(m<10){m='0'+m} 
		if(dd<10){dd='0'+dd} if(mm<10){mm='0'+mm} 
		today =yyyy+'-'+mm+'-'+dd;
	
		$id.find('#your_date').val(today);
		//$('#your_time').val(h + ':' + m);
		function checkSelect(obj) {
			var name = $id.find(obj).attr("data-valid");

			$id.find("."+name+"-validation").html("");
			$id.find(obj).css("border","");

			if($id.find(obj).val() == 'none' || $id.find(obj).val() == 'undefined'  || $id.find(obj).val() == undefined) {
				$id.find(obj).css("border","#FF0000 1px solid");
				$id.find("."+name+"-validation").html("Vui lòng chọn thông tin tại đây");
				return false;
			}
			return true;
		}
		function checkEmpty(obj) {
			var name = $id.find(obj).attr("data-valid");

			$id.find("."+name+"-validation").html("");
			$id.find(obj).css("border","");

			if($id.find(obj).val() == "" || $id.find(obj).val() == 'null' || $id.find(obj).val() == null  || $id.find(obj).val() == 'undefined'  || $id.find(obj).val() == undefined) {
				$id.find(obj).css("border","#FF0000 1px solid");
				$id.find("."+name+"-validation").html("Vui lòng điền thông tin tại đây");
				return false;
			}
			return true;
		}
		function checkEmail(obj) {
			var result_ph = true;

			var name = $id.find(obj).attr("data-valid");
			$id.find("."+name+"-validation").html("");
			$id.find(obj).css("border","");

			result_ph = checkEmpty(obj);

			if(!result_ph) {
				$id.find(obj).css("border","#FF0000 1px solid");
				$id.find("."+name+"-validation").html("Vui lòng điền thông tin tại đây");
				return false;
			}

			var email_regex = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
			result_ph = email_regex.test($id.find(obj).val());

			if(!result_ph) {
				$id.find(obj).css("border","#FF0000 1px solid");
				$id.find("."+name+"-validation").html("Địa chỉ Email không hợp lệ");
				return false;
			}

			return result_ph;
		}
		function checkPhone(obj) {
			var result = true;

			var name = $id.find(obj).attr("data-valid");
			$id.find("."+name+"-validation").html("");
			$id.find(obj).css("border","");

			result = checkEmpty(obj);

			if(!result) {
				$id.find(obj).css("border","#FF0000 1px solid");
				$id.find("."+name+"-validation").html("Vui lòng điền thông tin tại đây");
				return false;
			}

			var phone_regex = /(^0[2-9]\d{8}$)|(^01\d{9}$)/;
			result = phone_regex.test($id.find(obj).val());

			if(!result) {
				$id.find(obj).css("border","#FF0000 1px solid");
				$id.find("."+name+"-validation").html("Số điện thoại không hợp lệ");
				return false;
			}

			return result;
		}
    var valid = false;
		function validate(){
			var name = $id.find('.form-booking #full_name').val();
			var phone = $id.find('.form-booking #your_phone').val();
			var email = $id.find('.form-booking #your_email').val();
			
			//debugger;
			if(name != '' && name != null && checkPhone($id.find(".form-booking #your_phone")) && checkEmail($id.find(".form-booking #your_email"))){
				valid = true;
				//valid = valid && checkPhone($(".form-booking #your_phone"));
			}
			else{
				valid = false;
			}
			if(valid == true){
				$id.find("#btn-booking-send").removeClass('btn-disabled').attr("disabled",false);
			}
			else{
				$id.find("#btn-booking-send").addClass('btn-disabled').attr("disabled",true);
			}
		}
    
		$id.find('.form-booking #full_name').on('change keyup blur',function(){
			checkEmpty($id.find('.form-booking #full_name'));
      validate();
		})
		$id.find('.form-booking #your_phone').on('change keyup blur',function(){
			checkPhone($(this));
      validate();
		})
		$id.find('.form-booking #your_email').on('change keyup blur',function(){
			checkEmail($(this));
      validate();
		})
    $id.find('.form-booking .input-group select').change(function(){
      checkSelect($(this));
      validate();
		})

		$id.find('#btn-booking-send').click(function(e){
			e.preventDefault() ;
			if(checkEmpty($id.find(".form-booking #full_name")) && checkPhone($id.find(".form-booking #your_phone")) && checkEmail($id.find(".form-booking #your_email"))){
				let check_form = false;
				debugger;
				{%if settings.rd_form_booking == 'google-sheet'%}
					check_form = true;
				{%endif%}
				 if(check_form){
					 let unindexed_array = $id.find(".form-booking form").serializeArray();
					 let indexed_array = {};
					 let url = $id.find(".form-booking form").attr('action');
					 $.map(unindexed_array, function(n, i){
						 indexed_array[n['name']] = n['value'];
					 });
					 //debugger;
					 $.ajax({
						 type: 'POST',
						 url: url,
						 async : false,
						 data: indexed_array,
						 dataType: 'json',
						 complete: function() {
							 setTimeout(function(){
								 //$('#modal-booking').modal('hide');
								 $('#mymodal_success').modal('show');
							 },300);
							 setTimeout(function(){
								 $('#mymodal_success').modal('hide');
							 },5000);	
						 },
						 error: function(XMLHttpRequest, textStatus) {
							 console.log('err', textStatus );
						 }
					 });
				 }
				 else{
					const self = $(this).parents('form');
              let namee = self.find("#full_name").val(),
              phonee = self.find("#your_phone").val(),
              emaill = self.find("#your_email").val(),
              message = "{%if settings.rd_form_service != ''%}{{settings.rd_form_service}}: {%else%}Dịch vụ: {%endif%}";
              message += self.find("#rd_form_service").val();
              message += "\nNgày: " + self.find("#your_date").val();
               message += "\n{%if settings.rd_form_content != ''%}{{settings.rd_form_content}}: {%else%}Mô tả: {%endif%} " + self.find("#your_content").val();
             grecaptcha.ready(function() {
               grecaptcha.execute('6LchSLkqAAAAABVHBpeFgg8N-WgkYsr5fO6GUF_s', {action: 'submit'}).then(function(token) {
                 self.find('input[name="g-recaptcha-response"]').val(token);
                  $.ajax({
                   type: 'POST',
                   url:'/contact',
                   data: "form_type=contact&__RequestVerificationToken="+self.find('input[name="__RequestVerificationToken"]').val()+"&utf8=✓&contact[name]="+namee+"&contact[phone]="+phonee+"&contact[email]="+emaill+"&contact[body]="+message+"&g-recaptcha-response="+self.find('input[name="g-recaptcha-response"]').val(),
                   success:function(data){
                     self.trigger("reset")
                     setTimeout(function(){
    									 $('#mymodal_success').modal('show');
    								 },300);
    								 setTimeout(function(){
    									 $('#mymodal_success').modal('hide');
    								 },5000);	
                   }
                 })
               })
             })
				 }
				}
		});
		$("#mymodal_success").on('hidden.bs.modal', function(){
					 location.reload();
		});	
	},
};
(function() {
  Radiance.Header.init();
})();