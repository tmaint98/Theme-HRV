$colorMain: {{ settings.radiance_index_gallery_main }};
.radiance-index-gallery {
  padding: 80px 0;
  .heading-title {
    .title1 {
      color: $colorMain;
    }
  }
  .list-img {
    display: grid;
    grid-template-areas: 'img1 img2 img3 img3' 'img4 img4 img5 img6';
    grid-template-columns: repeat(4,1fr); 
    gap: 30px;
    .item{
      img{
        width: 100%;
      }
      &:nth-child(1){
        grid-area: img1;
      }
      &:nth-child(2){
        grid-area: img2;
      }
      &:nth-child(3){
        grid-area: img3;
      }
      &:nth-child(4){
        grid-area: img4;
      }
      &:nth-child(5){
        grid-area: img5;
      }
      &:nth-child(6){
        grid-area: img6;
      }
    }
}
  @media(max-width: 767px){
    scroll-margin-block-start: 110px;
    padding: 40px 0;
    .list-img {
      grid-template-areas: 'img1' 'img2' 'img3' 'img4' 'img5' 'img6';
    grid-template-columns: 1fr; 
    gap: 15px;
}
  }
}