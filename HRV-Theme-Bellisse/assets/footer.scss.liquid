$bgFt: {{ settings.radiance_footer_bg }};
$colorFt: {{ settings.radiance_footer_color }};
$bgFtBtn: {{ settings.radiance_footer_bg_btn }};
$colorFtBtn: {{ settings.radiance_footer_color_btn }};
$colorHover: {{settings.shop_text_hover_color}}; 

.radiance-mainFooter {
  background-color: $bgFt;
  color: rgba($colorFt, 0.8);
  padding-top: 80px;
  font-size: 14px;
  .row{
    margin: 0;
  }
  a {
    &:not(:hover){
      color: rgba($colorFt, 0.8);
    }
  }
  h2 a{
    &:not(:hover){
    color: $colorHover;
    }
  }
  .radiance-ft-logo {
    img {
      max-height: 60px;
      margin-bottom: 20px;
    }
  }
  .radiance-widget-footer {
    .radiance-title-footer,
    .radiance-fter-title {
      position: relative;
      margin-bottom: 28px;
      font-weight: 600;
      color: $colorFt;
      font-size: 20px;
      letter-spacing: 1px;
      @media(max-width: 991px) {
        border-bottom: 1px dashed rgba($colorFt, 0.3);
        margin: 0;
        padding: 15px 0;
         &:not(.radiance-fter-title):before {
          content: "\f107";
          font-family: "FontAwesome";
          position: absolute;
          top: 12px;
          right: 10px;
          text-align: center;
          font-size: 22px;
          transition: all 0.4s ease-in-out 0s;
          -moz-transition: all 0.4s ease-in-out 0s;
          -o-transition: all 0.4s ease-in-out 0s;
          -webkit-transition: all 0.4s ease-in-out 0s;
          -ms-transition: all 0.4s ease-in-out 0s;
        }
        &.opened {
          font-weight: 700;
        }
         &.opened:before {
          -moz-transform: rotate(-180deg);
          -webkit-transform: rotate(-180deg);
          -o-transform: rotate(-180deg);
          -ms-transform: rotate(-180deg);
          transform: rotate(-180deg);
        }
      }
      @media(max-width: 767px) {
        font-size: 15px;
      }
    }
    .desc {
      margin: 0;
    }
    .desc-newsletter {
      margin-bottom: 20px;
    }
  }
  
  .radiance-newsletter {
      margin-top: 40px;
    }
  

  .radiance-footer-newsletter {
    .radiance-newsletter-form {
      .radiance-newsletter-input {
        background: rgba($colorFt, 0.1);
        border: none;
        outline: none;
        border-radius: 0;
        color: $colorFt;
        &::-webkit-input-placeholder {
          color: $colorFt !important;
        }
        &::-moz-placeholder {
          color: $colorFt !important;
        }
         &:-moz-placeholder {
          color: $colorFt !important;
        }
      }
      .contact-form .input-group {
        flex-flow: nowrap;
        gap: 5px;
        input {
          font-size: 14px;
        }
      }
      .btn-more .btn-icon {
        border: none;
        outline: none;
        padding: 0 20px;
        height: 100%;
        display: flex;
        align-items: center;
        background: $bgFtBtn;
        color: $colorFtBtn;
        svg {
          fill: currentcolor;
        }
         &:hover {
          opacity: 0.8;
        }
      }
    }
  }
  .radiance-logo-footer {
    margin-top: 20px;
  }
  .radiance-footerNav-social {
    display: flex;
    flex-flow: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    i,
    svg {
      width: 36px;
      height: 36px;
      line-height: 34px;
      font-size: 19px;
      text-align: center;
      border: 1px solid;
      border-radius: 50%;
      -webkit-transition: all 0.2s ease;
      -moz-transition: all 0.2s ease;
      transition: all 0.2s ease;
    }
    .social-svg {
      svg {
        padding: 6px;
        fill: currentColor;
      }
      &.svg-lazada {
        svg path {
          stroke: currentColor;
        }
      }
    }
  }
  .radiance-address-footer {
    margin-bottom: 20px;
    li {
      margin-bottom: 10px;
      i {
        width: 20px;
      }
      &.address-phone {
        font-size: 22px;
        font-weight: 600;
      }
    }
  }
  .radiance-footer-link {
    li ~ li {
      margin-top: 10px;
    }
    a{
      position: relative;
      &:before{
        content: "";
        position: absolute;
        width: 0;
        height: 1px;
        left: auto;
        right: 0;
        bottom: 0;
        background-color: $colorHover;
        -ms-transition: all .4s ease;
        -o-transition: all .4s ease;
        -moz-transition: all .4s ease;
        -webkit-transition: all .4s ease;
        transition: all .4s ease;
      }
      &:hover{
        &:before{
          width: 100%;
          left: 0;
          right: auto;
        }
      }
    }
  }
  .radiance-footer-copyright {
    margin-top: 40px;
    padding: 35px 0;
    border-top: 1px solid rgba($colorFt, 0.1);
    p {
      margin: 0;
    }
  }
  .radiance-payment {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 30px;
    img{
      max-width: 36px;
    }
}
  @media(min-width: 992px) {
    .radiance-footer-newsletter {
      .radiance-newsletter-title h3 {
        margin: 0;
      }
      .radiance-newsletter-form {
        .contact-form .input-group {
          margin: 0;
        }
      }
    }
  }
  @media(max-width: 991px) {
    &.has-toolbar {
      padding-bottom: 45px;
    }
    .radiance-widget-footer {
       &:last-child {
        .radiance-title-footer {
          border: none;
        }
        .radiance-content-footer {
          border-top: 1px dashed rgba($colorFt, 0.3);
        }
      }
      .radiance-block-collapse {
        display: none;
        padding: 15px 0;
      }
      .radiance-newsletter {
        margin-top: 0;
        .radiance-title-footer {
          border-top: 1px dashed rgba($colorFt, 0.3);
        }
      }
    }
    
    .radiance-footer-newsletter {
      .radiance-newsletter-title h3 {
        font-size: 30px;
        margin-bottom: 20px;
      }
    }
    .radiance-footer-copyright {
      margin-top: 25px;
      padding: 25px 0;
      text-align: center;
      > .row {
        gap: 15px;
      }
      .radiance-footer-link {
        justify-content: center;
      }
    }
    
  }
  @media(max-width: 767px) {
    padding-top: 50px;
    .radiance-footer-about .title {
      font-size: 26px;
      br {
        content: '';
         &:after {
          content: ' ';
        }
      }
    }
    .radiance-footer-newsletter {
      .radiance-newsletter-title h3 {
        font-size: 22px;
      }
    }
  }
}