{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
$colorMain: {{ settings.radiance_index_form_main }};
$bgForm: {{ settings.radiance_index_form_bg }};
$colorForm: {{ settings.radiance_index_form_color }};
.radiance-index-form {
  padding: 80px 0;
  background-image: url("{{ 'radiance_index_form_img.jpg' | asset_url}}");
  background-size: cover;
  background-position: center;
  color: $colorForm;
  .heading-title {
    .title1 {
      color: $colorMain;
    }
  }
  .index-form {
    padding: 100px;
    background: $bgForm;
    color: $colorForm;
  }
  .form-box {
    .contact-form .input-group {
      input,
      select,
      textarea {
        color: $colorForm;
        height: 45px;
        width: 100%;
        font-weight: 400;
        padding: 8px 10px;
        background: transparent;
        border: 1px solid rgba($colorForm, 0.2);
        border-radius: 0;
        box-shadow: none;
        -moz-appearance: none;
        -webkit-appearance: none;
        appearance: none;
        &::-webkit-input-placeholder {
          color: $colorForm !important;
        }
        &::-moz-placeholder {
          color: $colorForm !important;
        }
         &:-moz-placeholder {
          color: $colorForm !important;
        }
      }
      select {
        background-image: url("data:image/svg+xml, %3Csvg fill='%23333333' width='15px' height='15px' viewBox='0 -6 524 524' xmlns='http://www.w3.org/2000/svg' %3E%3Ctitle%3Edown%3C/title%3E%3Cpath d='M64 191L98 157 262 320 426 157 460 191 262 387 64 191Z' /%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 10px center;
      }
      textarea {
        height: 100px;
      }
    }
    .button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 15px 30px;
      border: 1px solid $colorMain;
      background: $colorMain;
      color: $bgForm;
      border-radius: 0;
      font-weight: 600;
      text-decoration: none;
      outline: none;
      &.btn-disabled {
        opacity: 0.6;
      }
    }
  }
  .content-item {
    display: flex;
    gap: 15px;
     &:not(:last-child) {
      margin-bottom: 80px;
    }
    > div {
      flex: 0 0 auto;
    }
    .icon {
      width: 70px;
      img {
        border-radius: 50px;
      }
    }
    .title {
      font-size: 18px;
      font-family: "{{ webfont_title }}"
      , sans-serif;
      font-weight: 600;
      margin-bottom: 10px;
    }
    .desc {
      font-size: 14px;
      opacity: 0.8;
    }
  }
  @media(max-width: 991px) {
    .index-form {
      margin-bottom: 40px;
    }
    .content-item {
       &:not(:last-child) {
        margin-bottom: 30px;
      }
    }
  }
  @media(max-width: 767px) {
    scroll-margin-block-start: 110px;
    padding: 25px 0;
    .index-form {
      padding: 40px 20px;
    }
    .heading-title {
      margin-bottom: 15px;
      text-align: center;
    }
    .addcart-area {
      text-align: center;
    }
    .form-box {
      .contact-form .input-group {
      input,
      select,
      textarea {
        font-size: 14px;
      }
      }
      .button {
        padding: 12px 20px;
      }
    }
    .content-item {
       &:not(:last-child) {
        margin-bottom: 30px;
      }
      .icon {
        width: 50px;
      }
    }
  }
}
.modalForm-success {
  svg {
    fill: #009900;
    width: 80px;
    height: 80px;
    margin-bottom: 15px;
  }
  p {
    font-size: 18px;
  }
}