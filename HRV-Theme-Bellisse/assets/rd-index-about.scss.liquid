$colorMain: {{ settings.radiance_index_about_main }};
$bgAbout: {{ settings.radiance_index_about_bg }};
$colorAbout: {{ settings.radiance_index_about_color }};
$bgBtn: {{ settings.radiance_index_about_button }};
$colorBtn: {{ settings.radiance_index_about_button_text }};
.radiance-index-about {

  .about-group {
    margin: 0;
    padding: 40px 0;
    position: relative;
    color: $colorAbout;
     &:before,
     &:after {
      content: '';
      position: absolute;
      top: 0;
      height: 100%;
      background: $bgAbout;
    }
     &:before {
      left: 0;
      width: 54%;
    }
     &:after {
      left: calc(54% + 20px);
      width: 20%;
    }
    > div {
      position: relative;
      z-index: 1;
    }
  }
  .heading-title {
    .title1 {
      color: $colorMain;
    }
  }
  .about-content {
    padding: 0 25px 0 60px;
    .desc {
      font-size: 14px;
    }
  }
  .button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-block;
    padding: 15px 30px;
    line-height: normal;
    color: $colorBtn;
    background-color: $bgBtn;
    border: 0;
    border-radius: 0;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 1px;
    outline: none !important;
    -webkit-transition: all 0.45s;
    transition: all 0.45s;
     &:before {
      content: '';
      background-color: rgba($colorBtn, 0.2);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      z-index: -1;
      transition: all 0.4s ease-in-out;
    }
    @media(min-width: 992px) {
       &:hover,
      &.has-hover,
       &:focus {
        border-color: transparent;
      }
       &:hover:before,
       &.has-hover:before,
       &:focus:before {
        opacity: 1;
      }
    }
    @media(max-width: 767px) {
      font-size: 12px;
      padding: 8px 15px;
      min-height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
  .btn-more {
    margin-top: 60px;
  }
  @media(max-width: 991px){
    .about-group {
      gap: 60px;
      &:after{
        content: none;
      }
      &:before{
        width: 100%;
      }
    }
  }
  @media(max-width: 767px){
    scroll-margin-block-start: 110px;
    .about-group {
      gap: 40px;
    }
    .about-content{
      padding: 0;
    }
    .btn-more {
    margin-top: 30px;
  }
  }
}