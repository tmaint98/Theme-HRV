:root{
  --bg-contact-btn: {{settings.radiance_page_contact_bg_btn}};
  --color-contact-btn: {{settings.radiance_page_contact_color_btn}};
}
.radiance-layout-contact {
  .button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-block;
    padding: 18px 45px;
    line-height: normal;
    color: var(--color-contact-btn);
    background-color: var(--bg-contact-btn);
    border: none;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 1px;
    outline: none !important;
    -webkit-transition: all 0.45s;
    transition: all 0.45s;
    @media(min-width: 992px) {
       &:hover,
      &.has-hover,
       &:focus {
        opacity: 0.8;
      }
       
    }
    @media(max-width: 767px) {
      font-size: 12px;
      padding: 8px 15px;
      min-height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
  .sitebox-recaptcha {padding:6px 0 0;text-align: left;font-size: 13px;    clear: both;}
}
.radiance-contact-map {
  .map {
    display: flex;
    iframe {
      min-height: 590px;
    }
  }
  @media(max-width: 767px) {
    .map {
      iframe {
        min-height: 250px;
      }
    }
  }
}
.radiance-contact-info {
  padding: 80px 0;
  .form {
    .contact-form .input-group {
      position: relative;
      margin-bottom: 30px;
      &.group-text {
        margin-bottom: 0;
      }
      .icon-form {
        position: absolute;
        top: 10px;
        left: 0;
        z-index: 1;
        svg {
          fill: currentcolor;
          opacity: 0.6;
        }
      }
      .line {
         &:before {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          width: 0;
          height: 1px;
          background: currentcolor;
          transition: all 0.3s;
        }
      }
      input,
      textarea {
        background: none;
        border: none;
        border-bottom: 1px solid #e6e6e6;
        border-radius: 0;
        padding: 12px 0;
        box-shadow: none;

      }
      input {
        height: 50px;
      }
      textarea {
        height: 100px;
      }
      input[type="checkbox"] {
        width: 18px;
        height: 24px;
        flex: 0 0 18px;
        appearance: checkbox;
        -webkit-appearance: checkbox;
        margin-right: 10px;
      }
      label {
        margin: 0;
        opacity: 0.6;
        flex: 0 0 calc(100% - 30px);
        font-size: 14px;
      }
       &:not(.error) {
        input,
        textarea {
           &:focus {
             + .line:before {
              width: 100%;
            }
          }
        }
         &:hover {
          .line:before {
            width: 100%;
          }
        }
      }

    }
    .cta-submitform {
      margin-top: 30px;
      .icon {
        margin-right: 10px;
        svg {
          fill: var(--color-contact-btn);
        }
      }

    }
  }
  @media(min-width: 1200px) {
    .form {
      padding-left: 50px;
    }
  }
  @media(min-width: 768px) {
    .heading-title {
      .title2 {
        font-size: 28px;
      }
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .list-info {
      .info {
         &:not(:last-child) {
          margin-bottom: 20px;
        }
        li {
          font-size: 14px;
        }
        &.info-phone {
          a {
            font-size: 18px;
          }
        }
      }
    }
    .form {
      margin-top: 30px;
      .contact-form .input-group {
        margin-bottom: 15px;
        input,
        textarea {
          font-size: 14px;
        }
      }
      .btn-form{
        text-align: center;
      }
    }

  }
}