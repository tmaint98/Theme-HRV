<div id="modal-header-form" class="modal fade" role="dialog">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="btn close" data-dismiss="modal">×</button>
				<h4 class="modal-title">{{settings.radiance_index_form_title_2}}</h4>
			</div>
			<div class="modal-body">
				<div class="header-form">
          <div class="form-box form-booking header-formbooking">
            {%if settings.rd_form_booking == 'google-sheet'%}
              <form id="header_formbooking" action="{{settings.rd_gg_link_form}}" data-shop="{{shop.name}}">
                {%include 'index-form'%}
              </form>
            {%else%}
            {%- capture formProductContact -%}
              {%form "contact"%}
                {%include 'index-form'%}
              {%endform%}
              {%- endcapture -%}
              {{ formProductContact | replace: "script","noscript" }}
            {%endif%}
          </div>
        </div>
			</div>
		</div>
	</div>
</div>
