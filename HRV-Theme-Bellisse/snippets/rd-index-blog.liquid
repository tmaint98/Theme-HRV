{% unless has_heading %}
  <link rel="preload" href="{{ 'rd-page-heading.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'rd-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{% endunless %}

<link rel="preload" href="{{ 'rd-index-blog.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rd-index-blog.scss.css' | asset_url }}">
<link href="{{ 'rd-index-blog.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'rd-index-blog.js' | asset_url }}"></script>
<section class="radiance-index-blog" id="{{settings.radiance_index_blog_menu | handle}}">
  <div class="container">
    <div class="heading-title text-center">
      {% if settings.radiance_index_blog_title_1 != empty %}
        <div class="title1">{{ settings.radiance_index_blog_title_1 }}</div>
      {% endif %}
      {% if settings.radiance_index_blog_title_2 != empty %}
        <h2 class="title2">{{ settings.radiance_index_blog_title_2 | newline_to_br }}</h2>
      {% endif %}
    </div>
    <div class="blog-content">
      {% if blogs[settings.radiance_index_blog_handle].articles.size == 0 %}
        <p class="txt-noArticle text-center">Chưa có bài viết nào trong mục này</p>
        {% else %}
        <div class="list-article swiper">
          <div class="swiper-wrapper">
          {% for article in blogs[settings.radiance_index_blog_handle].articles limit: settings.radiance_index_blog_limit %}
            {% include 'article-image' with article: article %}
            <div class="swiper-slide">
            <article class="article-loop">
              <div class="article-inner">
                <div class="article-image">
                  <a href="{{ article.url}}" class="blog-post-thumbnail" title="{{ article.title }}" rel="nofollow">
                    <img
                      class="lazyload"
                      {% if forloop.first %}
                      data-src="{{ imageUrl | product_img_url : '1024x1024' }}"
                      {% else %}
                      data-src="{{ imageUrl | product_img_url : 'grande' }}"
                      {% endif %}
                      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                      alt="{{ article.title }}">
                  </a>
                </div>
                <div class="article-detail">
                  <div class="article-title">
                    <h3 class="post-title">
                      <a href="{{ article.url}}" title="{{ article.title }}">{{ article.title }}</a>
                    </h3>
                  </div>
                  <div class="article-post-meta">
                    <span class="date">
                      <time pubdate datetime="{{ article.published_at | date: '%d Tháng %m, %Y' }}">{{ article.published_at | date: '%d Tháng %m, %Y' }}</time>
                    </span>
                    <span class="author">bởi: {{ article.author }}</span>
                  </div>
                </div>
              </div>
            </article>
            </div>
          {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>