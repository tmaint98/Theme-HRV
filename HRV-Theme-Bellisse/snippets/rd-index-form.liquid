{% unless has_heading %}
  <link rel="preload" href="{{ 'rd-page-heading.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'rd-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{% endunless %}

<link rel="preload" href="{{ 'rd-index-form.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rd-index-form.scss.css' | asset_url }}">
<link href="{{ 'rd-index-form.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'rd-index-form.js' | asset_url }}"></script>
<section class="radiance-index-form" id="{{settings.radiance_index_form_menu | handle}}">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7 col-12">
        <div class="index-form">
        <div class="heading-title">
            {%if settings.radiance_index_form_title_1 != empty%}
            <div class="title1">{{settings.radiance_index_form_title_1}}</div>
              {%endif%}
            {%if settings.radiance_index_form_title_2 != empty%}
            <h2 class="title2">{{settings.radiance_index_form_title_2 | newline_to_br}}</h2>
            {%endif%}
          </div>
          <div class="form-box form-booking">
            {%if settings.rd_form_booking == 'google-sheet'%}
              <form id="formbooking" action="{{settings.rd_gg_link_form}}" data-shop="{{shop.name}}">
                {%include 'index-form'%}
              </form>
            {%else%}
            {%- capture formProductContact -%}
              {%form "contact"%}
                {%include 'index-form'%}
              {%endform%}
              {%- endcapture -%}
              {{ formProductContact | replace: "script","noscript" }}
            {%endif%}
          </div> 
        </div>
      </div>
      <div class="col-lg-5 col-12">
          <div class="form-content">
            {%if settings.show_radiance_index_form_time%}
            <div class="content-item">
              <div class="icon"><img src="{{'radiance_index_form_time_img.jpg' | asset_url}}" alt="{{settings.radiance_index_form_time_title}}" /></div>
              <div class="detail">
                <div class="title">{{settings.radiance_index_form_time_title}}</div>
                <div class="desc">{{settings.radiance_index_form_time_desc | newline_to_br}}</div>
              </div>
            </div>
            {%endif%}
            {%if settings.show_radiance_index_form_address%}
            <div class="content-item">
              <div class="icon"><img src="{{'radiance_index_form_address_img.jpg' | asset_url}}" alt="{{settings.radiance_index_form_address_title}}" /></div>
              <div class="detail">
                <div class="title">{{settings.radiance_index_form_address_title}}</div>
                <div class="desc">{{settings.radiance_index_form_address_desc | newline_to_br}}</div>
              </div>
            </div>
            {%endif%}
            {%if settings.show_radiance_index_form_contact%}
            <div class="content-item">
              <div class="icon"><img src="{{'radiance_index_form_contact_img.jpg' | asset_url}}" alt="{{settings.radiance_index_form_contact_title}}" /></div>
              <div class="detail">
                <div class="title">{{settings.radiance_index_form_contact_title}}</div>
                <div class="desc">{{settings.radiance_index_form_contact_desc | newline_to_br}}</div>
              </div>
            </div>
            {%endif%}
          </div>
        </div>
    </div>
  </div>
</section>

{%unless settings.show_radiance_header_btn%}
{%include 'modal-success'%}
{%endunless%}



