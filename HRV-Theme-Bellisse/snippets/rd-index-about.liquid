{%unless has_heading%}
<link rel="preload" href="{{ 'rd-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rd-page-heading.scss.css' | asset_url }}">
{%- assign has_heading = true -%}
{%endunless%}
<link rel="preload" href="{{ 'rd-index-about.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rd-index-about.scss.css' | asset_url }}">
<section class="radiance-index-about" id="{{settings.radiance_index_about_menu | handle}}">
  <div class="container">
    <div class="row align-items-center about-group">
      <div class="col-lg-6 col-12">
        <div class="about-content">
          <div class="heading-title">
            {%if settings.radiance_index_about_title_1 != empty%}
            <div class="title1">{{settings.radiance_index_about_title_1}}</div>
              {%endif%}
            {%if settings.radiance_index_about_title_2 != empty%}
            <h2 class="title2">{{settings.radiance_index_about_title_2 | newline_to_br}}</h2>
            {%endif%}
          </div>
          {%if settings.radiance_index_about_desc != empty%}
            <div class="desc">{{settings.radiance_index_about_desc | newline_to_br}}</div>
            {%endif%}
          {%if settings.radiance_index_about_btn != empty%}
          <div class="btn-more">
            <a href="{{settings.radiance_index_about_link}}" class="button">{{settings.radiance_index_about_btn}}</a>
          </div>
          {%endif%}
        </div>
      </div>
      <div class="col-lg-6 col-12">
        <div class="about-banner">
          <img src="{{ 'radiance_index_about_img.jpg' | asset_url}}" alt="{{settings.radiance_index_about_title_2 | strip_html | escape}}" loading="lazy" decoding="sync" />
        </div>
      </div>
    </div>
    
  </div>
</section>
