<div class="contact-form">
  <div class="row">
    
    <div class="col-sm-6 col-xs-12">
      <div class="input-group">
        <input required type="text" name="{{settings.rd_gg_full_name}}" id="full_name" data-valid="full_name"  class="form-control" placeholder="{{settings.rd_form_full_name}}" aria-describedby="basic-addon1">
      </div>
      <p class="full_name-validation field-error"></p>
    </div>
    <div class="col-sm-6 col-xs-12">
      <div class="input-group">
        <input pattern="[0-9]{10,12}" required type="text" name="{{settings.rd_gg_phone}}" id="your_phone" data-valid="your_phone" class="form-control" placeholder="{{settings.rd_form_phone}}" aria-describedby="basic-addon1">
      </div>
      <p class="your_phone-validation field-error"></p>
    </div>
    <div class="col-sm-6 col-xs-12">
      <div class="input-group">
        <input required type="text" name="{{settings.rd_gg_email}}" id="your_email" data-valid="your_email" class="form-control" placeholder="{{settings.rd_form_email}}" aria-describedby="basic-addon1">
      </div>
      <p class="your_email-validation field-error"></p>
    </div>
    <div class="col-sm-6 col-xs-12">
      <div class="input-group">
        <select class="form-control" id="rd_form_service" data-valid="rd_form_service" name="{{settings.rd_gg_service}}">
          <option value="none">{{settings.rd_form_service}}</option>
          {%for i in (1..10)%}
            {%capture title%}rd_form_service_{{i}}{%endcapture%}
            {%if settings[title]%}
            <option value="{{settings[title]}}">{{settings[title]}}</option>
            {%endif%}
          {%endfor%}
        </select>
      </div>
      <p class="rd_form_service-validation field-error"></p>
    </div>
    <div class="col-sm-12 col-xs-12">
      <div class="input-group">
        <input required type="date" name="{{settings.rd_gg_date}}" id="your_date" data-valid="your_date" class="form-control" placeholder="{{settings.rd_form_date}}" aria-describedby="basic-addon1">
      </div>
    </div>
    <div class="col-sm-12 col-xs-12">
      <div class="input-group">
        <textarea id="your_content" name="{{settings.rd_gg_content}}" class="form-control" placeholder="{{settings.rd_form_content}}"></textarea>
      </div>
      <p class="rd_form_content-validation field-error"></p>
    </div>
    <div class="col-sm-12 col-xs-12">
      <div class="input-group">
        <textarea id="your_body" class="form-control hidden" placeholder=""></textarea>
      </div>
    </div>
    <div class="col-sm-12 col-xs-12">
      <div class="addcart-area">						
        <button type="button" id="btn-booking-send" class="button btn-disabled" disabled>
          <span class="link-title">{{settings.rd_form_btn}}</span>
        </button>
      </div>
    </div>
  </div>
</div>