{% unless has_heading %}
  <link rel="preload" href="{{ 'rd-page-heading.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'rd-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{% endunless %}
<link rel="preload" href="{{ 'rd-index-team.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'rd-index-team.scss.css' | asset_url }}">
<section class="radiance-index-team" id="{{settings.radiance_index_team_menu | handle}}">
  <div class="container">
    <div class="heading-title text-center">
      {% if settings.radiance_index_team_title_1 != empty %}
        <div class="title1">{{ settings.radiance_index_team_title_1 }}</div>
      {% endif %}
      {% if settings.radiance_index_team_title_2 != empty %}
        <h2 class="title2">{{ settings.radiance_index_team_title_2 | newline_to_br }}</h2>
      {% endif %}
    </div>
    <div class="row list-team">
      {%for i in (1..4)%}
        {%capture show%}show_radiance_index_team_{{i}}{%endcapture%}
        {%capture img%}radiance_index_team_{{i}}_img.jpg{%endcapture%}
        {%capture name%}radiance_index_team_{{i}}_name{%endcapture%}
        {%capture position%}radiance_index_team_{{i}}_position{%endcapture%}
        {%capture link1%}radiance_index_team_{{i}}_link_1{%endcapture%}
        {%capture link2%}radiance_index_team_{{i}}_link_2{%endcapture%}
        {%capture link3%}radiance_index_team_{{i}}_link_3{%endcapture%}
        {%capture link4%}radiance_index_team_{{i}}_link_4{%endcapture%}
        {%if settings[show]%}
          <div class="col-lg-3 col-md-6 col-12">
            <div class="team-item">
              <div class="item-img">
                <img src="{{img | asset_url}}" alt="{{settings[name]}}" />
                <div class="item-link">
