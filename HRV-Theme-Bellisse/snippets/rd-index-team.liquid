                </div>
              </div>
              <div class="item-content text-center">
                <div class="name">{{settings[name]}}</div>
                <div class="position">{{settings[position]}}</div>
              </div>
            </div>
          </div>
        {%endif%}
      {%endfor%}
    </div>
  </div>
</section>

