<link rel="preload" href="{{ 'bc-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'bc-page-heading.scss.css' | asset_url }}">
<link rel="preload" href="{{ 'style-contact.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'style-contact.scss.css' | asset_url }}">
<div class="bamboocraft-layout-contact">
  <div class="hidden">{% include 'breadcrumb' %}</div>
  {% if settings.show_bamboocraft_contact_breadcrumb %}
    <section class="bamboocraft-contact-breadcrumb {%if settings.show_bamboocraft_contact_breadcrumb_img_1%}has-icon-1{%endif%} {%if settings.show_bamboocraft_contact_breadcrumb_img_2%}has-icon-2{%endif%}">
      <div class="container">
        <div class="heading-title text-center">
          <div class="title1">{{ settings.bamboocraft_contact_breadcrumb_title_1 }}</div>
          <h1 class="title2">{{ settings.bamboocraft_contact_breadcrumb_title_2 | newline_to_br }}</h1>
        </div>
      </div>
    </section>
  {% endif %}
  <section class="bamboocraft-contact-info">
    <div class="container">
      <div class="row">
        {% if settings.show_bamboocraft_contact_info %}
          <div class="col-lg-5 col-12 content-info {%if settings.show_bamboocraft_contact_info_img%}has-icon{%endif%}">
            {% if settings.bamboocraft_contact_info_title != '' %}
              <div class="heading-title">
              <h2 class="title2 info-title">{{ settings.bamboocraft_contact_info_title }}</h2>
              </div>
            {% endif %}
            <div class="row info-group">
            {% if settings.bamboocraft_contact_address_title != '' %}
              <div class="title-info"><i class="fa fa-map-marker" aria-hidden="true"></i> {{ settings.bamboocraft_contact_address_title}}</div>
            {% endif %}
            <div class="list-info">
              <ul class="info">
                {% for i in (1..3) %}
                  {% capture info %}bamboocraft_contact_address_{{i}}{%endcapture%}
                  {% if settings[info] != '' %}
                    <li>
                      <span>{{ settings[info] }}</span>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
              </div>
            <div class="row info-group">
            {% if settings.bamboocraft_contact_phone_title != '' %}
              <div class="title-info"><i class="fa fa-phone" aria-hidden="true"></i> {{ settings.bamboocraft_contact_phone_title}}</div>
            {% endif %}
            <div class="list-info">
              <ul class="info info-phone">
                {% for i in (1..3) %}
                  {% capture info %}bamboocraft_contact_phone_{{i}}{%endcapture%}
                  {% if settings[info] != '' %}
                    <li>
                      <a href="tel:{{settings[info] | remove: ' '}}">
                        <span>{{ settings[info] }}</span>
                      </a>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
              </div>
            <div class="row info-group">
            {% if settings.bamboocraft_contact_email_title != '' %}
              <div class="title-info"><i class="fa fa-envelope" aria-hidden="true"></i> {{ settings.bamboocraft_contact_email_title}}</div>
            {% endif %}
            <div class="list-info">
              <ul class="info info-email">
                {% for i in (1..3) %}
                  {% capture info %}bamboocraft_contact_email_{{i}}{%endcapture%}
                  {% if settings[info] != '' %}
                    <li>
                      <a href="mailto:{{settings[info]}}">
                        <span>{{ settings[info] }}</span>
                      </a>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
            </div>
            <div class="row info-group">
            {% if settings.bamboocraft_contact_time_title != '' %}
              <div class="title-info"><i class="fa fa-clock-o" aria-hidden="true"></i> {{ settings.bamboocraft_contact_time_title}}</div>
            {% endif %}
            {% if settings.bamboocraft_contact_time_desc != '' %}
              <div class="desc-info">{{ settings.bamboocraft_contact_time_desc | newline_to_br}}</div>
            {% endif %}
            </div>
          </div>
        {% endif %}
        {% if settings.show_bamboocraft_contact_form %}
          <div class="col-lg-7 col-12">
            <div class="form">
              <div class="heading-title">
                {% if settings.bamboocraft_contact_form_title != empty %}
                  <h2 class="title2">{{ settings.bamboocraft_contact_form_title }}</h2>
                {% endif %}
              </div>
              <div id="contactFormWrapper">
          {% form 'contact' %}
          {% if form.posted_successfully? %}
          <div class="alert alert-success">
            Cám ơn bạn đã liên hệ! Chúng tôi sẽ trả lời ngay khi có thể
          </div>
          {% endif %}
          <div class="contact-form">
            <div class="row">
              <div class="col-sm-12 col-xs-12">
                <div class="input-group">
                  <input required type="text" id="form-name" name="contact[name]" class="form-control" placeholder="Tên của bạn" aria-describedby="basic-addon1">
                </div>
              </div>
              <div class="col-sm-6 col-xs-12">
                <div class="input-group">
                  <input required type="text" id="form-email" name="contact[email]" class="form-control" placeholder="Email của bạn" aria-describedby="basic-addon1">
                </div>
              </div>
              <div class="col-sm-6 col-xs-12">
                <div class="input-group">
                  <input pattern="[0-9]{10,12}" id="form-phone" required type="text" name="contact[phone]" class="form-control" placeholder="Số điện thoại của bạn" aria-describedby="basic-addon1">
                </div>
              </div>
              <div class="col-sm-12 col-xs-12">
                <div class="input-group group-text">
                  <textarea required id="form-body" name="contact[body]" class="form-control" placeholder="Nội dung"></textarea>
                </div>
                <div class="sitebox-recaptcha " >
                    This site is protected by reCAPTCHA and the Google
                    <a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy Policy</a> 
                    and <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms of Service</a> apply.
                  </div>	
              </div>
              <div class="col-sm-12 col-xs-12">
                <div class="btn-form">
                  <button class="button dark cta-submitform">
                    <span class="icon"><svg width="22px" height="22px" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 491.022 491.022" style="enable-background:new 0 0 491.022 491.022;" xml:space="preserve"> <g> <g> <path d="M490.916,13.991c-0.213-1.173-0.64-2.347-1.28-3.307c-0.107-0.213-0.213-0.533-0.32-0.747 c-0.107-0.213-0.32-0.32-0.533-0.533c-0.427-0.533-0.96-1.067-1.493-1.493c-0.427-0.32-0.853-0.64-1.28-0.96 c-0.213-0.107-0.32-0.32-0.533-0.427c-0.32-0.107-0.747-0.32-1.173-0.427c-0.533-0.213-1.067-0.427-1.6-0.533 c-0.64-0.107-1.28-0.213-1.92-0.213c-0.533,0-1.067,0-1.6,0c-0.747,0.107-1.493,0.32-2.133,0.533 c-0.32,0.107-0.747,0.107-1.067,0.213L6.436,209.085c-5.44,2.347-7.893,8.64-5.547,14.08c1.067,2.347,2.88,4.373,5.227,5.44 l175.36,82.453v163.947c0,5.867,4.8,10.667,10.667,10.667c3.733,0,7.147-1.92,9.067-5.12l74.133-120.533l114.56,60.373 c5.227,2.773,11.627,0.747,14.4-4.48c0.427-0.853,0.747-1.813,0.96-2.667l85.547-394.987c0-0.213,0-0.427,0-0.64 c0.107-0.64,0.107-1.173,0.213-1.707C491.022,15.271,491.022,14.631,490.916,13.991z M190.009,291.324L36.836,219.218 L433.209,48.124L190.009,291.324z M202.809,437.138V321.831l53.653,28.267L202.809,437.138z M387.449,394.898l-100.8-53.013 l-18.133-11.2l-0.747,1.28l-57.707-30.4L462.116,49.298L387.449,394.898z"/> </g> </g> </svg></span>
                    {{settings.bamboocraft_contact_form_btn}}
                  </button>
                </div>
              </div>
            </div>
          </div>
          {% endform %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
      {% if settings.bamboocraft_google_maps_show %}
          <div class="bamboocraft-contact-map {%if settings.show_bamboocraft_contact_map_img%}has-icon{%endif%}">
            <div class="map">
              {{ settings.bamboocraft_google_maps_code }}
            </div>
          </div>
        {% endif %}
    </div>
  </section>
</div>

