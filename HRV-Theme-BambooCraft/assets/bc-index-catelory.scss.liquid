.bamboocraft-index-catelory {
  padding: 60px 0;
  .catelory-item {
    position: relative;
    overflow: hidden;
     &:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1;
    }
    .img {
      img {
        transition: all 0.5s;
        width: 100%;
      }
    }
    .content {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      z-index: 2;
      color: #fff;
      padding: 40px;
      a {
        color: #fff;
      }
      .title {
        font-size: 32px;
        position: relative;
        display: inline-block;
        margin-bottom: 10px;
         &:before {
          content: '';
          position: absolute;
          bottom: -2px;
          left: 0;
          width: 0;
          height: 1px;
          background: #fff;
          transition: all 0.3s ease-in-out;
        }
         &:hover {
           &:before {
            width: 100%;
          }
        }
      }

      .info {
        margin-bottom: 20px;
        transform: translateY(90%);
        transition: all 0.4s;
      }
      .btn-more {
        transform: translateY(200%);
        opacity: 0;
        transition: all 0.5s;
        .button {
           &:hover {
            opacity: 1;
            color: #000;
            background: #fff;
            border-color: #fff;
          }
        }
      }
    }
     &:hover {
      .img {
        img {
          transform: scale(1.05);
        }
      }
      .content {
        .info,
        .btn-more {
          transform: translateY(-30px);
          opacity: 1;
        }
      }
    }
  }
  @media(max-width: 1199px) {
    .catelory-item {
      .content {
        padding: 20px;
        .title {
          font-size: 24px;
        }
        .info {
          transform: translateY(50%);
        }
      }
    }
  }
  @media(max-width: 991px){
    .row{
      gap: 15px;
    }
  }
  @media(max-width: 767px){
    padding: 30px 0;
    .catelory-item {
      .content {
        .title {
          font-size: 20px;
        }
      }
    }
  }
}