$bgSlide: {{ settings.bamboocraft_index_slider_bg }};
$colorSlide: {{ settings.bamboocraft_index_slider_color }};
@keyframes slide_img {
  from {
    height: 0;
    transform: translate(0, 2%);
  }
  to {
    height: 100%;
    transform: translate(0, 0);
  }
}
@keyframes slide_img_left {
  from {
    transform: translateX(-100%);
  }
  to {
    height: 100%;
    transform: translateX(0);
  }
}
@keyframes slide_img_right {
  from {
    transform: translateX(100%);
  }
  to {
    height: 100%;
    transform: translateX(0);
  }
}
@keyframes slide_content {
  from {
    transform: translateY(110%);
  }
  to {
    transform: translateY(0);
  }
}
@keyframes slide_btn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.bamboocraft-index-slider {
  .button {
    display: inline-block;
    padding: 10px 30px;
    font-weight: 600;
    border: 1px solid;
    color: $colorSlide;
    border-radius: 50px;
    transition: all 0.3s;
    svg {
      fill: currentcolor;
      margin-left: 5px;
    }
     &:hover {
      opacity: 0.8;
    }
  }
  img {
    max-width: 100%;
    vertical-align: middle;
    border-style: none;
  }
  .slider-item {
    position: relative;
    min-height: 850px;
    background: $bgSlide;
    color: $colorSlide;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 40px 0;
  }
  .slide--content {
    width: 50%;
    margin: 0 auto;
    text-align: center;
    .title,
    .desc {
      position: relative;
      overflow: hidden;
      .text-ani {
        display: inline-block;
        transform: translateY(110%);
        line-height: 1.2;
      }
    }
    .title {
      font-size: 110px;
      line-height: 1.1;
      margin-bottom: 15px;
    }
    .desc {
      font-size: 24px;
      font-weight: 600;
    }
    .btn-more {
      margin-top: 40px;
      .button {
        opacity: 0;
      }
    }
  }
  .img-group {
    position: absolute;
    top: 0;
    height: 100%;
    &.has-bg {
       &:before {
        content: '';
        position: absolute;
        top: 0;
        width: 70%;
        height: 100%;
        background-image: var(--bg-img);
        background-size: cover;
      }
    }

    &.img-left {
      width: 28%;
      left: 0;
       &.has-bg:before {
        left: 0;
        background-position: top right;
        transform: translateX(-100%);
      }
      .img {
        position: absolute;
        height: 0;
        overflow: hidden;
        &--2 {
          width: 68%;
          top: 15%;
          left: 26%;
          z-index: 2;
        }
        &--3 {
          width: 52%;
          top: 35%;
          left: 0;
        }
        &--4 {
          width: 36%;
          top: 65%;
          left: 40%;
        }
      }
    }
    &.img-right {
      width: 30%;
      right: 0;
       &.has-bg:before {
        width: 60%;
        right: 0;
        background-position: top left;
        transform: translateX(100%);
      }
      .img {
        position: absolute;
        height: 0;
        overflow: hidden;
        &--2 {
          width: 58%;
          top: 10%;
          right: 0;
        }
        &--3 {
          top: 45%;
          right: 30%;
          width: 52%;
        }
      }
    }

  }
  .swiper {
    .swiper-slide {
      opacity: 0;
      &.swiper-slide-active {
        opacity: 1;
        .title,
        .desc {
          .text-ani {
            animation: slide_content 0.5s forwards 0.8s ease-out;
          }
        }
        .btn-more {
          .button {
            animation: slide_btn 0.5s forwards 1s ease-out;
          }
        }
        .img-group {
          &.img-left {
             &.has-bg:before {
              animation: slide_img_left 0.5s forwards 0.2s ease-out;
            }
            .img {
              &--2 {
                animation: slide_img 1.5s forwards 2s ease-out;
              }
              &--3 {
                animation: slide_img 1.5s forwards 1.5s ease-out;
              }
              &--4 {
                animation: slide_img 1.5s forwards 1s ease-out;
              }
            }
          }
          &.img-right {
             &.has-bg:before {
              animation: slide_img_right 0.5s forwards 0.2s ease-out;
            }
            .img {
              &--2 {
                animation: slide_img 1.5s forwards 1.5s ease-out;
              }
              &--3 {
                animation: slide_img 1.5s forwards 1s ease-out;
              }
            }
          }

        }
      }
    }
    .swiper-nav {
      position: absolute;
      top: calc(50% - 23px);
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: none;
      outline: none;
      color: $colorSlide;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      svg {
        width: 20px;
        height: 20px;
        fill: currentcolor;
        polyline,
        line {
          stroke: currentcolor;
        }
      }
      &.swiper-next {
        right: 15px;
      }
      &.swiper-prev {
        left: 15px;
      }
       &:hover {
        background: rgba($colorSlide, 0.2);
      }
    }
  }
  @media(min-width: 1200px) {
    .swiper {
      .swiper-nav {
        opacity: 0;
        transition: all 0.3s;
      }
       &:hover {
        .swiper-nav {
          opacity: 1;
        }
      }
    }
  }
  @media(max-width: 1199px) {
    .slider-item {
      min-height: 550px;
    }
    .slide--content {
      width: 70%;
      .title {
        font-size: 90px;
      }
      .desc {
        font-size: 20px;
      }
    }
    .img-group .img {
      display: none;
    }
  }
  @media(max-width: 991px) {
    .slide--content {
      .title {
        font-size: 80px;
      }
    }
  }
  @media(max-width: 767px) {
    .slider-item{
      min-height: 350px;
    }
    .slide--content {
      width: 90%;
      .title {
        font-size: 40px;
      }
      .desc{
        font-size: 14px;
      }
      .btn-more{
        margin-top: 30px;
      }
    }
    .swiper {
      .swiper-nav {
        top: calc(50% - 20px);
        width: 40px;
        height: 40px;
        background: rgba($colorSlide, 0.2);
        &.swiper-next {
          right: 5px;
        }
        &.swiper-prev {
          left: 5px;
        }
      }
    }
  }
}

.hrv-pus-promotion:empty,
.section-home-pus-promotion:empty,
.hrv-pmo-discount:empty,
.hrv-pmo-coupon:empty,
.section-home-hrvpmo:empty {
  padding: 0;
}