$mainAbout1: {{ settings.bamboocraft_about_us_about1_main }};
.bamboocraft-about-us-about1 {
  padding: 60px 0;
  .heading-title {
    .title1 {
      color: $mainAbout1;
    }
  }
  @media(min-width: 1200px) {
    .has-icon {
      position: relative;
       &:before {
        content: '';
        position: absolute;
        top: 0;
        right: 100%;
        width: 20%;
        height: 40%;
        background-image: url("{{'bamboocraft_about_us_about1_img.jpg' | asset_url}}");
        background-size: contain;
        background-repeat: no-repeat;
        background-position: right;
      }
    }
    .about-content {
      max-width: 80%;
      margin: 0 auto;
    }
  }
  @media(max-width: 991px) {
    .row {
      gap: 40px;
    }
    .about-banner {
      text-align: center;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
  }
}