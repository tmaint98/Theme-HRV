BambooCraft.IndexLogoSlider = {
		init: function() {
			var that = this;
      that.BambooCraft_IndexLogoSlider();
		},
  BambooCraft_IndexLogoSlider: function(){
    const bamboocraftSlider = new Swiper ('.bamboocraft-index-partner .swiper', {
      slidesPerView: 6,  
			loop: $('.bamboocraft-index-partner .logo-item').length > 6 ? true:false,
      preloadImages: false,
      lazy: true,
      speed: 1000,
      //autoplay: false,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      breakpoints: {
        0: {
          slidesPerView: 3,
          spaceBetween: 40
        },
        768: {
          slidesPerView: 4,
          spaceBetween: 40
        },
        992: {
          slidesPerView: 6,
          spaceBetween: 40
        }
      },
			/*navigation: {
				nextEl: ".bamboocraft-index-partner .swiper-next",
				prevEl: ".bamboocraft-index-partner .swiper-prev",
			},*/
      pagination: {
				el: ".swiper-pagination",
				clickable: true,
			},
			
    });
    const totalSlides = bamboocraftSlider.slides.length;
    if (totalSlides <= bamboocraftSlider.params.slidesPerView) {
      $('.bamboocraft-index-partner .swiper-next, .bamboocraft-index-partner .swiper-prev').hide();
    }
  }
};
(function() {
  BambooCraft.IndexLogoSlider.init();
})();






