.bamboocraft-index-collection{
  padding: 60px 0;
  overflow: hidden;
  .listProduct-row{
    gap: 30px 0;
  }
  .btn-more{
    margin-top: 30px;
  }
  @media(min-width: 1200px){
    .banner{
      width: 150%;
    }
  }
  @media(max-width: 991px){
    .banner{
      margin-top: 30px;
    }
  }
  @media(max-width: 767px){
    padding: 30px 0;
    .heading-title{
      text-align: center;
    }
    .btn-more{
      margin-top: 20px;
    }
  }
}
