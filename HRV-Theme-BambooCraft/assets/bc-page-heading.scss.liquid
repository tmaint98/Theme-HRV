.heading-title {
  margin-bottom: 50px;
  .title1 {
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 15px;
  }
  .title2 {
    font-size: 55px;
    line-height: 1.2;
    margin: 0;
  }
  .desc {
    opacity: 0.8;
    margin-top: 15px;
  }
  @media (max-width: 991px) {
    text-align: center;
    .title2 {
      font-size: 40px;
    }
    .title2,
    .desc {
      br {
        content: '';
         &:after {
          content: ' ';
        }
      }
    }
  }
  @media (max-width: 767px) {
    margin-bottom: 25px;
    .title2 {
      font-size: 30px;
    }
  }
}
.button {
  display: inline-block;
  padding: 10px 30px;
  font-weight: 600;
  border: 1px solid;
  border-radius: 50px;
  transition: all 0.3s;
  svg {
    fill: currentcolor;
    margin-left: 5px;
  }
   &:hover {
    opacity: 0.8;
  }
}