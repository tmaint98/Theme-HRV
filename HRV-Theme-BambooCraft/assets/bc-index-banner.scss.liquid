{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
$colorText: {{settings.shop_text_color}};
.bamboocraft-index-banner{
  padding: 60px 0;
  overflow: hidden;
  .banner-item{
    .img{
      overflow: hidden;
      transition: all 0.3s;
      padding: 0 3px;
      img{
        transition: all 0.8s;
      }
    }
    .title{
      font-size: 24px;
      font-family: "{{ webfont_title }}", sans-serif;
      font-weight: 600;
      margin-top: 30px;
    }
    &:hover{
      .img{
        border-radius: 300px;
        img{
          transform: scale(1.05);
        }
      }
    }
  }
  .swiper{
    padding-bottom: 60px;
    .swiper-pagination-bullet{
      background: $colorText;
      margin: 0 6px;
    }
  }
  @media(min-width: 1200px){
    .banner{
      width: 125%;
      margin-left: -25%;
    }
    .banner-content{
      padding-left: 80px; 
    }
  }
  @media(max-width: 991px) {
    text-align: center;
    .banner{
      display: none;
    }
  }
  @media(max-width: 767px){
    padding: 30px 0;
    .banner-item .title{
      font-size: 20px;
      margin-top: 15px;
    }
    .swiper{
      padding-bottom: 45px;
    }
  }
}
