BambooCraft.IndexBannerSlider = {
		init: function() {
			var that = this;
      that.BambooCraft_IndexBannerSlider();
		},
  BambooCraft_IndexBannerSlider: function(){
    const bamboocraftSlider = new Swiper ('.bamboocraft-index-banner .swiper', {
      slidesPerView: 1,  
			loop: $('.bamboocraft-index-banner .banner-item').length > 1 ? true:false,
      preloadImages: false,
      lazy: true,
      speed: 1000,
      //autoplay: false,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
			/*navigation: {
				nextEl: ".bamboocraft-index-banner .swiper-next",
				prevEl: ".bamboocraft-index-banner .swiper-prev",
			},*/
      pagination: {
				el: ".swiper-pagination",
				clickable: true,
			},
			
    });
    const totalSlides = bamboocraftSlider.slides.length;
    if (totalSlides <= bamboocraftSlider.params.slidesPerView) {
      $('.bamboocraft-index-banner .swiper-next, .bamboocraft-index-banner .swiper-prev').hide();
    }
  }
};
(function() {
  BambooCraft.IndexBannerSlider.init();
})();




