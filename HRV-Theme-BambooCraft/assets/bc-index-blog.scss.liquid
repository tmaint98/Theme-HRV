$colorMain: {{ settings.bamboocraft_index_blog_color }};
$colorText: {{ settings.shop_text_color }};
.bamboocraft-index-blog {
  padding: 80px 0;
  .heading-title {
    .title1 {
      color: $colorMain;
    }
  }
  .article-loop {
    .article-image {
      position: relative;
      overflow: hidden;
      img {
        transition: all 0.3s;
      }
    }
    .article-detail {
      margin-top: 20px;
      .post-title {
        font-size: 24px;
      }
      .article-post-meta {
        font-size: 14px;
        opacity: 0.8;
        .author {
          padding: 2px 10px;
          margin-left: 10px;
          border-left: 2px solid rgba($colorText, 0.2);
          display: inline-block;
        }
      }
    }
     &:hover {
      .article-image {
        img {
          transform: scale(1.05);
        }
      }
    }
  }
  .btn-more {
    margin-top: 50px;
  }
  @media(max-width: 991px) {
    .list-article{
      gap: 30px;
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .article-loop {
      .article-detail {
        .post-title {
          font-size: 18px;
        }
      }
      
    }
    .btn-more {
        margin-top: 30px;
      }
  }
}