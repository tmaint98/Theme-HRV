BambooCraft.IndexMainSlider = {
		init: function() {
			var that = this;
      that.BambooCraft_IndexMainSlider();
		},
  BambooCraft_IndexMainSlider: function(){
    const bamboocraftSlider = new Swiper ('.bamboocraft-index-slider .swiper', {
      slidesPerView: 1,  
			loop: $('.bamboocraft-index-slider .slider-item').length > 1 ? true:false,
      preloadImages: false,
      lazy: true,
      speed: 1000,
      effect: 'fade',
      fadeEffect: {
        crossFade: true
      },
      autoplay: false,
      /*autoplay: {
        delay: 6000,
        disableOnInteraction: false,
      },*/
			navigation: {
				nextEl: ".bamboocraft-index-slider .swiper-next",
				prevEl: ".bamboocraft-index-slider .swiper-prev",
			},
      /*pagination: {
				el: ".swiper-pagination",
				clickable: true,
			},*/
			
    });
    const totalSlides = bamboocraftSlider.slides.length;
    if (totalSlides <= bamboocraftSlider.params.slidesPerView) {
      $('.bamboocraft-index-slider .swiper-next, .bamboocraft-index-slider .swiper-prev').hide();
    }
  }
};
(function() {
  BambooCraft.IndexMainSlider.init();
})();



