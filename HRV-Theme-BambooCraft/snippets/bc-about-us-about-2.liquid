{% if settings.show_bamboocraft_about_us_about2 %}
  {% unless has_heading %}
    <link rel="preload" href="{{ 'bc-page-heading.scss.css' | asset_url }}" as="style">
    <link rel="stylesheet" href="{{ 'bc-page-heading.scss.css' | asset_url }}">
    {%- assign has_heading = true -%}
  {% endunless %}
  <link rel="preload" href="{{ 'bc-about-us-about-2.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'bc-about-us-about-2.scss.css' | asset_url }}">
  <section class="bamboocraft-about-us-about2">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 col-12">
          <div class="about-banner">
            <img src="{{ 'bamboocraft_about_us_about2_banner.jpg' | asset_url}}" alt="{{ settings.bamboocraft_about_us_about2_title_2 | strip_html | escape }}" loading="lazy" decoding="sync" />
          </div>
        </div>
        <div class="col-lg-6 col-12">
          <div class="about-content">
            <div class="heading-title text-center">
              <div class="title1">{{ settings.bamboocraft_about_us_about2_title_1 }}</div>
              <h1 class="title2">{{ settings.bamboocraft_about_us_about2_title_2 | newline_to_br }}</h1>
              <div class="desc">{{ settings.bamboocraft_about_us_about2_desc }}</div>
            </div>
            {% if settings.bamboocraft_about_us_about2_btn != empty %}
              <div class="btn-more text-center">
                <a href="{{settings.bamboocraft_about_us_about2_link}}" class="button"><span>{{settings.bamboocraft_about_us_about2_btn}}</span> <svg width="20px" height="20px" viewBox="0 0 24 24" id="right" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color"><path id="primary" d="M21.71,11.29l-7-7a1,1,0,0,0-1.42,1.42L18.59,11H3a1,1,0,0,0,0,2H18.59l-5.3,5.29a1,1,0,0,0,0,1.42,1,1,0,0,0,1.42,0l7-7A1,1,0,0,0,21.71,11.29Z"></path></svg></a>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}
