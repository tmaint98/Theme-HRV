<link rel="preload" href="{{ 'bc-index-about-2.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'bc-index-about-2.scss.css' | asset_url }}">

<section class="bamboocraft-index-about-2">
  <div class="container">
    <div class="row align-items-center {%if settings.show_bamboocraft_index_about_2_img%}has-icon{%endif%}">
      <div class="col-lg-6 col-12">
        <div class="about-content">
          {%for i in (1..3)%}
            {%capture title%}bamboocraft_index_about_2_title_{{i}}{%endcapture%}
            {%capture desc%}bamboocraft_index_about_2_desc_{{i}}{%endcapture%}
            {%if settings[title] != empty or settings[desc] != empty%}
              <div class="content-item">
                <div class="title">{{settings[title]}}</div>
                <div class="desc">{{settings[desc]}}</div>
              </div>
            {%endif%}
          {%endfor%}
        </div>
      </div>
      <div class="col-lg-6 col-12">
        <div class="banner">
          <img src="{{ 'bamboocraft_index_about_2_banner.jpg' | asset_url}}" alt="{{ settings.bamboocraft_index_about_2_banner_alt }}" loading="lazy" decoding="sync" />
        </div>
      </div>
    </div>
  </div>
</section>