{% unless has_heading %}
  <link rel="preload" href="{{ 'bc-page-heading.scss.css' | asset_url }}" as="style">
  <link rel="stylesheet" href="{{ 'bc-page-heading.scss.css' | asset_url }}">
  {%- assign has_heading = true -%}
{% endunless %}
<link rel="preload" href="{{ 'bc-index-banner.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'bc-index-banner.scss.css' | asset_url }}">
<link href="{{ 'bc-index-banner.js' | asset_url }}" rel="preload" as="script">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'bc-index-banner.js' | asset_url }}"></script>

<section class="bamboocraft-index-banner">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 col-12">
        <div class="banner">
          <img src="{{ 'bamboocraft_index_banner_img.jpg' | asset_url}}" alt="{{ settings.bamboocraft_index_banner_title | strip_html | escape }}" loading="lazy" decoding="sync" />
        </div>
      </div>
      <div class="col-lg-6 col-12">
        <div class="banner-content">
          <div class="heading-title">
            {% if settings.bamboocraft_index_banner_title != empty %}
              <h2 class="title2">{{ settings.bamboocraft_index_banner_title | newline_to_br }}</h2>
            {% endif %}
          </div>
          <div class="list-banner">
            <div class="swiper">
              <div class="swiper-wrapper">
                {% for i in (1..3) %}
                  {% capture show %}show_bamboocraft_index_banner_{{i}}{%endcapture%}
                  {% capture img %}bamboocraft_index_banner_{{i}}_img.jpg{%endcapture%}
                  {% capture title %}bamboocraft_index_banner_{{i}}_title{%endcapture%}
                  {% capture link %}bamboocraft_index_banner_{{i}}_link{%endcapture%}
                  {% if settings[show] %}
                    <div class="swiper-slide">
                      <div class="banner-item text-center">
                        <a href="{{settings[link]}}">
                          <div class="img"><img src="{{ img | asset_url}}" alt="{{ settings[title] }}" loading="lazy" decoding="sync" /></div>
                          <div class="title">{{ settings[title] }}</div>
                        </a>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              <div class="swiper-pagination"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>