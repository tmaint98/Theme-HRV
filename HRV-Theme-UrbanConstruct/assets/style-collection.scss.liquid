	}
		&:nth-child(4n) ~ .loop {
		&:before{top: auto !important; bottom: 0;} 
	}
	}*/
	}
	@media(max-width: 991px){
		/*.collection-wraper{
		.listProduct-row{gap: 30px 0;}
	}*/
		.collection-wraper{
			.listProduct-row{margin: 0;}
		}
		.product-loop{-ms-flex: 0 0 50%;flex: 0 0 50%;max-width: 50%;

		&:nth-child(odd){
