$colorText: {{settings.shop_text_color}};	


/*===== COLLECTION ========================================*/
.layout-collections .breadcrumb-shop{
	margin-bottom:0;
}
.collection-alert-no{font-size:14px;padding:10px 0;}
.collection-alert-no p {margin:0;}
.collection-heading__banner {
	/*img:not(.lazyloaded) {min-height: 220px;}*/
	img{display: block;margin: auto;}
}
.collection-heading__content {
	h1 {margin:0;font-size:24px;}
	.heading-box {
		@media(max-width: 991px){
			width: 50%;
			.filter-box:not(.noBorder) {
				position: relative;
				height: 38px;
				line-height: 36px;
				width: 100%;
				font-size: 13px;
				font-weight: 600;
				padding: 0px 40px 0px 10px;
				cursor: pointer;
				border: 1px solid #eae4e8;
				border-right: 0;
				border-radius: 0;
			}
		}
		.title-filter {
			display: flex;
			-webkit-box-pack: center;
			justify-content: center;
			-webkit-box-align: center;
			align-items: center;
			cursor: pointer;
		}
		svg {
			width: 16px;
			height: 16px;
			stroke: var(--shop-color-text);
			margin-left: 5px;
		}
	}
	.collection-filter-tags {
		margin: 20px 0;

		.layered_filter_tags .filter_tags {
			position: relative;
			border-radius: 12px;
			margin: 10px 0;
			color: #5d5d5d;
			background: #fff;
			border: 1px solid #dadada;
			font-size: 13px;
			display: none;
			padding: 2px 32px 2px 10px;
			&.opened ~ .filter_tags {
				margin-left: 10px;
			}
		}
		.layered_filter_tags .filter_tags.filter_tags_remove_all {
			cursor: pointer;
			border: 0;
			padding: 2px 10px;
		}
		.layered_filter_tags .filter_tags.filter_tags_remove_all span {
			color: var(--shop-color-main);
			border-bottom: 1px solid var(--shop-color-main);
		}
		.layered_filter_tags .filter_tags span.filter_tags_remove {
			position: absolute;
			right: 8px;
			top: 0;
			bottom: 0;
			margin: auto;
			width: 16px;
			height: 16px;
			cursor: pointer;
			display:flex;display:-ms-flex;
		}
		.layered_filter_tags .filter_tags.opened {
			display: inline-block;
		}
		.line-collection-content{
			display: none;
		}
		.heading-box-mb{
			&__count{
				.col-title {
					font-size: 22px;
					font-weight: 600;
					color: var(--shop-color-main);
				}
			}
		}
		@media(max-width: 991px){
			margin: 10px 0;
			.line-collection-content{
				display: block;
			}
			.heading-box-mb{
				width: 100%;
				display: flex;
				flex-flow: wrap;
				&__filter{
					order: 1;
					flex: 0 0 50%;
					position: relative;
					height: 38px;
					line-height: 36px;
					width: 100%;
					font-size: 13px;
					font-weight: 600;
					/*padding: 0px 40px 0px 10px;*/
					cursor: pointer;
					border: 1px solid #eae4e8;
					border-right: 0;
					border-radius: 0;
					background: #fff;
					.title-filter {
						margin: 0;
					}
				}
				&__sortby{
					order: 2;
					flex: 0 0 50%;
				}
				&__count{
					order: 3;
					flex: 0 0 100%;
					margin: 15px 0 10px;
				}
			}
		}
	}
}
.collection-heading {
	.wrapper-collection-banner {
		background: #f8f8f8;
		.collection-heading__banner {
			img {
				width: 100%;
			}
			@media(max-width: 991px){
				width: 100%;
			}
		}
		.collection-description {
			width: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 21px;
			@media(max-width: 991px){
				width: 100%;
				font-size: 16px;
				padding: 15px 0;
			}
			h1 {
				font-size: 45px;
				font-weight: 500;
				@media(max-width: 991px){
					font-size: 25px;
				}
			}
			.collection-description-inner {
				width: calc(100% - 60px);
				@media(max-width: 991px){
					width: calc(100% - 30px);
				}
			}
		}
	}
}
