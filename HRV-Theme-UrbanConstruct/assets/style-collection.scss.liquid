	.collection-sortbyfilter-container {
		position: relative;
		min-width: 180px;
		@media(max-width: 991px){
			min-width: auto;
		}
		.collection-sortby-option {
			background: #fff;border: 1px solid #eae4e8;border-top:0;
			-webkit-transition: all 0.3s ease;-o-transition: all 0.3s ease;transition: all 0.3s ease;
			@media(max-width: 991px){
				position: absolute;
				z-index: 9;
				width: 100%;
			}
			ul.sort-by{margin:0;padding:5px 10px;}
			ul.sort-by li{position: relative;cursor: pointer;padding:4px 10px 4px 25px;}
			ul.sort-by li:before{
				content: "";
				position: absolute;left: 5px;top:10px;margin: auto;z-index: 1;
				width: 12px;height: 6px;
				border: 1.5px solid var(--shop-color-main);
				border-top-style: none;	border-right-style: none;
				-webkit-transition: -webkit-transform 0.4s cubic-bezier(0.45, 1.8, 0.5, 0.75);
				-moz-transition: -moz-transform 0.4s cubic-bezier(0.45, 1.8, 0.5, 0.75);
				transition: transform 0.4s cubic-bezier(0.45, 1.8, 0.5, 0.75);
				-webkit-transform: rotate(-45deg) scale(0, 0);
				-moz-transform: rotate(-45deg) scale(0, 0);
				-ms-transform: rotate(-45deg) scale(0, 0);
				-o-transform: rotate(-45deg) scale(0, 0);
				transform: rotate(-45deg) scale(0, 0);
			}
			ul.sort-by li.active:before{
				-webkit-transform: rotate(-45deg) scale(1, 1);
				-moz-transform: rotate(-45deg) scale(1, 1);
				-ms-transform: rotate(-45deg) scale(1, 1);
				-o-transform: rotate(-45deg) scale(1, 1);
				transform: rotate(-45deg) scale(1, 1);
			}
			ul.sort-by li:hover{color: var(--shop-color-main)}
		}
		@media(min-width:992px){
			.collection-sortby-option{
				position: absolute;left:0;right:0;margin: 0;top:calc(100% + 10px);z-index: 999;	
				pointer-events: none;visibility: hidden;opacity: 0;
			}
			&:hover	.collection-sortby-option{
				pointer-events: auto;visibility: visible;top: 100%;opacity: 1;
			}
			&:hover .collection-sortby-opticccon{
				color: #666;
				-webkit-transform: rotate(180deg);
				-moz-transform: rotate(180deg);
				-ms-transform: rotate(180deg);
				-o-transform: rotate(180deg);
				transform: rotate(180deg);
			}
		}
		@media(max-width:991px){
			.collection-sortby-option{
				position: absolute;left:0;right:0;margin: 0;top:calc(100% + 10px);z-index: 999;	
				pointer-events: none;visibility: hidden;opacity: 0;
				&.isShow {
					pointer-events: auto;visibility: visible;top: 100%;opacity: 1;
				}
				ul.sort-by{}
				ul.sort-by li{padding-left:10px;padding-right:25px}
				ul.sort-by li:before{left: initial; right: 5px;}
			}
		}
	}
	.collection-sortby-filter{
		display: -ms-flexbox;display: -webkit-flex;display: flex;
		-webkit-flex-flow: row nowrap;flex-flow: row nowrap;
		.collection-sortby,.collection-filterby{-webkit-flex: 1 1;flex: 1 1; width: 50%;}
		.collection-filterby{display:none}
		.collection-sortby .boxstyle-mb,
		.collection-filterby .boxstyle-mb{
			position: relative;height: 38px;line-height: 36px;
			width: 100%;font-size: 13px;font-weight: 600;
			padding:0px 40px 0px 10px; cursor: pointer;
			border: 1px solid #eae4e8;border-right:0;border-radius:0;
		}
		&>div:last-child .boxstyle-mb{border-right:1px solid #eae4e8;background: #fff;}
		.layered_filter_title .title_filter{
			margin:0;
			overflow: hidden;
			-webkit-line-clamp: 1;
			-webkit-box-orient: vertical;
			display: -webkit-box;
			@media(max-width: 991px){
				text-align: center;
			}
		}
		.layered_filter_title .title_filter:after{
			content:"";
			display: block;	position: absolute;	top: 40%;right: 10px;width: 0px;height: 0px;margin:0;
			background: transparent;border-style: solid;border-width: 7px 6px 0 6px;
			border-color: #bababa transparent transparent transparent;
		}
		.layered_filter_title .title_filter .icon-filter{height: 36px;line-height: 36px;display: inline-block;vertical-align: top;color: var(--shop-text-color);margin-right: 6px;}
		.layered_filter_title .title_filter .icon-filter svg{width:20px;height: 36px;line-height: 36px;fill: var(--shop-text-color);stroke: var(--shop-text-color);}
		.layered_filter_title .title_filter .icon-filter .fa{line-height: 36px;font-size:17px;color: var(--shop-text-color);}
		.layered_filter_title .title_filter .icon-close{
			display:none;
			position: absolute;top: 0;bottom:0;margin:auto;right: 8px;width:18px;height:18px;line-height: 18px;
			svg{width:18px;height:18px;fill:var(--shop-color-main)}
		}
	}
	.collection-listproduct{
		margin-bottom: 25px;
		.animated.fadeIn{ animation-duration: 1.5s;-webkit-animation-fill-mode: none;animation-fill-mode: none;}
	}
	.layered_filter_bottom{display:none;}
	.collection-loadmore{margin-top: 20px;}
	.product-loop{
		-ms-flex: 0 0 calc(100% / 3);
		flex: 0 0 calc(100% / 3);
		max-width: calc(100% / 3);
		position: relative;
		/*&:before, &:after{
