.urbanconstruct-index-team{
  @media(min-width: 992px){
  	.container{	max-width: 100%;padding-left: 20px;	padding-right: 20px;}
  }
  @media(min-width: 1200px){
  	.container{max-width:1170px;}
  }
  @media(min-width: 1366px){
  	.container{max-width:1290px;}
  }
  @media(min-width: 1600px){
  	.container{max-width:1410px;}
  	.container-fluid{max-width:1800px;}
  }
}
.urbanconstruct-index-team {
  padding: 80px 0;
  .heading-title {
    .desc {
      font-size: 24px;
      font-weight: 600;
      opacity: 1;
    }
  }
  .team-right {
    display: flex;
    flex-flow: wrap;
    gap: 35px 30px;
    .team-item {
      -ms-flex: 0 0 calc(50% - 15px);
      flex: 0 0 calc(50% - 15px);
      max-width: calc(50% - 15px);
      .img {
        position: relative;
        overflow: hidden;
        display: block;
        border-radius: 16px;
        img {
          border-radius: 16px;
          transition: all 0.3s;
        }
         &:hover {
          img {
            transform: scale(1.08);
          }
        }
      }
      .detail {
        margin-top: 30px;
        .name {
          font-size: 20px;
          font-weight: 600;
        }
        .position {
          opacity: 0.6;
        }
      }
    }
  }
  @media(min-width: 992px) {
    .team-left {
      position: sticky;
      top: 90px;
    }
  }
  @media(max-width: 767px){
    padding: 40px 0;
    .heading-title .desc{
      font-size: 16px;
    }
    .team-right {
    gap: 20px;
    .team-item {
      -ms-flex: 0 0 100%;
      flex: 0 0 100%;
      max-width: 100%;
      .detail {
        margin-top: 15px;
        .name {
          font-size: 16px;
        }
      }
    }
    }
  }
}