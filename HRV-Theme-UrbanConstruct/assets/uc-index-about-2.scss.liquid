:root{
  --uc-index-project-bg: {{ settings.urbanconstruct_index_about_2_bg }};
  --uc-index-project-color: {{ settings.urbanconstruct_index_about_2_color }};
  --uc-index-project-bg-btn: {{ settings.urbanconstruct_index_about_2_bg_btn }};
  --uc-index-project-color-btn: {{ settings.urbanconstruct_index_about_2_color_btn }};
}
.urbanconstruct-index-about-2{
  @media(min-width: 992px){
  	.container{	max-width: 100%;padding-left: 20px;	padding-right: 20px;}
  }
  @media(min-width: 1200px){
  	.container{max-width:1170px;}
  }
  @media(min-width: 1366px){
  	.container{max-width:1290px;}
  }
  @media(min-width: 1600px){
  	.container{max-width:1410px;}
  	.container-fluid{max-width:1800px;}
  }
}
.urbanconstruct-index-about-2 .button {
  color: var(--uc-index-project-color-btn);
  background-color: var(--uc-index-project-bg-btn);
}
.urbanconstruct-index-about-2 {
  padding: 80px 0;
  background: var(--uc-index-project-bg);
  color: var(--uc-index-project-color);
  .heading-title {
    .title2 span,
    .desc {
      opacity: 0.6;
    }
    .btn-more {
      margin-top: 30px;
    }
  }
  .list-project {
    margin-top: 40px;
    .project-item {
      .detail {
        margin-top: 20px;
        color: var(--uc-index-project-color);
        .title {
          font-size: 20px;
          margin-bottom: 6px;
        }
        .desc {
          opacity: 0.6;
        }
      }
    }
  }
  @media(min-width: 1200px) {
    .heading-title {
      &.heading--1 {
        max-width: 65%;
      }
    }
    .list-project {
      display: flex;
      gap: 10px;
      padding: 0 50px;
      .project-item {
        transition: all 0.5s ease-in-out;
        .img {
          height: 730px;
          background-image: var(--bg-img);
          background-size: cover;
          background-position: center;
          border-radius: 16px;
          overflow: hidden;
          img {
            display: none;
          }
        }
      }
      &.item--1 {
        .project-item {
          -ms-flex: 0 0 100%;
          flex: 0 0 100%;
          max-width: 100%;
        }
      }
      &.item--2 {
        .project-item {
          -ms-flex: 0 0 calc(50% - 5px);
          flex: 0 0 calc(50% - 5px);
          max-width: calc(50% - 5px);
          &.no-active {
            -ms-flex: 0 0 20%;
            flex: 0 0 20%;
            max-width: 20%;
          }
          &.active {
            -ms-flex: 0 0 calc(80% - 10px);
            flex: 0 0 calc(80% - 10px);
            max-width: calc(80% - 10px);
          }
        }
      }
      &.item--3 {
        .project-item {
          -ms-flex: 0 0 calc(100% / 3 - 7px);
          flex: 0 0 calc(100% / 3 - 7px);
          max-width: calc(100% / 3 - 7px);
          &.no-active {
            -ms-flex: 0 0 15%;
            flex: 0 0 15%;
            max-width: 15%;
          }
          &.active {
            -ms-flex: 0 0 calc(70% - 20px);
            flex: 0 0 calc(70% - 20px);
            max-width: calc(70% - 20px);
          }
        }
      }
    }
  }
  @media(max-width: 1199px) {
    .list-project {
      .project-item {
        .img {
          border-radius: 16px;
          overflow: hidden;
        }
         &:not(:last-child) {
          margin-bottom: 15px;
        }
      }
    }
  }
  @media(max-width: 767px) {
    padding: 40px 0;
    .list-project {
      margin-top: 20px;
      .project-item {
        .detail{
          margin-top: 10px;
          .title{
            font-size: 16px;
          }
        }
      }
    }
  }
}