<link rel="preload" href="{{ 'uc-index-policy.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'uc-index-policy.scss.css' | asset_url }}">
<section class="urbanconstruct-index-policy">
    <div class="container">
      <div class="row">
        {% assign time = 0 %}
        {% for i in (1..3) %}
          {% capture show %}show_urbanconstruct_index_policy_{{i}}{%endcapture%}
          {% capture img %}urbanconstruct_index_policy_{{i}}_img.jpg{%endcapture%}
          {% capture title %}urbanconstruct_index_policy_{{i}}_title{%endcapture%}
          {% capture desc %}urbanconstruct_index_policy_{{i}}_desc{%endcapture%}
          {% if settings[show] %}
            {% assign time = time | plus: 0.2 %}
            <div class="col-lg-4 col-12 policy-item wow fadeInUp" data-wow-delay="{{time}}s" data-wow-duration="0.8s">
              <div class="img"><img src="{{ img | asset_url}}" alt="{{settings[title]}}" /></div>
              <div class="detail">
                <h3 class="title">{{ settings[title] }}</h3>
                {% if settings[desc] != '' %}
                  <div class="desc">{{ settings[desc] }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>