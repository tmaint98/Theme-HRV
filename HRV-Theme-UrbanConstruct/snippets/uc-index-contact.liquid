{%unless has_heading %} 
  <link rel="preload" href="{{ 'uc-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'uc-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload" href="{{ 'uc-index-contact.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'uc-index-contact.scss.css' | asset_url }}">
<section class="urbanconstruct-index-contact wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
    <div class="container-fluid">
      <div class="contact-img">
      <picture>
        <source media="(max-width: 767px)" srcset="{{ 'urbanconstruct_index_contact_img_mb.jpg' | asset_url}}" />
        <source media="(min-width: 768px)" srcset="{{ 'urbanconstruct_index_contact_img.jpg' | asset_url}}" />
        <img src="{{ 'urbanconstruct_index_contact_img.jpg' | asset_url }}" alt="{{ settings.urbanconstruct_index_contact_title_2 }}" />
      </picture>
      </div>
      <div class="contact-detail">
        <div class="heading-title text-center">
          {% if settings.urbanconstruct_index_contact_title_1 != '' %}
            <div class="title1">{{ settings.urbanconstruct_index_contact_title_1 }}</div>
          {% endif %}
          {% if settings.urbanconstruct_index_contact_title_2 != '' %}
            <h2 class="title2">{{ settings.urbanconstruct_index_contact_title_2 | newline_to_br }}</h2>
          {% endif %}
          {% if settings.urbanconstruct_index_contact_desc != '' %}
            <div class="desc">{{ settings.urbanconstruct_index_contact_desc }}</div>
          {% endif %}
          {% if settings.urbanconstruct_index_contact_btn != '' %}
            <div class="btn-more">
              <a href="{{settings.urbanconstruct_index_contact_link}}" class="button">{{ settings.urbanconstruct_index_contact_btn }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>