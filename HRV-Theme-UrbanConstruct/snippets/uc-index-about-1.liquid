{%unless has_heading %} 
  <link rel="preload" href="{{ 'uc-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'uc-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload" href="{{ 'uc-index-about-1.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'uc-index-about-1.scss.css' | asset_url }}">
<section class="urbanconstruct-index-about-1">
    <div class="container">
      <div class="row">
        {% if settings.show_urbanconstruct_index_about_1_banner_1 %}
          <div class="col-lg-6 col-12">
            <div class="banner banner-left wow fadeInUp" data-wow-delay="0s" data-wow-duration="0.8s">
              <img src="{{'urbanconstruct_index_about_1_banner_1_img.jpg' | asset_url}}" alt="{{settings.urbanconstruct_index_about_1_banner_1_alt}}" />
            </div>
          </div>
        {% endif %}
        <div class="{%if settings.show_urbanconstruct_index_about_1_banner_1%}col-lg-6{%endif%} col-12 wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="1s">
          <div class="heading-title">
            {% if settings.urbanconstruct_index_about_1_title_1 != '' %}
              <div class="title1">{{ settings.urbanconstruct_index_about_1_title_1 }}</div>
            {% endif %}
            {% if settings.urbanconstruct_index_about_1_title_2 != '' %}
              <h2 class="title2">{{ settings.urbanconstruct_index_about_1_title_2 | newline_to_br }}</h2>
            {% endif %}
            {% if settings.urbanconstruct_index_about_1_desc != '' %}
              <div class="desc">{{ settings.urbanconstruct_index_about_1_desc }}</div>
            {% endif %}
          </div>
          {% if settings.show_urbanconstruct_index_about_1_banner_2 %}
            <div class="banner banner-right">
              <img src="{{'urbanconstruct_index_about_1_banner_2_img.jpg' | asset_url}}" alt="{{settings.urbanconstruct_index_about_1_banner_2_alt}}" />
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>