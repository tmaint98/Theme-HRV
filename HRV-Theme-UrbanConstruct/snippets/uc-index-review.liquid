{%unless has_heading %} 
  <link rel="preload" href="{{ 'uc-page-heading.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'uc-page-heading.scss.css' | asset_url }}">
  {% assign has_heading = true %}
{% endunless %}
<link rel="preload" href="{{ 'uc-index-review.scss.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'uc-index-review.scss.css' | asset_url }}">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'uc-index-review.js' | asset_url }}"></script>
<section class="urbanconstruct-index-review">
    <div class="container">
      <div class="heading-title text-center wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
        {% if settings.urbanconstruct_index_review_title_1 != '' %}
          <div class="title1">{{ settings.urbanconstruct_index_review_title_1 }}</div>
        {% endif %}
        {% if settings.urbanconstruct_index_review_title_2 != '' %}
          <h2 class="title2">{{ settings.urbanconstruct_index_review_title_2 | newline_to_br }}</h2>
        {% endif %}
        {% if settings.urbanconstruct_index_review_desc != '' %}
          <div class="desc">{{ settings.urbanconstruct_index_review_desc }}</div>
        {% endif %}
      </div>
      <div class="swiper list-review">
        <div class="swiper-wrapper">
        {% for i in (1..3) %}
          {% capture show %}show_urbanconstruct_index_review_{{i}}{%endcapture%}
          {% capture logo %}urbanconstruct_index_review_{{i}}_logo.jpg{%endcapture%}
          {% capture title %}urbanconstruct_index_review_{{i}}_title{%endcapture%}
          {% capture desc %}urbanconstruct_index_review_{{i}}_desc{%endcapture%}
          {% capture img %}urbanconstruct_index_review_{{i}}_img.jpg{%endcapture%}
          {% capture name %}urbanconstruct_index_review_{{i}}_name{%endcapture%}
          {% capture position %}urbanconstruct_index_review_{{i}}_position{%endcapture%}
          {% capture p_title %}urbanconstruct_index_review_{{i}}_percent_title{%endcapture%}
          {% capture p_num %}urbanconstruct_index_review_{{i}}_percent_num{%endcapture%}
          {% capture p_num_desc %}urbanconstruct_index_review_{{i}}_percent_num_desc{%endcapture%}
          {% capture p_desc %}urbanconstruct_index_review_{{i}}_percent_desc{%endcapture%}
          {% if settings[show] %}
            <div class="swiper-slide">
              <div class="review-item wow fadeInUp" data-wow-delay="0.5s" data-wow-duration="0.8s">
              <div class="row">
                <div class="col-lg-8 col-12">
                  <div class="item-left">
                    <div class="logo"><img src="{{ logo | asset_url}}" alt="logo" /></div>
                    <div class="title">{{ settings[title] }}</div>
                    <div class="desc">{{ settings[desc] }}</div>
                    <div class="info">
                      <div class="img"><img src="{{ img | asset_url}}" alt="{{settings[name]}}" /></div>
                      <div class="detail">
                        <div class="name">{{ settings[name] }}</div>
                        <div class="position">{{ settings[position] }}</div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-lg-4 col-12">
                  <div class="item-right">
                    <div class="title">{{ settings[p_title] }}</div>
                    <div class="percent">
                      <span class="counter-num" aria-label="{{settings[p_num]}}">{{ settings[p_num] }}</span>
                      <span class="p-desc">{{ settings[p_num_desc] }}</span>
                    </div>
                    <div class="desc">{{ settings[p_desc] }}</div>
                  </div>
                </div>
              </div>
            </div>
            </div>
          {% endif %}
        {% endfor %}
          </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>
  </section>