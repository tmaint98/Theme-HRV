<div class="layout-about-us">
  <div class="hidden">{% include 'breadcrumb' %}<h1>{{ page.title }}</h1>
  </div>
  {% if settings.show_about_us %}
    <section class="section-about-us">
      <div class="container">
        <div class="row">
          <div class="col-lg-6 col-12">
            <div class="banner-left wow fadeInUp" data-wow-delay="0.1s" data-wow-duration="0.8s">
              <div class="img">
                <img src="{{ 'about_us_img_1.jpg' | asset_url}}" alt="{{ settings.about_us_title_2 }}" />
              </div>
            </div>
          </div>
          <div class="col-lg-6 col-12">
            <div class="banner-right wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
              <div class="heading-title">
                {% if settings.about_us_title_1 != '' %}
                  <div class="title1">{{ settings.about_us_title_1 }}</div>
                {% endif %}
                <div class="title-right">
                  {% if settings.about_us_title_2 != '' %}
                    <h2 class="title2">{{ settings.about_us_title_2 | newline_to_br }}</h2>
                  {% endif %}
                  {% if settings.about_us_desc != '' %}
                    <div class="desc">{{ settings.about_us_desc | newline_to_br }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="img">
                <img src="{{ 'about_us_img_2.jpg' | asset_url}}" alt="{{ settings.about_us_title_2 }}" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}
  {% if settings.show_about_us_service %}
    <section class="section-about-us-services">
    <div class="container">
      <div class="heading-title wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
        {% if settings.about_us_service_title_1 != '' %}
          <div class="title1">{{ settings.about_us_service_title_1 }}</div>
        {% endif %}
        {% if settings.about_us_service_title_2 != '' %}
          <h2 class="title2">{{ settings.about_us_service_title_2 | newline_to_br }}</h2>
        {% endif %}
        {% if settings.about_us_service_desc != '' %}
          <div class="desc">{{ settings.about_us_service_desc | newline_to_br }}</div>
        {% endif %}
      </div>
      <div class="list-services">
        {% assign time2 = 0.2 %}
        {% assign count = 0 %}
        {% for i in (1..3) %}
          {% capture show %}show_about_us_service_{{i}}{%endcapture%}
          {% capture title %}about_us_service_{{i}}_title{%endcapture%}
          {% capture desc %}about_us_service_{{i}}_desc{%endcapture%}
          {% capture link %}about_us_service_{{i}}_link{%endcapture%}
          {% if settings[show] %}
            {% assign time2 = time2 | plus: 0.1 %}
            {% assign count = count | plus: 1 %}
            <div class="service-item wow fadeInUp" data-wow-delay="{{time2}}s" data-wow-duration="0.8s">
            <div class="detail">
              <div class="num">0{{ count }}</div>
              <h3 class="title">{{ settings[title] }}</h3>
              <div class="desc">{{ settings[desc] }}</div>
              <div class="link">
                <a href="{{settings[link]}}">
                  <svg viewBox="0 0 18 12" width="20" height="20">
                    <path d="M17.0988 5.45522L12.1438 0.500221C11.9986 0.355015 11.8016 0.273437 11.5963 0.273438C11.3909 0.273438 11.194 0.355015 11.0488 0.500221C10.9036 0.645427 10.822 0.84237 10.822 1.04772C10.822 1.25307 10.9036 1.45002 11.0488 1.59522L14.6818 5.22822H1.44978C1.2445 5.22822 1.04763 5.30977 0.902481 5.45492C0.757327 5.60007 0.675781 5.79694 0.675781 6.00222C0.675781 6.2075 0.757327 6.40437 0.902481 6.54952C1.04763 6.69468 1.2445 6.77622 1.44978 6.77622H14.6818L11.0488 10.4092C10.9036 10.5544 10.822 10.7514 10.822 10.9567C10.822 11.1621 10.9036 11.359 11.0488 11.5042C11.194 11.6494 11.3909 11.731 11.5963 11.731C11.8016 11.731 11.9986 11.6494 12.1438 11.5042L17.0978 6.54922C17.2429 6.40422 17.3245 6.20756 17.3247 6.00243C17.3249 5.7973 17.2436 5.60048 17.0988 5.45522Z"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>{% endif %}{% if settings.show_about_us_marquee %}
<section class="section-about-us-marquee">
<div class="marquee wow fadeIn" data-wow-delay="0.3s" data-wow-duration="0.8s">
  <div class="marquee__inner">
    {% if settings.about_us_marquee_desc != '' %}
      {% assign list = settings.about_us_marquee_desc | split: ';' %}
      {% for i in (1..3) %}
        {% for desc in list %}
          <div class="marquee__inner--item">{{ desc }}
          <span class="icon">
            <svg viewBox="0 0 19 21">
              <path d="M7.93164 20.1157L8.25293 13.0703L2.33203 16.9028L0.496094 13.7358L6.78418 10.5229L0.496094 7.31006L2.33203 4.09717L8.25293 7.92969L7.93164 0.884277H11.5576L11.2363 7.92969L17.1572 4.09717L18.9932 7.31006L12.7051 10.5229L18.9932 13.7358L17.1572 16.9028L11.2363 13.0703L11.5576 20.1157H7.93164Z"></path>
            </svg>
          </span>
        </div>
      {% endfor %}
    {% endfor %}
  {% endif %}
</div></div></section>{% endif %}{% if settings.show_about_us_banner %}
<section class="section-about-us-banner">
  <div class="container">
    <div class="heading-title text-center wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
      {% if settings.about_us_banner_title_1 != '' %}
        <div class="title1">{{ settings.about_us_banner_title_1 }}</div>
      {% endif %}
      {% if settings.about_us_banner_title_2 != '' %}
        <h2 class="title2">{{ settings.about_us_banner_title_2 | newline_to_br }}</h2>
      {% endif %}
      {% if settings.about_us_banner_desc != '' %}
        <div class="desc">{{ settings.about_us_banner_desc | newline_to_br }}</div>
      {% endif %}
    </div>
    <div class="list-banner wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
      {% for i in (1..4) %}
        {% capture img %}about_us_banner_{{i}}_img.jpg{%endcapture%}
        <div class="banner-item"><img src="{{ img | asset_url}}" alt="" /></div>
      {% endfor %}
    </div>
  </div>
</section>{% endif %}{% if settings.show_about_us_review %}
<section class="section-about-us-review wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
  <div class="container">
    <div class="list-item owl-carousel">
      {% for i in (1..5) %}
        {% capture show %}show_about_us_review_{{i}}{%endcapture%}
        {% capture img %}about_us_review_{{i}}_img.jpg{%endcapture%}
        {% capture name %}about_us_review_{{i}}_name{%endcapture%}
        {% capture position %}about_us_review_{{i}}_position{%endcapture%}
        {% capture desc %}about_us_review_{{i}}_desc{%endcapture%}
        {% if settings[show] %}
          <div class="review-item text-center">
          <div class="star"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i></div>
            <div class="desc">{{settings[desc]}}</div>
            <div class="img"><img src="{{ img | asset_url}}" alt="{{settings[name]}}" /></div>
            <div class="name">{{settings[name]}}</div>
            <div class="position">{{settings[position]}}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>{% endif %}
{% if settings.show_about_us_banner_full %}
  <section class="section-about-us-banner-full wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
    <div class="container">
      <div class="contact-img">
      <picture>
        <source media="(max-width: 767px)" srcset="{{ 'about_us_banner_full_img_mb.jpg' | asset_url}}" />
        <source media="(min-width: 768px)" srcset="{{ 'about_us_banner_full_img.jpg' | asset_url}}" />
        <img src="{{ 'about_us_banner_full_img.jpg' | asset_url }}" alt="{{ settings.about_us_banner_full_title_2 }}" />
      </picture>
      </div>
      <div class="contact-detail">
        <div class="heading-title text-center">
          {% if settings.about_us_banner_full_title_1 != '' %}
            <div class="title1">{{ settings.about_us_banner_full_title_1 }}</div>
          {% endif %}
          {% if settings.about_us_banner_full_title_2 != '' %}
            <h2 class="title2">{{ settings.about_us_banner_full_title_2 | newline_to_br }}</h2>
          {% endif %}
          {% if settings.about_us_banner_full_desc != '' %}
            <div class="desc">{{ settings.about_us_banner_full_desc }}</div>
          {% endif %}
          {% if settings.about_us_banner_full_btn != '' %}
            <div class="btn-more">
              <a href="{{settings.about_us_banner_full_link}}" class="button">{{ settings.about_us_banner_full_btn }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endif %}
{% if settings.show_about_us_team %}
  <section class="section-about-us-team">
    <div class="container">
      <div class="row">
        <div class="col-lg-4 col-12 wow fadeIn" data-wow-delay="0.3s" data-wow-duration="0.8s">
          <div class="team-left">
            <div class="heading-title">
              {% if settings.about_us_team_title_1 != '' %}
                <div class="title1">{{ settings.about_us_team_title_1 }}</div>
              {% endif %}
              {% if settings.about_us_team_title_2 != '' %}
                <h2 class="title2">{{ settings.about_us_team_title_2 | newline_to_br }}</h2>
              {% endif %}
              {% if settings.about_us_team_desc != '' %}
                <div class="desc">{{ settings.about_us_team_desc }}</div>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="col-lg-8 col-12">
          <div class="team-right">
            {%assign time1 = 0.3%}
            {% for i in (1..4) %}
              {% capture show %}show_about_us_team_{{i}}{%endcapture%}
              {% capture img %}about_us_team_{{i}}_img.jpg{%endcapture%}
              {% capture name %}about_us_team_{{i}}_name{%endcapture%}
              {% capture position %}about_us_team_{{i}}_position{%endcapture%}
              {% capture link %}about_us_team_{{i}}_link{%endcapture%}
              {% if settings[show] %}
                {%assign time1 = time1 | plus: 0.05%}
                <div class="team-item wow fadeInUp" data-wow-delay="{{time1}}s" data-wow-duration="0.8s">
                  <a href="{{settings[link]}}" class="img"><img src="{{ img | asset_url}}" alt="{{settings[name]}}" /></a>
                  <div class="detail">
                    <div class="name">{{ settings[name] }}</div>
                    <div class="position">{{ settings[position] }}</div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}
</div>