<div class="layout-services">
  <div class="hidden">{% include 'breadcrumb'%}</div>
	{%if settings.show_services_1%}
<section class="section-services-1">
  <div class="container">
    <div class="heading-title text-center wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
      {% if settings.services_1_title_1 != '' %}
        <div class="title1">{{ settings.services_1_title_1 }}</div>
      {% endif %}
      {% if settings.services_1_title_2 != '' %}
        <h2 class="title2">{{ settings.services_1_title_2 | newline_to_br }}</h2>
      {% endif %}
      {% if settings.services_1_desc != '' %}
        <div class="desc">{{ settings.services_1_desc }}</div>
      {% endif %}
    </div>
    <div class="row list-services">
      {%assign time = 0.2%}
      {%for i in (1..6)%}
        {%capture show%}show_services_1_{{i}}{%endcapture%}
        {%capture img%}services_1_{{i}}_img.jpg{%endcapture%}
        {%capture title%}services_1_{{i}}_title{%endcapture%}
        {%capture desc%}services_1_{{i}}_desc{%endcapture%}
        {%capture link%}services_1_{{i}}_link{%endcapture%}
        {%if settings[show]%}
          {%assign time = time | plus: 0.1%}
          <div class="col-lg-4 col-12 service-item wow fadeInUp" data-wow-delay="{{time}}s" data-wow-duration="0.8s">
            <a href="{{settings[link]}}" class="item-bg">
              <div class="img"><img src="{{ img | asset_url}}" alt="{{settings[title]}}" /></div>
              <div class="detail">
                {%if settings[title] != ''%}<h3 class="title">{{settings[title]}}</h3>{%endif%}
                {%if settings[desc] != ''%}<div class="desc">{{settings[desc]}}</div>{%endif%}
              </div>
            </a>
          </div>
        {%endif%}
      {%endfor%}
    </div>
  </div>
</section>
  {%endif%}
  {%if settings.show_services_2%}
<section class="section-services-2">
  <div class="container">
    <div class="heading-title text-center wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
      {% if settings.services_2_title_1 != '' %}
        <div class="title1">{{ settings.services_2_title_1 }}</div>
      {% endif %}
      {% if settings.services_2_title_2 != '' %}
        <h2 class="title2">{{ settings.services_2_title_2 | newline_to_br }}</h2>
      {% endif %}
      {% if settings.services_2_desc != '' %}
        <div class="desc">{{ settings.services_2_desc }}</div>
      {% endif %}
    </div>
    <div class="row list-services">
      {%assign time1 = 0.2%}
      {%for i in (1..4)%}
        {%capture show%}show_services_2_{{i}}{%endcapture%}
        {%capture img%}services_2_{{i}}_img.jpg{%endcapture%}
        {%capture title%}services_2_{{i}}_title{%endcapture%}
        {%capture desc%}services_2_{{i}}_desc{%endcapture%}
        {%capture link%}services_2_{{i}}_link{%endcapture%}
        {%if settings[show]%}
          {%assign time1 = time1 | plus: 0.1%}
          <div class="col-lg-3 col-12 wow fadeInUp" data-wow-delay="{{time1}}s" data-wow-duration="0.8s">
            <div class="service-item">
              <div class="img"><img src="{{ img | asset_url}}" alt="{{settings[title]}}" /></div>
              <div class="detail">
                {%if settings[title] != ''%}<h3 class="title"><a href="{{settings[link]}}">{{settings[title]}}</a></h3>{%endif%}
                {%if settings[desc] != ''%}<div class="desc">{{settings[desc]}}</div>{%endif%}
              </div>
              </div>
          </div>
        {%endif%}
      {%endfor%}
    </div>
  </div>
</section>
    {%endif%}
  {%if settings.show_services_3%}
<section class="section-services-3">
  <div class="container">
    <div class="heading-title wow fadeInUp" data-wow-delay="0.3s" data-wow-duration="0.8s">
      {% if settings.services_3_title_1 != '' %}
        <div class="title1">{{ settings.services_3_title_1 }}</div>
      {% endif %}
      {% if settings.services_3_title_2 != '' %}
        <h2 class="title2">{{ settings.services_3_title_2 | newline_to_br }}</h2>
      {% endif %}
      {% if settings.services_3_desc != '' %}
        <div class="desc">{{ settings.services_3_desc }}</div>
      {% endif %}
    </div>
    <div class="list-services">
      {%assign time2 = 0.2%}
      {%assign count = 0 %}
      {%for i in (1..3)%}
        {%capture show%}show_services_3_{{i}}{%endcapture%}
        {%capture title%}services_3_{{i}}_title{%endcapture%}
        {%capture desc%}services_3_{{i}}_desc{%endcapture%}
        {%capture link%}services_3_{{i}}_link{%endcapture%}
        {%if settings[show]%}
          {%assign time2 = time2 | plus: 0.1%}
          {%assign count = count | plus: 1 %}
            <div class="service-item wow fadeInUp" data-wow-delay="{{time2}}s" data-wow-duration="0.8s">
              <div class="detail">
                <div class="num">0{{count}}</div>
                <h3 class="title">{{settings[title]}}</h3>
                <div class="desc">{{settings[desc]}}</div>
                <div class="link">
                <a href="{{settings[link]}}">
                  <svg viewBox="0 0 18 12" width="20" height="20"><path d="M17.0988 5.45522L12.1438 0.500221C11.9986 0.355015 11.8016 0.273437 11.5963 0.273438C11.3909 0.273438 11.194 0.355015 11.0488 0.500221C10.9036 0.645427 10.822 0.84237 10.822 1.04772C10.822 1.25307 10.9036 1.45002 11.0488 1.59522L14.6818 5.22822H1.44978C1.2445 5.22822 1.04763 5.30977 0.902481 5.45492C0.757327 5.60007 0.675781 5.79694 0.675781 6.00222C0.675781 6.2075 0.757327 6.40437 0.902481 6.54952C1.04763 6.69468 1.2445 6.77622 1.44978 6.77622H14.6818L11.0488 10.4092C10.9036 10.5544 10.822 10.7514 10.822 10.9567C10.822 11.1621 10.9036 11.359 11.0488 11.5042C11.194 11.6494 11.3909 11.731 11.5963 11.731C11.8016 11.731 11.9986 11.6494 12.1438 11.5042L17.0978 6.54922C17.2429 6.40422 17.3245 6.20756 17.3247 6.00243C17.3249 5.7973 17.2436 5.60048 17.0988 5.45522Z"></path></svg>
                </a>
                </div>
              </div>
          </div>
        {%endif%}
      {%endfor%}
    </div>
  </div>
</section>
    {%endif%}
   {%if settings.show_services_banner%}
<section class="section-services-banner {%if settings.show_services_3%}has-sv{%endif%}">
  <div class="container-fluid">
    <div class="banner"><img src="{{ 'services_banner_img.jpg' | asset_url}}" alt="{{settings.services_banner_desc}}" /></div>
  </div>
  {%if settings.services_banner_desc != ''%}
    <div class="desc text-center">
      <div class="container">{{settings.services_banner_desc}}</div>
    </div>
  {%endif%}
</section>
     {%endif%}
</div>
